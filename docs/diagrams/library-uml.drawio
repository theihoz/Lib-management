y="405.15999999999997" /><mxPoint x="239.02" y="405.15999999999997" /><mxPoint x="253.52" y="414.51" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F14__label5" value="at(effectiveFrom) / kích hoạt nguyên&lt;br&gt;tử" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_ST_F14"><mxGeometry x="278.82" y="486.15999999999997" width="213.20000000000002" height="30" as="geometry" /></mxCell><mxCell id="card_ST_F14__e5" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F14" source="card_ST_F14__n4" target="card_ST_F14__n5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="302.61" y="482.24" /><mxPoint x="302.61" y="508.69999999999993" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F14__label6" value="rút lịch [chưa hiệu lực]" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_ST_F14"><mxGeometry x="309.12" y="305.46" width="144.8" height="17" as="geometry" /></mxCell><mxCell id="card_ST_F14__e6" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F14" source="card_ST_F14__n4" target="card_ST_F14__n1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="328.22" y="417.77" /><mxPoint x="339.61" y="405.15999999999997" /><mxPoint x="339.61" y="405.15999999999997" /><mxPoint x="339.61" y="405.15999999999997" /><mxPoint x="339.61" y="393.15999999999997" /><mxPoint x="339.61" y="393.15999999999997" /><mxPoint x="339.61" y="393.15999999999997" /><mxPoint x="315.61" y="247.95999999999998" /><mxPoint x="315.61" y="247.95999999999998" /><mxPoint x="315.61" y="247.95999999999998" /><mxPoint x="287.65" y="217.20999999999998" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F14__label7" value="version kế tiếp có hiệu lực" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_ST_F14"><mxGeometry x="284.73" y="594.66" width="161.9" height="17" as="geometry" /></mxCell><mxCell id="card_ST_F14__e7" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F14" source="card_ST_F14__n5" target="card_ST_F14__n6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="302.61" y="587.622" /><mxPoint x="302.61" y="608.0179999999999" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F14__note" value="PolicyVersion" style="text;html=1;fontFamily=Arial;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="content_card_ST_F14"><mxGeometry x="24" y="704.16" width="498.23" height="70" as="geometry" /></mxCell><mxCell id="board_161" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chức năng:&lt;/b&gt; F14 ↔ UC17 — Cấu hình quy định&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Người thao tác:&lt;/b&gt; Quản lý&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chủ thể / phạm vi:&lt;/b&gt; PolicyVersion&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; Nút = trạng thái của chủ thể; cạnh = sự kiện [điều kiện] / hành động. Nút đen bắt đầu; nút kép kết thúc phiên được mô tả.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Hoạt động:&lt;/b&gt; Tạo bản nháp từ chính sách hiện hành. → Kiểm tra miền giá trị, các ràng buộc liên quan và tác động. → Duyệt và lên lịch effectiveFrom; không hai version chồng hiệu lực. → Kích hoạt cho giao dịch mới; giao dịch cũ giữ policyVersionId đã chụp.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Quy tắc đề xuất:&lt;/b&gt; Không ghi đè chính sách lịch sử; effectiveFrom, version, người duyệt; tham số nghiệp vụ mâu thuẫn chưa tự áp dụng.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lỗi / ngoại lệ:&lt;/b&gt; Không cho đổi version đã ACTIVE. Muốn sửa tạo bản mới. Thay đổi hồi tố là quy trình riêng có duyệt, không tự tính lại phí.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Kết quả / bất biến:&lt;/b&gt; Một chính sách hiệu lực tại một thời điểm; audit đầy đủ.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="1961" y="14708" width="570" height="850" /></mxCell><mxCell id="card_ST_F15" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#A8BACB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="2626" y="14603" width="1116" height="958" /></mxCell><mxCell id="board_163" value="CHI TIẾT • ST_F15 F15 — Quản lý ảnh bìa R2" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=22;fontStyle=1;fillColor=#EAF2F8;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="2638" y="14613" width="1092" height="80" /></mxCell><mxCell id="content_card_ST_F15" value="" style="group;" vertex="1" parent="1"><mxGeometry as="geometry" x="2646" y="14708" width="476" height="818" /></mxCell><mxCell id="card_ST_F15__title" value="F15 — Quản lý ảnh bìa R2" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="content_card_ST_F15"><mxGeometry x="24" y="16" width="385.53" height="40" as="geometry" /></mxCell><mxCell id="card_ST_F15__n0" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;ellipse;fillColor=#243444;" vertex="1" parent="content_card_ST_F15"><mxGeometry x="212.52" y="90.00000000000001" width="12.959999999999999" height="12.959999999999999" as="geometry" /></mxCell><mxCell id="card_ST_F15__n1" value="STAGED" style="htm