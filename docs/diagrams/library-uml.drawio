"482.35999999999996" /><mxPoint x="180.87" y="713.4" /><mxPoint x="180.87" y="713.4" /><mxPoint x="180.87" y="762.29" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F16__e4" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F16" source="card_AD_F16__n4" target="card_AD_F16__n9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="238.71" y="871.2149999999999" /><mxPoint x="267.49" y="891.164" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F16__label5" value="[hợp lệ]" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_AD_F16"><mxGeometry x="285.11" y="412.09999999999997" width="53.6" height="17" as="geometry" /></mxCell><mxCell id="card_AD_F16__e5" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F16" source="card_AD_F16__n3" target="card_AD_F16__n5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="237.41" y="393.75" /><mxPoint x="288.95" y="422.39" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F16__e6" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F16" source="card_AD_F16__n5" target="card_AD_F16__n6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="406.01" y="529.0799999999999" /><mxPoint x="408.96" y="543.5" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F16__e7" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F16" source="card_AD_F16__n6" target="card_AD_F16__n7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="419.87" y="643.48" /><mxPoint x="419.87" y="657.75" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F16__label8" value="[thành công]" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_AD_F16"><mxGeometry x="411.99" y="766.66" width="76.4" height="17" as="geometry" /></mxCell><mxCell id="card_AD_F16__e8" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F16" source="card_AD_F16__n7" target="card_AD_F16__n8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="421.95" y="761.43" /><mxPoint x="422.77" y="780.43" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F16__label9" value="[lỗi / rollback nếu có ghi DB]" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_AD_F16"><mxGeometry x="259.63" y="766.66" width="179.0" height="17" as="geometry" /></mxCell><mxCell id="card_AD_F16__e9" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F16" source="card_AD_F16__n7" target="card_AD_F16__n4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="311.72" y="757.91" /><mxPoint x="284.38" y="769.16" /><mxPoint x="284.38" y="769.16" /><mxPoint x="284.38" y="769.16" /><mxPoint x="256.78" y="785.15" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F16__e10" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F16" source="card_AD_F16__n8" target="card_AD_F16__n9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="365.95" y="871.3" /><mxPoint x="336.51" y="891.3779999999999" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F16__note" value="Vai trò hành động ghi trong nút; nhánh lỗi kết thúc yêu cầu, dữ liệu không ghi một phần." style="text;html=1;fontFamily=Arial;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="content_card_AD_F16"><mxGeometry x="24" y="962.92" width="584.2" height="70" as="geometry" /></mxCell><mxCell id="board_270" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chức năng:&lt;/b&gt; F16 ↔ UC0 — Đăng nhập và phiên truy cập&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Người thao tác:&lt;/b&gt; Nhân viên; độc giả có tài khoản&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chủ thể / phạm vi:&lt;/b&gt; Một lần thực hiện chức năng; từ bắt đầu đến kết quả&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; Đọc theo mũi tên; chữ nhật là hoạt động, hình thoi chọn nhánh theo guard. Nhánh lỗi phải sửa hoặc kết thúc; không bỏ qua bước kiểm tra.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Hoạt động:&lt;/b&gt; Chuyển đăng nhập tới nhà cung cấp danh tính đã cấu hình. → Nhận callback; kiểm tra state/nonce/PKCE và token. → Ánh xạ tài khoản được mời/allowlist; lấy vai trò từ máy chủ. → Tạo phiên, kiểm tra quyền mỗi API; logout/thu hồi/hết hạn kết thúc phiên.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Quy tắc đề xuất:&lt;/b&gt; OIDC/JWT từ issuer tin cậy; kiểm tra iss/aud/exp/chữ ký; JIT chỉ từ danh mục đã cho phép, không tự nâng quyền.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lỗi / ngoại lệ:&lt;/b&gt; Token sai hoặc hết hạn: 401. Token hợp lệ nhưng không quyền: 403. Không log token; không tiết lộ tài khoản tồn tại qua lỗi đăng nhập.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Kết quả / bất biến:&lt;/b&gt; Vai trò không lấy từ input hoặc token issuer tùy ý; JWT ngắn hạn, refresh token có xoay vòng.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="4902" y="20125" width="570" height="1108" /></mxCell><mxCell id="card_AD_F17" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#A8BACB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="5567" y="20020" width="1305" height="1197" /></mxCell><mxCell id="board_272" value="CHI TIẾT • AD_F17 F17 — Luồng Xem lịch sử độc giả" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=22;fontStyle=1;fillColor=#EAF2F8;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="5579" y="20030" width="1281" height="80" /></mxCell><mxCell id="content_card_AD_F17" value="" style="group;" vertex="1" parent="1"><mxGeometry as="geometry" x="5587" y="20125" width="665" height="1057" /></mxCell><mxCell id="card_AD_F17__title" value="F17 — Luồng Xem lịch sử độc giả" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="content_card_AD_F17"><mxGeometry x="24" y="16" width="574.25" height="40" as="geometry" /></mxCell><mxCell id="card_AD_F17__n0" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;ellipse;fillColor=#243444;" vertex="1" parent="content_card_AD_F17"><mxGeometry x="204.01000000000002" y="90.00000000000001" width="12.959999999999999" height="12.959999999999999" as="geometry" /></mxCell><mxCell id="card_AD_F17__n1" value="Người dùng&lt;br&gt;Xác định readerId từ phiên cho độc giả." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F17"><mxGeometry x="75.05439999999999" y="151.96012000000007" width="270.87120000000004" height="49.91976" as="geometry" /></mxCell><mxCell id="card_AD_F17__n2" value="API&lt;br&gt;Kiểm tra quyền và input" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F17"><mxGeometry x="125.638" y="250.88012000000003" width="169.704" height="49.91976" as="geometry" /></mxCell><mxCell id="card_AD_F17__n3" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rhombus;" vertex="1" parent="content_card_AD_F17"><mxGeometry x="197.89000000000001" y="349.79999999999995" width="25.2" height="25.2" as="geometry" /></mxCell><mxCell id="card_AD_F17__n4" value="API&lt;br&gt;Trả lỗi có mã; không ghi dữ liệu" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F17"><mxGeometry x="70.0024" y="773.9601200000001" width="220.9752" height="49.91976" as="geometry" /></mxCell><mxCell id="card_AD_F17__n5" value="Hệ thống&lt;br&gt;Kiểm tra phạm vi, kỳ và phân trang." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F17"><mxGeometry x="269.5228" y="435.00012000000004" width="241.93439999999998" height="49.91976" as="geometry" /></mxCell><mxCell id="card_AD_F17__n6" value="Hệ thống&lt;br&gt;Đọc khoản mượn, trả, gia hạn và sổ phí;&lt;br&gt;không nối bảng làm nhân số tiền." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F17"><mxGeometry x="284.73080000000004" y="533.9200000000001" width="279.5184" height="65.52" as="geometry" /></mxCell><mxCell id="card_AD_F17__n7" value="Hệ thống&lt;br&gt;Trả kết quả đã che dữ liệu không cần&lt;br&gt;thiết." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F17"><mxGeometry x="293.7632" y="648.44" width="261.4536" height="65.52" as="geometry" /></mxCell><mxCell id="card_AD_F17__n8" value="API&lt;br&gt;Trả kết quả và mã yêu cầu" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F17"><mxGeometry x="327.3728" y="773.9601200000001" width="194.23440000000002" height="49.91976" as="geometry" /></mxCell><mxCell id="card_AD_F17__n9" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;shape=doubleEllipse;fillColor=#243444;" vertex="1" parent="content_card_AD_F17"><mxGeometry x="289.57004" y="872.8800400000001" width="23.83992" height="23.83992" as="geometry" /></mxCell><mxCell id="card_AD_F17__e0" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F17" source="card_AD_F17__n0" target="card_AD_F17__n1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="210.49" y="111.91000000000008" /><mxPoint x="210.49" y="128.35000000000002" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F17__e1" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F17" source="card_AD_F17__n1" target="card_AD_F17__n2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="210.49" y="214.43000000000006" /><mxPoint x="210.49" y="229.13" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F17__e2" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F17" source="card_AD_F17__n2" target="card_AD_F17__n3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="210.49" y="313.89" /><mxPoint x="210.49" y="329.07000000000005" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F17__label3" value="[không hợp lệ]" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_AD_F17"><mxGeometry x="170.76999999999998" y="558.1800000000001" width="87.8" height="17" as="geometry" /></mxCell><mxCell id="card_AD_F17__e3" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F17" source="card_AD_F17__n3" target="card_AD_F17__n4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="200.1" y="396.48" /><mxPoint x="180.49" y="458.96000000000004" /><mxPoint x="180.49" y="458.96000000000004" /><mxPoint x="180.49" y="458.96000000000004" /><mxPoint x="180.49" y="458.96000000000004" /><mxPoint x="180.49" y="682.2" /><mxPoint x="180.49" y="682.2" /><mxPoint x="180.49" y="731.09" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F17__e4" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F17" source="card_AD_F17__n4" target="card_AD_F17__n9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="238.33" y="840.015" /><mxPoint x="267.1" y="859.964" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F17__label5" value="[hợp lệ]" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_AD_F17"><mxGeometry x="287.47" y="396.5" width="53.6" height="17" as="geometry" /></mxCell><mxCell id="card_AD_F17__e5" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F17" source="card_AD_F17__n3" target="card_AD_F17__n5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="238.51" y="378.28" /><mxPoint x="294.65999999999997" y="408.09000000000003" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F17__e6" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F17" source="card_AD_F17__n5" target="card_AD_F17__n6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="402.28" y="497.27000000000004" /><mxPoint x="407.09" y="512.09" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F17__e7" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F17" source="card_AD_F17__n6" target="card_AD_F17__n7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="424.49" y="612.28" /><mxPoint x="424.49" y="626.55" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F17__label8" value="[thành công]" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_AD_F17"><mxGeometry x="413.81" y="735.46" width="76.4" height="17" as="geometry" /></mxCell><mxCell id="card_AD_F17__e8" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F17" source="card_AD_F17__n7" target="card_AD_F17__n8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="424.49" y="730.23" /><mxPoint x="424.49" y="749.23" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F17__label9" value="[lỗi / rollback nếu có ghi DB]" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_AD_F17"><mxGeometry x="261.24" y="735.46" width="179.0" height="17" as="geometry" /></mxCell><mxCell id="card_AD_F17__e9" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F17" source="card_AD_F17__n7" target="card_AD_F17__n4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="313.94" y="726.71" /><mxPoint x="286" y="737.96" /><mxPoint x="286" y="737.96" /><mxPoint x="286" y="737.96" /><mxPoint x="257.87" y="753.95" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F17__e10" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F17" source="card_AD_F17__n8" target="card_AD_F17__n9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="365.57" y="840.1" /><mxPoint x="336.13" y="860.178" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F17__note" value="Vai trò hành động ghi trong nút; nhánh lỗi kết thúc yêu cầu, dữ liệu không ghi một phần." style="text;html=1;fontFamily=Arial;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="content_card_AD_F17"><mxGeometry x="24" y="931.72" width="594.25" height="70" as="geometry" /></mxCell><mxCell id="board_274" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chức năng:&lt;/b&gt; F17 ↔ UC13 — Xem lịch sử độc giả&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Người thao tác:&lt;/b&gt; Thủ thư; độc giả xem của mình&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chủ thể / phạm vi:&lt;/b&gt; Một lần thực hiện chức năng; từ bắt đầu đến kết quả&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; Đọc theo mũi tên; chữ nhật là hoạt động, hình thoi chọn nhánh theo guard. Nhánh lỗi phải sửa hoặc kết thúc; không bỏ qua bước kiểm tra.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Hoạt động:&lt;/b&gt; Xác định readerId từ phiên cho độc giả. → Kiểm tra phạm vi, kỳ và phân trang. → Đọc khoản mượn, trả, gia hạn và sổ phí; không nối bảng làm nhân số tiền. → Trả kết quả đã che dữ liệu không cần thiết.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Quy tắc đề xuất:&lt;/b&gt; Độc giả chỉ truy cập readerId của chính mình; nhân viên theo phạm vi quyền, có audit truy cập dữ liệu cá nhân.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lỗi / ngoại lệ:&lt;/b&gt; Đổi readerId để xem người khác: 403; không có lịch sử trả danh sách rỗng; dữ liệu nhân viên chỉ được đọc có quyền.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Kết quả / bất biến:&lt;/b&gt; Truy vấn không sửa khoản mượn; kết quả có cursor và phạm vi rõ ràng.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="6267" y="20125" width="570" height="1077" /></mxCell><mxCell id="card_AD_F18" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#A8BACB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="6932" y="20020" width="1302" height="1213" /></mxCell><mxCell id="board_276" value="CHI TIẾT • AD_F18 F18 — Luồng Tìm kiếm nhanh sách và độc giả" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=22;fontStyle=1;fillColor=#EAF2F8;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="6944" y="20030" width="1278" height="80" /></mxCell><mxCell id="content_card_AD_F18" value="" style="group;" vertex="1" parent="1"><mxGeometry as="geometry" x="6952" y="20125" width="662" height="1073" /></mxCell><mxCell id="card_AD_F18__title" value="F18 — Luồng Tìm kiếm nhanh sách và độc giả" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="content_card_AD_F18"><mxGeometry x="24" y="16" width="571.03" height="40" as="geometry" /></mxCell><mxCell id="card_AD_F18__n0" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;ellipse;fillColor=#243444;" vertex="1" parent="content_card_AD_F18"><mxGeometry x="206.89000000000001" y="90.00000000000001" width="12.959999999999999" height="12.959999999999999" as="geometry" /></mxCell><mxCell id="card_AD_F18__n1" value="Người dùng&lt;br&gt;Nhập từ khóa/bộ lọc tên sách, tác giả, thể&lt;br&gt;loại hoặc mã." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F18"><mxGeometry x="70" y="151.96000000000004" width="286.74" height="65.52" as="geometry" /></mxCell><mxCell id="card_AD_F18__n2" value="API&lt;br&gt;Kiểm tra quyền và input" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F18"><mxGeometry x="128.518" y="266.48012000000006" width="169.704" height="49.91976" as="geometry" /></mxCell><mxCell id="card_AD_F18__n3" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rhombus;" vertex="1" parent="content_card_AD_F18"><mxGeometry x="200.77" y="365.4" width="25.2" height="25.2" as="geometry" /></mxCell><mxCell id="card_AD_F18__n4" value="API&lt;br&gt;Trả lỗi có mã; không ghi dữ liệu" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F18"><mxGeometry x="72.8824" y="789.5601200000001" width="220.9752" height="49.91976" as="geometry" /></mxCell><mxCell id="card_AD_F18__n5" value="Hệ thống&lt;br&gt;Chuẩn hóa, giới hạn độ dài và phân trang." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F18"><mxGeometry x="259.1492" y="450.60012000000006" width="282.4416" height="49.91976" as="geometry" /></mxCell><mxCell id="card_AD_F18__n6" value="Hệ thống&lt;br&gt;Tách truy vấn catalog và reader; kiểm tra&lt;br&gt;quyền trước truy vấn reader." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F18"><mxGeometry x="287.67600000000004" y="549.52" width="269.388" height="65.52" as="geometry" /></mxCell><mxCell id="card_AD_F18__n7" value="Hệ thống&lt;br&gt;Trả trạng thái tồn tại thời điểm truy vấn,&lt;br&gt;không bảo đảm sách còn lúc checkout." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1"