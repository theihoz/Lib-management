ontent_card_Components"><mxGeometry x="24" y="657.32" width="1091.1799999999998" height="70" as="geometry" /></mxCell><mxCell id="board_32" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Mục đích:&lt;/b&gt; Thành phần và phụ thuộc&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; Hộp là thành phần / module; mũi tên chỉ phụ thuộc hoặc giao tiếp. Adapter giữ tích hợp ngoài tách khỏi nghiệp vụ.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách hoạt động:&lt;/b&gt; Web UI gửi yêu cầu tới HTTP API. API xác thực, phân quyền, kiểm tra dữ liệu và chuyển cho module miền: danh mục, thẻ, lưu thông, giữ chỗ, phí, báo cáo và chính sách. Các module dùng repository trên PostgreSQL. Worker xử lý outbox / job sau commit; adapter bọc OIDC, storage và thông báo. Kế hoạch đề xuất TypeScript, React và FastAPI; cấu trúc là modular monolith.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lưu ý / ràng buộc:&lt;/b&gt; Modular monolith cho quy mô ban đầu; chia module trước, chỉ tách service khi có số liệu.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="1297" y="4987" width="570" height="803" /></mxCell><mxCell id="board_33" value="&lt;b&gt;04 — TRIỂN KHAI&lt;/b&gt;&lt;br&gt;Thiết bị, môi trường chạy và vùng tin cậy." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=24;fillColor=#16324F;fontColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="5905" width="9800" height="95" /></mxCell><mxCell id="card_Deployment" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#A8BACB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="6035" width="1645" height="756" /></mxCell><mxCell id="board_35" value="TỔNG QUÁT TOÀN HỆ THỐNG • Deployment Triển khai và vùng tin cậy" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=22;fontStyle=1;fillColor=#DDF2E7;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="112" y="6045" width="1621" height="80" /></mxCell><mxCell id="content_card_Deployment" value="" style="group;" vertex="1" parent="1"><mxGeometry as="geometry" x="120" y="6140" width="1005" height="616" /></mxCell><mxCell id="card_Deployment__title" value="Triển khai và vùng tin cậy" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="content_card_Deployment"><mxGeometry x="24" y="16" width="914.34" height="40" as="geometry" /></mxCell><mxCell id="card_Deployment__n0" value="Thiết bị quầy / độc giả" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=0;fillColor=#edf3f7;" vertex="1" parent="content_card_Deployment"><mxGeometry x="562.1044" y="90" width="175.4712" height="36" as="geometry" /></mxCell><mxCell id="card_Deployment__n1" value="TLS reverse proxy&lt;br&gt;Rate limit" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=0;fillColor=#edf3f7;" vertex="1" parent="content_card_Deployment"><mxGeometry x="583.78" y="186.00011999999998" width="132.12" height="49.91976" as="geometry" /></mxCell><mxCell id="card_Deployment__n2" value="App replicas&lt;br&gt;Stateless API" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=0;fillColor=#edf3f7;" vertex="1" parent="content_card_Deployment"><mxGeometry x="597.8596" y="295.92012" width="103.96079999999999" height="49.91976" as="geometry" /></mxCell><mxCell id="card_Deployment__n3" value="Worker replicas&lt;br&gt;Job lease" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=0;fillColor=#edf3f7;" vertex="1" parent="content_card_Deployment"><mxGeometry x="166.73239999999998" y="295.92012" width="116.21520000000001" height="49.91976" as="geometry" /></mxCell><mxCell id="card_Deployment__n4" value="PostgreSQL primary&lt;br&gt;Backup + WAL" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=0;fillColor=#edf3f7;" vertex="1" parent="content_card_Deployment"><mxGeometry x="69.9994" y="405.84012" width="143.6832" height="49.91976" as="geometry" /></mxCell><mxCell id="card_Deployment__n5" value="R2 covers (domain riêng)&lt;br&gt;R2 exports (private)" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=0;fillColor=#edf3f7;" vertex="1" parent="content_card_Deployment"><mxGeometry x="331.91159999999996" y="405.84012" width="171.8568" height="49.91976" as="geometry" /></mxCell><mxCell id="card_Deployment__n6" value="Logs / Metrics / Traces&lt;br&gt;Không PII/token" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=0;fillColor=#edf3f7;" vertex="1" parent="content_card_Deployment"><mxGeometry x="581.1404" y="405.84012" width="157.3992" height="49.91976" as="geometry" /></mxCell><mxCell id="card_Deployment__n7" value="OIDC provider" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_Deployment"><mxGeometry x="795.3396" y="412.8" width="109.0008" height="36" as="geometry" /></mxCell><mxCell id="card_Deployment__label0" value="HTTPS" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_Deployment"><mxGeometry x="647.98" y="147.5" width="36.5" height="17" as="geometry" /></mxCell><mxCell id="card_Deployment__e0" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="