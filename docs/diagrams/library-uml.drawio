></mxGeometry></mxCell><mxCell id="card_ERD__label13" value="1 : N" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_ERD"><mxGeometry x="1061.95" y="611.4000000000001" width="36.5" height="17" as="geometry" /></mxCell><mxCell id="card_ERD__e13" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;endArrow=none;" edge="1" parent="content_card_ERD" source="card_ERD__n8" target="card_ERD__n10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1068.25" y="625.28" /><mxPoint x="1092.6" y="636.26" /></Array></mxGeometry></mxCell><mxCell id="card_ERD__label14" value="1 : N" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_ERD"><mxGeometry x="437.02" y="463.99" width="36.5" height="17" as="geometry" /></mxCell><mxCell id="card_ERD__e14" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;endArrow=none;" edge="1" parent="content_card_ERD" source="card_ERD__n11" target="card_ERD__n5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="425" y="505.09000000000003" /><mxPoint x="485.51" y="483.88" /></Array></mxGeometry></mxCell><mxCell id="card_ERD__label15" value="1 : N" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_ERD"><mxGeometry x="624.23" y="537.79" width="36.5" height="17" as="geometry" /></mxCell><mxCell id="card_ERD__e15" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;endArrow=none;" edge="1" parent="content_card_ERD" source="card_ERD__n11" target="card_ERD__n8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="491.94" y="550.09" /><mxPoint x="731.73" y="562.62" /></Array></mxGeometry></mxCell><mxCell id="card_ERD__note" value="Bảng liên kết Author/Category, Media, Waiver, Audit, Outbox, Idempotency và Jobs mô tả thêm trong từ điển dữ liệu." style="text;html=1;fontFamily=Arial;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="content_card_ERD"><mxGeometry x="24" y="874.6" width="1314.7" height="70" as="geometry" /></mxCell><mxCell id="board_67" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Mục đích:&lt;/b&gt; ERD — Khóa và liên kết cốt lõi&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; PK = khóa chính; FK = tham chiếu; UQ = duy nhất; ? = tùy chọn. Nhãn bội số phản ánh quan hệ, không phải thứ tự gọi.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách hoạt động:&lt;/b&gt; Các khóa id nhận diện bảng; FK liên kết đầu sách → bản sao, độc giả → thẻ / phiếu, phiếu → item và giữ chỗ → edition / copy. Partial unique chỉ cho phép một item OPEN trên copy và một READY trên copy. Các bảng nghiệp vụ được giữ lịch sử; không cascade xóa giao dịch khi ngừng khai thác sách.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lưu ý / ràng buộc:&lt;/b&gt; Bảng liên kết Author/Category, Media, Waiver, Audit, Outbox, Idempotency và Jobs mô tả thêm trong từ điển dữ liệu.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="4070" y="9006" width="570" height="1020" /></mxCell><mxCell id="card_ERD_Loan" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#A8BACB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="4735" y="8901" width="1493" height="956" /></mxCell><mxCell id="board_69" value="CHI TIẾT • ERD_Loan ERD chi tiết — Mượn và giữ chỗ" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fon