as="geometry"><Array as="points"><mxPoint x="234.92" y="393.77" /><mxPoint x="288.3" y="422.50999999999993" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F06__e6" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F06" source="card_AD_F06__n5" target="card_AD_F06__n6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="411.01" y="529.0799999999999" /><mxPoint x="414.73" y="543.5" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F06__e7" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F06" source="card_AD_F06__n6" target="card_AD_F06__n7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="426.9" y="643.48" /><mxPoint x="426.4" y="657.75" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F06__label8" value="[thành công]" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_AD_F06"><mxGeometry x="413.81" y="766.66" width="76.4" height="17" as="geometry" /></mxCell><mxCell id="card_AD_F06__e8" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F06" source="card_AD_F06__n7" target="card_AD_F06__n8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="424.49" y="761.43" /><mxPoint x="424.49" y="780.43" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F06__label9" value="[lỗi / rollback nếu có ghi DB]" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_AD_F06"><mxGeometry x="261.24" y="766.66" width="179.0" height="17" as="geometry" /></mxCell><mxCell id="card_AD_F06__e9" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F06" source="card_AD_F06__n7" target="card_AD_F06__n4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="313.94" y="757.91" /><mxPoint x="286" y="769.16" /><mxPoint x="286" y="769.16" /><mxPoint x="286" y="769.16" /><mxPoint x="257.87" y="785.15" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F06__e10" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F06" source="card_AD_F06__n8" target="card_AD_F06__n9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="365.57" y="871.3" /><mxPoint x="336.13" y="891.3779999999999" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F06__note" value="Vai trò hành động ghi trong nút; nhánh lỗi kết thúc yêu cầu, dữ liệu không ghi một phần." style="text;html=1;fontFamily=Arial;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="content_card_AD_F06"><mxGeometry x="24" y="962.92" width="605.11" height="70" as="geometry" /></mxCell><mxCell id="board_230" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chức năng:&lt;/b&gt; F06 ↔ UC5 — Quản lý độc giả và thẻ&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Người thao tác:&lt;/b&gt; Thủ thư&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chủ thể / phạm vi:&lt;/b&gt; Một lần thực hiện chức năng; từ bắt đầu đến kết quả&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; Đọc theo mũi tên; chữ nhật là hoạt động, hình thoi chọn nhánh theo guard. Nhánh lỗi phải sửa hoặc kết thúc; không bỏ qua bước kiểm tra.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Hoạt động:&lt;/b&gt; Nhập độc giả, loại X/Y/Z, ngày sinh và email. → Tính tuổi theo ngày địa phương; kiểm tra trùng và tham chiếu. → Cấp thẻ ACTIVE với expiresAt cộng 6 tháng lịch. → Tạm khóa theo lý do; hết hạn được xác định theo đồng hồ dù job chưa chạy.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Quy tắc đề xuất:&lt;/b&gt; QĐ01: tuổi 12–55 lúc cấp; QĐ02: hiệu lực 6 tháng lịch; khoảng hiệu lực [issuedAt, expiresAt).&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lỗi / ngoại lệ:&lt;/b&gt; Không đủ tuổi hoặc email trùng: không cấp. Mở khóa chỉ khi còn hiệu lực. Gia hạn thẻ cần chính sách được duyệt, chưa tự thêm vào baseline.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Kết quả / bất biến:&lt;/b&gt; Không sửa ngày cấp để kéo dài thẻ; lưu người cấp và lịch sử.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="811" y="18821" width="570" height="1108" /></mxCell><mxCell id="card_AD_F07" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#A8BACB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="1476" y="18716" width="1310" height="1244" /></mxCell><mxCell id="board_232" value="CHI TIẾT • AD_F07 F07 — Luồng Cho mượn sách" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=22;fontStyle=1;fillColor=#EAF2F8;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="1488" y="18726" width="1286" height="80" /></mxCell><mxCell id="content_card_AD_F07" value="" style="group;" vertex="1" parent="1"><mxGeometry as="geometry" x="1496" y="18821" width="670" height="1104" /></mxCell><mxCell id="card_AD_F07__title" value="F07 — Luồng Cho mượn sách" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="content_card_AD_F07"><mxGeometry x="24" y="16" width="579.3199999999999" height="40" as="geometry" /></mxCell><mxCell id="card_AD_F07__n0" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;ellipse;fillColor=#243444;" vertex="1" parent="content_card_AD_F07"><mxGeometry x="204.01000000000002" y="90.00000000000001" width="12.959999999999999" height="12.959999999999999" as="geometry" /></mxCell><mxCell id="card_AD_F07__n1" value="Người dùng&lt;br&gt;Quét thẻ và mã vạch các bản sao; nhận&lt;br&gt;Idempotency-Key." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F07"><mxGeometry x="75.42520000000002" y="151.96000000000004" width="270.1296" height="65.52" as="geometry" /></mxCell><mxCell id="card_AD_F07__n2" value="API&lt;br&gt;Kiểm tra quyền và input" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F07"><mxGeometry x="125.638" y="266.48011999999994" width="169.704" height="49.91976" as="geometry" /></mxCell><mxCell id="card_AD_F07__n3" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rhombus;" vertex="1" parent="content_card_AD_F07"><mxGeometry x="197.89000000000001" y="365.4" width="25.2" height="25.2" as="geometry" /></mxCell><mxCell id="card_AD_F07__n4" value="API&lt;br&gt;Trả lỗi có mã; không ghi dữ liệu" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F07"><mxGeometry x="70.0024" y="820.76012" width="220.9752" height="49.91976" as="geometry" /></mxCell><mxCell id="card_AD_F07__n5" value="Hệ thống&lt;br&gt;Kiểm tra quyền, thẻ, dư nợ, quá hạn, số&lt;br&gt;cuốn và giữ chỗ." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F07"><mxGeometry x="260.8944" y="450.59999999999997" width="275.1912" height="65.52" as="geometry" /></mxCell><mxCell id="card_AD_F07__n6" value="Hệ thống&lt;br&gt;Khóa các bản sao theo thứ tự ID; kiểm tra&lt;br&gt;lại khả dụng trong giao dịch." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F07"><mxGeometry x="284.73080000000004" y="565.12" width="279.5184" height="65.52" as="geometry" /></mxCell><mxCell id="card_AD_F07__n7" value="Hệ thống&lt;br&gt;Tạo Loan và LoanItem với dueAt,&lt;br&gt;policyVersionId; chuyển bản sao ON_LOAN;&lt;br&gt;commit." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F07"><mxGeometry x="279.66200000000003" y="679.6388000000001" width="289.65599999999995" height="81.1224" as="geometry" /></mxCell><mxCell id="card_AD_F07__n8" value="API&lt;br&gt;Trả kết quả và mã yêu cầu" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F07"><mxGeometry x="327.3728" y="820.76012" width="194.23440000000002" height="49.91976" as="geometry" /></mxCell><mxCell id="card_AD_F07__n9" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;shape=doubleEllipse;fillColor=#243444;" vertex="1" parent="content_card_AD_F07"><mxGeometry x="289.57004" y="919.6800400000001" width="23.83992" height="23.83992" as="geometry" /></mxCell><mxCell id="card_AD_F07__e0" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F07" source="card_AD_F07__n0" target="card_AD_F07__n1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="210.49" y="111.75999999999999" /><mxPoint x="210.49" y="127.68999999999994" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F07__e1" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F07" source="card_AD_F07__n1" target="card_AD_F07__n2">