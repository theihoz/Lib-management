608.59" y="305.46000000000004" width="65.0" height="17" as="geometry" /></mxCell><mxCell id="card_ST_F17__e7" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F17" source="card_ST_F17__n5" target="card_ST_F17__n1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="629.28" y="417.598" /><mxPoint x="649" y="405.16" /><mxPoint x="649" y="405.16" /><mxPoint x="649" y="405.16" /><mxPoint x="649" y="393.16" /><mxPoint x="649" y="393.16" /><mxPoint x="649" y="393.16" /><mxPoint x="567" y="211.96000000000004" /><mxPoint x="567" y="211.96000000000004" /><mxPoint x="567" y="211.96000000000004" /><mxPoint x="519.0799999999999" y="198.95000000000005" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F17__label8" value="thử lại" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_ST_F17"><mxGeometry x="266.13" y="305.46000000000004" width="47.9" height="17" as="geometry" /></mxCell><mxCell id="card_ST_F17__e8" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F17" source="card_ST_F17__n6" target="card_ST_F17__n1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="263.41999999999996" y="422.399" /><mxPoint x="189" y="405.16" /><mxPoint x="189" y="405.16" /><mxPoint x="189" y="405.16" /><mxPoint x="189" y="393.16" /><mxPoint x="189" y="393.16" /><mxPoint x="189" y="393.16" /><mxPoint x="333.92" y="251.3" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F17__label9" value="đóng phiên" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_ST_F17"><mxGeometry x="721.88" y="209.46000000000004" width="65.0" height="17" as="geometry" /></mxCell><mxCell id="card_ST_F17__e9" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F17" source="card_ST_F17__n1" target="card_ST_F17__n7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="556.95" y="189.91000000000003" /><mxPoint x="721" y="211.96000000000004" /><mxPoint x="721" y="211.96000000000004" /><mxPoint x="721" y="211.96000000000004" /><mxPoint x="737.22" y="233.46000000000004" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F17__note" value="HistoryQuerySession" style="text;html=1;fontFamily=Arial;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="content_card_ST_F17"><mxGeometry x="24" y="500.16" width="809.12" height="70" as="geometry" /></mxCell><mxCell id="board_173" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chức năng:&lt;/b&gt; F17 ↔ UC13 — Xem lịch sử độc giả&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Người thao tác:&lt;/b&gt; Thủ thư; độc giả xem của mình&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chủ thể / phạm vi:&lt;/b&gt; HistoryQuerySession&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; Nút = trạng thái của chủ thể; cạnh = sự kiện [điều kiện] / hành động. Nút đen bắt đầu; nút kép kết thúc phiên được mô tả.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Hoạt động:&lt;/b&gt; Xác định readerId từ phiên cho độc giả. → Kiểm tra phạm vi, kỳ và phân trang. → Đọc khoản mượn, trả, gia hạn và sổ phí; không nối bảng làm nhân số tiền. → Trả kết quả đã che dữ liệu không cần thiết.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Quy tắc đề xuất:&lt;/b&gt; Độc giả chỉ truy cập readerId của chính mình; nhân viên theo phạm vi quyền, có audit truy cập dữ liệu cá nhân.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lỗi / ngoại lệ:&lt;/b&gt; Đổi readerId để xem người khác: 403; không có lịch sử trả danh sách rỗng; dữ liệu nhân viên chỉ được đọc có quyền.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Kết quả / bất biến:&lt;/b&gt; Truy vấn không sửa khoản mượn; kết quả có cursor và phạm vi rõ ràng.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="5944" y="14708" width="570" height="646" /></mxCell><mxCell id="card_ST_F18" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#A8BACB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="6609" y="14603" width="1520" height="766" /></mxCell><mxCell id="board_175" value="CHI TIẾT • ST_F18 F18 — Tìm kiếm nhanh sách và độc giả" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=22;fontStyle=1;fillColor=#EAF2F8;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="6621" y="14613" width="1496" height="80" /></mxCell><mxCell id="content_card_ST_F18" value="" style="group;" vertex="1" parent="1"><mxGeometry as="geometry" x="6629" y="14708" width="880" height="626" /></mxCell><mxCell id="card_ST_F18__title" value="F18 — Tìm kiếm nhanh sách và độc giả" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="content_card_ST_F18"><mxGeometry x="24" y="16" width="789.12" height="40" as="geometry" /></mxCell><mxCell id="card_ST_F18__n0" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;ellipse;fillColor=#243444;" vertex="1" parent="content_card_ST_F18"><mxGeometry x="409.52" y="90.00000000000001" width="12.959999999999999" height="12.959999999999999" as="geometry" /></mxCell><mxCell id="card_ST_F18__n1" value="Nhập bộ lọc" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_ST_F18"><mxGeo