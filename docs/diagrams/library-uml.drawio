 id="card_AD_F18__e6" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F18" source="card_AD_F18__n5" target="card_AD_F18__n6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="407.97" y="512.76" /><mxPoint x="411.05" y="527.4200000000001" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F18__e7" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F18" source="card_AD_F18__n6" target="card_AD_F18__n7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="422.37" y="627.8800000000001" /><mxPoint x="422.37" y="642.1500000000001" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F18__label8" value="[thành công]" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_AD_F18"><mxGeometry x="414.49" y="751.0600000000001" width="76.4" height="17" as="geometry" /></mxCell><mxCell id="card_AD_F18__e8" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F18" source="card_AD_F18__n7" target="card_AD_F18__n8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="424.44" y="745.83" /><mxPoint x="425.27" y="764.83" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F18__label9" value="[lỗi / rollback nếu có ghi DB]" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_AD_F18"><mxGeometry x="262.12" y="751.0600000000001" width="179.0" height="17" as="geometry" /></mxCell><mxCell id="card_AD_F18__e9" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F18" source="card_AD_F18__n7" target="card_AD_F18__n4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="314.22" y="742.3100000000001" /><mxPoint x="286.88" y="753.5600000000001" /><mxPoint x="286.88" y="753.5600000000001" /><mxPoint x="286.88" y="753.5600000000001" /><mxPoint x="259.28" y="769.5500000000001" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F18__e10" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F18" source="card_AD_F18__n8" target="card_AD_F18__n9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="368.45" y="855.7" /><mxPoint x="339.01" y="875.778" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F18__note" value="Vai trò hành động ghi trong nút; nhánh lỗi kết thúc yêu cầu, dữ liệu không ghi một phần." style="text;html=1;fontFamily=Arial;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="content_card_AD_F18"><mxGeometry x="24" y="947.32" width="591.03" height="70" as="geometry" /></mxCell><mxCell id="board_278" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chức năng:&lt;/b&gt; F18 ↔ UC12 — Tìm kiếm nhanh sách và độc giả&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Người thao tác:&lt;/b&gt; Mọi người tìm sách; Thủ thư tìm độc giả&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chủ thể / phạm vi:&lt;/b&gt; Một lần thực hiện chức năng; từ bắt đầu đến kết quả&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; Đọc theo mũi tên; chữ nhật là hoạt động, hình thoi chọn nhánh theo guard. Nhánh lỗi phải sửa hoặc kết thúc; không bỏ qua bước kiểm tra.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Hoạt động:&lt;/b&gt; Nhập từ khóa/bộ lọc tên sách, tác giả, thể loại hoặc mã. → Chuẩn hóa, giới hạn độ dài và phân trang. → Tách truy vấn catalog và reader; kiểm tra quyền trước truy vấn reader. → Trả trạng thái tồn tại thời điểm truy vấn, không bảo đảm sách còn lúc checkout.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Quy tắc đề xuất:&lt;/b&gt; Tìm độc giả là API có quyền riêng; catalog công khai không chứa dữ liệu độc giả; Ctrl+K là shortcut UI.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lỗi / ngoại lệ:&lt;/b&gt; Không kết quả là trạng thái rỗng. Truy vấn quá rộng phải có limit; không ghép SQL bằng chuỗi input.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Kết quả / bất biến:&lt;/b&gt; Không rò rỉ reader qua endpoint công khai.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="7629" y="20125" width="570" height="1093" /></mxCell><mxCell id="card_AD_F19" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#A8BACB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="8294" y="20020" width="1304" height="1197" /></mxCell><mxCell id="board_280" value="CHI TIẾT • AD_F19 F19 — Luồng Theo dõi sách quá hạn" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=22;fontStyle=1;fillColor=#EAF2F8;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="8306" y="20030" width="1280" height="80" /></mxCell><mxCell id="content_card_AD_F19" value="" style="group;" vertex="1" parent="1"><mxGeometry as="geometry" x="8314" y="20125" width="664" height="1057" /></mxCell><mxCell id="card_AD_F19__title" value="F19 — Luồng Theo dõi sách quá hạn" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="content_card_AD_F19"><mxGeometry x="24" y="16" width="573.31" height="40" as="geometry" /></mxCell><mxCell id="card_AD_F19__n0" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;ellipse;fillColor=#243444;" vertex="1" 