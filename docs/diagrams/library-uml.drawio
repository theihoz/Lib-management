llback nếu có ghi DB]" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_AD_F07"><mxGeometry x="261.24" y="782.26" width="179.0" height="17" as="geometry" /></mxCell><mxCell id="card_AD_F07__e9" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F07" source="card_AD_F07__n7" target="card_AD_F07__n4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="309.74" y="773.86" /><mxPoint x="286" y="784.76" /><mxPoint x="286" y="784.76" /><mxPoint x="286" y="784.76" /><mxPoint x="257.87" y="800.75" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F07__e10" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F07" source="card_AD_F07__n8" target="card_AD_F07__n9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="365.57" y="886.9" /><mxPoint x="336.13" y="906.978" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F07__note" value="Vai trò hành động ghi trong nút; nhánh lỗi kết thúc yêu cầu, dữ liệu không ghi một phần." style="text;html=1;fontFamily=Arial;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="content_card_AD_F07"><mxGeometry x="24" y="978.52" width="599.3199999999999" height="70" as="geometry" /></mxCell><mxCell id="board_234" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chức năng:&lt;/b&gt; F07 ↔ UC6 — Cho mượn sách&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Người thao tác:&lt;/b&gt; Thủ thư&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chủ thể / phạm vi:&lt;/b&gt; Một lần thực hiện chức năng; từ bắt đầu đến kết quả&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; Đọc theo mũi tên; chữ nhật là hoạt động, hình thoi chọn nhánh theo guard. Nhánh lỗi phải sửa hoặc kết thúc; không bỏ qua bước kiểm tra.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Hoạt động:&lt;/b&gt; Quét thẻ và mã vạch các bản sao; nhận Idempotency-Key. → Kiểm tra quyền, thẻ, dư nợ, quá hạn, số cuốn và giữ chỗ. → Khóa các bản sao theo thứ tự ID; kiểm tra lại khả dụng trong giao dịch. → Tạo Loan và LoanItem với dueAt, policyVersionId; chuyển bản sao ON_LOAN; commit.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Quy tắc đề xuất:&lt;/b&gt; QĐ05: tối đa 4 cuốn trong một phiếu; QĐ06: hạn tối đa 4 ngày; QĐ08: không nợ phạt và không có khoản quá hạn.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lỗi / ngoại lệ:&lt;/b&gt; Hai quầy mượn cùng bản sao: một giao dịch thành công, giao dịch kia 409. Không đủ điều kiện: 422 có mã lý do. Mất kết nối sau commit: dùng lại key để lấy kết quả.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Kết quả / bất biến:&lt;/b&gt; Tất cả mục trong phiếu được lưu cùng giao dịch; không mượn một phần âm thầm.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="2181" y="18821" width="570" height="1124" /></mxCell><mxCell id="card_AD_F08" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#A8BACB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="2846" y="18716" width="1317" height="1213" /></mxCell><mxCell id="board_236" value="CHI TIẾT • AD_F08 F08 — Luồng Nhận trả sách" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=22;fontStyle=1;fillColor=#EAF2F8;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="2858" y="18726" width="1293" height="80" /></mxCell><mxCell id="content_card_AD_F08" value="" style="group;" vertex="1" parent="1"><mxGeometry as="geometry" x="2866" y="18821" width="677" height="1073" /></mxCell><mxCell id="card_AD_F08__title" value="F08 — Luồng Nhận trả sách" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="content_card_AD_F08"><mxGeometry x="24" y="16" width="586.2" height="40" as="geometry" /></mxCell><mxCell id="card_AD_F08__n0" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;ellipse;fillColor=#243444;" vertex="1" parent="content_card_AD_F08"><mxGeometry x="200.01000000000002" y="90.00000000000001" width="12.959999999999999" height="12.959999999999999" as="geometry" /></mxCell><mxCell id="card_AD_F08__n1" value="Người dùng&lt;br&gt;Quét bản sao; lấy LoanItem OPEN." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F08"><mxGeometry x="88.03920000000002" y="151.96012000000007" width="236.90159999999997" height="49.91976" as="geometry" /></mxCell><mxCell id="card_AD_F08__n2" value="API&lt;br&gt;Kiểm tra quyền và input" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F08"><mxGeometry x="121.638" y="250.88012000000003" width="169.704" height="49.91976" as="geometry" /></mxCell><mxCell id="card_AD_F08__n3" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rhombus;" vertex="1" parent="content_card_AD_F08"><mxGeometry x="193.89000000000001" y="349.80000000000007" width="25.2" height="25.2" as="geometry" /></mxCell><mxCell id="card_AD_F08__n4" value="API&lt;br&gt;Trả lỗi có mã; không ghi dữ liệu" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F08"><mxGeometry x="70.0024" y="789.5601200000001" width="220.9752" height="49.91976" as="geometry" /></mxCell><mxCell id="card_AD_F08__n5" value="Hệ thống&lt;br&gt;Kiểm tra tình trạng tốt/hỏng/mất; tính trễ&lt;br&gt;theo dueAt đã lưu." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F08"><mxGeometry x="258.84720000000004" y="435.00000000000006" width="285.2856" height="65.52" as="geometry" /></mxCell><mxCell id="card_AD_F08__n6" value="Hệ thống&lt;br&gt;Trong giao dịch: đóng mục mượn, cập nhật&lt;br&gt;bản sao; phí trễ ghi sổ,&lt;br&gt;hỏng/mất tạo ChargeAssessment PENDING." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F08"><mxGeometry x="280.77840000000003" y="549.52" width="295.4232" height="65.52" as="geometry" /></mxCell><mxCell id="card_AD_F08__n7" value="Hệ thống&lt;br&gt;Nếu sách tốt, phân bổ FIFO giữ chỗ hợp lệ;&lt;br&gt;phát outbox thông báo sau commit." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F08"><mxGeometry x="274.622" y="664.0400000000001" width="299.736" height="65.52" as="geometry" /></mxCell><mxCell id="card_AD_F08__n8" value="API&lt;br&gt;Trả kết quả và mã yêu cầu" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F08"><mxGeometry x="327.3728" y="789.5601200000001" width="194.23440000000002" height="49.91976" as="geometry" /></mxCell><mxCell id="card_AD_F08__n9" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;shape=doubleEllipse;fillColor=#243444;" vertex="1" parent="content_card_AD_F08"><mxGeometry x="289.57004" y="888.4800400000001" width="23.83992" height="23.83992" as="geometry" /></mxCell><mxCell id="card_AD_F08__e0" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1