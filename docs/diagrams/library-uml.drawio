ry"><Array as="points"><mxPoint x="329.67" y="631.22" /><mxPoint x="337.54" y="614.6" /><mxPoint x="355.06" y="614.6" /><mxPoint x="372.58" y="614.6" /><mxPoint x="380.45" y="631.22" /></Array></mxGeometry></mxCell><mxCell id="card_Classes_Catalog__label7" value="0..1 — 0..1 active cover" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_Classes_Catalog"><mxGeometry x="438.79999999999995" y="497.15" width="144.8" height="17" as="geometry" /></mxCell><mxCell id="card_Classes_Catalog__e7" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;endArrow=none;" edge="1" parent="content_card_Classes_Catalog" source="card_Classes_Catalog__n0" target="card_Classes_Catalog__n7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="482.8" y="519.01" /><mxPoint x="542.44" y="538.87" /></Array></mxGeometry></mxCell><mxCell id="card_Classes_Catalog__label8" value="1 — 0..*" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_Classes_Catalog"><mxGeometry x="201.01" y="137.29999999999995" width="53.6" height="17" as="geometry" /></mxCell><mxCell id="card_Classes_Catalog__e8" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;endArrow=none;" edge="1" parent="content_card_Classes_Catalog" source="card_Classes_Catalog__n8" target="card_Classes_Catalog__n9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="213.75" y="151.79999999999995" /><mxPoint x="255.58" y="151.79999999999995" /></Array></mxGeometry></mxCell><mxCell id="card_Classes_Catalog__note" value="Liên kết không dùng composition khi cần giữ lịch sử độc lập. Chuỗi thuộc tính là hợp đồng khái niệm, không sơ đồ màn hình." style="text;html=1;fontFamily=Arial;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="content_card_Classes_Catalog"><mxGeometry x="24" y="778" width="751.76" height="70" as="geometry" /></mxCell><mxCell id="board_46" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Mục đích:&lt;/b&gt; UML lớp — Danh mục và độc giả&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; Hộp lớp gồm tên và thuộc tính. Bội số ở liên kết cho biết số đối tượng được phép liên quan; đây là mô hình miền, không là flow.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách hoạt động:&lt;/b&gt; BookEdition mô tả đầu sách; BookCopy là từng bản có mã vạch và vị trí. BookAuthor / BookCategory nối nhiều tác giả / thể loại. Publisher là tham chiếu tùy chọn; MediaAsset đại diện tệp bìa. Reader có nhiều ReaderCard theo lịch sử; kiểm tra trạng thái và thời hạn thẻ khi dùng.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lưu ý / ràng buộc:&lt;/b&gt; Liên kết không dùng composition khi cần giữ lịch sử độc lập. Chuỗi thuộc tính là hợp đồng khái niệm, không sơ đồ màn hình.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="3344" y="7126" width="570" height="923" /></mxCell><mxCell id="card_Classes_Circulation" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#A8BACB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="4009" y="7021" width="1979" height="1028" /></mxCell><mxCell id="board_48" value="CHI TIẾT • Classes_Circulation UML lớp — Mượn, giữ chỗ và sổ phí" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=22;fontStyle=1;fillColor=#EAF2F8;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="4021" y="7031" width="1955" height="80" /></mxCell><mxCell id="content_card_Classes_Circulation" val