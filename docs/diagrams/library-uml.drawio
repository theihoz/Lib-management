0" y="470.9599999999999" /><mxPoint x="1284.8" y="515.43" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F02__label14" value="không thể sửa [không có nghĩa vụ mở]" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_ST_F02"><mxGeometry x="974.6999999999999" y="509.4599999999999" width="213.20000000000002" height="17" as="geometry" /></mxCell><mxCell id="card_ST_F02__e14" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F02" source="card_ST_F02__n4" target="card_ST_F02__n6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="976.41" y="503.77" /><mxPoint x="989.58" y="523.9599999999999" /><mxPoint x="989.58" y="523.9599999999999" /><mxPoint x="989.58" y="523.9599999999999" /><mxPoint x="1088.5" y="543.15" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F02__label15" value="thanh lý [đã xử lý mất]" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_ST_F02"><mxGeometry x="1165.05" y="461.4599999999999" width="139.1" height="17" as="geometry" /></mxCell><mxCell id="card_ST_F02__e15" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F02" source="card_ST_F02__n5" target="card_ST_F02__n6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1168.8" y="425.8399999999999" /><mxPoint x="1186.1" y="500.65" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F02__e16" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F02" source="card_ST_F02__n6" target="card_ST_F02__n7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1201" y="596.3989999999999" /><mxPoint x="1201" y="612.309" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F02__note" value="BookCopy" style="text;html=1;fontFamily=Arial;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="content_card_ST_F02"><mxGeometry x="24" y="691.8" width="1540.6" height="70" as="geometry" /></mxCell><mxCell id="board_113" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chức năng:&lt;/b&gt; F02 ↔ UC2 — Quản lý bản sao và mã vạch&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Người thao tác:&lt;/b&gt; Thủ thư&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chủ thể / phạm vi:&lt;/b&gt; BookCopy&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; Nút = trạng thái của chủ thể; cạnh = sự kiện [điều kiện] / hành động. Nút đen bắt đầu; nút kép kết thúc phiên được mô tả.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Hoạt động:&lt;/b&gt; Tạo bản sao từ đầu sách có sẵn, nhập vị trí và mã vạch. → Kiểm tra mã vạch, định danh đầu sách và quyền. → Lưu bản sao AVAILABLE; thao tác mượn/trả cập nhật trạng thái trong giao dịch. → Ngừng khai thác chỉ khi không có khoản mượn đang mở hoặc giữ chỗ còn hiệu lực.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Quy tắc đề xuất:&lt;/b&gt; Mã vạch duy nhất; một bản sao chỉ có một LoanItem đang mở; trạng thái do nghiệp vụ chuyển.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lỗi / ngoại lệ:&lt;/b&gt; Trùng mã: 409. ON_LOAN không được sửa thành AVAILABLE bằng CRUD. Mất tìm lại phải qua kiểm tra, không tự mở lại khoản mượn đã đóng.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Kết quả / bất biến:&lt;/b&gt; Số tồn và số khả dụng được tính từ bản sao; LoanItem và BookCopy nhất quán.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="4619" y="12759" width="570" height="837" /></mxCell><mxCell id="card_ST_F03" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#A8BACB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="5284" y="12654" width="1234" height="862" /></mxCell><mxCell id="board_115" value="CHI TIẾT • ST_F03 F03 — Quản lý thể loại phân cấp" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=22;fontStyle=1;fillColor=#EAF2F8;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="5296" y="12664" width="1210" height="80" /></mxCell><mxCell id="content_card_ST_F03" value="" style="group;" vertex="1" parent="1"><mxGeometry as="geometry" x="5304" y="12759" width="594" height="722" /></mxCell><mxCell id="card_ST_F03__title" value="F03 — Quản lý thể loại phân cấp" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="content_card_ST_F03"><mxGeometry x="24" y="16" width="503.49" height="40" as="geometry" /></mxCell><mxCell id="card_ST_F03__n0" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;ellipse;fillColor=#243444;" vertex="1" parent="content_card_ST_F03"><mxGeometry x="360.85999999999996" y="90.00000000000001" width="12.959999999999999" height="12.959999999999999" as="geometry" /></mxCell><mxCell id="card_ST_F03__n1" value="Đang xem" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_ST_F03"><mxGeometry x="325.8392" y="151.96000000000004" width="83.0016" height="36" as="geometry" /></mxCell><mxCell id="card_ST_F03__n2" value="Đang sửa" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_ST_F03"><mxGeometry x="167.8356" y="247.96000000000004" width="83.00880000000001" height="36" as="geometry" /></mxCell><mxCell 