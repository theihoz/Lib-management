llipse;" vertex="1" parent="content_card_OV_UC"><mxGeometry x="717.2928" y="772.70128" width="199.0944" height="70.59743999999999" as="geometry" /></mxCell><mxCell id="card_OV_UC__n19" value="UC22&lt;br&gt;Ghi phí phát sinh" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;ellipse;" vertex="1" parent="content_card_OV_UC"><mxGeometry x="354.682" y="558.70128" width="180.756" height="70.59743999999999" as="geometry" /></mxCell><mxCell id="card_OV_UC__n20" value="Miễn/đảo khoản&lt;br&gt;phạt" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;ellipse;" vertex="1" parent="content_card_OV_UC"><mxGeometry x="353.674" y="1949.70128" width="182.772" height="70.59743999999999" as="geometry" /></mxCell><mxCell id="card_OV_UC__n21" value="UC13&lt;br&gt;Lịch sử độc giả" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;ellipse;" vertex="1" parent="content_card_OV_UC"><mxGeometry x="352.1476" y="1200.70128" width="185.8248" height="70.59743999999999" as="geometry" /></mxCell><mxCell id="card_OV_UC__n22" value="UC14&lt;br&gt;Theo dõi quá hạn" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;ellipse;" vertex="1" parent="content_card_OV_UC"><mxGeometry x="352.6372" y="1628.70128" width="184.8456" height="70.59743999999999" as="geometry" /></mxCell><mxCell id="card_OV_UC__n23" value="UC15&lt;br&gt;Xuất CSV" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;ellipse;" vertex="1" parent="content_card_OV_UC"><mxGeometry x="383.8168" y="2056.70128" width="122.4864" height="70.59743999999999" as="geometry" /></mxCell><mxCell id="card_OV_UC__n24" value="UC16&lt;br&gt;Báo cáo" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;ellipse;" vertex="1" parent="content_card_OV_UC"><mxGeometry x="393.01120000000003" y="1