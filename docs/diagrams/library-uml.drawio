 vertex="1" parent="content_card_ST_F24_"><mxGeometry x="538.6600000000001" y="257.46000000000004" width="104.9" height="17" as="geometry" /></mxCell><mxCell id="card_ST_F24___e6" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F24_" source="card_ST_F24___n4" target="card_ST_F24___n1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="525.9" y="356.4" /><mxPoint x="539.55" y="343.96000000000004" /><mxPoint x="539.55" y="343.96000000000004" /><mxPoint x="539.55" y="343.96000000000004" /><mxPoint x="552.75" y="244.68" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F24___e7" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F24_" source="card_ST_F24___n3" target="card_ST_F24___n7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="286.55" y="416.399" /><mxPoint x="286.55" y="432.309" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F24___e8" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F24_" source="card_ST_F24___n5" target="card_ST_F24___n7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="197.35" y="420.173" /><mxPoint x="243.36" y="442.719" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F24___e9" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F24_" source="card_ST_F24___n6" target="card_ST_F24___n7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="621.1" y="367.15" /><mxPoint x="567.55" y="403.96000000000004" /><mxPoint x="567.55" y="403.96000000000004" /><mxPoint x="567.55" y="403.96000000000004" /><mxPoint x="370.43" y="445.994" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F24___note" value="NotificationDelivery" style="text;html=1;fontFamily=Arial;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="content_card_ST_F24_"><mxGeometry x="24" y="511.8" width="785.73" height="70" as="geometry" /></mxCell><mxCell id="board_201" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chức năng:&lt;/b&gt; F24 ↔ UC21 — Thông báo giữ chỗ và quá hạn&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Người thao tác:&lt;/b&gt; Worker; Thủ thư theo dõi&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chủ thể / phạm vi:&lt;/b&gt; NotificationDelivery&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; Nút = trạng thái của chủ thể; cạnh = sự kiện [điều kiện] / hành động. Nút đen bắt đầu; nút kép kết thúc phiên được mô tả.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Hoạt động:&lt;/b&gt; Đọc outbox đã commit hoặc lịch nhắc quá hạn theo cấu hình được duyệt. → Kiểm tra sự kiện còn phù hợp; thẻ/thông tin nhận và consent theo kênh. → Nhận lease và gửi qua adapter; không log nội dung chứa PII. → Ghi delivered/failed; retry có backoff, vào dead-letter khi hết lượt; không kéo dài hạn READY.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Quy tắc đề xuất:&lt;/b&gt; Giữ chỗ có outbox trong baseline; nhắc quá hạn là mở rộng từ PDF; at-least-once với dedupe eventId+channel.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lỗi / ngoại lệ:&lt;/b&gt; Provider lỗi không rollback mượn/trả. Timeout có thể đã gửi: dedupe phía provider nếu hỗ trợ; không hứa exactly-once.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Kết quả / bất biến:&lt;/b&gt; Có số lần thử, nextAttemptAt, trạng thái và mã provider; thư không gửi không làm sai vòng đời giữ chỗ.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="6369" y="15738" width="570" height="657" /></mxCell><mxCell id="board_202" value="&lt;b&gt;09 — HOẠT ĐỘNG / FLOW&lt;/b&gt;&lt;br&gt;Một luồng cho mỗi chức năng F01–F24; có lỗi và hậu điều kiện." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=24;fillColor=#16324F;fontColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="16691" width="9800" height="95" /></mxCell><mxCell id="card_OV_ACTIVITY" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#A8BACB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="16821" width="2027" height="1835" /></mxCell><mxCell id="board_204" value="TỔNG QUÁT TOÀN HỆ THỐNG • OV_ACTIVITY Activity — Tổng quát luồng xử lý toàn hệ thống" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=22;fontStyle=1;fillColor=#DDF2E7;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="112" y="16831" width="2003" height="80" /></mxCell><mxCell id="content_card_OV_ACTIVITY" value="" style="group;" vertex="1" parent="1"><mxGeometry as="geometry" x="120" y="16926" width="1387" height="1695" /></mxCell><mxCell id="card_OV_ACTIVITY__title" value="Activity — Tổng quát luồng xử lý toàn hệ thống" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="content_card_OV_ACTIVITY"><mxGeometry x="24" y="16" width="1296.7" height="40" as="geometry" /></mxCell><mxCell id="card_OV_ACTIVITY__n0" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;ellipse;fillColor=#243444;" vertex="1" parent="content_card_OV_ACTIVITY"><mxGeometry x="1144.42" y="90.02" width="12.959999999999999" height="12.959999999999999" as="geometry" /></mxCell><mxCell id="card_OV_ACTIVITY__n1" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rhombus;" vertex="1" parent="content_card_OV_ACTIVITY"><mxGeometry x="1138.3000000000002" y="151.99999999999991" width="25.2" height="25.2" as="geometry" /></mxCell><mxCell id="card_OV_ACTIVITY__n2" value="Xác thực OIDC; ánh xạ tài khoản và vai trò" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_OV_ACTIVITY"><mxGeometry x="911.7379999999999" y="226.20000000000005" width="282.384" height="36" as="geometry" /></mxCell><mxCell id="card_OV_ACTIVITY__n3" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rhombus;" vertex="1" parent="content_card_OV_ACTIVITY"><mxGeometry x="1040.33" y="311.19999999999993" width="25.2" height="25.2" as="geometry" /></mxCell><mxCell id="card_OV_ACTIVITY__n4" value="Báo lỗi xác thực; chọn thử lại hoặc hủy" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_OV_ACTIVITY"><mxGeometry x="920.4251999999999" y="396.4000000000001" width="273.0096" height="36" as="geometry" /></mxCell><mxCell id="card_OV_ACTIVITY__n5" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rhombus;" vertex="1" parent="content_card_OV_ACTIVITY"><mxGeometry x="1084.3000000000002" y="481.4" width="25.2" height="25.2" as="geometry" /></mxCell><mxCell id="card_OV_ACTIVITY__n6" value="Chọn chức năng F01–F24 theo quyền" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_OV_ACTIVITY"><mxGeometry x="621.098" y="396.4000000000001" width="263.664" height="36" as="geometry" /></mxCell><mxCell id="card_OV_ACTIVITY__n7" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rhombus;" vertex="1" parent="