ng=16;" vertex="1" parent="1"><mxGeometry x="3420" y="37221" width="3160" height="310" as="geometry" /></mxCell><mxCell id="sync_assessment" value="ChargeAssessment&lt;br&gt;id PK · reader_id FK&lt;br&gt;return_event_id FK&lt;br&gt;kind · proposed_amount · reason&lt;br&gt;status · decided_by FK · version&lt;br&gt;fine_charge_id FK nullable UQ" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;strokeColor=#344454;fillColor=#FFFFFF;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="3470" y="36241" width="1000" height="380" as="geometry" /></mxCell><mxCell id="sync_notification" value="Notification&lt;br&gt;id PK · reader_id FK&lt;br&gt;event_id FK nullable&lt;br&gt;kind · summary · dedupe_key UQ&lt;br&gt;read_at nullable" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;strokeColor=#344454;fillColor=#FFFFFF;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="4700" y="36241" width="850" height="330" as="geometry" /></mxCell><mxCell id="sync_delivery" value="NotificationDelivery&lt;br&gt;id PK · notification_id FK&lt;br&gt;channel · status · job_id FK&lt;br&gt;provider_message_id · delivered_at&lt;br&gt;UQ notification_id+channel" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;strokeColor=#344454;fillColor=#FFFFFF;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="4700" y="36771" width="850" height="330" as="geometry" /></mxCell><mxCell id="sync_preference" value="NotificationPreference&lt;br&gt;reader_id PK/FK Reader&lt;br&gt;email_consent DEFAULT false&lt;br&gt;changed_by FK Account&lt;br&gt;updated_at" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;strokeColor=#344454;fillColor=#FFFFFF;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="5700" y="36471" width="800" height="330" as="geometry" /></mxCell><mxCell id="sync_rel_delivery" value="N : 1" style="html=1;fontFamily=Arial;fontSize=14;edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;endArrow=none;" edge="1" parent="1" source="sync_delivery" target="sync_notification"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="sync_st_assessment" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;strokeColor=#344454;fillColor=#FFFFFF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="6700" y="36071" width="3200" height="1500" as="geometry" /></mxCell><mxCell id="sync_st_assessment_title" value="State — ChargeAssessment" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;strokeColor=#344454;fillColor=#FFFFFF;fontSize=24;fontStyle=1;fillColor=#EDF3F7;" vertex="1" parent="1"><mxGeometry x="6720" y="36091" width="3160" height="70" as="geometry" /></mxCell><mxCell id="sync_st_assessment_note" value="PENDING chặn checkout/renew/hold; nhận trả vẫn được. Quản lý quyết định một lần. Terminal không sửa, phí đã ghi điều chỉnh qua waiver/reversal. Snapshot và audit lưu cùng commit." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;strokeColor=#344454;fillColor=#FFFFFF;fillColor=#F1F5F9;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="6720" y="37221" width="3160" height="310" as="geometry" /></mxCell><mxCell id="sync_st_initial" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;strokeColor=#344454;fillColor=#FFFFFF;ellipse;fillColor=#17212B;" vertex="1" parent="1"><mxGeometry x="6800" y="36491" width="35" height="35" as="geometry" /></mxCell><mxCell id="sync_st_pending" value="PENDING" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="1"><mxGeometry x="7000" y="36421" width="700" height="180" as="geometry" /></mxCell><mxCell id="sync_st_assessed" value="ASSESSED&lt;br&gt;FineCharge được ghi" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="1"><mxGeometry x="8300" y="36271" width="1150" height="180" as="geometry" /></mxCell><mxCell id="sync_st_closed" value="CLOSED_NO_CHARGE&lt;br&gt;Không tạo phí0" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="1"><mxGeometry x="8300" y="36771" width="1150" height="180" as="geometry" /></mxCell><mxCell id="sync_st_e1" value="Return DAMAGE/LOST / tạo đề xuất" style="html=1;fontFamily=Arial;fontSize=14;edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sync_st_initial" target="sync_st_pending"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="sync_st_e2" value="decide [permission + version + amount&gt;0] / charge+audit" style="html=1;fontFamily=Arial;fontSize=14;edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sync_st_pending" target="sync_st_assessed"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="sync_st_e3" value="decide [permission + amount=0 + reason] / audit" style="html=1;fontFamily=Arial;fontSize=14;edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sync_st_pending" target="sync_st_closed"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="sync_uc" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;strokeColor=#344454;fillColor=#FFFFFF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="100" y="37671" width="3200" height="1500" as="geometry" /></mxCell><mxCell id="sync_uc_title" value="Use case — Duyệt phí và scope đã duyệt" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;strokeColor=#344454;fillColor=#FFFFFF;fontSize=24;fontStyle=1;fillColor=#EDF3F7;" vertex="1" parent="1"><mxGeometry x="120" y="37691" width="3160" height="70" as="geometry" /></mxCell><mxCell id="sync_uc_note" value="Thủ thư đề xuất khi nhận trả; Quản lý quyết định; độc giả xem trạng thái của mình. F21–F24 đã vào phạm vi. Worker không là user cấp quyền; Admin hệ thống và vận hành tách permission." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;strokeColor=#344454;fillColor=#FFFFFF;fillColor=#F1F5F9;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="120" y="38821" width="3160" height="310" as="geometry" /></mxCell><mxCell id="sync_uc_staff" value="Thủ thư" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;strokeColor=#344454;fillColor=#FFFFFF;shape=umlActor;" vertex="1" parent="1"><mxGeometry x="180" y="37971" width="500" height="100" as="geometry" /></mxCell><mxCell id="sync_uc_manager" value="Quản lý" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;strokeColor=#344454;fillColor=#FFFFFF;shape=umlActor;" vertex="1" parent="1"><mxGeometry x="180" y="38431" width="500" height="100" as="geometry" /></mxCell><mxCell id="sync_uc_propose" value="F08/F11 — Đề xuất phí&lt;br&gt;sau nhận trả hỏng/mất" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;strokeColor=#344454;fillColor=#FFFFFF;ellipse;" vertex="1" parent="1"><mxGeometry x="1100" y="37931" width="1300" height="140" as="geometry" /></mxCell><mxCell id="sync_uc_decide" value="F11 — Xác nhận số tiền&lt;br&gt;hoặc kết thúc không thu" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;strokeColor=#344454;fillColor=#FFFFFF;ellipse;" vertex="1" parent="1"><mxGeometry x="1100" y="38401" width="1300" height="140" as="geometry" /></mxCell><mxCell id="sync_uc_e1" value="" style="html=1;fontFamily=Arial;fontSize=14;edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;endArrow=none;" edge="1" parent="1" source="sync_uc_staff" target="sync_uc_propose"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="sync_uc_e2" value="" style="html=1;fontFamily=Arial;fontSize=14;edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;endArrow=none;" edge="1" parent="1" source="sync_uc_manager" target="sync_uc_decide"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="sync_ad" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;strokeColor=#344454;fillColor=#FFFFFF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="3400" y="37671" width="3200" height="1500" as="geometry" /></mxCell><mxCell id="sync_ad_title" value="Activity — Return hỏng/mất và duyệt phí" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;strokeColor=#344454;fillColor=#FFFFFF;fontSize=24;fontStyle=1;fillColor=#EDF3F7;" vertex="1" parent="1"><mxGeometry x="3420" y="37691" width="3160" height="70" as="geometry" /></mxCell><mxCell id="sync_ad_note" value="Return commit riêng với thu tiền. Khóa Reader/copy/item theo thứ tự; cùng transaction đóng mục và tạo PENDING. Không rollback nhận trả khi email thất bại. Quyết định phí không tự đổi copy vềAVAILABLE." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;strokeColor=#344454;fillColor=#FFFFFF;fillColor=#F1F5F9;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="3420" y="38821" width="3160" height="310" as="geometry" /></mxCell><mxCell id="sync_ad_start" value="Quét LoanItem · nhận trả" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;strokeColor=#344454;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="3500" y="37851" width="800" height="130" as="geometry" /></mxCell><mxCell id="sync_ad_return" value="Đóng mục/cập nhật copy&lt;br&gt;Phí trễ theo snapshot&lt;br&gt;Hỏng/mất → PENDING" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;strokeColor=#344454;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="4550" y="37851" width="1500" height="190" as="geometry" /></mxCell><mxCell id="sync_ad_manager" value="Quản lý quyết định amount/reason" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;strokeColor=#344454;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="4550" y="38271" width="1500" height="130" as="geometry" /></mxCell><mxCell id="sync_ad_terminal" value="amount&gt;0 → charge / amount=0 → không charge&lt;br&gt;Audit + assessment terminal" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;strokeColor=#344454;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="4550" y="38571" width="1500" height="160" as="geometry" /></mxCell><mxCell id="sync_ad_e1" value="transaction" style="html=1;fontFamily=Arial;fontSize=14;edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sync_ad_start" target="sync_ad_return"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="sync_ad_e2" value="Sau commit; chờ xử lý" style="html=1;fontFamily=Arial;fontSize=14;edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sync_ad_return" target="sync_ad_manager"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="sync_ad_e3" value="Khóa/version/idempotency" style="html=1;fontFamily=Arial;fontSize=14;edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sync_ad_manager" target="sync_ad_terminal"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="sync_sd" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;strokeColor=#344454;fillColor=#FFFFFF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="6700" y="37671" width="3200" height="1500" as="geometry" /></mxCell><mxCell id="sync_sd_title" value="Sequence — Return / Assessment / Eligibility" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;strokeColor=#344454;fillColor=#FFFFFF;fontSize=24;fontStyle=1;fillColor=#EDF3F7;" vertex="1" parent="1"><mxGeometry x="6720" y="37691" width="3160" height="70" as="geometry" /></mxCell><mxCell id="sync_sd_note" value="1–3: trả ghi PENDING dưới khóa Reader, commit. 4–5: request lưu thông kiểm lại và chặn nếu PENDING. 6–7: manager quyết định amount&gt;0 tạo charge, amount0 đóng không phí; transaction riêng. Return không bị chặn bởi debt." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;strokeColor=#344454;fillColor=#FFFFFF;fillColor=#F1F5F9;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="6720" y="38821" width="3160" height="310" as="geometry" /></mxCell><mxCell id="sync_life_h0" value="Thủ thư" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;strokeColor=#344454;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="6820" y="37791" width="460" height="90" as="geometry" /></mxCell><mxCell id="sync_life_0" value="" style="dashed=1;endArrow=none;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="7050" y="37881" /><mxPoint as="targetPoint" x="7050" y="38751" /></mxGeometry></mxCell><mxCell id="sync_life_h1" value="FastAPI" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;strokeColor=#344454;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="7620" y="37791" width="460" height="90" as="geometry" /></mxCell><mxCell id="sync_life_1" value="" style="dashed=1;endArrow=none;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="7850" y="37881" /><mxPoint as="targetPoint" x="7850" y="38751" /></mxGeometry></mxCell><mxCell id="sync_life_h2" value="PostgreSQL" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;strokeColor=#344454;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="8470" y="37791" width="460" height="90" as="geometry" /></mxCell><mxCell id="sync_life_2" value="" style="dashed=1;endArrow=none;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="8700" y="37881" /><mxPoint as="targetPoint" x="8700" y="38751" /></mxGeometry></mxCell><mxCell id="sync_life_h3" value="Quản lý" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;strokeColor=#344454;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="9270" y="37791" width="460" height="90" as="geometry" /></mxCell><mxCell id="sync_life_3" value="" style="dashed=1;endArrow=none;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="9500" y="37881" /><mxPoint as="targetPoint" x="9500" y="38751" /></mxGeometry></mxCell><mxCell id="sync_msg_0" value="1 Return DAMAGE/LOST" style="html=1;fontFamily=Arial;fontSize=16;endArrow=open;endFill=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="7050" y="37971" /><mxPoint as="targetPoint" x="7850" y="37971" /></mxGeometry></mxCell><mxCell id="sync_msg_1" value="2 Tx: khóa Reader; close item; PENDING" style="html=1;fontFamily=Arial;fontSize=16;endArrow=open;endFill=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="7850" y="38081" /><mxPoint as="targetPoint" x="8700" y="38081" /></mxGeometry></mxCell><mxCell id="sync_msg_2" value="3 Commit + receipt" style="html=1;fontFamily=Arial;fontSize=16;endArrow=open;endFill=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="8700" y="38191" /><mxPoint as="targetPoint" x="7850" y="38191" /></mxGeometry></mxCell><mxCell id="sync_msg_3" value="4 Checkout/renew/hold" style="html=1;fontFamily=Arial;fontSize=16;endArrow=open;endFill=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="7050" y="38301" /><mxPoint as="targetPoint" x="7850" y="38301" /></mxGeometry></mxCell><mxCell id="sync_msg_4" value="5 Kiểm tra PENDING dưới khóa → chặn" style="html=1;fontFamily=Arial;fontSize=16;endArrow=open;endFill=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="7850" y="38411" /><mxPoint as="targetPoint" x="8700" y="38411" /></mxGeometry></mxCell><mxCell id="sync_msg_5" value="6 Quyết định amount/reason/version" style="html=1;fontFamily=Arial;fontSize=16;endArrow=open;endFill=0;labelBackgroundCol