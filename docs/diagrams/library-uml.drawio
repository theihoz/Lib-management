t_card_UC_Catalog" source="card_UC_Catalog__n3" target="card_UC_Catalog__n10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="193.92000000000002" y="702.34" /><mxPoint x="251.51" y="701.86" /></Array></mxGeometry></mxCell><mxCell id="card_UC_Catalog__note" value="Biên hệ thống: Phần mềm quản lý thư viện. Actor không nằm trong biên. include chỉ là hành vi bắt buộc; extend là hành vi có điều kiện." style="text;html=1;fontFamily=Arial;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="content_card_UC_Catalog"><mxGeometry x="24" y="894" width="556.56" height="70" as="geometry" /></mxCell><mxCell id="board_14" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Mục đích:&lt;/b&gt; UC — Danh mục và thẻ&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; Actor ở ngoài biên hệ thống; ellipse là mục tiêu. Association không có hướng thực thi; include / extend là đường đứt có hướng.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách hoạt động:&lt;/b&gt; Thủ thư quản lý đầu sách, bản sao, thể loại, ảnh bìa và thẻ độc giả; nhân viên và độc giả tìm kiếm theo quyền. UC0 thiết lập danh tính. Các UC khác kiểm tra quyền tại API. Thay đổi danh mục không được thay đổi lịch sử mượn.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lưu ý / ràng buộc:&lt;/b&gt; Biên hệ thống: Phần mềm quản lý thư viện. Actor không nằm trong biên. include chỉ là hành vi bắt buộc; extend là hành vi có điều kiện.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="2495" y="1165" width="570" height="1039" /></mxCell><mxCell id="card_UC_Circulation" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#A8BACB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry 