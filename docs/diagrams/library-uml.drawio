 x="24" y="947.32" width="606.2" height="70" as="geometry" /></mxCell><mxCell id="board_238" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chức năng:&lt;/b&gt; F08 ↔ UC7 — Nhận trả sách&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Người thao tác:&lt;/b&gt; Thủ thư&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chủ thể / phạm vi:&lt;/b&gt; Một lần thực hiện chức năng; từ bắt đầu đến kết quả&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; Đọc theo mũi tên; chữ nhật là hoạt động, hình thoi chọn nhánh theo guard. Nhánh lỗi phải sửa hoặc kết thúc; không bỏ qua bước kiểm tra.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Hoạt động:&lt;/b&gt; Quét bản sao; lấy LoanItem OPEN. → Kiểm tra tình trạng tốt/hỏng/mất; tính trễ theo dueAt đã lưu. → Trong giao dịch: đóng mục mượn, cập nhật bản sao và tạo FineCharge nếu có. → Nếu sách tốt, phân bổ FIFO giữ chỗ hợp lệ; phát outbox thông báo sau commit.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Quy tắc đề xuất:&lt;/b&gt; Luôn cho trả dù thẻ hết hạn hoặc đang nợ; phí được ghi nhận, thu tiền là UC10 riêng.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lỗi / ngoại lệ:&lt;/b&gt; Mã không có mục mượn mở: 409 hoặc trả lại kết quả idempotent tương ứng. Hỏng/mất: dùng quy tắc phí đã được duyệt; không tự định giá.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Kết quả / bất biến:&lt;/b&gt; ReturnEvent duy nhất cho mỗi LoanItem; không thu phí hai lần khi gửi lại.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="3558" y="18821" width="570" height="1093" /></mxCell><mxCell id="card_AD_F09" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#A8BACB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="4223" y="18716" width="1321" height="1213" /></mxCell><mxCell id="board_240" value="CHI TIẾT • AD_F09 F09 — Luồng Gia hạn mượn" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=22;fontStyle=1;fillColor=#EAF2F8;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="4235" y="18726" width="1297" height="80" /></mxCell><mxCell id="content_card_AD_F09" value="" style="group;" vertex="1" parent="1"><mxGeometry as="geometry" x="4243" y="18821" width="681" height="1073" /></mxCell><mxCell id="card_AD_F09__title" value="F09 — Luồng Gia hạn mượn" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="content_card_AD_F09"><mxGeometry x="24" y="16" width="590.7" height="40" as="geometry" /></mxCell><mxCell id="card_AD_F09__n0" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;ellipse;fillColor=#243444;" vertex="1" parent="content_card_AD_F09"><mxGeometry x="199.01000000000002" y="90.00000000000001" width="12.959999999999999" height="12.959999999999999" as="geometry" /></mxCell><mxCell id="card_AD_F09__n1" value="Người dùng&lt;br&gt;Chọn phiếu và các mục còn OPEN." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F09"><mxGeometry x="84.88640000000001" y="151.96012000000007" width="241.2072" height="49.91976" as="geometry" /></mxCell><mxCell id="card_AD_F09__n2" value="API&lt;br&gt;Kiểm tra quyền và input" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F09"><mxGeometry x="120.638" y="250.88012000000003" width="169.704" height="49.91976" as="geometry" /></mxCell><mxCell id="card_AD_F09__n3" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rhombus;" vertex="1" parent="content_card_AD_F09"><mxGeometry x="192.89000000000001" y="349.80000000000007" width="25.2" height="25.2" as="geometry" /></mxCell><mxCell id="card_AD_F09__n4" value="API&lt;br&gt;Trả lỗi có mã; không ghi dữ liệu" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F09"><mxGeometry x="70.0024" y="789.5601200000001" width="220.9752" height="49.91976" as="geometry" /></mxCell><mxCell id="card_AD_F09__n5" value="Hệ thống&lt;br&gt;Khóa phiếu/mục và kiểm tra lại lần gia&lt;br&gt;hạn, nợ, thẻ, hạn, hàng đợi." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F09"><mxGeometry x="264.6868" y="435.00000000000006" width="263.6064" height="65.52" as="geometry" /></mxCell><mxCell id="card_AD_F09__n6" value="Hệ thống&lt;br&gt;Kiểm tra toàn bộ mục mở; mục đã trả không&lt;br&gt;tham gia." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F09"><mxGeometry x="280.27639999999997" y="549.52" width="300.4272" height="65.52" as="geometry" /></mxCell><mxCell id="card_AD_F09__n7" value="Hệ thống&lt;br&gt;Cập nhật dueAt, renewalCount, lưu&lt;br&gt;RenewalEvent cùng giao dịch." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F09"><mxGeometry x="306.7484" y="664.0400000000001" width="235.4832" height="65.52" as="geometry" /></mxCell><mxCell id="card_AD_F09__n8" value="API&lt;br&gt;Trả kết quả và mã yêu cầu" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F09"><mxGeometry x="327.3728" y="789.5601200000001" width="194.23440000000002" height="49.91976" as="geometry" /></mxCell><