16" /><mxPoint x="201.21" y="394.16" /><mxPoint x="201.21" y="382.16" /><mxPoint x="201.21" y="382.16" /><mxPoint x="201.21" y="382.16" /><mxPoint x="203.89" y="374.77000000000004" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F06__label7" value="at(expiresAt)" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_ST_F06"><mxGeometry x="303.74" y="427.66" width="82.10000000000001" height="17" as="geometry" /></mxCell><mxCell id="card_ST_F06__e7" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F06" source="card_ST_F06__n3" target="card_ST_F06__n5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="282.49" y="367.61" /><mxPoint x="319.03999999999996" y="382.16" /><mxPoint x="319.03999999999996" y="382.16" /><mxPoint x="319.03999999999996" y="382.16" /><mxPoint x="319.03999999999996" y="394.16" /><mxPoint x="319.03999999999996" y="394.16" /><mxPoint x="319.03999999999996" y="394.16" /><mxPoint x="309.03999999999996" y="490.16" /><mxPoint x="309.03999999999996" y="490.16" /><mxPoint x="309.03999999999996" y="490.16" /><mxPoint x="301.73" y="498.48800000000006" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F06__label8" value="at(expiresAt)" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_ST_F06"><mxGeometry x="230.39999999999998" y="475.66" width="82.10000000000001" height="17" as="geometry" /></mxCell><mxCell id="card_ST_F06__e8" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F06" source="card_ST_F06__n4" target="card_ST_F06__n5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="228.18" y="469.149" /><mxPoint x="243.65" y="490.53700000000003" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F06__note" value="ReaderCard" style="text;html=1;fontFamily=Arial;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="content_card_ST_F06"><mxGeometry x="24" y="585.1600000000001" width="552.76" height="70" as="geometry" /></mxCell><mxCell id="board_129" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chức năng:&lt;/b&gt; F06 ↔ UC5 — Quản lý độc giả và thẻ&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Người thao tác:&lt;/b&gt; Thủ thư&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chủ thể / phạm vi:&lt;/b&gt; ReaderCard&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; Nút = trạng thái của chủ thể; cạnh = sự kiện [điều kiện] / hành động. Nút đen bắt đầu; nút kép kết thúc phiên được mô tả.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Hoạt động:&lt;/b&gt; Nhập độc giả, loại X/Y/Z, ngày sinh và email. → Tính tuổi theo ngày địa phương; kiểm tra trùng và tham chiếu. → Cấp thẻ ACTIVE với expiresAt cộng 6 tháng lịch. → Tạm khóa theo lý do; hết hạn được xác định theo đồng hồ dù job chưa chạy.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Quy tắc đề xuất:&lt;/b&gt; QĐ01: tuổi 12–55 lúc cấp; QĐ02: hiệu lực 6 tháng lịch; khoảng hiệu lực [issuedAt, expiresAt).&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lỗi / ngoại lệ:&lt;/b&gt; Không đủ tuổi hoặc email trùng: không cấp. Mở khóa chỉ khi còn hiệu lực. Gia hạn thẻ cần chính sách được duyệt, chưa tự thêm vào baseline.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Kết quả / bất biến:&lt;/b&gt; Không sửa ngày cấp để kéo dài thẻ; lưu người cấp và lịch sử.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="758" y="13787" width="570" height="731" /></mxCell><mxCell id="card_ST_F07" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#A8BACB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="1423" y="13682" width="1209" height="861" /></mxCell><mxCell id="board_131" value="CHI TIẾT • ST_F07 F07 — Cho mượn sách" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=22;fontStyle=1;fillColor=#EAF2F8;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="1435" y="13692" width="1185" height="80" /></mxCell><mxCell id="content_card_ST_F07" value="" style="group;" vertex="1" parent="1"><mxGeometry as="geometry" x="1443" y="13787" width="569" height="721" /></mxCell><mxCell id="card_ST_F07__title" value="F07 — Cho mượn sách" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="content_card_ST_F07"><mxGeometry x="24" y="16" width="478.3" height="40" as="geometry" /></mxCell><mxCell id="card_ST_F07__n0" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;ellipse;fillColor=#243444;" vertex="1" parent="content_card_ST_F07"><mxGeometry x="351.93" y="90.00000000000001" width="12.959999999999999" height="12.959999999999999" as="geometry" /></mxCell><mxCell id="card_ST_F07__n1" value="Nháp yêu cầu" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_ST_F07"><mxGeometry x="303.54240000000004" y="151.95999999999998" width="109.7352" height="36" as="geometry" /></mxCell><mxCell id="card_ST_F07__n2" value="Đang kiểm tra" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_ST_F07"><mxGeometry x="192.2696" y="247.95999999999998" width="108.2808" height="36" as="geometry" /></mxCell><mxCell id="card_ST_F07__n3" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fo