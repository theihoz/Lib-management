xPoint x="401.87" y="319.96" /><mxPoint x="401.87" y="319.96" /><mxPoint x="401.87" y="319.96" /><mxPoint x="386.82" y="329.313" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F11__label3" value="thu/miễn [còn dư]" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_ST_F11"><mxGeometry x="255.04000000000002" y="257.46" width="104.9" height="17" as="geometry" /></mxCell><mxCell id="card_ST_F11__e3" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F11" source="card_ST_F11__n2" target="card_ST_F11__n2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="252.43" y="257.67999999999995" /><mxPoint x="267.75" y="260.64" /><mxPoint x="267.75" y="265.96" /><mxPoint x="267.75" y="270.53" /><mxPoint x="256.44" y="273.36" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F11__label4" value="thu/miễn [hết dư]" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_ST_F11"><mxGeometry x="110.40599999999999" y="305.46" width="104.9" height="17" as="geometry" /></mxCell><mxCell id="card_ST_F11__e4" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F11" source="card_ST_F11__n2" target="card_ST_F11__n3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="131.465" y="295.34499999999997" /><mxPoint x="122.839" y="307.96" /><mxPoint x="122.839" y="307.96" /><mxPoint x="122.839" y="307.96" /><mxPoint x="122.839" y="319.96" /><mxPoint x="122.839" y="319.96" /><mxPoint x="122.839" y="319.96" /><mxPoint x="222" y="339.04499999999996" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F11__label5" value="đảo khoản [còn xử lý một phần]" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_ST_F11"><mxGeometry x="230.68" y="305.46" width="179.0" height="17" as="geometry" /></mxCell><mxCell id="card_ST_F11__e5" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F11" source="card_ST_F11__n3" target="card_ST_F11__n2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="271.51" y="332.39799999999997" /><mxPoint x="243.48" y="319.96" /><mxPoint x="243.48" y="319.96" /><mxPoint x="243.48" y="319.96" /><mxPoint x="214.01" y="303.092" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F11__label6" value="đảo khoản [chưa xử lý]" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_ST_F11"><mxGeometry x="536.6400000000001" y="257.46" width="133.4" height="17" as="geometry" /></mxCell><mxCell id="card_ST_F11__e6" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F11" source="card_ST_F11__n3" target="card_ST_F11__n1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="440.62" y="323.092" /><mxPoint x="548.87" y="283.96" /><mxPoint x="548.87" y="283.96" /><mxPoint x="548.87" y="283.96" /><mxPoint x="548.87" y="247.95999999999998" /><mxPoint x="548.87" y="247.95999999999998" /><mxPoint x="548.87" y="247.95999999999998" /><mxPoint x="459.84" y="212.07" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F11__label7" value="đảo khoản [chưa xử lý]" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_ST_F11"><mxGeometry x="262.54" y="209.45999999999998" width="133.4" height="17" as="geometry" /></mxCell><mxCell id="card_ST_F11__e7" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F11" source="card_ST_F11__n2" target="card_ST_F11__n1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="221.23" y="236.39999999999998" /><mxPoint x="251.87" y="223.95999999999998" /><mxPoint x="251.87" y="223.95999999999998" /><mxPoint x="251.87" y="223.95999999999998" /><mxPoint x="286.19" y="206.79999999999998" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F11__note" value="FineCharge và số dư" style="text;html=1;fontFamily=Arial;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="content_card_ST_F11"><mxGeometry x="24" y="414.96" width="687.81" height="70" as="geometry" /></mxCell><mxCell id="board_149" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chức năng:&lt;/b&gt; F11 ↔ UC10; UC22 — Ghi phí, thu và miễn phạt&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Người thao tác:&lt;/b&gt; Thủ thư thu; Quản lý miễn&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chủ thể / phạm vi:&lt;/b&gt; FineCharge và số dư&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; Nút = trạng thái của chủ thể; cạnh = sự kiện [điều kiện] / hành động. Nút đen bắt đầu; nút kép kết thúc phiên được mô tả.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Hoạt động:&lt;/b&gt; Tạo phí từ UC22 khi trả trễ/hỏng/mất hoặc ghi phí thủ công có lý do. → Thu khoản thanh toán; khóa số dư, phân bổ cho các phí. → Cho thanh toán một phần, không cho tổng phân bổ vượt tiền thu hoặc số dư. → Miễn/đảo khoản có thẩm quyền và audit; tính số dư từ sổ giao dịch.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Quy tắc đề xuất:&lt;/b&gt; Trễ 1.000 VND/ngày/cuốn theo QĐ07; phí mất 100.000–600.000 theo loại cần bảng được duyệt; phí hỏng chưa thống nhất.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lỗi / ngoại lệ:&lt;/b&gt; Gửi thu tiền lại: idempotent. Không xóa khoản đã thu; sai sót dùng đảo giao dịch. Thu tiền không phụ thuộc việc đang trả sách.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Kết quả / bất biến:&lt;/b&gt; Assessed, collected, waived và outstanding là bốn đại lượng khác nhau; số dư không âm.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="7395" y="13787" width="570" height="658" /></mxCell><mxCell id="card_ST_F12" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#A8BACB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="8060" y="13682" width="1070" height="755" /></mxCell><mxCell id="board_151" value="CHI TIẾT • ST_F12 F12 — Kiểm tra điều kiện độc giả" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=22;fontStyle=1;fillColor=#EAF2F8;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="8072" y="13692" width="1046" height="80" /></mxCell><mxCell id="content_card_ST_F12" value="" style="group;" vertex="1" parent="1"><mxGeometry as="geometry" x="8080" y="13787" width="430" height="591" /></mxCell><mxCell id="card_ST_F12__title" value="F12 — Kiểm tra điều kiện độc giả" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="content_card_ST_F12"><mxGeometry x="24" y="16" width="339.34" height="40" as="geometry" /></mxCell><mxCell id="card_ST_F12__n0" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;ellipse;fillColor=#243444;" vertex="1" parent="content_card_ST_F12"><mxGeometry x="170.26999999999998" y="90.00000000000001" width="12.959999999999999" height="12.959999999999999" as="geometry" /></mxCell><mxCell id="card_ST_F12__n1" value="Đang đánh giá" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" 