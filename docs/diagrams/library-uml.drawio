ntFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F21_" source="card_ST_F21___n1" target="card_ST_F21___n2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="205.05" y="202.41999999999996" /><mxPoint x="205.05" y="222.82" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F21___label2" value="khóa / thu hồi phiên" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_ST_F21_"><mxGeometry x="54.027" y="305.46" width="122.0" height="17" as="geometry" /></mxCell><mxCell id="card_ST_F21___e2" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F21_" source="card_ST_F21___n2" target="card_ST_F21___n3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="128.163" y="290.29999999999995" /><mxPoint x="70" y="307.96" /><mxPoint x="70" y="307.96" /><mxPoint x="70" y="307.96" /><mxPoint x="70" y="319.96" /><mxPoint x="70" y="319.96" /><mxPoint x="70" y="319.96" /><mxPoint x="107.707" y="331.40999999999997" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F21___label3" value="mở khóa [có thẩm quyền]" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_ST_F21_"><mxGeometry x="192.20999999999998" y="305.46" width="139.1" height="17" as="geometry" /></mxCell><mxCell id="card_ST_F21___e3" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F21_" source="card_ST_F21___n3" target="card_ST_F21___n2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="202.56" y="332.57" /><mxPoint x="201.46" y="319.96" /><mxPoint x="201.46" y="319.96" /><mxPoint x="201.46" y="319.96" /><mxPoint x="201.46" y="307.96" /><mxPoint x="201.46" y="307.96" /><mxPoint x="201.46" y="307.96" /><mxPoint x="202.08" y="300.86" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F21___label4" value="ngừng sử dụng / thu hồi phiên" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_ST_F21_"><mxGeometry x="311.84000000000003" y="353.46" width="173.3" height="17" as="geometry" /></mxCell><mxCell id="card_ST_F21___e4" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F21_" source="card_ST_F21___n2" target="card_ST_F21___n4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="277.9" y="291.43999999999994" /><mxPoint x="327.05" y="307.96" /><mxPoint x="327.05" y="307.96" /><mxPoint x="327.05" y="307.96" /><mxPoint x="327.05" y="415.96" /><mxPoint x="327.05" y="415.96" /><mxPoint x="327.05" y="415.96" /><mxPoint x="316.47" y="424.815" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F21___label5" value="ngừng sử dụng" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_ST_F21_"><mxGeometry x="242.11999999999998" y="401.46" width="82.10000000000001" height="17" as="geometry" /></mxCell><mxCell id="card_ST_F21___e5" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F21_" source="card_ST_F21___n3" target="card_ST_F21___n4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="229.9" y="394.94899999999996" /><mxPoint x="246.51" y="416.337" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F21___note" value="StaffAccount" style="text;html=1;fontFamily=Arial;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="content_card_ST_F21_"><mxGeometry x="24" y="510.96" width="499.92" height="70" as="geometry" /></mxCell><mxCell id="board_189" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chức năng:&lt;/b&gt; F21 ↔ UC18 — Quản trị tài khoản và vai trò&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Người thao tác:&lt;/b&gt; Admin hệ thống&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chủ thể / phạm vi:&lt;/b&gt; StaffAccount&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; Nút = trạng thái của chủ thể; cạnh = sự kiện [điều kiện] / hành động. Nút đen bắt đầu; nút kép kết thúc phiên được mô tả.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Hoạt động:&lt;/b&gt; Mời tài khoản theo directory/issuer được phép. → Admin gán các permission theo nhiệm vụ; quản lý thư viện không tự sửa quyền hệ thống. → Kích hoạt sau xác minh; thu hồi quyền làm mất hiệu lực các phiên đang dùng. → Khóa hoặc ngừng tài khoản, giữ dấu vết tác giả của giao dịch lịch sử.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Quy tắc đề xuất:&lt;/b&gt; Mở rộng từ PDF và kiến trúc; không cho tài khoản tự nâng quyền; phân quyền máy chủ, không mặc định Quản lý có mọi quyền Thủ thư.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lỗi / ngoại lệ:&lt;/b&gt; Không xóa admin cuối cùng; role change cần audit. Vô hiệu hóa tài khoản không được xóa phiếu do họ lập.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Kết quả / bất biến:&lt;/b&gt; Account trạng thái độc lập với ReaderCard; giữ FK lịch sử.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="1962" y="15738" width="570" height="656" /></mxCell><mxCell id="card_ST_F22_" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#A8BACB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="2627" y="15633" width="1344" height="874" /></mxCell><mxCell id="board_191" value="CHI TIẾT • ST_F22 F22 — Nhập sách và thanh lý" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=22;fontStyle=1;fillColor=#EAF2F8;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="2639" y="15643" width="1320" height="80" /></mxCell><mxCell id="content_card_ST_F22_" value="" style="group;" vertex="1" parent="1"><mxGeometry as="geometry" x="2647" y="15738" width="704" height="734" /></mxCell><mxCell id="card_ST_F22___title" value="F22 — Nhập sách và thanh lý" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="content_card_ST_F22_"><mxGeometry x="24" y="16" width="613.17" height="40" as="geometry" /></mxCell><mxCell id="card_ST_F22___n0" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;ellipse;fillColor=#243444;" vertex="1" parent="content_card_ST_F22_"><mxGeometry x="344.49" y="90.00000000000001" width="12.959999999999999" height="12.959999999999999" as="geometry" /></mxCell><mxCell id="card_ST_F22___n1" value="DRAFT" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_ST_F22_"><mxGeometry x="316.34556000000003" y="151.96000000000004" width="69.24888" height="36" as="geometry" /></mxCell><mxCell id="card_ST_F22___n2" value="VALIDATING" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_ST_F22_"><mxGeometry x="210.364" y="247.96000000000004" width="103.212" height="36" as="geometry" /></mxCell><mxCell id="card_ST_F22___n3" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rhombus;" vertex="1" parent="content_card_ST_F22_"><mxGeometry x="373.37" y="343.96000000000004" width="25.2" height="25.2" as="geometry" /></mxCell><mxCell id="card_ST_F22___n4