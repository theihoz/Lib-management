99.77000000000004" /><mxPoint x="268.75" y="319.96000000000004" /><mxPoint x="268.75" y="319.96000000000004" /><mxPoint x="268.75" y="319.96000000000004" /><mxPoint x="293.46000000000004" y="337.25" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F04__note" value="Phiên sửa Author" style="text;html=1;fontFamily=Arial;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="content_card_ST_F04"><mxGeometry x="24" y="596.1600000000001" width="523.49" height="70" as="geometry" /></mxCell><mxCell id="board_121" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chức năng:&lt;/b&gt; F04 ↔ UC1.1 — Quản lý tác giả&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Người thao tác:&lt;/b&gt; Thủ thư&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chủ thể / phạm vi:&lt;/b&gt; Phiên sửa Author&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; Nút = trạng thái của chủ thể; cạnh = sự kiện [điều kiện] / hành động. Nút đen bắt đầu; nút kép kết thúc phiên được mô tả.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Hoạt động:&lt;/b&gt; Tìm tác giả trước khi tạo. → Nhập tên và thông tin phân biệt; cho phép người trùng tên. → Lưu Author; liên kết với đầu sách qua BookAuthor. → Xóa chỉ khi chưa được tham chiếu; hợp nhất là thao tác riêng có audit.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Quy tắc đề xuất:&lt;/b&gt; Tên không phải khóa định danh; Author–BookEdition là quan hệ nhiều–nhiều.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lỗi / ngoại lệ:&lt;/b&gt; Thiếu tên: 422; đang tham chiếu: 409. Không tự hợp nhất theo tên.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Kết quả / bất biến:&lt;/b&gt; Không mất tác giả của các đầu sách khác khi sửa liên kết.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeo