ometry relative="1" as="geometry"><mxPoint x="542.5" y="316" as="sourcePoint" /><mxPoint x="952.5" y="316" as="targetPoint" /></mxGeometry></mxCell><mxCell id="card_SD_Checkout__l3" value="4. BEGIN; khóa edition, reader, copies theo ID" style="text;html=1;fontSize=12;whiteSpace=wrap;align=center;fillColor=#FFFFFF;" vertex="1" parent="content_card_SD_Checkout"><mxGeometry x="557.5" y="273" width="380" height="36" as="geometry" /></mxCell><mxCell id="card_SD_Checkout__m4" value="" style="endArrow=classic;endFill=1;strokeColor=#344454;" edge="1" parent="content_card_SD_Checkout"><mxGeometry relative="1" as="geometry"><mxPoint x="542.5" y="373" as="sourcePoint" /><mxPoint x="747.5" y="373" as="targetPoint" /></mxGeometry></mxCell><mxCell id="card_SD_Checkout__l4" value="5. Đánh giá thẻ/nợ/quá hạn/số cuốn/hold" style="text;html=1;fontSize=12;whiteSpace=wrap;align=center;fillColor=#FFFFFF;" vertex="1" parent="content_card_SD_Checkout"><mxGeometry x="455" y="330" width="380" height="36" as="geometry" /></mxCell><mxCell id="card_SD_Checkout__m5" value="" style="endArrow=classic;endFill=1;strokeColor=#344454;" edge="1" parent="content_card_SD_Checkout"><mxGeometry relative="1" as="geometry"><mxPoint x="747.5" y="430" as="sourcePoint" /><mxPoint x="542.5" y="430" as="targetPoint" /></mxGeometry></mxCell><mxCell id="card_SD_Checkout__l5" value="6. allowed + rules snapshot" style="text;html=1;fontSize=12;whiteSpace=wrap;align=center;fillColor=#FFFFFF;" vertex="1" parent="content_card_SD_Checkout"><mxGeometry x="455" y="387" width="380" height="36" as="geometry" /></mxCell><mxCell id="card_SD_Checkout__m6" value="" style="endArrow=classic;endFill=1;strokeColor=#344454;" edge="1" parent="content_card_SD_Checkout"><mxGeometry relative="1" as="geometry"><mxPoint x="542.5" y="487" as="sourcePoint" /><mxPoint x="952.5" y="487" as="targetPoint" /></mxGeometry></mxCell><mxCell id="card_SD_Checkout__l6" value="7. INSERT Loan/Items; UPDATE copies ON_LOAN" style="text;html=1;fontSize=12;whiteSpace=wrap;align=center;fillColor=#FFFFFF;" vertex="1" parent="content_card_SD_Checkout"><mxGeometry x="557.5" y="444" width="380" height="36" as="geometry" /></mxCell><mxCell id="card_SD_Checkout__m7" value="" style="endArrow=classic;endFill=1;strokeColor=#344454;" edge="1" parent="content_card_SD_Checkout"><mxGeometry relative="1" as="geometry"><mxPoint x="542.5" y="544" as="sourcePoint" /><mxPoint x="952.5" y="544" as="targetPoint" /></mxGeometry></mxCell><mxCell id="card_SD_Checkout__l7" value="8. INSERT audit/outbox/key; COMMIT" style="text;html=1;fontSize=12;whiteSpace=wrap;align=center;fillColor=#FFFFFF;" vertex="1" parent="content_card_SD_Checkout"><mxGeometry x="557.5" y="501" width="380" height="36" as="geometry" /></mxCell><mxCell id="card_SD_Checkout__m8" value="" style="endArrow=classic;endFill=1;strokeColor=#344454;" edge="1" parent="content_card_SD_Checkout"><mxGeometry relative="1" as="geometry"><mxPoint x="542.5" y="601" as="sourcePoint" /><mxPoint x="337.5" y="601" as="targetPoint" /></mxGeometry></mxCell><mxCell id="card_SD_Checkout__l8" value="9. 201 loan + dueAt" style="text;html=1;fontSize=12;whiteSpace=wrap;align=center;fillColor=#FFFFFF;" vertex="1" parent="content_card_SD_Checkout"><mxGeometry x="250" y="558" width="380" height="36" as="geometry" /></mxCell><mxCell id="card_SD_Checkout__m9" value="" style="endArrow=classic;endFill=1;strokeColor=#344454;" edge="1" parent="content_card_SD_Checkout"><mxGeometry relative="1" as="geometry"><mxPoint x="542.5" y="658" as="sourcePoint" /><mxPoint x="952.5" y="658" as="targetPoint" /></mxGeometry></mxCell><mxCell id="card_SD_Checkout__l9" value="10. alt thất bại: ROLLBACK" style="text;html=1;fontSize=12;whiteSpace=wrap;align=center;fillColor=#FFFFFF;" vertex="1" parent="content_card_SD_Checkout"><mxGeometry x="557.5" y="615" width="380" height="36" as="geometry" /></mxCell><mxCell id="card_SD_Checkout__m10" value="" style="endArrow=classic;endFill=1;strokeColor=#344454;" edge="1" parent="content_card_SD_Checkout"><mxGeometry relative="1" as="geometry"><mxPoint x="542.5" y="715" as="sourcePoint" /><mxPoint x="337.5" y="715" as="targetPoint" /></mxGeometry></mxCell><mxCell id="card_SD_Checkout__l10" value="11. 409 copy không khả dụng / 422 eligibility" style="text;html=1;fontSize=12;whiteSpace=wrap;align=center;fillColor=#FFFFFF;" vertex="1" parent="content_card_SD_Checkout"><mxGeometry x="250" y="672" width="380" height="36" as="geometry" /></mxCell><mxCell id="card_SD_Checkout__note" value="critical: từ BEGIN đến COMMIT/ROLLBACK. Eligibility được đánh giá sau khóa; unique partial là lớp bảo vệ cuối." style="text;html=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="content_card_SD_Checkout"><mxGeometry x="25" y="787" width="1015" height="60" as="geometry" /></mxCell><mxCell id="board_323" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Mục đích:&lt;/b&gt; Sequence — UC6 cho mượn nguyên tử&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; Cột là participant, nét đứt là lifeline; thời gian từ trên xuống. alt = chọn một nhánh; critical = vùng nguyên tử; opt = có điều kiện.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách hoạt động:&lt;/b&gt; API nhận readerId, copyIds và idempotency key. Service khóa theo thứ tự đã quy định; kiểm tra lại thẻ, nợ, quá hạn và copy. Ghi Loan / LoanItem, trạng thái copy và audit / outbox cùng transaction. Một mục lỗi làm cả phiếu rollback. Retry cùng key trả kết quả cũ; không tạo phiếu trùng.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lưu ý / ràng buộc:&lt;/b&gt; critical: từ BEGIN đến COMMIT/ROLLBACK. Eligibility được đánh giá sau khóa; unique partial là lớp bảo vệ cuối.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="8565" y="22903" width="570" height="902" /></mxCell><mxCell id="card_SD_Return" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#A8BACB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="24651" width="2068" height="1250" /></mxCell><mxCell id="board_325" value="CHI TIẾT • SD_Return Sequence — UC7 trả; UC22 ghi phí; UC10 thu độc lập" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=22;fontStyle=1;fillColor=#EAF2F8;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="112" y="24661" width="2044" height="80" /></mxCell><mxCell id="content_card_SD_Return" value="" style="group;" vertex="1" parent="1"><mxGeometry as="geometry" x="120" y="24756" width="1428" height="1110" /></mxCell><mxCell id="card_SD_Return__frame0" value="opt [trễ/hỏng/mất]" style="rounded=0;fillColor=none;strokeColor=#657585;html=1;verticalAlign=top;align=left;fontSize=11;" vertex="1" parent="content_card_SD_Return"><mxGeometry x="20" y="336" width="1230" height="114" as="geometry" /></mxCell><mxCell id="card_SD_Return__p0" value="Thủ thư" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=0;fillColor=#edf3f7;" vertex="1" parent="content_card_SD_Return"><mxGeometry x="50" y="55" width="165" height="44" as="geometry" /></mxCell><mxCell id="card_SD_Return__life0" value="" style="dashed=1;endArrow=none;strokeColor=#657585;" edge="1" parent="content_card_SD_Return"><mxGeometry relative="1" as="geometry"><mxPoint x="132.5" y="99" as="sourcePoint" /><mxPoint x="132.5" y="1000" as="targetPoint" /></mxGeometry></mxCell><mxCell id="card_SD_Return__p1" value="UI" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=0;fillColor=#edf3f7;" vertex="1" parent="content_card_SD_Return"><mxGeometry x="255" y="55" width="165" height="44" as="geometry" /></mxCell><mxCell id="card_SD_Return__life1" value="" style="dashed=1;endArrow=none;strokeColor=#657585;" edge="1" parent="content_card_SD_Return"><mxGeometry relative="1" as="geometry"><mxPoint x="337.5" y="99" as="sourcePoint" /><mxPoint x="337.5" y="1000" as="targetPoint" /></mxGeometry></mxCell><mxCell id="card_SD_Return__p2" value="Circulation" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=0;fillColor=#edf3f7;" vertex="1" parent="content_card_SD_Return"><mxGeometry x="460" y="55" width="165" height="44" as="geometry" /></mxCell><mxCell id="card_SD_Return__life2" value="" style="dashed=1;endArrow=none;strokeColor=#657585;" edge="1" parent="content_card_SD_Return"><mxGeometry relative="1" as="geometry"><mxPoint x="542.5" y="99" as="sourcePoint" /><mxPoint x="542.5" y="1000" as="targetPoint" /></mxGeometry></mxCell><mxCell id="card_SD_Return__p3" value="Finance" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=0;fillColor=#edf3f7;" vertex="1" parent="content_card_SD_Return"><mxGeometry x="665" y="55" width="165" height="44" as="geometry" /></mxCell><mxCell id="card_SD_Return__life3" value="" style="dashed=1;endArrow=none;strokeColor=#657585;" edge="1" parent="content_card_SD_Return"><mxGeometry relative="1" as="geometry"><mxPoint x="747.5" y="99" as="sourcePoint" /><mxPoint x="747.5" y="1000" as="targetPoint" /></mxGeometry></mxCell><mxCell id="card_SD_Return__p4" value="Database" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=0;fillColor=#edf3f7;" vertex="1" parent="content_card_SD_Return"><mxGeometry x="870" y="55" width="165" height="44" as="geometry" /></mxCell><mxCell id="card_SD_Return__life4" value="" style="dashed=1;endArrow=none;strokeColor=#657585;" edge="1" parent="content_card_SD_Return"><mxGeometry relative="1" as="geometry"><mxPoint x="952.5" y="99" as="sourcePoint" /><mxPoint x="952.5" y="1000" as="targetPoint" /></mxGeometry></mxCell><mxCell id="card_SD_Return__p5" value="Worker" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=0;fillColor=#edf3f7;" vertex="1" parent="content_card_SD_Return"><mxGeometry x="1075" y="55" width="165" height="44" as="geometry" /></mxCell><mxCell id="card_SD_Return__life5" value="" style="dashed=1;endArrow=none;strokeColor=#657585;" edge="1" parent="content_card_SD_Return"><mxGeometry relative="1" as="geometry"><mxPoint x="1157.5" y="99" as="sourcePoint" /><mxPoint x="1157.5" y="1000" as="targetPoint" /></mxGeometry></mxCell><mxCell id="card_SD_Return__m0" value="" style="endArrow=classic;endFill=1;strokeColor=#344454;" edge="1" parent="content_card_SD_Return"><mxGeometry relative="1" as="geometry"><mxPoint x="132.5" y="145" as="sourcePoint" /><mxPoint x="337.5" y="145" as="targetPoint" /></mxGeometry></mxCell><mxCell id="card_SD_Return__l0" value="1. Quét trả và tình trạng" style="text;html=1;fontSize=12;whiteSpace=wrap;align=center;fillColor=#FFFFFF;" vertex="1" parent="content_card_SD_Return"><mxGeometry x="45" y="102" width="380" height="36" as="geometry" /></mxCell><mxCell id="card_SD_Return__m1" value="" style="endArrow=classic;endFill=1;strokeColor=#344454;" edge="1" parent="content_card_SD_Return"><mxGeometry relative="1" as="geometry"><mxPoint x="337.5" y="202" as="sourcePoint" /><mxPoint x="542.5" y="202" as="targetPoint" /></mxGeometry></mxCell><mxCell id="card_SD_Return__l1" value="2. POST /returns + key" style="text;html=1;fontSize=12;whiteSpace=wrap;align=center;fillColor=#FFFFFF;" vertex="1" parent="content_card_SD_Return"><mxGeometry x="250" y="159" width="380" height="36" as="geometry" /></mxCell><mxCell id="card_SD_Return__m2" value="" style="endArrow=classic;endFill=1;strokeColor=#344454;" edge="1" parent="content_card_SD_Return"><mxGeometry relative="1" as="geometry"><mxPoint x="542.5" y="259" as="sourcePoint" /><mxPoint x="952.5" y="259" as="targetPoint" /></mxGeometry></mxCell><mxCell id="card_SD_Return__l2" value="3. BEGIN; khóa edition/reader/copy/item/queue" style="text;html=1;fontSize=12;whiteSpace=wrap;align=center;fillColor=#FFFFFF;" vertex="1" parent="content_card_SD_Return"><mxGeometry x="557.5" y="216" width="380" height="36" as="geometry" /></mxCell><mxCell id="card_SD_Return__m3" value="" style="endArrow=classic;endFill=1;strokeColor=#344454;" edge="1" parent="content_card_SD_Return"><mxGeometry relative="1" as="geometry"><mxPoint x="542.5" y="316" as="sourcePoint" /><mxPoint x="542.5" y="316" as="targetPoint" /><Array as="points"><mxPoint x="622.5" y="316" /><mxPoint x="622.5" y="338" /></Array></mxGeometry></mxCell><mxCell id="card_SD_Return__l3" value="4. Tính ngày trễ từ dueAt đã lưu" style="text;html=1;fontSize=12;whiteSpace=wrap;align=center;fillColor=#FFFFFF;" vertex="1" parent="content_card_SD_Return"><mxGeometry x="412.5" y="273" width="380" height="36" as="geometry" /></mxCell><mxCell id="card_SD_Return__m4" value="" style="endArrow=classic;endFill=1;strokeColor=#344454;" edge="1" parent="content_card_SD_Return"><mxGeometry relative="1" as="geometry"><mxPoint x="542.5" y="373" as="sourcePoint" /><mxPoint x="747.5" y="373" as="targetPoint" /></mxGeometry></mxCell><mxCell id="card_SD_Return__l4" value="5. opt trễ/hỏng/mất: assessCharge" style="text;html=1;fontSize=12;whiteSpace=wrap;align=center;fillColor=#FFFFFF;" vertex="1" parent="content_card_SD_Return"><mxGeometry x="455" y="330" width="380" height="36" as="geometry" /></mxCell><mxCell id="card_SD_Return__m5" value="" style="endArrow=classic;endFill=1;strokeColor=#344454;" edge="1" parent="content_card_SD_Return"><mxGeometry relative="1" as="geometry"><mxPoint x="747.5" y="430" as="sourcePoint" /><mxPoint x="952.5" y="430" as="targetPoint" /></mxGeometry></mxCell><mxCell id="card_SD_Return__l5" value="6. INSERT charge theo policy snapshot" style="text;html=1;fontSize=12;whiteSpace=wrap;align=center;fillColor=#FFFFFF;" vertex="1" parent="content_card_SD_