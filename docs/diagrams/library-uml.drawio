ard_AD_F09__n3" target="card_AD_F09__n4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="195.48000000000002" y="397.87" /><mxPoint x="175.49" y="466.76000000000005" /><mxPoint x="175.49" y="466.76000000000005" /><mxPoint x="175.49" y="466.76000000000005" /><mxPoint x="175.49" y="466.76000000000005" /><mxPoint x="175.49" y="697.8000000000001" /><mxPoint x="175.49" y="697.8000000000001" /><mxPoint x="177.6" y="746.69" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F09__e4" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F09" source="card_AD_F09__n4" target="card_AD_F09__n9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="238.33" y="855.615" /><mxPoint x="267.1" y="875.5640000000001" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F09__label5" value="[hợp lệ]" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_AD_F09"><mxGeometry x="281.92999999999995" y="396.50000000000006" width="53.6" height="17" as="geometry" /></mxCell><mxCell id="card_AD_F09__e5" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F09" source="card_AD_F09__n3" target="card_AD_F09__n5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="232.78" y="378.1700000000001" /><mxPoint x="285.88" y="406.91" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F09__e6" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F09" source="card_AD_F09__n5" target="card_AD_F09__n6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="410" y="513.48" /><mxPoint x="414.36" y="527.9000000000001" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F09__e7" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F09" source="card_AD_F09__n6" target="card_AD_F09__n7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="428.11" y="627.8800000000001" /><mxPoint x="427.35" y="642.1500000000001" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F09__label8" value="[thành công]" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_AD_F09"><mxGeometry x="413.81" y="751.0600000000001" width="76.4" height="17" as="geometry" /></mxCell><mxCell id="card_AD_F09__e8" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F09" source="card_AD_F09__n7" target="card_AD_F09__n8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="424.49" y="745.83" /><mxPoint x="424.49" y="764.83" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F09__label9" value="[lỗi / rollback nếu có ghi DB]" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_AD_F09"><mxGeometry x="261.24" y="751.0600000000001" width="179.0" height="17" as="geometry" /></mxCell><mxCell id="card_AD_F09__e9" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F09" source="card_AD_F09__n7" target="card_AD_F09__n4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="313.94" y="742.3100000000001" /><mxPoint x="286" y="753.5600000000001" /><mxPoint x="286" y="753.5600000000001" /><mxPoint x="286" y="753.5600000000001" /><mxPoint x="257.87" y="769.5500000000001" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F09__e10" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F09" source="card_AD_F09__n8" target="card_AD_F09__n9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="365.57" y="855.7" /><mxPoint x="336.13" y="875.778" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F09__note" value="Vai trò hành động ghi trong nút; nhánh lỗi kết thúc yêu cầu, dữ liệu không ghi một phần." style="text;html=1;fontFamily=Arial;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="content_card_AD_F09"><mxGeometry x="24" y="947.32" width="610.7" height="70" as="geometry" /></mxCell><mxCell id="board_242" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chức năng:&lt;/b&gt; F09 ↔ UC8 — Gia hạn mượn&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Người thao tác:&lt;/b&gt; Thủ thư&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chủ thể / phạm vi:&lt;/b&gt; Một lần thực hiện chức năng; từ bắt đầu đến kết quả&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; Đọc theo mũi tên; chữ nhật là hoạt động, hình thoi chọn nhánh theo guard. Nhánh lỗi phải sửa hoặc kết thúc; không bỏ qua bước kiểm tra.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Hoạt động:&lt;/b&gt; Chọn phiếu và các mục còn OPEN. → Khóa phiếu/mục và kiểm tra lại lần gia hạn, nợ, thẻ, hạn, hàng đợi. → Kiểm tra toàn bộ mục mở; mục đã trả không tham gia. → Cập nhật dueAt, renewalCount, lưu RenewalEvent cùng giao dịch.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Quy tắc đề xuất:&lt;/b&gt; Theo tài liệu DFD: một lần/phiếu; thêm 4 ngày từ hạn cũ; chưa quá hạn, không nợ và không có người khác giữ đầu sách.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lỗi / ngoại lệ:&lt;/b&gt; Có một mục mở không đủ điều kiện: từ chối toàn phiếu; không cập nhật một phần. Hai yêu cầu cùng lúc: khóa và kiểm tra lại; một lần gia hạn duy nhất.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Kết quả / bất biến:&lt;/b&gt; Hạn mới dựa trên hạn cũ, không tính lại từ issuedAt. Quy định một lần/phiếu được đánh dấu cần thống nhất với giới hạn tổng thời gian.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="4939" y="18821" width="570" height="1093" /></mxCell><mxCell id="card_AD_F10" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#A8BACB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="5604" y="18716" width="1302" height="1213" /></mxCell><mxCell id="board_244" value="CHI TIẾT • AD_F10 F10 — Luồng Đặt trước và giữ chỗ" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=22;fontStyle=1;fillColor=#EAF2F8;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="5616" y="18726" width="1278" height="80" /></mxCell><mxCell id="content_card_AD_F10" value="" style="group;" vertex="1" parent="1"><mxGeometry as="geometry" x="5624" y="18821" width="662" height="1073" /></mxCell><mxCell id="card_AD_F10__title" value="F10 — Luồng Đặt trước và giữ chỗ" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="content_card_AD_F10"><mxGeometry x="24" y="16" width="571.4200000000001" height="40" as="geometry" /></mxCell><mxCell id="card_AD_F10__n0" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;ellipse;fillColor=#243444;" vertex="1" parent="content_card_AD_F10"><mxGeometry x="204.01000000000002" y="90.00000000000001" width="12.959999999999999" height="12.959999999999999" as="geometry" /></mxCell><mxCell id="card_AD_F10__n1" value="Người dùng&lt;br&gt;Xác thực độc giả; kiểm tra đầu sách và&lt;br&gt;trùng lượt đang hoạt động." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F10"><mxGeometry x="76.8904" y="151.96000000000004" width="267.1992" height="65.52" as="geometry" /></mxCell><mxCell id="card_AD_F10__n2" value="API&lt;br&gt;Kiểm tra quyền và input" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F10"><mxGeometry x="125.638" y="266.48012000000006" width="169.704" height="49.91976" as="geometry" /></mxCell><mxCell id="card_AD_F10__n3" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rhombus;" vertex="1" parent="content_card_AD_F10"><mxGeometry x="197.89000000000001" y="365.4" width="25.2" height="25.2" as="geometry" /></mxCell><mxCell id="card_AD_F10__n4" value="API&lt;br&gt;Trả lỗi có mã; không ghi dữ liệu" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F10"><mxGeometry x="70.0024" y="789.5601200000001" width="220.9752" height="49.91976" as="geometry" /></mxCell><mxCell id="card_AD_F10__n5" value="Hệ thống&lt;br&gt;Khi không có bản sao khả dụng, tạo QUEUED." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F10"><mxGeometry x="249.186" y="450.60012000000006" width="310.608" height="49.91976" as="geometry" /></mxCell><mxCell id="card_AD_F10__n6" value="Hệ thống&lt;br&gt;Khi có bản sao trả tốt, khóa hàng đợi và&lt;br&gt;gán lượt hợp lệ đầu tiên thành READY." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F10"><mxGeometry x="284.78520000000003" y="549.52" width="269.4096" height="65.52" as="geometry" /></mxCell><mxCell id="card_AD_F10__n7" value="Hệ thống&lt;br&gt;Gửi thông báo sau commit; nhận sách phải&lt;br&gt;kiểm tra điều kiện mượn lần nữa." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F10"><mxGeometry x="277.5564" y="664.0400000000001" width="283.8672" height="65.52" as="geometry" /></mxCell><mxCell id="card_AD_F10__n8" value="API&lt;br&gt;Trả kết quả và mã yêu cầu" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F10"><mxGeometry x="327.3728" y="789.5601200000001" width="194.23440000000002" height="49.91976" as="geometry" /></mxCell><mxCell id="card_AD_F10__n9" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;shape=doubleEllipse;fillColor=#243444;" vertex="1" parent="content_card_AD_F10"><mxGeometry x="289.57004" y="888.4800400000001" width="23.83992" height="23.83992" as="geometry" /></mxCell><mxCell id="card_AD_F10__e0" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F10" source="card_AD_F10__n0" target="card_AD_F10__n1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="210.49" y="111.7600000000001" /><mxPoint x="210.49" y="127.69000000000005" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F10__e1" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F10" source="card_AD_F10__n1" target="card_AD_F10__n2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="210.49" y="230.41000000000008" /><mxPoint x="210.49" y="245.0200000000001" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F10__e2" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F10" source="card_AD_F10__n2" target="card_AD_F10__n3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="210.49" y="329.49" /><mxPoint x="210.49" y="344.6700000000001" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F10__label3" value="[không hợp lệ]" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_AD_F10"><mxGeometry x="170.76999999999998" y="573.78" width="87.8" height="17" as="geometry" /></mxCell><mxCell id="card_AD_F10__e3" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F10" source="card_AD_F10__n3" target="card_AD_F10__n4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="200.1" y="412.08000000000004" /><mxPoint x="180.49" y="474.56000000000006" /><mxPoint x="180.49" y="474.56000000000006" /><mxPoint x="180.49" y="474.56000000000006" /><mxPoint x="180.49" y="474.56000000000006" /><mxPoint x="180.49" y="697.8000000000001" /><mxPoint x="180.49" y="697.8000000000001" /><mxPoint x="180.49" y="746.69" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F10__e4" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F10" source="card_AD_F10__n4" target="card_AD_F10__n9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="238.33" y="855.615" /><mxPoint x="267.1" y="875.5640000000001" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F10__label5" value="[hợp lệ]" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_AD_F10"><mxGeometry x="294.04999999999995" y="412.1" width="53.6" height="17" as="geometry" /></mxCell><mxCell id="card_AD_F10__e5" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F10" source="card_AD_F10__n3" target="card_AD_F10__n5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="239.82" y="393.45000000000005" /><mxPoint x="301.12" y="423.64000000000004" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F10__e6" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F10" source="card_AD_F10__n5" target="card_AD_F10__n6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="409.67" y="512.76" /><mxPoint x="411.77" y="527.4200000000001" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F10__e7" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F10" source="card_AD_F10__n6" target="card_AD_F10__n7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="419.49" y="627.8800000000001" /><mxPoint x="419.49" y="642.1500000000001" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F10__label8" value="[thành công]" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_AD_F10"><mxGeometry x="411.61" y="751.0600000000001" width="76.4" height="17" as="geometry" /></mxCell><mxCell id="card_AD_F10__e8" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F10" source="card_AD_F10__n7" target="card_AD_F10__n8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="421.56" y="745.83" /><mxPoint x="422.38" y="764.83" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F10__label9" value="[lỗi / rollback nếu có ghi DB]" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_AD_F10"><mxGeometry x="259.24" y="751.0600000000001" width="179.0" height="17" as="geometry" /></mxCell><mxCell id="card_AD_F10__e9" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F10" source="card_AD_F10__n7" target="card_AD_F10__n4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="311.34000000000003" y="742.3100000000001" /><mxPoint x="284" y="753.5600000000001" /><mxPoint x="284" y="753.5600000000001" /><mxPoint x="284" y="753.5600000000001" /><mxPoint x="256.4" y="769.5500000000001" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F10__e10" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F10" source="card_AD_F10__n8" target="card_AD_F10__n9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="365.57" y="855.7" /><mxPoint x="336.13" y="875.778" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F10__note" value="Vai trò hành động ghi trong nút; nhánh lỗi kết thúc yêu cầu, dữ liệu không ghi một phần." style="text;html=1;fontFamily=Arial;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="content_card_AD_F10"><mxGeometry x="24" y="947.32" width="591.4200000000001" height="70" as="geometry" /></mxCell><mxCell id="board_246" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chức năng:&lt;/b&gt; F10 ↔ UC9 — Đặt trước và giữ chỗ&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Người thao tác:&lt;/b&gt; Độc giả; Thủ thư hỗ trợ&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chủ thể / phạm vi:&lt;/b&gt; Một lần thực hiện chức năng; từ bắt đầu đến kết quả&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; Đọc theo mũi tên; chữ nhật là hoạt động, hình thoi chọn nhánh theo guard. Nhánh lỗi phải sửa hoặc kết thúc; không bỏ qua bước kiểm tra.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Hoạt động:&lt;/b&gt; Xác thực độc giả; kiểm tra đầu sách và trùng lượt đang hoạt động. → Khi không có bản sao khả dụng, tạo QUEUED. → Khi có bản sao trả tốt, khóa hàng đợi và gán lượt hợp lệ đầu tiên thành READY. → Gửi thông báo sau commit; nhận sách phải kiểm tra điều kiện mượn lần nữa.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Quy tắc đề xuất:&lt;/b&gt; Đặt theo đầu sách; hàng đợi FIFO createdAt+ID; mỗi độc giả chỉ một lượt đang hoạt động/đầu sách; READY hết hạn sau 3 ngày.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lỗi / ngoại lệ:&lt;/b&gt; Hết 3 ngày: EXPIRED và phân bổ lượt tiếp theo cùng giao dịch. Hủy được QUEUED/READY. Không cấm đặt lại chỉ vì đã từng có lịch sử.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Kết quả / bất biến:&lt;/b&gt; Một bản sao chỉ gắn một lượt READY; một lượt READY chỉ gắn một bản sao.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="6301" y="18821" width="570" height="1093" /></mxCell><mxCell id="card_AD_F11" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#A8BACB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="6966" y="18716" width="1313" height="1228" /></mxCell><mxCell id="board_248" value="CHI TIẾT • AD_F11 F11 — Luồng Ghi phí, thu và miễn phạt" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=22;fontStyle=1;fillColor=#EAF2F8;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="6978" y="18726" width="1289" height="80" /></mxCell><mxCell id="content_card_AD_F11" value="" style="group;" vertex="1" parent="1"><mxGeometry as="geometry" x="6986" y="18821" width="673" height="1088" /></mxCell><mxCell id="card_AD_F11__title" value="F11 — Luồng Ghi phí, thu và miễn phạt" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="content_card_AD_F11"><mxGeometry x="24" y="16" width="582.5699999999999" height="40" as="geometry" /></mxCell><mxCell id="card_AD_F11__n0" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;ellipse;fillColor=#243444;" vertex="1" parent="content_card_AD_F11"><mxGeometry x="212.3" y="89.9999999999999" width="12.959999999999999" height="12.959999999999999" as="geometry" /></mxCell><mxCell id="card_AD_F11__n1" value="Người dùng&lt;br&gt;Tạo phí từ UC22 khi trả trễ/hỏng/mất hoặc&lt;br&gt;ghi phí thủ công có lý do." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F11"><mxGeometry x="69.9956" y="151.95999999999992" width="297.5688" height="65.52" as="geometry" /></mxCell><mxCell id="card_AD_F11__n2" value="API&lt;br&gt;Kiểm tra quyền và input" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F11"><mxGeometry x="133.928" y="266.48011999999994" width="169.704" height="49.91976" as="geometry" /></mxCell><mxCell id="card_AD_F11__n3" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rhombus;" vertex="1" parent="content_card_AD_F11"><mxGeometry x="206.18" y="365.4" width="25.2" height="25.2" as="geometry" /></mxCell><mxCell id="card_AD_F11__n4" value="API&lt;br&gt;Trả lỗi có mã; không ghi dữ liệu" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F11"><mxGeometry x="78.2924" y="805.16012" width="220.9752" height="49.91976" as="geometry" /></mxCell><mxCell id="card_AD_F11__n5" value="Hệ thống&lt;br&gt;Thu khoản thanh toán; khóa số dư, phân bổ&lt;br&gt;cho các phí." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F11"><mxGeometry x="265.6576" y="450.59999999999997" width="288.2448" height="65.52" as="geometry" /></mxCell><mxCell id="card_AD_F11__n6" value="Hệ thống&lt;br&gt;Cho thanh toán một phần, không cho tổng&lt;br&gt;phân bổ vượt tiền thu hoặc số dư." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F11"><mxGeometry x="292.99559999999997" y="565.1199999999999" width="279.5688" height="65.52" as="geometry" /></mxCell><mxCell id="card_AD_F11__n7" value="Hệ thống&lt;br&gt;Miễn/đảo khoản có thẩm quyền và audit;&lt;br&gt;tính số dư từ sổ giao dịch." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F11"><mxGeometry x="293.7408" y="679.64" width="278.0784" height="65.52" as="geometry" /></mxCell><mxCell id="card_AD_F11__n8" value="API&lt;br&gt;Trả kết quả và mã yêu cầu" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F11"><mxGeometry x="335.66279999999995" y="805.16012" width="194.23440000000002" height="49.91976" as="geometry" /></mxCell><mxCell id="card_AD_F11__n9" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;shape=doubleEllipse;fillColor=#243444;" vertex="1" parent="content_card_AD_F11"><mxGeometry x="297.86004" y="904.08004" width="23.83992" height="23.83992" as="geometry" /></mxCell><mxCell id="card_AD_F11__e0" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F11" source="card_AD_F11__n0" target="card_AD_F11__n1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="218.78" y="111.75999999999999" /><mxPoint x="218.78" y="127.68999999999994" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F11__e1" value="" style="html=1;fontFamily=