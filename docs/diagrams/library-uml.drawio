card_AD_F01__label9" value="[lỗi / rollback nếu có ghi DB]" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_AD_F01"><mxGeometry x="276.52" y="751.0600000000001" width="179.0" height="17" as="geometry" /></mxCell><mxCell id="card_AD_F01__e9" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F01" source="card_AD_F01__n7" target="card_AD_F01__n4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="335.09" y="741.85" /><mxPoint x="301.28" y="753.5600000000001" /><mxPoint x="301.28" y="753.5600000000001" /><mxPoint x="301.28" y="753.5600000000001" /><mxPoint x="273.15" y="769.5500000000001" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F01__e10" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F01" source="card_AD_F01__n8" target="card_AD_F01__n9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="380.85" y="855.7" /><mxPoint x="351.41" y="875.778" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F01__note" value="Vai trò hành động ghi trong nút; nhánh lỗi kết thúc yêu cầu, dữ liệu không ghi một phần." style="text;html=1;fontFamily=Arial;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="content_card_AD_F01"><mxGeometry x="24" y="947.32" width="618.66" height="70" as="geometry" /></mxCell><mxCell id="board_210" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chức năng:&lt;/b&gt; F01 ↔ UC1 — Quản lý đầu sách&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Người thao tác:&lt;/b&gt; Thủ thư&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chủ thể / phạm vi:&lt;/b&gt; Một lần thực hiện chức năng; từ bắt đầu đến kết quả&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; Đọc theo mũi tên; chữ nhật là hoạt động, hình thoi chọn nhánh theo guard. Nhánh lỗi phải sửa hoặc kết thúc; không bỏ qua bước kiểm tra.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Hoạt động:&lt;/b&gt; Chọn thêm hoặc sửa đầu sách; tải phiên bản hiện tại. → Nhập tên, năm, ISBN, nhà xuất bản, tác giả và thể loại. → Kiểm tra năm, tham chiếu và ISBN; khóa lạc quan bằng version. → Lưu đầu sách; ghi audit; trả dữ liệu mới.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Quy tắc đề xuất:&lt;/b&gt; QĐ03: năm xuất bản trong 8 năm; ISBN chuẩn hóa và duy nhất khi có; nhiều tác giả, thể loại.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lỗi / ngoại lệ:&lt;/b&gt; ISBN trùng: 409; version cũ: 409; dữ liệu sai: 422. Xóa bị chặn khi còn bản sao hoặc lịch sử; dùng ngừng khai thác.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Kết quả / bất biến:&lt;/b&gt; Không đổi số lượng bản sao bằng cách sửa đầu sách. Bản ghi hợp lệ hoặc toàn bộ thao tác không lưu.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="2911" y="16926" width="570" height="1093" /></mxCell><mxCell id="card_AD_F02" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#A8BACB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="3576" y="16821" width="1321" height="1228" /></mxCell><mxCell id="board_212" value="CHI TIẾT • AD_F02 F02 — Luồng Quản lý bản sao và mã vạch" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=22;fontStyle=1;fillColor=#EAF2F8;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="3588" y="16831" width="1297" height="80" /></mxCell><mxCell id="content_card_AD_F02" value="" style="group;" vertex="1" parent="1"><mxGeometry as="geometry" x="3596" y="16926" width="681" height="1088" /></mxCell><mxCell id="card_AD_F02__title" value="F02 — Luồng Quản lý bản sao và mã vạch" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="content_card_AD_F02"><mxGeometry x="24" y="16" width="590.01" height="40" as="geometry" /></mxCell><mxCell id="card_AD_F02__n0" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;ellipse;fillColor=#243444;" vertex="1" parent="content_card_AD_F02"><mxGeometry x="208.34" y="89.9999999999999" width="12.959999999999999" height="12.959999999999999" as="geometry" /></mxCell><mxCell id="card_AD_F02__n1" value="Người dùng&lt;br&gt;Tạo bản sao từ đầu sách có sẵn, nhập vị&lt;br&gt;trí và mã vạch." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F02"><mxGeometry x="69.99919999999997" y="151.95999999999992" width="289.64160000000004" height="65.52" as="geometry" /></mxCell><mxCell id="card_AD_F02__n2" value="API&lt;br&gt;Kiểm tra quyền và input" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F02"><mxGeometry x="129.968" y="266.48011999999994" width="169.704" height="49.91976" as="geometry" /></mxCell><mxCell id="card_AD_F02__n3" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rhombus;" vertex="1" parent="content_card_AD_F02"><mxGeometry x="202.22" y="365.4" width="25.2" height="25.2" as="geometry" /></mxCell><mxCell id="card_AD_F02__n4" value="API&lt;br&gt;Trả lỗi có mã; không ghi dữ liệu" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F02"><mxGeometry x="77.33239999999999" y="805.16012" width="220.9752" height="49.91976" as="geometry" /></mxCell><mxCell id="card_AD_F02__n5" value="Hệ thống&lt;br&gt;Kiểm tra mã vạch, định danh đầu sách và&lt;br&gt;quyền." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F02"><mxGeometry x="265.8972" y="450.59999999999997" width="283.8456" height="65.52" as="geometry" /></mxCell><mxCell id="card_AD_F02__n6" value="Hệ thống&lt;br&gt;Lưu bản sao AVAILABLE; thao tác mượn/trả&lt;br&gt;cập nhật trạng thái trong giao dịch." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F02"><mxGeometry x="289.6284" y="565.1199999999999" width="290.3832" height="65.52" as="geometry" /></mxCell><mxCell id="card_AD_F02__n7" value="Hệ thống&lt;br&gt;Ngừng khai thác chỉ khi không có khoản&lt;br&gt;mượn đang mở hoặc giữ chỗ còn hiệu lực." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F02"><mxGeometry x="285.9228" y="679.64" width="291.7944" height="65.52" as="geometry" /></mxCell><mxCell id="card_AD_F02__n8" value="API&lt;br&gt;Trả kết quả và mã yêu cầu" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F02"><mxGeometry x="334.70279999999997" y="805.16012" width="194.23440000000002" height="49.91976" as="geometry" /></mxCell><mxCell id="card_AD_F02__n9" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;shape=doubleEllipse;fillColor=#243444;" vertex="1" parent="content_card_AD_F02"><mxGeometry x="296.90004" y="904.08004" width="23.83992" height="23.83992" as="geometry" /></mxCell><mxCell id="card_AD_F02__e0" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F02" source="card_AD_F02__n0" target="card_AD_F02__n1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="214.82" y="111.75999999999999" /><mxPoint x="214.82" y="127.68999999999994" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F02__e1" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F02" source="card_AD_F02__n1" target="card_AD_F02__n2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="214.82" y="230.40999999999997" /><mxPoint x="214.82" y="245.01999999999998" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F02__e2" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F02" source="card_AD_F02__n2" target="card_AD_F02__n3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="214.82" y="329.49" /><mxPoint x="214.82" y="344.66999999999996" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F02__label3" value="[không hợp lệ]" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_AD_F02"><mxGeometry x="175.1" y="589.3799999999999" width="87.8" height="17" as="geometry" /></mxCell><mxCell id="card_AD_F02__e3" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F02" source="card_AD_F02__n3" target="card_AD_F02__n4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="204.82" y="413.4699999999999" /><mxPoint x="184.82" y="482.35999999999996" /><mxPoint x="184.82" y="482.35999999999996" /><mxPoint x="184.82" y="482.35999999999996" /><mxPoint x="184.82" y="482.35999999999996" /><mxPoint x="184.82" y="713.4" /><mxPoint x="184.82" y="713.4" /><mxPoint x="186.09" y="762.29" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F02__e4" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F02" source="card_AD_F02__n4" target="card_AD_F02__n9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="245.66" y="871.2149999999999" /><mxPoint x="274.44" y="891.164" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F02__label5" value="[hợp lệ]" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_AD_F02"><mxGeometry x="292.14" y="412.09999999999997" width="53.6" height="17" as="geometry" /></mxCell><mxCell id="card_AD_F02__e5" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F02" source="card_AD_F02__n3" target="card_AD_F02__n5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="242.4" y="393.77" /><mxPoint x="296.06" y="422.50999999999993" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F02__e6" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F02" source="card_AD_F02__n5" target="card_AD_F02__n6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="418.55" y="529.0799999999999" /><mxPoint x="422.01" y="543.5" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F02__e7" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F02" source="card_AD_F02__n6" target="card_AD_F02__n7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="433.63" y="643.48" /><mxPoint x="433.25" y="657.75" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F02__label8" value="[thành công]" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_AD_F02"><mxGeometry x="421.14" y="766.66" width="76.4" height="17" as="geometry" /></mxCell><mxCell id="card_AD_F02__e8" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F02" source="card_AD_F02__n7" target="card_AD_F02__n8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="431.82" y="761.43" /><mxPoint x="431.82" y="780.43" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F02__label9" value="[lỗi / rollback nếu có ghi DB]" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_AD_F02"><mxGeometry x="268.57" y="766.66" width="179.0" height="17" as="geometry" /></mxCell><mxCell id="card_AD_F02__e9" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F02" source="card_AD_F02__n7" target="card_AD_F02__n4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="321.28" y="757.91" /><mxPoint x="293.33000000000004" y="769.16" /><mxPoint x="293.33000000000004" y="769.16" /><mxPoint x="293.33000000000004" y="769.16" /><mxPoint x="265.2" y="785.15" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F02__e10" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F02" source="card_AD_F02__n8" target="card_AD_F02__n9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="372.9" y="871.3" /><mxPoint x="343.46" y="891.3779999999999" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F02__note" value="Vai trò hành động ghi trong nút; nhánh lỗi kết thúc yêu cầu, dữ liệu không ghi một phần." style="text;html=1;fontFamily=Arial;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="content_card_AD_F02"><mxGeometry x="24" y="962.92" width="610.01" height="70" as="geometry" /></mxCell><mxCell id="board_214" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chức năng:&lt;/b&gt; F02 ↔ UC2 — Quản lý bản sao và mã vạch&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Người thao tác:&lt;/b&gt; Thủ thư&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chủ thể / phạm vi:&lt;/b&gt; Một lần thực hiện chức năng; từ bắt đầu đến kết quả&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; Đọc theo mũi tên; chữ nhật là hoạt động, hình thoi chọn nhánh theo guard. Nhánh lỗi phải sửa hoặc kết thúc; không bỏ qua bước kiểm tra.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Hoạt động:&lt;/b&gt; Tạo bản sao từ đầu sách có sẵn, nhập vị trí và mã vạch. → Kiểm tra mã vạch, định danh đầu sách và quyền. → Lưu bản sao AVAILABLE; thao tác mượn/trả cập nhật trạng thái trong giao dịch. → Ngừng khai thác chỉ khi không có khoản mượn đang mở hoặc giữ chỗ còn hiệu lực.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Quy tắc đề xuất:&lt;/b&gt; Mã vạch duy nhất; một bản sao chỉ có một LoanItem đang mở; trạng thái do nghiệp vụ chuyển.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lỗi / ngoại lệ:&lt;/b&gt; Trùng mã: 409. ON_LOAN không được sửa thành AVAILABLE bằng CRUD. Mất tìm lại phải qua kiểm tra, không tự mở lại khoản mượn đã đóng.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Kết quả / bất biến:&lt;/b&gt; Số tồn và số khả dụng được tính từ bản sao; LoanItem và BookCopy nhất quán.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="4292" y="16926" width="570" height="1108" /></mxCell><mxCell id="card_AD_F03" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#A8BACB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="4957" y="16821" width="1292" height="1213" /></mxCell><mxCell id="board_216" value="CHI TIẾT • AD_F03 F03 — Luồng Quản lý thể loại phân cấp" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=22;fontStyle=1;fillColor=#EAF2F8;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="4969" y="16831" width="1268" height="80" /></mxCell><mxCell id="content_card_AD_F03" value="" style="group;" vertex="1" parent="1"><mxGeometry as="geometry" x="4977" y="16926" width="652" height="1073" /></mxCell><mxCell id="card_AD_F03__title" value="F03 — Luồng Quản lý thể loại phân cấp" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="content_card_AD_F03"><mxGeometry x="24" y="16" width="562" height="40" as="geometry" /></mxCell><mxCell id="card_AD_F03__n0" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;ellipse;fillColor=#243444;" vertex="1" parent="content_card_AD_F03"><mxGeometry x="204.01000000000002" y="90.00000000000001" width="12.959999999999999" height="12.959999999999999" as="geometry" /></mxCell><mxCell id="card_AD_F03__n1" value="Người dùng&lt;br&gt;Chọn thêm/sửa thể loại dưới một gốc." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F03"><mxGeometry x="77.2432" y="151.96012000000007" width="266.4936" height="49.91976" as="geometry" /></mxCell><mxCell id="card_AD_F03__n2" value="API&lt;br&gt;Kiểm tra quyền và input" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F03"><mxGeometry x="125.638" y="250.88012000000003" width="169.704" height="49.91976" as="geometry" /></mxCell><mxCell id="card_AD_F03__n3" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rhombus;" vertex="1" parent="content_card_AD_F03"><mxGeometry x="197.89000000000001" y="349.80000000000007" width="25.2" height="25.2" as="geometry" /></mxCell><mxCell id="card_AD_F03__n4" value="API&lt;br&gt;Trả lỗi có mã; không ghi dữ liệu" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F03"><mxGeometry x="70.0024" y="789.5601200000001" width="220.9752" height="49.91976" as="geometry" /></mxCell><mxCell id="card_AD_F03__n5" value="Hệ thống&lt;br&gt;Kiểm tra cha tồn tại, không phải chính nó&lt;br&gt;hoặc hậu duệ." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F03"><mxGeometry x="255.36" y="435.00000000000006" width="280.26" height="65.52" as="geometry" /></mxCell><mxCell id="card_AD_F03__n6" value="Hệ thống&lt;br&gt;Lưu parentId trong giao dịch; kiểm soát&lt;br&gt;cạnh tranh." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F03"><mxGeometry x="284.3852" y="549.52" width="262.2096" height="65.52" as="geometry" /></mxCell><mxCell id="card_AD_F03__n7" value="Hệ thống&lt;br&gt;Xóa chỉ khi không có con và liên kết đầu&lt;br&gt;sách." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F03"><mxGeometry x="278.978" y="664.0400000000001" width="273.024" height="65.52" as="geometry" /></mxCell><mxCell id="card_AD_F03__n8" value="API&lt;br&gt;Trả kết quả và mã yêu cầu" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F03"><mxGeometry x="327.3728" y="789.5601200000001" width="194.23440000000002" height="49.91976" as="geometry" /></mxCell><mxCell id="card_AD_F03__n9" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454