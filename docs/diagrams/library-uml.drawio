AD_F14__e9" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F14" source="card_AD_F14__n7" target="card_AD_F14__n4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="313.94" y="742.3100000000001" /><mxPoint x="286" y="753.5600000000001" /><mxPoint x="286" y="753.5600000000001" /><mxPoint x="286" y="753.5600000000001" /><mxPoint x="257.87" y="769.5500000000001" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F14__e10" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F14" source="card_AD_F14__n8" target="card_AD_F14__n9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="365.57" y="855.7" /><mxPoint x="336.13" y="875.778" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F14__note" value="Vai trò hành động ghi trong nút; nhánh lỗi kết thúc yêu cầu, dữ liệu không ghi một phần." style="text;html=1;fontFamily=Arial;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="content_card_AD_F14"><mxGeometry x="24" y="947.32" width="598.96" height="70" as="geometry" /></mxCell><mxCell id="board_262" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chức năng:&lt;/b&gt; F14 ↔ UC17 — Cấu hình quy định&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Người thao tác:&lt;/b&gt; Quản lý&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chủ thể / phạm vi:&lt;/b&gt; Một lần thực hiện chức năng; từ bắt đầu đến kết quả&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; Đọc theo mũi tên; chữ nhật là hoạt động, hình thoi chọn nhánh theo guard. Nhánh lỗi phải sửa hoặc kết thúc; không bỏ qua bước kiểm tra.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Hoạt động:&lt;/b&gt; Tạo bản nháp từ chính sách hiện hành. → Kiểm tra miền giá trị, các ràng buộc liên quan và tác động. → Duyệt và lên lịch effectiveFrom; không hai version chồng hiệu lực. → Kích hoạt cho giao dịch mới; giao dịch cũ giữ policyVersionId đã chụp.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Quy tắc đề xuất:&lt;/b&gt; Không ghi đè chính sách lịch sử; effectiveFrom, version, người duyệt; tham số nghiệp vụ mâu thuẫn chưa tự áp dụng.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lỗi / ngoại lệ:&lt;/b&gt; Không cho đổi version đã ACTIVE. Muốn sửa tạo bản mới. Thay đổi hồi tố là quy trình riêng có duyệt, không tự tính lại phí.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Kết quả / bất biến:&lt;/b&gt; Một chính sách hiệu lực tại một thời điểm; audit đầy đủ.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="2192" y="20125" width="570" height="1093" /></mxCell><mxCell id="card_AD_F15" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#A8BACB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="2857" y="20020" width="1295" height="1213" /></mxCell><mxCell id="board_264" value="CHI TIẾT • AD_F15 F15 — Luồng Quản lý ảnh bìa R2" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=22;fontStyle=1;fillColor=#EAF2F8;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="2869" y="20030" width="1271" height="80" /></mxCell><mxCell id="content_card_AD_F15" value="" style="group;" vertex="1" parent="1"><mxGeometry as="geometry" x="2877" y="20125" width="655" height="1073" /></mxCell><mxCell id="card_AD_F15__title" value="F15 — Luồng Quản lý ảnh bìa R2" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="content_card_AD_F15"><mxGeometry x="24" y="16" width="564.81" height="40" as="geometry" /></mxCell><mxCell id="card_AD_F15__n0" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;ellipse;fillColor=#243444;" vertex="1" parent="content_card_AD_F15"><mxGeometry x="204.01000000000002" y="90.00000000000001" width="12.959999999999999" height="12.959999999999999" as="geometry" /></mxCell><mxCell id="card_AD_F15__n1" value="Người dùng&lt;br&gt;Tạo upload intent có quyền cho đầu sách." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F15"><mxGeometry x="71.43280000000001" y="151.96012000000007" width="278.1144" height="49.91976" as="geometry" /></mxCell><mxCell id="card_AD_F15__n2" value="API&lt;br&gt;Kiểm tra quyền và input" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F15"><mxGeometry x="125.638" y="250.88012000000003" width="169.704" height="49.91976" as="geometry" /></mxCell><mxCell id="card_AD_F15__n3" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rhombus;" vertex="1" parent="content_card_AD_F15"><mxGeometry x="197.89000000000001" y="349.80000000000007" width="25.2" height="25.2" as="geometry" /></mxCell><mxCell id="card_AD_F15__n4" value="API&lt;br&gt;Trả lỗi có mã; không ghi dữ liệu" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F15"><mxGeometry x="70.0024" y="789.5601200000001" width="220.9752" height="49.91976" as="geometry" /></mxCell><mxCell id="card_AD_F15__n5" value="Hệ thống&lt;br&gt;Upload vào vùng staging; kiểm tra magic&lt;br&gt;bytes và giải mã ảnh." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F15"><mxGeometry x="259.3124" y="435.00000000000006" width="264.3552" height="65.52" as="geometry" /></mxCell><mxCell id="card_AD_F15__n6" value="Hệ thống&lt;br&gt;Lưu objectKey, hash, kích thước và gắn&lt;br&gt;MediaAsset với đầu sách." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F15"><mxGeometry x="284.6652" y="549.52" width="263.6496" height="65.52" as="geometry" /></mxCell><mxCell id="card_AD_F15__n7" value="Hệ thống&lt;br&gt;Khi thay ảnh, kích hoạt bản mới rồi dọn&lt;br&gt;ảnh cũ sau; dọn orphan theo lịch." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F15"><mxGeometry x="278.1708" y="664.0400000000001" width="276.6384" height="65.52" as="geometry" /></mxCell><mxCell id="card_AD_F15__n8" value="API&lt;br&gt;Trả kết quả và mã yêu cầu" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F15"><mxGeometry x="327.3728" y="789.5601200000001" width="194.23440000000002" height="49.91976" as="geometry" /></mxCell><mxCell id="card_AD_F15__n9" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;shape=doubleEllipse;fillColor=#243444;" vertex="1" parent="content_card_AD_F15"><mxGeometry x="289.57004" y="888.4800400000001" width="23.83992" height="23.83992" as="geometry" /></mxCell><mxCell id="card_AD_F15__e0" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F15" source="card_AD_F15__n0" target="card_AD_F15__n1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="210.49" y="111.91000000000008" /><mxPoint x="210.49" y="128.35000000000002" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F15__e1" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#34