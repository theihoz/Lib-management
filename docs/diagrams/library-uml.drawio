ay></mxGeometry></mxCell><mxCell id="card_ST_F19__label8" value="thử lại" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_ST_F19"><mxGeometry x="266.13" y="305.46000000000004" width="47.9" height="17" as="geometry" /></mxCell><mxCell id="card_ST_F19__e8" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F19" source="card_ST_F19__n6" target="card_ST_F19__n1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="263.41999999999996" y="422.399" /><mxPoint x="189" y="405.16" /><mxPoint x="189" y="405.16" /><mxPoint x="189" y="405.16" /><mxPoint x="189" y="393.16" /><mxPoint x="189" y="393.16" /><mxPoint x="189" y="393.16" /><mxPoint x="333.92" y="251.3" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F19__label9" value="đóng phiên" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_ST_F19"><mxGeometry x="721.88" y="209.46000000000004" width="65.0" height="17" as="geometry" /></mxCell><mxCell id="card_ST_F19__e9" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F19" source="card_ST_F19__n1" target="card_ST_F19__n7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="556.95" y="189.91000000000003" /><mxPoint x="721" y="211.96000000000004" /><mxPoint x="721" y="211.96000000000004" /><mxPoint x="721" y="211.96000000000004" /><mxPoint x="737.22" y="233.46000000000004" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F19__note" value="OverdueQuerySession" style="text;html=1;fontFamily=Arial;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="content_card_ST_F19"><mxGeometry x="24" y="500.16" width="809.12" height="70" as="geometry" /></mxCell><mxCell id="board_181" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chức năng:&lt;/b&gt; F19 ↔ UC14 — Theo dõi sách quá hạn&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Người thao tác:&lt;/b&gt; Quản lý; Thủ thư&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chủ thể / phạm vi:&lt;/b&gt; OverdueQuerySession&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; Nút = trạng thái của chủ thể; cạnh = sự kiện [điều kiện] / hành động. Nút đen bắt đầu; nút kép kết thúc phiên được mô tả.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Hoạt động:&lt;/b&gt; Chọn bộ lọc và mốc thời gian. → Đọc các mục OPEN quá hạn theo dueAt. → Hiển thị ngày trễ và phí dự kiến, phân biệt phí đã được ghi sổ. → Làm mới khi có trả hoặc gia hạn; thông báo tự động là mở rộng riêng.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Quy tắc đề xuất:&lt;/b&gt; Quá hạn = LoanItem OPEN và now &amp;gt; dueAt đã lưu; không tính từ ngày mượn + mặc định 4 ngày.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lỗi / ngoại lệ:&lt;/b&gt; Thay quy định không thay dueAt cũ. Job chậm không làm mất trạng thái quá hạn vì trạng thái là phép tính.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Kết quả / bất biến:&lt;/b&gt; Dữ liệu và phí dự kiến không được dùng như khoản phải thu đã xác nhận.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="9104" y="14708" width="570" height="646" /></mxCell><mxCell id="card_ST_F20" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#A8BACB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="15633" width="1197" height="849" /></mxCell><mxCell id="board_183" value="CHI TIẾT • ST_F20 F20 — Xuất dữ liệu CSV" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=22;fontStyle=1;fillColor=#EAF2F8;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="112" y="15643" width="1173" height="80" /></mxCell><mxCell id="content_card_ST_F20" value="" style="group;" vertex="1" parent="1"><mxGeometry as="geometry" x="120" y="15738" width="557" height="709" /></mxCell><mxCell id="card_ST_F20__title" value="F20 — Xuất dữ liệu CSV" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="content_card_ST_F20"><mxGeometry x="24" y="16" width="466.56" height="40" as="geometry" /></mxCell><mxCell id="card_ST_F20__n0" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;ellipse;fillColor=#243444;" vertex="1" parent="content_card_ST_F20"><mxGeometry x="274.87" y="90.00000000000001" width="12.959999999999999" height="12.959999999999999" as="geometry" /></mxCell><mxCell id="card_ST_F20__n1" value="QUEUED" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_ST_F20"><mxGeometry x="240.57999999999998" y="151.96000000000004" width="81.54" height="36" as="geometry" /></mxCell><mxCell id="card_ST_F20__n2" value="RUNNING" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_ST_F20"><mxGeometry x="180.0564" y="247.96000000000004" width="86.5872" height="36" as="geometry" /></mxCell><mxCell id="card_ST_F20__n3" value="READY" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_ST_F20"><mxGeometry x="70.00048" y="343.96000000000004" width="70.70904" height="36" as="geometry" /></mxCell><mxCell id="card_ST_F20__n4" value="FAILED" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFF