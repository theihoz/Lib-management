ntFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;endArrow=none;" edge="1" parent="content_card_Class_Loan_Hold" source="card_Class_Loan_Hold__n7" target="card_Class_Loan_Hold__n4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="311.65999999999997" y="505.43000000000006" /><mxPoint x="295" y="544.53" /></Array></mxGeometry></mxCell><mxCell id="card_Class_Loan_Hold__label8" value="0..1 fulfilled item — 0..1" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_Class_Loan_Hold"><mxGeometry x="352.91999999999996" y="539.9000000000001" width="156.20000000000002" height="17" as="geometry" /></mxCell><mxCell id="card_Class_Loan_Hold__e8" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;endArrow=none;" edge="1" parent="content_card_Class_Loan_Hold" source="card_Class_Loan_Hold__n2" target="card_Class_Loan_Hold__n4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="391.89" y="532.48" /><mxPoint x="362.3" y="556.59" /></Array></mxGeometry></mxCell><mxCell id="card_Class_Loan_Hold__note" value="LoanItem OPEN xác định bằng closedAt IS NULL. Không lưu lại tổng dư nợ như nguồn chân lý; tính từ ledger." style="text;html=1;fontFamily=Arial;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="content_card_Class_Loan_Hold"><mxGeometry x="24" y="752.6" width="666.11" height="70" as="geometry" /></mxCell><mxCell id="board_54" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Mục đích:&lt;/b&gt; UML chi tiết — Lưu thông&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; Hộp lớp gồm tên và thuộc tính. Bội số ở liên kết cho biết số đối tượng được phép liên quan; đây là mô hình miền, không là flow.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách hoạt động:&lt;/b&gt; Một Loan có nhiều LoanItem; item OPEN khi closedAt chưa có. Copy chỉ có tối đa một item OPEN. Reservation xếp FIFO theo edition, sau đó gán copy và hạn READY; nhận sách gắn fulfilledLoanItemId. ReturnEvent là bằng chứng trả. PolicyVersion giữ quy tắc lúc phát sinh để thay đổi cấu hình không sửa hạn cũ.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lưu ý / ràng buộc:&lt;/b&gt; LoanItem OPEN xác định bằng closedAt IS NULL. Không lưu lại tổng dư nợ như nguồn chân lý; tính từ ledger.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="6820" y="7126" width="570" height="898" /></mxCell><mxCell id="card_Class_Finance" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#A8BACB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="7485" y="7021" width="1191" height="1034" /></mxCell><mxCell id="board_56" value="CHI TIẾT • Class_Finance UML chi tiết — Sổ phí" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=22;fontStyle=1;fillColor=#EAF2F8;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="7497" y="7031" width="1167" height="80" /></mxCell><mxCell id="content_card_Class_Finance" value="" style="group;" vertex="1" parent="1"><mxGeometry as="geometry" x="7505" y="7126" width="551" height="894" /></mxCell><mxCell id="card_Class_Finance__title" value="UML chi tiết — Sổ phí" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="content_card_Class_Finance"><mxGeometry x="24" y="16" width="460.8" height="40" as="geometry" /></mxCell><mxCell id="card_Class_Finance__n0" value="&lt;b&gt;Reader&lt;/b&gt;&lt;hr&gt;+id: UUID" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=0;align=left;spacing=6;" ve