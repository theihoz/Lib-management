ative="1" as="geometry"><Array as="points"><mxPoint x="426.47" y="761.43" /><mxPoint x="427.13" y="780.43" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F20__label9" value="[lỗi / rollback nếu có ghi DB]" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_AD_F20"><mxGeometry x="263.57" y="766.66" width="179.0" height="17" as="geometry" /></mxCell><mxCell id="card_AD_F20__e9" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F20" source="card_AD_F20__n7" target="card_AD_F20__n4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="315.87" y="757.91" /><mxPoint x="288.32" y="769.16" /><mxPoint x="288.32" y="769.16" /><mxPoint x="288.32" y="769.16" /><mxPoint x="260.72" y="785.15" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F20__e10" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F20" source="card_AD_F20__n8" target="card_AD_F20__n9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="369.89" y="871.3" /><mxPoint x="340.45" y="891.3779999999999" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F20__note" value="Vai trò hành động ghi trong nút; nhánh lỗi kết thúc yêu cầu, dữ liệu không ghi một phần." style="text;html=1;fontFamily=Arial;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="content_card_AD_F20"><mxGeometry x="24" y="962.92" width="596.38" height="70" as="geometry" /></mxCell><mxCell id="board_286" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chức năng:&lt;/b&gt; F20 ↔ UC15 — Xuất dữ liệu CSV&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Người thao tác:&lt;/b&gt; Quản lý theo nguồn yêu cầu&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chủ thể / phạm vi:&lt;/b&gt; Một lần thực hiện chức năng; từ bắt đầu đến kết quả&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; Đọc theo mũi tên; chữ nhật là hoạt động, hình thoi chọn nhánh theo guard. Nhánh lỗi phải sửa hoặc kết thúc; không bỏ qua bước kiểm tra.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Hoạt động:&lt;/b&gt; Kiểm tra quyền và phạm vi dữ liệu; tạo job idempotent. → Chụp bộ lọc/snapshot; tạo CSV UTF-8 và chống công thức khi mở bảng tính. → Lưu artifact private, hash, số dòng và hạn tải. → Kiểm tra quyền lần nữa khi tải; trả signed URL ngắn hạn hoặc stream.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Quy tắc đề xuất:&lt;/b&gt; Baseline CSV khoản mượn/phạt; mở quyền Thủ thư hoặc định dạng Excel/PDF cần duyệt vì nguồn mâu thuẫn.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lỗi / ngoại lệ:&lt;/b&gt; Không export PII ngoài phạm vi; quyền đã bị thu hồi chặn tải. Artifact hết hạn: 410; worker retry giới hạn, không nhân job.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Kết quả / bất biến:&lt;/b&gt; File không công khai; audit người xuất và người tải.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="802" y="21413" width="570" height="1108" /></mxCell><mxCell id="card_AD_F21_" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#A8BACB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="1467" y="21308" width="1314" height="1244" /></mxCell><mxCell id="board_288" value="CHI TIẾT • AD_F21 F21 — Luồng Quản trị tài khoản và vai trò" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=22;fontStyle=1;fillColor=#EAF2F8;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="1479" y="21318" width="1290" height="80" /></mxCell><mxCell id="content_card_AD_F21_" value="" style="group;" vertex="1" parent="1"><mxGeometry as="geometry" x="1487" y="21413" width="674" height="1104" /></mxCell><mxCell id="card_AD_F21___title" value="F21 — Luồng Quản trị tài khoản và vai trò" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="content_card_AD_F21_"><mxGeometry x="24" y="16" width="583.29" height="40" as="geometry" /></mxCell><mxCell id="card_AD_F21___n0" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;ellipse;fillColor=#243444;" vertex="1" parent="content_card_AD_F21_"><mxGeometry x="203.01000000000002" y="90.00000000000001" width="12.959999999999999" height="12.959999999999999" as="geometry" /></mxCell><mxCell id="card_AD_F21___n1" value="Người dùng&lt;br&gt;Mời tài khoản theo directory/issuer được&lt;br&gt;phép." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F21_"><mxGeometry x="76.2396" y="151.96000000000004" width="266.5008" height="65.52" as="geometry" /></mxCell><mxCell id="card_AD_F21___n2" value="API&lt;br&gt;Kiểm tra quyền và input" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F21_"><mxGeometry x="124.638" y="266.48011999999994" width="169.704" height="49.91976" as="geometry" /></mxCell><mxCell id="card_AD_F21___n3" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rhombus;" vertex="1" parent="content_card_AD_F21_"><mxGeometry x="196.89000000000001" y="365.4" width="25.2" height="25.2" as="geometry" /></mxCell><mxCell id="card_AD_F21___n4" value="API&lt;br&gt;Trả lỗi có mã; không ghi dữ liệu" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F21_"><mxGeometry x="70.0024" y="820.76012" width="220.9752" height="49.91976" as="geometry" /></mxCell><mxCell id="card_AD_F21___n5" value="Hệ thống&lt;br&gt;Admin gán các permission theo nhiệm vụ;&lt;br&gt;quản lý thư viện không tự sửa quyền hệ&lt;br&gt;thống." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F21_"><mxGeometry x="261.2472" y="450.5988" width="274.4856" height="81.1224" as="geometry" /></mxCell><mxCell id="card_AD_F21___n6" value="Hệ thống&lt;br&gt;Kích hoạt sau xác minh; thu hồi quyền làm&lt;br&gt;mất hiệu lực các phiên đang dùng." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F21_"><mxGeometry x="283.8364" y="580.72" width="285.3072" height="65.52" as="geometry" /></mxCell><mxCell id="card_AD_F21___n7" value="Hệ thống&lt;br&gt;Khóa hoặc ngừng tài khoản, giữ dấu vết tác&lt;br&gt;giả của giao dịch lịch sử." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F21_"><mxGeometry x="275.684" y="695.24" width="297.61199999999997" height="65.52" as="geometry" /></mxCell><mxCell id="card_AD_F21___n8" value="API&lt;br&gt;Trả kết quả và mã yêu cầu" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F21_"><mxGeometry x="327.3728" y="820.76012" width="194.23440000000002" height="49.91976" as="geometry" /></mxCell><mxCell id="card_AD_F21___n9" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;shape=doubleEllipse;fillColor=#243444;" vertex="1" parent="content_card_AD_F21_"><mxGeometry x="289.57004" y="919.6800400000001" width="23.83992" height="23.83992" as="geometry" /></mxCell><mxCell id="card_AD_F21___e0" v