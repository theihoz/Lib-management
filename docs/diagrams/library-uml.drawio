><mxPoint x="1444.9" y="559.5100000000001" /><mxPoint x="1519.1" y="518.9000000000001" /></Array></mxGeometry></mxCell><mxCell id="card_OV_ERD__label25" value="1 : N" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_OV_ERD"><mxGeometry x="1491.15" y="640.8000000000001" width="36.5" height="17" as="geometry" /></mxCell><mxCell id="card_OV_ERD__e25" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;endArrow=none;" edge="1" parent="content_card_OV_ERD" source="card_OV_ERD__n19" target="card_OV_ERD__n21"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1447.7" y="646.0700000000002" /><mxPoint x="1528" y="677.72" /></Array></mxGeometry></mxCell><mxCell id="card_OV_ERD__label26" value="1 : N" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_OV_ERD"><mxGeometry x="1491.15" y="715.7" width="36.5" height="17" as="geometry" /></mxCell><mxCell id="card_OV_ERD__e26" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;endArrow=none;" edge="1" parent="content_card_OV_ERD" source="card_OV_ERD__n20" target="card_OV_ERD__n21"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1434" y="730.2" /><mxPoint x="1523" y="730.2" /></Array></mxGeometry></mxCell><mxCell id="card_OV_ERD__label27" value="1 : N" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_OV_ERD"><mxGeometry x="555.39" y="697.8100000000002" width="36.5" height="17" as="geometry" /></mxCell><mxCell id="card_OV_ERD__e27" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;endArrow=none;" edge="1" parent="content_card_OV_ERD" source="card_OV_ERD__n22" target="card_OV_ERD__n1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="545.6" y="708.3200000000002" /><mxPoint x="604.05" y="721.3400000000001" /></Array></mxGeometry></mxCell><mxCell id="card_OV_ERD__label28" value="1 : N created_by" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_OV_ERD"><mxGeometry x="1459.8000000000002" y="594.7" width="99.2" height="17" as="geometry" /></mxCell><mxCell id="card_OV_ERD__e28" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;endArrow=none;" edge="1" parent="content_card_OV_ERD" source="card_OV_ERD__n19" target="card_OV_ERD__n26"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1448.2" y="609.2" /><mxPoint x="1529.6" y="609.2" /></Array></mxGeometry></mxCell><mxCell id="card_OV_ERD__note" value="Bổ sung các bảng đã nêu trong từ điển dữ liệu. Audit/Outbox dùng tham chiếu đa hình, không vẽ FK giả; Idempotency độc lập theo scope+key. Các cột tối thiểu của phần bổ sung là thiết kế đề xuất, cần migration chi tiết. Không xóa lịch sử; tiền VND dùng số nguyên." style="text;html=1;fontFamily=Arial;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="content_card_OV_ERD"><mxGeometry x="24" y="1180.4" width="1780" height="70" as="geometry" /></mxCell><mxCell id="board_63" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Mục đích:&lt;/b&gt; ERD — Tổng quát dữ liệu nghiệp vụ và dữ liệu vận hành&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; PK = khóa chính; FK = tham chiếu; UQ = duy nhất; ? = tùy chọn. Nhãn bội số phản ánh quan hệ, không phải thứ tự gọi.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách hoạt động:&lt;/b&gt; Đọc PK để nhận diện, FK để theo tham chiếu và UQ để hiểu chống trùng. Bảng nối xử lý quan hệ nhiều–nhiều. Lưu thông / tài chính giữ lịch sử; outbox ghi cùng transaction với nghiệp vụ. Audit và outbox tham chiếu đa hình; không có FK đa hình giả. Các bảng vận hành và cột bổ sung là mô hình logic đề xuất, cần migration cụ thể.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lưu ý / ràng buộc:&lt;/b&gt; Bổ sung các bảng đã nêu trong từ điển dữ liệu. Audit/Outbox dùng tham chiếu đa hình, không vẽ FK giả; Idempotency độc lập theo scope+key. Các cột tối thiểu của phần bổ sung là thiết kế đề xuất, cần migration chi tiết. Không xóa lịch sử; tiền VND dùng số nguyên.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="1985" y="9006" width="570" height="1326" /></mxCell><mxCell id="card_ERD" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#A8BACB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="2650" y="8901" width="2025" height="1140" /></mxCell><mxCell id="board_65" value="CHI TIẾT • ERD ERD — Khóa và liên kết cốt lõi" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=22;fontStyle=1;fillColor=#EAF2F8;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="2662" y="8911" width="2001" height="80" /></mxCell><mxCell id="content_card_ERD" value="" style="group;" vertex="1" parent="1"><mxGeometry as="geometry" x="2670" y="9006" width="1385" height="1000" /></mxCell><mxCell id="card_ERD__title" value="ERD — Khóa và liên kết cốt lõi" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="content_card_ERD"><mxGeometry x="24" y="16" width="1294.7" height="40" as="geometry" /></mxCell><mxCell id="card_ERD__n0" value="&lt;b&gt;book_editions&lt;/b&gt;&lt;hr&gt;PK id&lt;br&gt;UQ isbn (non-null)&lt;br&gt;FK publisher_id" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=0;align=left;spacing=6;" vertex="1" parent="content_card_ERD"><mxGeometry x="70.0002" y="90.00120000000004" width="121.4856" height="92.39760000000001" as="geometry" /></mxCell><mxCell id="card_ERD__n1" value="&lt;b&gt;book_copies&lt;/b&gt;&lt;hr&gt;PK id&lt;br&gt;UQ barcode&lt;br&gt;FK edition_id" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=0;align=left;spacing=6;" vertex="1" parent="content_card_ERD"><mxGeometry x="273.2476" y="178.00120000000004" width="95.46480000000001" height="92.39760000000001" as="geometry" /></mxCell><mxCell id="card_ERD__n2" value="&lt;b&gt;readers&lt;/b&gt;&lt;hr&gt;PK id" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=0;align=left;spacing=6;" vertex="1" parent="content_card_ERD"><mxGeometry x="99.25344" y="603.6" width="62.97912" height="61.199999999999996" as="geometry" /></mxCell><mxCell id="card_ERD__n3" value="&lt;b&gt;reader_cards&lt;/b&gt;&lt;hr&gt;PK id&lt;br&gt;FK reader_id" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=0;align=left;spacing=6;" vertex="1" parent="content_card_ERD"><mxGeometry x="272.14599999999996" y="762.7988" width="97.668" height="76.8024" as="geometry" /></mxCell><mxCell id="card_ERD__n4" value="&lt;b&gt;loans&lt;/b&gt;&lt;hr&gt;PK id&lt;br&gt;FK reader_id" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=0;align=left;spacing=6;" vertex="1" parent="content_card_ERD"><mxGeometry x="275.404" y="389.7988" width="91.152" height="76.8024" as="geometry" /></mxCell><mxCell id="card_ERD__n5" value="&lt;b&gt;loan_items&lt;/b&gt;&lt;hr&gt;PK id&lt;br&gt;FK loan_id, copy_id, policy_id&lt;br&gt;UQ copy_id WHERE closed_at IS&lt;br&gt;NULL" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=0;align=left;spacing=6;" vertex="1" parent="