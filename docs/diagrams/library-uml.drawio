.5600000000001" /><mxPoint x="279" y="753.5600000000001" /><mxPoint x="252.95" y="769.4100000000001" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F04__e10" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F04" source="card_AD_F04__n8" target="card_AD_F04__n9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="365.57" y="855.7" /><mxPoint x="336.13" y="875.778" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F04__note" value="Vai trò hành động ghi trong nút; nhánh lỗi kết thúc yêu cầu, dữ liệu không ghi một phần." style="text;html=1;fontFamily=Arial;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="content_card_AD_F04"><mxGeometry x="24" y="947.32" width="590.73" height="70" as="geometry" /></mxCell><mxCell id="board_222" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chức năng:&lt;/b&gt; F04 ↔ UC1.1 — Quản lý tác giả&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Người thao tác:&lt;/b&gt; Thủ thư&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chủ thể / phạm vi:&lt;/b&gt; Một lần thực hiện chức năng; từ bắt đầu đến kết quả&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; Đọc theo mũi tên; chữ nhật là hoạt động, hình thoi chọn nhánh theo guard. Nhánh lỗi phải sửa hoặc kết thúc; không bỏ qua bước kiểm tra.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Hoạt động:&lt;/b&gt; Tìm tác giả trước khi tạo. → Nhập tên và thông tin phân biệt; cho phép người trùng tên. → Lưu Author; liên kết với đầu sách qua BookAuthor. → Xóa chỉ khi chưa được tham chiếu; hợp nhất là thao tác riêng có audit.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Quy tắc đề xuất:&lt;/b&gt; Tên không phải khóa định danh; Author–BookEdition là quan hệ nhiều–nhiều.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lỗi / ngoại lệ:&lt;/b&gt; Thiếu tên: 422; đang tham chiếu: 409. Không tự hợp nhất theo tên.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Kết quả / bất biến:&lt;/b&gt; Không mất tác giả của các đầu sách khác khi sửa liên kết.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="7005" y="16926" width="570" height="1093" /></mxCell><mxCell id="card_AD_F05" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#A8BACB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="7670" y="16821" width="1279" height="1166" /></mxCell><mxCell id="board_224" value="CHI TIẾT • AD_F05 F05 — Luồng Quản lý nhà xuất bản" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=22;fontStyle=1;fillColor=#EAF2F8;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="7682" y="16831" width="1255" height="80" /></mxCell><mxCell id="content_card_AD_F05" value="" style="group;" vertex="1" parent="1"><mxGeometry as="geometry" x="7690" y="16926" width="639" height="1026" /></mxCell><mxCell id="card_AD_F05__title" value="F05 — Luồng Quản lý nhà xuất bản" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="content_card_AD_F05"><mxGeometry x="24" y="16" width="548.46" height="40" as="geometry" /></mxCell><mxCell id="card_AD_F05__n0" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;ellipse;fillColor=#243444;" vertex="1" parent="content_card_AD_F05"><mxGeometry x="204.01000000000002" y="90.00000000000001" width="12.959999999999999" height="12.959999999999999" as="geometry" /></mxCell><mxCell id="card_AD_F05__n1" value="Người dùng&lt;br&gt;Tra cứu nhà xuất bản." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize