<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" agent="Codex" version="29.0.0" pages="1" modified="2026-10-07"><diagram id="library-single-canvas" name="TOÀN BỘ HỆ THỐNG — 1 TRANG"><mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" math="0" shadow="0" pageWidth="10000" pageHeight="39421"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="board_1" value="THIẾT KẾ PHẦN MỀM QUẢN LÝ THƯ VIỆN — TOÀN BỘ TRÊN 1 TRANG" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=36;fontStyle=1;fontColor=#FFFFFF;fillColor=#16324F;strokeColor=none;spacing=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="70" width="9800" height="90" /></mxCell><mxCell id="board_2" value="94 khung trên một canvas: 80 khung gốc + 8 ERD chi tiết + 6 khung kiến trúc/duyệt phí/dữ liệu bổ sung. 10 loại sơ đồ có tổng quát; State và Activity riêng từng F01–F24. Thuộc tính chi tiết theo DOCX; ARCHIVE giữ lịch sử. Tất cả cell chỉnh sửa được." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=22;fillColor=#EAF2F8;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="180" width="9800" height="85" /></mxCell><mxCell id="board_3" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Hướng đọc:&lt;/b&gt; Từ vùng 01 đến 10: tổng quát trước, chi tiết sau. Mỗi khung: sơ đồ bên trái, cách hoạt động bên phải. Vùng 11 là nguồn lịch sử. Đây là một trang canvas lớn; phóng to 100% để đọc, không phải bố cục giấy A4.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Quy ước:&lt;/b&gt; F = chức năng; UC = mục tiêu sử dụng; * = phạm vi mở rộng chưa chốt. [guard] = điều kiện; / action = hành động sau chuyển trạng thái. Thiết kế và quy tắc dưới đây là baseline đề xuất, chưa thay thế quyết định của chủ nghiệp vụ.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Bất biến:&lt;/b&gt; Một item OPEN trên mỗi copy; trả sách độc lập thu phí; giữ chỗ FIFO theo edition; sổ phí giữ lịch sử; idempotency chống lặp lệnh; audit + outbox cùng commit; tích hợp ngoài chạy sau commit.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=20;fillColor=#FFFFFF;strokeColor=#CCD8E4;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="290" width="9800" height="200" /></mxCell><mxCell id="board_4" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Quyết định nghiệp vụ đã duyệt:&lt;/b&gt; C01: Không nợ hay dưới 50.000 → đề xuất không nợ. C02: 4 cuốn / phiếu; chưa bật giới hạn tổng đang mượn/giữ. C03: Thủ thư đề xuất, Quản lý quyết định; PENDING chặn mượn/gia hạn/đặt trước, không chặn trả. C04: 4 ngày, gia hạn một lần thêm 4 ngày từ hạn cũ. C05: Quản lý xuất CSV; Excel / PDF chờ duyệt. C06: Keycloak, nhân viên cấp tài khoản; độc giả chỉ xem dữ liệu của mình. C07: Giữ READY 3 ngày từ readyAt. C08: Phạt theo ngày địa phương; trễ cùng ngày có thể phí 0. C09: Năm xuất bản từ currentYear − 8 đến currentYear, gồm hai biên. C01–C09 và F01–F24 đã được người dùng duyệt; phí hỏng/mất do Quản lý xác nhận trước khi ghi sổ.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=20;fillColor=#FFF7E8;strokeColor=#D7A34A;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="520" width="9800" height="120" /></mxCell><mxCell id="board_5" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Mục lục trên cùng trang:&lt;/b&gt; 01 — USE CASE [Y≈930] • 02 — KIẾN TRÚC / NGỮ CẢNH [Y≈3924] • 03 — THÀNH PHẦN [Y≈4752] • 04 — TRIỂN KHAI [Y≈5905] • 05 — UML LỚP [Y≈6891] • 06 — MÔ HÌNH DỮ LIỆU [Y≈8771] • 07 — LUỒNG DỮ LIỆU [Y≈10447] • 08 — TRẠNG THÁI [Y≈12524] • 09 — HOẠT ĐỘNG / FLOW [Y≈16691] • 10 — TUẦN TỰ [Y≈22668] • 11 — SƠ ĐỒ GỐC THAM KHẢO [Y≈26001]&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Truy vết:&lt;/b&gt; 24 chức năng F01–F24 nối UC tương ứng ở chú giải State / Activity. Các vùng lớp, dữ liệu và sequence mô tả cùng các đối tượng. Tổng quát không thay thế chi tiết hoặc biến quan hệ dữ liệu thành thứ tự thực hiện.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=20;fillColor=#F1F5F9;strokeColor=#CCD8E4;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="670" width="9800" height="180" /></mxCell><mxCell id="board_6" value="&lt;b&gt;01 — USE CASE&lt;/b&gt;&lt;br&gt;Vai trò → mục tiêu sử dụng; tổng quát trước, phân nhóm sau." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=24;fillColor=#16324F;fontColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="930" width="9800" height="95" /></mxCell><mxCell id="card_OV_UC" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#A8BACB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="1060" width="1673" height="2764" /></mxCell><mxCell id="board_8" value="TỔNG QUÁT TOÀN HỆ THỐNG • OV_UC UC — Tổng quát toàn hệ thống: vai trò và mục tiêu" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=22;fontStyle=1;fillColor=#DDF2E7;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="112" y="1070" width="1649" height="80" /></mxCell><mxCell id="content_card_OV_UC" value="" style="group;" vertex="1" parent="1"><mxGeometry as="geometry" x="120" y="1165" width="1033" height="2624" /></mxCell><mxCell id="card_OV_UC__title" value="UC — Tổng quát toàn hệ thống: vai trò và mục tiêu" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="content_card_OV_UC"><mxGeometry x="24" y="16" width="942.39" height="40" as="geometry" /></mxCell><mxCell id="card_OV_UC__boundary" value="Phần mềm quản lý thư viện" style="rounded=0;html=1;fillColor=none;strokeColor=#657585;verticalAlign=top;align=left;fontSize=16;" vertex="1" parent="content_card_OV_UC"><mxGeometry x="282.84000000000003" y="98" width="641.55" height="2358" as="geometry" /></mxCell><mxCell id="card_OV_UC__n1" value="«actor»&lt;br&gt;Thủ thư" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=0;align=center;" vertex="1" parent="content_card_OV_UC"><mxGeometry x="114.0772" y="887.40012" width="83.68560000000001" height="67.19976" as="geometry" /></mxCell><mxCell id="card_OV_UC__n2" value="«actor»&lt;br&gt;Quản lý" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=0;align=center;" vertex="1" parent="content_card_OV_UC"><mxGeometry x="113.3536" y="1737.40012" width="85.13279999999999" height="67.19976" as="geometry" /></mxCell><mxCell id="card_OV_UC__n3" value="«actor»&lt;br&gt;Độc giả" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=0;align=center;" vertex="1" parent="content_card_OV_UC"><mxGeometry x="113.3572" y="1317.40012" width="85.12559999999999" height="67.19976" as="geometry" /></mxCell><mxCell id="card_OV_UC__n4" value="«actor»&lt;br&gt;Admin hệ thống" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=0;align=center;" vertex="1" parent="content_card_OV_UC"><mxGeometry x="88.7836" y="2219.40012" width="134.2728" height="67.19976" as="geometry" /></mxCell><mxCell id="card_OV_UC__n5" value="«actor»&lt;br&gt;Bộ lập lịch vận hành" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=0;align=center;" vertex="1" parent="content_card_OV_UC"><mxGeometry x="69.9988" y="2379.40012" width="171.8424" height="67.19976" as="geometry" /></mxCell><mxCell id="card_OV_UC__n6" value="UC0&lt;br&gt;Đăng nhập" style="html