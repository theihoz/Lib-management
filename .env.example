# Copy to .env and replace this LOCAL password before starting.
# Single-quote passwords containing $ so Compose preserves literal characters.
POSTGRES_USER=lib_dev
POSTGRES_DB=lib_management
POSTGRES_PASSWORD='replace-with-a-local-password'
POSTGRES_PORT=5432
API_PORT=8000
# Optional OIDC (Keycloak). Empty = business routes answer 503; health still works.
OIDC_ISSUER=
OIDC_JWKS_URL=
# Full local stack (scripts/local.sh up) appends random KEYCLOAK_ADMIN_PASSWORD and
# KEYCLOAK_DEV_USER_PASSWORD here. Change KEYCLOAK_PORT if 8080 is taken.
KEYCLOAK_PORT=8080
