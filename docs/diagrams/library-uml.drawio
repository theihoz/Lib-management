_ST_F13__e5" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F13" source="card_ST_F13__n4" target="card_ST_F13__n6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="228.86" y="412.93" /><mxPoint x="202.57" y="483.97400000000005" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F13__label6" value="at(expiresAt) / xóa artifact" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_ST_F13"><mxGeometry x="77.592" y="401.46000000000004" width="167.6" height="17" as="geometry" /></mxCell><mxCell id="card_ST_F13__e6" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F13" source="card_ST_F13__n3" target="card_ST_F13__n5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="104.714" y="391.35" /><mxPoint x="104.429" y="403.96000000000004" /><mxPoint x="104.429" y="403.96000000000004" /><mxPoint x="104.429" y="403.96000000000004" /><mxPoint x="104.429" y="415.96000000000004" /><mxPoint x="104.429" y="415.96000000000004" /><mxPoint x="104.429" y="415.96000000000004" /><mxPoint x="107.36" y="423.51" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F13__e7" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F13" source="card_ST_F13__n5" target="card_ST_F13__n6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="145.555" y="489.72900000000004" /><mxPoint x="160.428" y="507.88800000000003" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F13__note" value="ReportJob" style="text;html=1;fontFamily=Arial;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="content_card_ST_F13"><mxGeometry x="24" y="583.8" width="486.56" height="70" as="geometry" /></mxCell><mxCell id="board_157" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chức năng:&lt;/b&gt; F13 ↔ UC16 — Thống kê và báo cáo&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Người thao tác:&lt;/b&gt; Quản lý; Thủ thư&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chủ thể / phạm vi:&lt;/b&gt; ReportJob&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; Nút = trạng thái của chủ thể; cạnh = sự kiện [điều kiện] / hành động. Nút đen bắt đầu; nút kép kết thúc phiên được mô tả.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Hoạt động:&lt;/b&gt; Chọn kỳ và loại báo cáo; kiểm tra quyền và ngày. → Tạo job với phạm vi và mốc snapshot. → Tổng hợp số phiếu, mục mượn, tình trạng bản sao, phí và tiền thu riêng. → Tạo bản xem/biểu mẫu và lưu nguồn, bộ lọc, thời điểm dữ liệu.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Quy tắc đề xuất:&lt;/b&gt; Khoảng từ&amp;lt;=đến&amp;lt;=hôm nay; múi giờ Asia/Ho_Chi_Minh; định nghĩa rõ số phiếu khác số cuốn.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lỗi / ngoại lệ:&lt;/b&gt; Không có dữ liệu là báo cáo rỗng, không phải lỗi. Job thất bại chỉ retry lỗi tạm; không lặp vô hạn.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Kết quả / bất biến:&lt;/b&gt; Tổng chi tiết khớp tổng hợp cùng snapshot; không nhân bản tiền do join nhiều LoanItem.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="692" y="14708" width="570" height="729" /></mxCell><mxCell id="card_ST_F14" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#A8BACB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="1357" y="14603" width="1209" height="970" /></mxCell><mxCell id="board_159" value="CHI TIẾT • ST_F14 F14 — Cấu hình quy định" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=22;fontStyle=1;fillColor=#EAF2F8;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="1369" y="14613" width="1185" height="80" /></mxCell><mxCell id="content_card_ST_F14" value="" style="group;" vertex="1" parent="1"><mxGeometry as="geometry" x="1377" y="14708" width="569" height="830" /></mxCell><mxCell id="card_ST_F14__title" value="F14 — Cấu hình quy định" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="content_card_ST_F14"><mxGeometry x="24" y="16" width="478.23" height="40" as="geometry" /></mxCell><mxCell id="card_ST_F14__n0" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;ellipse;fillColor=#243444;" vertex="1" parent="content_card_ST_F14"><mxGeometry x="239.13000000000002" y="90.00000000000001" width="12.959999999999999" height="12.959999999999999" as="geometry" /></mxCell><mxCell id="card_ST_F14__n1" value="DRAFT" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_ST_F14"><mxGeometry x="210.98556000000002" y="151.95999999999998" width="69.24888" height="36" as="geometry" /></mxCell><mxCell id="card_ST_F14__n2" value="VALIDATING" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_ST_F14"><mxGeometry x="70.002" y="247.95999999999998" width="103.212" height="36" as="geometry" /></mxCell><mxCell id="card_ST_F14__n3" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rhombus;" vertex="1" parent="content_card_ST_F14"><mxGeometry x="230.01000000000002" y="343.9599999999999" width="25.2" height="25.2" as="geometry" /></mxCell><mxCell id="card_ST_F14__n4" value="SCHEDULED" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_ST_F14"><mxGeometry x="249.5568" y="429.15999999999997" width="106.10640000000001" height="36" as="geometry" /></mxCell><mxCell id="card_ST_F14__n5" value="ACTIVE" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_ST_F14"><mxGeometry x="266.1744" y="537.16" width="72.8712" height="36" as="geometry" /></mxCell><mxCell id="card_ST_F14__n6" value="SUPERSEDED" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_ST_F14"><mxGeometry x="244.8624" y="633.16" width="115.49520000000001" height="36" as="geometry" /></mxCell><mxCell id="card_ST_F14__e0" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F14" source="card_ST_F14__n0" target="card_ST_F14__n1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="245.61" y="111.73000000000002" /><mxPoint x="245.61" y="128.81999999999994" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F14__label1" value="gửi duyệt" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_ST_F14"><mxGeometry x="164.89" y="209.45999999999998" width="59.300000000000004" height="17" as="geometry" /></mxCell><mxCell id="card_ST_F14__e1" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F14" source="card_ST_F14__n1" target="card_ST_F14__n2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="193.95999999999998" y="199.51999999999998" /><mxPoint x="171.47" y="211.95999999999998" /><mxPoint x="171.47" y="211.95999999999998" /><mxPoint x="171.47" y="211.9599