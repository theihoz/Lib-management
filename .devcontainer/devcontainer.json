{
  "name": "Lib-management — Python + Node + PostgreSQL",
  "initializeCommand": [
    "docker",
    "run",
    "--rm",
    "--mount",
    "type=bind,source=${localWorkspaceFolder},target=/workspace",
    "--env",
    "LOCAL_WORKSPACE_HOST=${localWorkspaceFolder}",
    "python:3.13-slim-bookworm@sha256:a1165e272e578941b84abc79e4ab38a0305cd12803a5c4247979ac7655f4d641",
    "python",
    "/workspace/.devcontainer/prepare.py"
  ],
  "dockerComposeFile": [
    "compose.yaml",
    "workspace.generated.json"
  ],
  "service": "workspace",
  "workspaceFolder": "/workspaces/lib-management",
  "remoteUser": "developer",
  "overrideCommand": false,
  "shutdownAction": "stopCompose",
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "forwardPorts": [
    8000,
    5173,
    8080
  ],
  "portsAttributes": {
    "8000": { "label": "API (FastAPI)" },
    "5173": { "label": "Web (Vite)" },
    "8080": { "label": "Keycloak (dev only)" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "openai.chatgpt",
        "Anthropic.claude-code"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/home/developer/.venv/bin/python",
        "editor.formatOnSave": true,
        "[python]": { "editor.defaultFormatter": "charliermarsh.ruff" },
        "[typescript][typescriptreact][json][yaml]": { "editor.defaultFormatter": "esbenp.prettier-vscode" }
      }
    }
  },
  "updateRemoteUserUID": true
}
