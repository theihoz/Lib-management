"><mxGeometry x="412.5" y="216" width="380" height="36" as="geometry" /></mxCell><mxCell id="card_SD_Catalog__m3" value="" style="endArrow=classic;endFill=1;strokeColor=#344454;" edge="1" parent="content_card_SD_Catalog"><mxGeometry relative="1" as="geometry"><mxPoint x="542.5" y="316" as="sourcePoint" /><mxPoint x="747.5" y="316" as="targetPoint" /></mxGeometry></mxCell><mxCell id="card_SD_Catalog__l3" value="4. INSERT edition + liên kết; COMMIT" style="text;html=1;fontSize=12;whiteSpace=wrap;align=center;fillColor=#FFFFFF;" vertex="1" parent="content_card_SD_Catalog"><mxGeometry x="455" y="273" width="380" height="36" as="geometry" /></mxCell><mxCell id="card_SD_Catalog__m4" value="" style="endArrow=classic;endFill=1;strokeColor=#344454;" edge="1" parent="content_card_SD_Catalog"><mxGeometry relative="1" as="geometry"><mxPoint x="542.5" y="373" as="sourcePoint" /><mxPoint x="337.5" y="373" as="targetPoint" /></mxGeometry></mxCell><mxCell id="card_SD_Catalog__l4" value="5. 201 editionId" style="text;html=1;fontSize=12;whiteSpace=wrap;align=center;fillColor=#FFFFFF;" vertex="1" parent="content_card_SD_Catalog"><mxGeometry x="250" y="330" width="380" height="36" as="geometry" /></mxCell><mxCell id="card_SD_Catalog__m5" value="" style="endArrow=classic;endFill=1;strokeColor=#344454;" edge="1" parent="content_card_SD_Catalog"><mxGeometry relative="1" as="geometry"><mxPoint x="132.5" y="430" as="sourcePoint" /><mxPoint x="337.5" y="430" as="targetPoint" /></mxGeometry></mxCell><mxCell id="card_SD_Catalog__l5" value="6. Thêm các bản sao" style="text;html=1;fontSize=12;whiteSpace=wrap;align=center;fillColor=#FFFFFF;" vertex="1" parent="content_card_SD_Catalog"><mxGeometry x="45" y="387" width="380" height="36" as="geometry" /></mxCell><mxCell id="card_SD_Catalog__m6" value="" style="endArrow=classic;endFill=1;strokeColor=#344454;" edge="1" parent="content_card_SD_Catalog"><mxGeometry relative="1" as="geometry"><mxPoint x="337.5" y="487" as="sourcePoint" /><mxPoint x="542.5" y="487" as="targetPoint" /></mxGeometry></mxCell><mxCell id="card_SD_Catalog__l6" value="7. POST /book-editions/{id}/copies + key" style="text;html=1;fontSize=12;whiteSpace=wrap;align=center;fillColor=#FFFFFF;" vertex="1" parent="content_card_SD_Catalog"><mxGeometry x="250" y="444" width="380" height="36" as="geometry" /></mxCell><mxCell id="card_SD_Catalog__m7" value="" style="endArrow=classic;endFill=1;strokeColor=#344454;" edge="1" parent="content_card_SD_Catalog"><mxGeometry relative="1" as="geometry"><mxPoint x="542.5" y="544" as="sourcePoint" /><mxPoint x="747.5" y="544" as="targetPoint" /></mxGeometry></mxCell><mxCell id="card_SD_Catalog__l7" value="8. BEGIN; kiểm tra barcode UQ; INSERT copies" style="text;html=1;fontSize=12;whiteSpace=wrap;align=center;fillColor=#FFFFFF;" vertex="1" parent="content_card_SD_Catalog"><mxGeometry x="455" y="501" width="380" height="36" as="geometry" /></mxCell><mxCell id="card_SD_Catalog__m8" value="" style="endArrow=classic;endFill=1;strokeColor=#344454;" edge="1" parent="content_card_SD_Catalog"><mxGeometry relative="1" as="geometry"><mxPoint x="747.5" y="601" as="sourcePoint" /><mxPoint x="542.5" y="601" as="targetPoint" /></mxGeometry></mxCell><mxCell id="card_SD_Catalog__l8" value="9. COMMIT hoặc conflict" style="text;html=1;fontSize=12;whiteSpace=wrap;align=center;fillColor=#FFFFFF;" vertex="1" parent="content_card_SD_Catalog"><mxGeometry x="455" y="558" width="380" height="36" as="geometry" /></mxCell><mxCell id="card_SD_Catalog__m9" value="" style="endArrow=classic;endFill=1;strokeColor=#344454;" edge="1" parent="content_card_SD_Catalog"><mxGeometry relative="1" as="geometry"><mxPoint x="542.5" y="658" as="sourcePoint" /><mxPoint x="337.5" y="658" as="targetPoint" /></mxGeometry></mxCell><mxCell id="card_SD_Catalog__l9" value="10. 201 copies / alt 409 duplicate" style="text;html=1;fontSize=12;whiteSpace=wrap;align=center;fillColor=#FFFFFF;" vertex="1" parent="content_card_SD_Catalog"><mxGeometry x="250" y="615" width="380" height="36" as="geometry" /></mxCell><mxCell id="card_SD_Catalog__note" value="ISBN định danh ấn bản; barcode định danh bản sao. Không tái dùng thuật toán đầu sách cho bản sao." style="text;html=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="content_card_SD_Catalog"><mxGeometry x="25" y="730" width="810" height="60" as="geometry" /></mxCell><mxCell id="board_319" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Mục đích:&lt;/b&gt; Sequence — UC1/UC2 đầu sách và bản sao&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; Cột là participant, nét đứt là lifeline; thời gian từ trên xuống. alt = chọn một nhánh; critical = vùng nguyên tử; opt = có điều kiện.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách hoạt động:&lt;/b&gt; UI gửi thêm / sửa đầu sách hoặc bản sao; API kiểm tra schema và quyền. Domain kiểm tra ISBN, mã vạch, tham chiếu và version; DB cưỡng chế unique. Ghi bản ghi và audit cùng transaction. Xung đột phiên bản / khóa duy nhất trả 409 để tải lại; sai dữ liệu trả 422.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lưu ý / ràng buộc:&lt;/b&gt; ISBN định danh ấn bản; barcode định danh bản sao. Không tái dùng thuật toán đầu sách cho bản sao.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="6780" y="22903" width="570" height="845" /></mxCell><mxCell id="card_SD_Checkout" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#A8BACB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="7445" y="22798" width="1725" height="1022" /></mxCell><mxCell id="board_321" value="CHI TIẾT • SD_Checkout Sequence — UC6 cho mượn nguyên tử" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=22;fontStyle=1;fillColor=#EAF2F8;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="7457" y="22808" width="1701" height="80" /></mxCell><mxCell id="content_card_SD_Checkout" value="" style="group;" vertex="1" parent="1"><mxGeometry as="geometry" x="7465" y="22903" width="1085" height="882" /></mxCell><mxCell id="card_SD_Checkout__frame0" value="alt [allowed và copy khả dụng]" style="rounded=0;fillColor=none;strokeColor=#657585;html=1;verticalAlign=top;align=left;fontSize=11;" vertex="1" parent="content_card_SD_Checkout"><mxGeometry x="20" y="450" width="1025" height="285" as="geometry" /></mxCell><mxCell id="card_SD_Checkout__divider0" value="[else]" style="text;html=1;fontSize=11;align=left;" vertex="1" parent="content_card_SD_Checkout"><mxGeometry x="25" y="621" width="1015" height="20" as="geometry" /></mxCell><mxCell id="card_SD_Checkout__frame1" value="critical [khóa và giao dịch DB]" style="rounded=0;fillColor=none;strokeColor=#657585;html=1;verticalAlign=top;align=left;fontSize=11;" vertex="1" parent="content_card_SD_Checkout"><mxGeometry x="32" y="279" width="1001" height="456" as="geometry" /></mxCell><mxCell id="card_SD_Checkout__p0" value="Thủ thư" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=0;fillColor=#edf3f7;" vertex="1" parent="content_card_SD_Checkout"><mxGeometry x="50" y="55" width="165" height="44" as="geometry" /></mxCell><mxCell id="card_SD_Checkout__life0" value="" style="dashed=1;endArrow=none;strokeColor=#657585;" edge="1" parent="content_card_SD_Checkout"><mxGeometry relative="1" as="geometry"><mxPoint x="132.5" y="99" as="sourcePoint" /><mxPoint x="132.5" y="772" as="targetPoint" /></mxGeometry></mxCell><mxCell id="card_SD_Checkout__p1" value="UI" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=0;fillColor=#edf3f7;" vertex="1" parent="content_card_SD_Checkout"><mxGeometry x="255" y="