ometry" /></mxCell><mxCell id="card_ST_F07__e4" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F07" source="card_ST_F07__n3" target="card_ST_F07__n4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="234.12" y="378.9" /><mxPoint x="232.59" y="393.15999999999997" /><mxPoint x="232.59" y="393.15999999999997" /><mxPoint x="232.59" y="393.15999999999997" /><mxPoint x="232.59" y="417.15999999999997" /><mxPoint x="232.59" y="417.15999999999997" /><mxPoint x="232.59" y="417.15999999999997" /><mxPoint x="245.76" y="426.35" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F07__label5" value="chỉnh lại" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_ST_F07"><mxGeometry x="338.72" y="305.46000000000004" width="59.300000000000004" height="17" as="geometry" /></mxCell><mxCell id="card_ST_F07__e5" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F07" source="card_ST_F07__n4" target="card_ST_F07__n1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="322.06" y="429.6" /><mxPoint x="335.41" y="417.15999999999997" /><mxPoint x="335.41" y="417.15999999999997" /><mxPoint x="335.41" y="417.15999999999997" /><mxPoint x="350.14" y="259.49" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F07__label6" value="trả mã phiếu" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_ST_F07"><mxGeometry x="201.01" y="498.65999999999997" width="76.4" height="17" as="geometry" /></mxCell><mxCell id="card_ST_F07__e6" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F07" source="card_ST_F07__n5" target="card_ST_F07__n6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="183.55" y="495.155" /><mxPoint x="223.42" y="521.914" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F07__label7" value="hủy" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_ST_F07"><mxGeometry x="446.31" y="348.06" width="25.1" height="17" as="geometry" /></mxCell><mxCell id="card_ST_F07__e7" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F07" source="card_ST_F07__n1" target="card_ST_F07__n6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="401.37" y="215.33999999999997" /><mxPoint x="449.41" y="264.96" /><mxPoint x="449.41" y="264.96" /><mxPoint x="449.41" y="264.96" /><mxPoint x="449.41" y="264.96" /><mxPoint x="449.41" y="460.15999999999997" /><mxPoint x="449.41" y="460.15999999999997" /><mxPoint x="327.62" y="517.4200000000001" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F07__note" value="CheckoutRequest" style="text;html=1;fontFamily=Arial;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="content_card_ST_F07"><mxGeometry x="24" y="596" width="498.3" height="70" as="geometry" /></mxCell><mxCell id="board_133" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chức năng:&lt;/b&gt; F07 ↔ UC6 — Cho mượn sách&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Người thao tác:&lt;/b&gt; Thủ thư&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chủ thể / phạm vi:&lt;/b&gt; CheckoutRequest&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; Nút = trạng thái của chủ thể; cạnh = sự kiện [điều kiện] / hành động. Nút đen bắt đầu; nút kép kết thúc phiên được mô tả.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Hoạt động:&lt;/b&gt; Quét thẻ và mã vạch các bản sao; nhận Idempotency-Key. → Kiểm tra quyền, thẻ, dư nợ, quá hạn, số cuốn và giữ chỗ. → Khóa các bản sao theo thứ tự ID; kiểm tra lại khả dụng trong giao dịch. → Tạo Loan và LoanItem với dueAt, policyVersionId; chuyển bản sao ON_LOAN; commit.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Quy tắc đề xuất:&lt;/b&gt; QĐ05: tối đa 4 cuốn trong một phiếu; QĐ06: hạn tối đa 4 ngày; QĐ08: không nợ phạt và không có khoản quá hạn.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lỗi / ngoại lệ:&lt;/b&gt; Hai quầy mượn cùng bản sao: một giao dịch thành công, giao dịch kia 409. Không đủ điều kiện: 422 có mã lý do. Mất kết nối sau commit: dùng lại key để lấy kết quả.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Kết quả / bất biến:&lt;/b&gt; Tất cả mục trong phiếu được lưu cùng giao dịch; không mượn một phần âm thầm.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="2027" y="13787" width="570" height="741" /></mxCell><mxCell id="card_ST_F08" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#A8BACB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="2692" y="13682" width="1215" height="838" /></mxCell><mxCell id="board_135" value="CHI TIẾT • ST_F08 F08 — Nhận trả sách" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=22;fontStyle=1;fillColor=#EAF2F8;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="2704" y="13692" width="1191" height="80" /></mxCell><mxCell id="content_card_ST_F08" value="" style="group;" vertex="1" parent="1"><mxGeometry as="geometry" x="2712" y="13787" width="575" height="698" /></mxCell><mxCell id="card_ST_F08__title" value="F08 — Nhận trả sách" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="content_card_ST_F08"><mxGeometry x="24" y="16" width="484.97" height="40" as="geometry" /></mxCell><mxCell id="card_ST_F08__n0" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;ellipse;fillColor=#243444;" vertex="1" parent="content_card_ST_F08"><mxGeometry x="139.325" y="90.00000000000001" width="12.959999999999999" height="12.959999999999999" as="geometry" /></mxCell><mxCell id="card_ST_F08__n1" value="Xác minh mục mượn" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_ST_F08"><mxGeometry x="69.99980000000001" y="151.95999999999998" width="151.6104" height="36" as="geometry" /></mxCell><mxCell id="card_ST_F08__n2" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rhombus;" vertex="1" parent="content_card_ST_F08"><mxGeometry x="133.205" y="236.96" width="25.2" height="25.2" as="geometry" /></mxCell><mxCell id="card_ST_F08__n3" value="Không thể ghi nhận" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_ST_F08"><mxGeometry x="102.8532" y="418.15999999999997" width="145.8936" height="36" as="geometry" /></mxCell><mxCell id="card_ST_F08__n4" value="Đang ghi giao dịch" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_ST_F08"><mxGeometry x="216.104" y="322.15999999999997" width="139.392" height="36" as="geometry" /></mxCell><mxCell id="card_ST_F08__n5" value="Đã nhận trả" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_ST_F08"><mxGeometry x="289.35400000000004" y="418.15999999999997" width="98.892" height="36" as="geometry" /></mxCell><mxCell id="card_ST_F08__n6" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;shape=doubleEllipse;fillColor=#243444;" vertex="1" parent="content_card_ST_F08"><mxGeometry x="241.88004" y="514.16004" width="23.83992" height="23.83992" as="geometry" /></mxCell><mxCell id="card_ST_F08__e0" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F08" source="card_ST_F08__n0" target="card_ST_F08__n1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="145.805" y="111.73000000000002" /><mxPoint x="145.805" y="128.82" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F08__e1" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F08" source="card_ST_F08__n1" target="card_ST_F08__n2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="145.805" y="199.97000000000003" /><mxPoint x="145.805" y="215.64999999999998" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F08__label2" value="[OPEN và dữ liệu hợp lệ]" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_ST_F08"><mxGeometry x="207.9" y="283.65999999999997" width="144.8" height="17" as="geometry" /></mxCell><mxCell id="card_ST_F08__e2" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F08" source="card_ST_F08__n2" target="card_ST_F08__n4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="171.44" y="266.79" /><mxPoint x="218.38" y="296.49" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F08__label3" value="[else] / nêu lỗi" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_ST_F08"><mxGeometry x="115.969" y="331.65999999999997" width="99.2" height="17" as="geometry" /></mxCell><mxCell id="card_ST_F08__e3" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F08" source="card_ST_F08__n2" target="card_ST_F08__n3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="140.56900000000002" y="280.62" /><mxPoint x="133.332" y="322.15999999999997" /><mxPoint x="133.332" y="322.15999999999997" /><mxPoint x="133.332" y="322.15999999999997" /><mxPoint x="133.332" y="358.15999999999997" /><mxPoint x="133.332" y="358.15999999999997" /><mxPoint x="133.332" y="358.15999999999997" /><mxPoint x="149.721" y="387.87" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F08__label4" value="commit / đóng mục, phí, trạng thái" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_ST_F08"><mxGeometry x="294.32000000000005" y="379.65999999999997" width="201.8" height="17" as="geometry" /></mxCell><mxCell id="card_ST_F08__e4" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F08" source="card_ST_F08__n4" target="card_ST_F08__n5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="303.77" y="373.02" /><mxPoint x="315.69" y="394.15999999999997" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F08__label5" value="rollback / không đổi dữ liệu" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_ST_F08"><mxGeometry x="152.64999999999998" y="379.65999999999997" width="167.6" height="17" as="geometry" /></mxCell><mxCell id="card_ST_F08__e5" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F08" source="card_ST_F08__n4" target="card_ST_F08__n3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="207.28" y="369.72" /><mxPoint x="173.09" y="382.15999999999997" /><mxPoint x="173.09" y="382.15999999999997" /><mxPoint x="173.09" y="382.15999999999997" /><mxPoint x="173.09" y="394.15999999999997" /><mxPoint x="173.09" y="394.15999999999997" /><mxPoint x="173.09" y="394.15999999999997" /><mxPoint x="173.56" y="401.26" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F08__label6" value="kết thúc yêu cầu" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_ST_F08"><mxGeometry x="190.03" y="475.65999999999997" width="99.2" height="17" as="geometry" /></mxCell><mxCell id="card_ST_F08__e6" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F08" source="card_ST_F08__n3" target="card_ST_F08__n6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="191.06" y="469.971" /><mxPoint x="200.45" y="490.15999999999997" /><mxPoint x="200.45" y="490.15999999999997" /><mxPoint x="200.45" y="490.15999999999997" /><mxPoint x="221.63" y="504.023" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F08__label7" value="trả biên nhận" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_ST_F08"><mxGeometry x="289.76" y="475.65999999999997" width="82.10000000000001" height="17" as="geometry" /></mxCell><mxCell id="card_ST_F08__e7" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F08" source="card_ST_F08__n5" target="card_ST_F08__n6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="306.09000000000003" y="470.995" /><mxPoint x="282.47" y="495.43" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F08__note" value="ReturnRequest" style="text;html=1;fontFamily=Arial;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="content_card_ST_F08"><mxGeometry x="24" y="573" width="504.97" height="70" as="geometry" /></mxCell><mxCell id="board_137" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chức năng:&lt;/b&gt; F08 ↔ UC7 — Nhận trả sách&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Người thao tác:&lt;/b&gt; Thủ thư&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chủ thể / phạm vi:&lt;/b&gt; ReturnRequest&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; Nút = trạng thái của chủ thể; cạnh = sự kiện [điều kiện] / hành động. Nút đen bắt đầu; nút kép kết thúc phiên được mô tả.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Hoạt động:&lt;/b&gt; Quét bản sao; lấy LoanItem OPEN. → Kiểm tra tình trạng tốt/hỏng/mất; tính trễ theo dueAt đã lưu. → Trong giao dịch: đóng mục mượn, cập nhật bản sao và tạo FineCharge nếu có. → Nếu sách tốt, phân bổ FIFO giữ chỗ hợp lệ; phát outbox thông báo sau commit.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Quy tắc đề xuất:&lt;/b&gt; Luôn cho trả dù thẻ hết hạn hoặc đang nợ; phí được ghi nhận, thu tiền là UC10 riêng.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lỗi / ngoại lệ:&lt;/b&gt; Mã không có mục mượn mở: 409 hoặc trả lại kết quả idempotent tương ứng. Hỏng/mất: dùng quy tắc phí đã được duyệt; không tự định giá.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Kết quả / bất biến:&lt;/b&gt; ReturnEvent duy nhất cho mỗi LoanItem; không thu phí hai lần khi gửi lại.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="3302" y="13787" width="570" height="718" /></mxCell><mxCell id="card_ST_F09" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#A8BACB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="3967" y="13682" width="1183" height="755" /></mxCell><mxCell id="board_139" value="CHI TIẾT • ST_F09 F09 — Gia hạn mượn" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=22;fontStyle=1;fillColor=#EAF2F8;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="3979" y="13692" width="1159" height="80" /></mxCell><mxCell id="content_card_ST_F09" value="" style="group;" vertex="1" parent="1"><mxGeometry as="geometry" x="3987" y="13787" width="543" height="614" /></mxCell><mxCell id="card_ST_F09__title" value="F09 — Gia hạn mượn" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="content_card_ST_F09"><mxGeometry x="24" y="16" width="452.23" height="40" as="geometry" /></mxCell><mxCell id="card_ST_F09__n0" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;ellipse;fillColor=#243444;" vertex="1" parent="content_card_ST_F09"><mxGeometry x="207.33" y="90.00000000000001" width="12.959999999999999" height="12.959999999999999" as="geometry" /></mxCell><mxCell id="card_ST_F09__n1" value="Đang kiểm tra phiếu" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_ST_F09"><mxGeometry x="140.1576" y="151.95999999999998" width="147.3048" height="36" as="geometry" /></mxCell><mxCell id="card_ST_F09__n2" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rhombus;" vertex="1" parent="content_card_ST_F09"><mxGeometry x="201.21" y="236.96" width="25.2" height="25.2" as="geometry" /></mxCell><mxCell id="card_ST_F09__n3" value="Từ chối gia hạn" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_ST_F09"><mxGeometry x="70.00120000000001" y="334.15999999999997" width="125.62559999999999" height="36" as="geometry" /></mxCell><mxCell id="card_ST_F09__n4" value="Đã cập nhật hạn" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_ST_F09"><mxGeometry x="231.8264" y="334.15999999999997" width="129.9672" height="36" as="geometry" /></mxCell><mxCell id="card_ST_F09__n5" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;shape=doubleEllipse;fillColor=#243444;" vertex="1" parent="content_card_ST_F09"><mxGeometry x="202.89004" y="430.16004" width="23.83992" height="23.83992" as="geometry" /></mxCell><mxCell id="card_ST_F09__e0" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F09" source="card_ST_F09__n0" target="card_ST_F09__n1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="213.81" y="111.73000000000002" /><mxPoint x="213.81" y="128.82" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F09__e1" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F09" source="card_ST_F09__n1" target="card_ST_F09__n2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="213.81" y="199.97" /><mxPoint x="213.81" y="215.65" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F09__label2" value="[tất cả mục mở hợp lệ] / commit hạn&lt;br&gt;mới" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_ST_F09"><mxGeometry x="249.57" y="283.15999999999997" width="207.5" height="30" as="geometry" /></mxCell><mxCell id="card_ST_F09__e2" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F09" source="card_ST_F09__n2" target="card_ST_F09__n4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="229.02" y="266.96000000000004" /><mxPoint x="246.81" y="286.15999999999997" /><mxPoint x="246.81" y="286.15999999999997" /><mxPoint x="246.81" y="286.15999999999997" /><mxPoint x="264.1" y="308.63" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F09__label3" value="[else] / giữ hạn cũ" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_ST_F09"><mxGeometry x="141.7" y="289.65999999999997" width="116.3" height="17" as="geometry" /></mxCell><mxCell id="card_ST_F09__e3" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F09" source="card_ST_F09__n2" target="card_ST_F09__n3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="191.34" y="264.86" /><mxPoint x="157.889" y="286.15999999999997" /><mxPoint x="157.889" y="286.15999999999997" /><mxPoint x="157.889" y="286.15999999999997" /><mxPoint x="149.522" y="307.85" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F09__label4" value="nêu lý do" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_ST_F09"><mxGeometry x="172.07999999999998" y="391.65999999999997" width="59.300000000000004" height="17" as="geometry" /></mxCell><mxCell id="card_ST_F09__e4" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F09" source="card_ST_F09__n3" target="card_ST_F09__n5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="164.37099999999998" y="386.995" /><mxPoint x="187.16" y="411.43" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F09__label5" value="trả hạn mới" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_ST_F09"><mxGeometry x="252.1" y="391.65999999999997" width="70.7" height="17" as="geometry" /></mxCell><mxCell id="card_ST_F09__e5" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F09" source="card_ST_F09__n4" target="card_ST_F09__n5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="265.26" y="386.995" /><mxPoint x="242.47" y="411.43" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F09__note" value="RenewalRequest" style="text;html=1;fontFamily=Arial;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="content_card_ST_F09"><mxGeometry x="24" y="489" width="472.23" height="70" as="geometry" /></mxCell><mxCell id="board_141" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chức năng:&lt;/b&gt; F09 ↔ UC8 — Gia hạn mượn&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Người thao tác:&lt;/b&gt; Thủ thư&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chủ thể / phạm vi:&lt;/b&gt; RenewalRequest&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; Nút = trạng thái của chủ thể; cạnh = sự kiện [điều kiện] / hành động. Nút đen bắt đầu; nút kép kết thúc phiên được mô tả.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Hoạt động:&lt;/b&gt; Chọn phiếu và các mục còn OPEN. → Khóa phiếu/mục và kiểm tra lại lần gia hạn, nợ, thẻ, hạn, hàng đợi. → Kiểm tra toàn bộ mục mở; mục đã trả không tham gia. → Cập nhật dueAt, renewalCount, lưu RenewalEvent cùng giao dịch.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Quy tắc đề xuất:&lt;/b&gt; Theo tài liệu DFD: một lần/phiếu; thêm 4 ngày từ hạn cũ; chưa quá hạn, không nợ và không có người khác giữ đầu sách.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lỗi / ngoại lệ:&lt;/b&gt; Có một mục mở không đủ điều kiện: từ chối toàn phiếu; không cập nhật một phần. Hai yêu cầu cùng lúc: khóa và kiểm tra lại; một lần gia hạn duy nhất.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Kết quả / bất biến:&lt;/b&gt; Hạn mới dựa trên hạn cũ, không tính lại từ issuedAt. Quy định một lần/phiếu được đánh dấu cần thống nhất với giới hạn tổng thời gian.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="4545" y="13787" width="570" height="635" /></mxCell><mxCell id="card_ST_F10" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#A8BACB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="5210" y="13682" width="1332" height="778" /></mxCell><mxCell id="board_143" value="CHI TIẾT • ST_F10 F10 — Đặt trước và giữ chỗ" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=22;fontStyle=1;fillColor=#EAF2F8;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="5222" y="13692" width="1308" height="80" /></mxCell><mxCell id="content_card_ST_F10" value="" style="group;" vertex="1" parent="1"><mxGeometry as="geometry" x="5230" y="13787" width="692" height="637" /></mxCell><mxCell id="card_ST_F10__title" value="F10 — Đặt trước và giữ chỗ" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="content_card_ST_F10"><mxGeometry x="24" y="16" width="601.31" height="40" as="geometry" /></mxCell><mxCell id="card_ST_F10__n0" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;ellipse;fillColor=#243444;" vertex="1" parent="content_card_ST_F10"><mxGeometry x="104.289" y="90.00000000000001" width="12.959999999999999" height="12.959999999999999" as="geometry" /></mxCell><mxCell id="card_ST_F10__n1" value="QUEUED" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSiz