cePoint" /><mxPoint x="952.5" y="658" as="targetPoint" /></mxGeometry></mxCell><mxCell id="card_SD_Return__l9" value="10. Đọc outbox đã commit" style="text;html=1;fontSize=12;whiteSpace=wrap;align=center;fillColor=#FFFFFF;" vertex="1" parent="content_card_SD_Return"><mxGeometry x="865" y="615" width="380" height="36" as="geometry" /></mxCell><mxCell id="card_SD_Return__m10" value="" style="endArrow=classic;endFill=1;strokeColor=#344454;" edge="1" parent="content_card_SD_Return"><mxGeometry relative="1" as="geometry"><mxPoint x="1157.5" y="715" as="sourcePoint" /><mxPoint x="1157.5" y="715" as="targetPoint" /><Array as="points"><mxPoint x="1237.5" y="715" /><mxPoint x="1237.5" y="737" /></Array></mxGeometry></mxCell><mxCell id="card_SD_Return__l10" value="11. Gửi thông báo; dedupe eventId" style="text;html=1;fontSize=12;whiteSpace=wrap;align=center;fillColor=#FFFFFF;" vertex="1" parent="content_card_SD_Return"><mxGeometry x="1027.5" y="672" width="380" height="36" as="geometry" /></mxCell><mxCell id="card_SD_Return__m11" value="" style="endArrow=classic;endFill=1;strokeColor=#344454;" edge="1" parent="content_card_SD_Return"><mxGeometry relative="1" as="geometry"><mxPoint x="132.5" y="772" as="sourcePoint" /><mxPoint x="337.5" y="772" as="targetPoint" /></mxGeometry></mxCell><mxCell id="card_SD_Return__l11" value="12. Thu tiền lúc này hoặc lần sau" style="text;html=1;fontSize=12;whiteSpace=wrap;align=center;fillColor=#FFFFFF;" vertex="1" parent="content_card_SD_Return"><mxGeometry x="45" y="729" width="380" height="36" as="geometry" /></mxCell><mxCell id="card_SD_Return__m12" value="" style="endArrow=classic;endFill=1;strokeColor=#344454;" edge="1" parent="content_card_SD_Return"><mxGeometry relative="1" as="geometry"><mxPoint x="337.5" y="829" as="sourcePoint" /><mxPoint x="747.5" y="829" as="targetPoint" /></mxGeometry></mxCell><mxCell id="card_SD_Return__l12" value="13. POST /payments + key" style="text;html=1;fontSize=12;whiteSpace=wrap;align=center;fillColor=#FFFFFF;" vertex="1" parent="content_card_SD_Return"><mxGeometry x="352.5" y="786" width="380" height="36" as="geometry" /></mxCell><mxCell id="card_SD_Return__m13" value="" style="endArrow=classic;endFill=1;strokeColor=#344454;" edge="1" parent="content_card_SD_Return"><mxGeometry relative="1" as="geometry"><mxPoint x="747.5" y="886" as="sourcePoint" /><mxPoint x="952.5" y="886" as="targetPoint" /></mxGeometry></mxCell><mxCell id="card_SD_Return__l13" value="14. BEGIN; khóa số dư; payment/allocation; COMMIT" style="text;html=1;fontSize=12;whiteSpace=wrap;align=center;fillColor=#FFFFFF;" vertex="1" parent="content_card_SD_Return"><mxGeometry x="660" y="843" width="380" height="36" as="geometry" /></mxCell><mxCell id="card_SD_Return__m14" value="" style="endArrow=classic;endFill=1;strokeColor=#344454;" edge="1" parent="content_card_SD_Return"><mxGeometry relative="1" as="geometry"><mxPoint x="747.5" y="943" as="sourcePoint" /><mxPoint x="337.5" y="943" as="targetPoint" /></mxGeometry></mxCell><mxCell id="card_SD_Return__l14" value="15. 201 biên lai" style="text;html=1;fontSize=12;whiteSpace=wrap;align=center;fillColor=#FFFFFF;" vertex="1" parent="content_card_SD_Return"><mxGeometry x="352.5" y="900" width="380" height="36" as="geometry" /></mxCell><mxCell id="card_SD_Return__note" value="Trả được khi thẻ hết hạn/nợ. Thanh toán là giao dịch riêng; lỗi gửi thông báo không rollback việc trả." style="text;html=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="content_card_SD_Return"><mxGeometry x="25" y="1015" width="1220" height="60" as="geometry" /></mxCell><mxCell id="board_327" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Mục đích:&lt;/b&gt; Sequence — UC7 trả; UC22 ghi phí; UC10 thu độc lập&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; Cột là participant, nét đứt là lifeline; thời gian từ trên xuống. alt = chọn một nhánh; critical = vùng nguyên tử; opt = có điều kiện.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách hoạt động:&lt;/b&gt; Nhận trả được chấp nhận ngay cả khi thẻ hết hạn hoặc có nợ. Transaction đóng LoanItem, ghi ReturnEvent, cập nhật copy, phí phát sinh và phân bổ giữ chỗ. Sau commit mới thông báo. Thu tiền là transaction riêng tạo Payment / Allocation, không trì hoãn việc trả sách; miễn phí cần thẩm quyền.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lưu ý / ràng buộc:&lt;/b&gt; Trả được khi thẻ hết hạn/nợ. Thanh toán là giao dịch riêng; lỗi gửi thông báo không rollback việc trả.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="1563" y="24756" width="570" height="1130" /></mxCell><mxCell id="card_SD_Hold" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#A8BACB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="2228" y="24651" width="1725" height="1136" /></mxCell><mxCell id="board_329" value="CHI TIẾT • SD_Hold Sequence — UC9 phân bổ và nhận sách đặt trước" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=22;fontStyle=1;fillColor=#EAF2F8;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="2240" y="24661" width="1701" height="80" /></mxCell><mxCell id="content_card_SD_Hold" value="" style="group;" vertex="1" parent="1"><mxGeometry as="geometry" x="2248" y="24756" width="1085" height="996" /></mxCell><mxCell id="card_SD_Hold__p0" value="Độc giả" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=0;fillColor=#edf3f7;" vertex="1" parent="content_card_SD_Hold"><mxGeometry x="50" y="55" width="165" height="44" as="geometry" /></mxCell><mxCell id="card_SD_Hold__life0" value="" style="dashed=1;endArrow=none;strokeColor=#657585;" e