996" /><mxPoint x="430.84" y="369.84" /><mxPoint x="430.84" y="369.84" /><mxPoint x="430.84" y="369.84" /><mxPoint x="462.6" y="381.84" /><mxPoint x="462.6" y="381.84" /><mxPoint x="462.6" y="381.84" /><mxPoint x="519.85" y="395.76" /></Array></mxGeometry></mxCell><mxCell id="card_Deployment__label8" value="OIDC" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_Deployment"><mxGeometry x="788.71" y="367.34" width="30.8" height="17" as="geometry" /></mxCell><mxCell id="card_Deployment__e8" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_Deployment" source="card_Deployment__n2" target="card_Deployment__n7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="737.62" y="354.77" /><mxPoint x="777.84" y="369.84" /><mxPoint x="777.84" y="369.84" /><mxPoint x="777.84" y="369.84" /><mxPoint x="802.19" y="390.121" /></Array></mxGeometry></mxCell><mxCell id="card_Deployment__note" value="Secrets ở vault/env được quản lý; DB không mở Internet; restore diễn tập trong môi trường cô lập." style="text;html=1;fontFamily=Arial;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="content_card_Deployment"><mxGeometry x="24" y="490.76" width="934.34" height="70" as="geometry" /></mxCell><mxCell id="board_37" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Mục đích:&lt;/b&gt; Triển khai và vùng tin cậy&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; Hộp thể hiện thiết bị / node / vùng triển khai; đường nối mô tả kênh giao tiếp và biên tin cậy.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách hoạt động:&lt;/b&gt; Thiết bị người dùng đi qua TLS reverse proxy tới API và Web UI. API / Worker nằm trong vùng ứng dụng; DB và bản sao lưu ở vùng dữ liệu riêng. Dịch vụ ngoài truy cập qua kết nối được cấu hình. DB không mở Internet; secrets quản lý bằng môi trường / vault. Phục hồi được chạy và kiểm tra trong môi trường cô lập.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lưu ý / ràng buộc:&lt;/b&gt; Secrets ở vault/env được quản lý; DB không mở Internet; restore diễn tập trong môi trường cô lập.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="1140" y="6140" width="570" height="636" /></mxCell><mxCell id="board_38" value="&lt;b&gt;05 — UML LỚP&lt;/b&gt;&lt;br&gt;Mô hình miền tổng quát và lớp của từng phân hệ." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=24;fillColor=#16324F;fontColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="6891" width="9800" height="95" /></mxCell><mxCell id="card_OV_CLASS" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#A8BACB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="7021" width="2327" height="1650" /></mxCell><mxCell id="board_40" value="TỔNG QUÁT TOÀN HỆ THỐNG • OV_CLASS UML lớp — Tổng quát mô hình miền toàn hệ thống" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=22;fontStyle=1;fillColor=#DDF2E7;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="112" y="7031" width="2303" height="80" /></mxCell><mxCell id="content_card_OV_CLASS" value="" style="group;" vertex="1" parent="1"><mxGeometry as="geometry" x="120" y="7126" width="1687" height="1510" /></mxCell><mxCell id="card_OV_CLASS__title" value="UML lớp — Tổng quát mô hình miền toàn hệ thống" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="content_card_OV_CLASS"><mxGeometry x="24" y="16" width="1596.9" height=