_n8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="594.86" y="391.48" /><mxPoint x="649.96" y="403.96000000000004" /><mxPoint x="649.96" y="403.96000000000004" /><mxPoint x="649.96" y="403.96000000000004" /><mxPoint x="689.22" y="430.30000000000007" /></Array></mxGeometry></mxCell><mxCell id="card_OV_STATE__label13" value="đóng ứng dụng" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_OV_STATE"><mxGeometry x="701.12" y="305.46000000000004" width="82.10000000000001" height="17" as="geometry" /></mxCell><mxCell id="card_OV_STATE__e13" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_OV_STATE" source="card_OV_STATE__n1" target="card_OV_STATE__n8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="585.36" y="211.15000000000003" /><mxPoint x="691.96" y="247.96000000000004" /><mxPoint x="691.96" y="247.96000000000004" /><mxPoint x="691.96" y="247.96000000000004" /><mxPoint x="722.96" y="403.96000000000004" /><mxPoint x="722.96" y="403.96000000000004" /><mxPoint x="722.96" y="403.96000000000004" /><mxPoint x="725.04" y="422.27000000000004" /></Array></mxGeometry></mxCell><mxCell id="card_OV_STATE__note" value="Chủ thể duy nhất: một phiên người dùng. Mỗi phiên độc lập. Các trạng thái BookCopy, LoanItem, Reservation, biểu mẫu và job ở 24 sơ đồ riêng; không ghép chúng thành một vòng đời đối tượng giả." style="text;html=1;fontFamily=Arial;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="content_card_OV_STATE"><mxGeometry x="24" y="702.96" width="808.31" height="70" as="geometry" /></mxCell><mxCell id="board_105" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Mục đích:&lt;/b&gt; State — Tổng quát phiên làm việc của người dùng&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; Nút là trạng thái của chủ thể; cạnh là event [guard] / action. Nút đầu / cuối thể hiện vòng đời được mô tả.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách hoạt động:&lt;/b&gt; Chủ thể là một phiên người dùng, từ chưa xác thực → xác thực → sẵn sàng → kiểm tra → xử lý → sẵn sàng. Guard quyết định nhánh; lỗi quay về trạng thái có thể sửa hoặc thử lại. Hết hạn phiên yêu cầu xác thực lại; đăng xuất kết thúc phiên. Mỗi đối tượng nghiệp vụ có vòng đời riêng ở F01–F24.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lưu ý / ràng buộc:&lt;/b&gt; Chủ thể duy nhất: một phiên người dùng. Mỗi phiên độc lập. Các trạng thái BookCopy, LoanItem, Reservation, biểu mẫu và job ở 24 sơ đồ riêng; không ghép chúng thành một vòng đời đối tượng giả.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="1014" y="12759" width="570" height="848" /></mxCell><mxCell id="card_ST_F01" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#A8BACB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="1679" y="12654" width="1234" height="862" /></mxCell><mxCell id="board_107" value="CHI TIẾT • ST_F01 F01 — Quản lý đầu sách" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=22;fontStyle=1;fillColor=#EAF2F8;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="1691" y="12664" width="1210" height="80" /></mxCell><mxCell id="content_card_ST_F01" value="" style="group;" vertex="1" parent="1"><mxGeometry as="geometry" x="1699" y="12759" width="594" height="722" /></mxCell><mxCell id="card_ST_F01__title" value="F01 — Quản lý đầu sách" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="content_card_ST_F01"><mxGeometry x="24" y="16" width="503.49" heigh