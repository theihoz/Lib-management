height="17" as="geometry" /></mxCell><mxCell id="card_AD_F19__e5" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F19" source="card_AD_F19__n3" target="card_AD_F19__n5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="239.14" y="378.28" /><mxPoint x="296.53" y="408.09000000000003" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F19__e6" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F19" source="card_AD_F19__n5" target="card_AD_F19__n6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="402.78" y="497.16" /><mxPoint x="406.14" y="511.82000000000005" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F19__e7" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F19" source="card_AD_F19__n6" target="card_AD_F19__n7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="418.49" y="612.28" /><mxPoint x="418.49" y="626.55" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F19__label8" value="[thành công]" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_AD_F19"><mxGeometry x="411.16" y="735.46" width="76.4" height="17" as="geometry" /></mxCell><mxCell id="card_AD_F19__e8" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F19" source="card_AD_F19__n7" target="card_AD_F19__n8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="420.98" y="730.23" /><mxPoint x="421.96" y="749.23" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F19__label9" value="[lỗi / rollback nếu có ghi DB]" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_AD_F19"><mxGeometry x="258.24" y="735.46" width="179.0" height="17" as="geometry" /></mxCell><mxCell id="card_AD_F19__e9" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F19" source="card_AD_F19__n7" target="card_AD_F19__n4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="310.34000000000003" y="726.71" /><mxPoint x="283" y="737.96" /><mxPoint x="283" y="737.96" /><mxPoint x="283" y="737.96" /><mxPoint x="255.67" y="753.95" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F19__e10" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F19" source="card_AD_F19__n8" target="card_AD_F19__n9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="365.57" y="840.1" /><mxPoint x="336.13" y="860.178" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F19__note" value="Vai trò hành động ghi trong nút; nhánh lỗi kết thúc yêu cầu, dữ liệu không ghi một phần." style="text;html=1;fontFamily=Arial;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="content_card_AD_F19"><mxGeometry x="24" y="931.72" width="593.31" height="70" as="geometry" /></mxCell><mxCell id="board_282" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chức năng:&lt;/b&gt; F19 ↔ UC14 — Theo dõi sách quá hạn&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Người thao tác:&lt;/b&gt; Quản lý; Thủ thư&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chủ thể / phạm vi:&lt;/b&gt; Một lần thực hiện chức năng; từ bắt đầu đến kết quả&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; Đọc theo mũi tên; chữ nhật là hoạt động, hình thoi chọn nhánh theo guard. Nhánh lỗi phải sửa hoặc kết thúc; không bỏ qua bước kiểm tra.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Hoạt động:&lt;/b&gt; Chọn bộ lọc và mốc thời gian. → Đọc các mục OPEN quá hạn theo dueAt. → Hiển thị ngày trễ và phí dự kiến, phân biệt phí đã được ghi sổ. → Làm mới khi có trả hoặc gia hạn; thông báo tự động là mở rộng riêng.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Quy tắc đề xuất:&lt;/b&gt; Quá hạn = LoanItem OPEN và now &amp;gt; dueAt đã lưu; không tính từ ngày mượn + mặc định 4 ngày.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lỗi / ngoại lệ:&lt;/b&gt; Thay quy định không thay dueAt cũ. Job chậm không làm mất trạng thái quá hạn vì trạng thái là phép tính.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Kết quả / bất biến:&lt;/b&gt; Dữ liệu và phí dự kiến không được dùng như khoản phải thu đã xác nhận.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="8993" y="20125" width="570" height="1077" /></mxCell><mxCell id="card_AD_F20" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#A8BACB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="21308" width="1307" height="1228" /></mxCell><mxCell id="board_284" value="CHI TIẾT • AD_F20 F20 — Luồng Xuất dữ liệu CSV" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=22;fontStyle=1;fillColor=#EAF2F8;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="112" y="21318" width="1283" height="80" /></mxCell><mxCell id="content_card_AD_F20" value="" style="group;" vertex="1" parent="1"><mxGeometry as="geometry" x="120" y="21413" width="667" height="1088" /></mxCell><mxCell id="card_AD_F20__title" value="F20 — Luồng Xuất dữ liệu CSV" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="content_card_AD_F20"><mxGeometry x="24" y="16" width="576.38" height="40" as="geometry" /></mxCell><mxCell id="card_AD_F20__n0" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;ellipse;fillColor=#243444;" vertex="1" parent="content_card_AD_F20"><mxGeometry x="208.33" y="89.9999999999999" width="12.959999999999999" height="12.959999999999999" as="geometry" /></mxCell><mxCell id="card_AD_F20__n1" value="Người dùng&lt;br&gt;Kiểm tra quyền và phạm vi dữ liệu; tạo job&lt;br&gt;idempotent." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F20"><mxGeometry x="69.99640000000002" y="151.95999999999992" width="289.62719999999996" height="65.52" as="geometry" /></mxCell><mxCell id="card_AD_F20__n2" value="API&lt;br&gt;Kiểm tra quyền và input" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F20"><mxGeometry x="129.958" y="266.48011999999994" width="169.704" height="49.91976" as="geometry" /></mxCell><mxCell id="card_AD_F20__n3" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rhombus;" vertex="1" parent="content_card_AD_F20"><mxGeometry x="202.21" y="365.4" width="25.2" height="25.2" as="geometry" /></mxCell><mxCell id="card_AD_F20__n4" value="API&lt;br&gt;Trả lỗi có mã; không ghi dữ liệu" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F20"><mxGeometry x="74.3224" y="805.16012" width="220.9752" height="49.91976" as="geometry" /></mxCell><mxCell id="card_AD_F20__n5" value="Hệ thống&lt;br&gt;Chụp bộ lọc/snapshot; tạo CSV UTF-8 và&lt;br&gt;chống công thức khi mở bảng tính." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vert