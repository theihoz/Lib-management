t x="105.39" y="521.55" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F15__label6" value="dọn object" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_ST_F15"><mxGeometry x="293.64" y="547.66" width="65.0" height="17" as="geometry" /></mxCell><mxCell id="card_ST_F15__e6" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F15" source="card_ST_F15__n5" target="card_ST_F15__n7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="300.21000000000004" y="545.9300000000001" /><mxPoint x="286" y="610.16" /><mxPoint x="286" y="610.16" /><mxPoint x="286" y="610.16" /><mxPoint x="254.72" y="625.766" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F15__label7" value="dọn object [không còn tham chiếu]" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_ST_F15"><mxGeometry x="104.02" y="595.66" width="196.1" height="17" as="geometry" /></mxCell><mxCell id="card_ST_F15__e7" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F15" source="card_ST_F15__n6" target="card_ST_F15__n7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="121.18" y="589.971" /><mxPoint x="123.138" y="610.16" /><mxPoint x="123.138" y="610.16" /><mxPoint x="123.138" y="610.16" /><mxPoint x="170.15" y="627.84" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F15__note" value="MediaAsset" style="text;html=1;fontFamily=Arial;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="content_card_ST_F15"><mxGeometry x="24" y="693" width="405.53" height="70" as="geometry" /></mxCell><mxCell id="board_165" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chức năng:&lt;/b&gt; F15 ↔ UC4 — Quản lý ảnh bìa R2&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Người thao tác:&lt;/b&gt; Thủ thư&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chủ thể / phạm vi:&lt;/b&gt; MediaAsset&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; Nút = trạng thái của chủ thể; cạnh = sự kiện [điều kiện] / hành động. Nút đen bắt đầu; nút kép kết thúc phiên được mô tả.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Hoạt động:&lt;/b&gt; Tạo upload intent có quyền cho đầu sách. → Upload vào vùng staging; kiểm tra magic bytes và giải mã ảnh. → Lưu objectKey, hash, kích thước và gắn MediaAsset với đầu sách. → Khi thay ảnh, kích hoạt bản mới rồi dọn ảnh cũ sau; dọn orphan theo lịch.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Quy tắc đề xuất:&lt;/b&gt; PNG/JPEG/WebP; kiểm tra nội dung, kích thước và giới hạn; R2 mặc định private; URL công khai chỉ khi cấu hình domain cho ảnh bìa.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lỗi / ngoại lệ:&lt;/b&gt; Upload xong nhưng DB lỗi: orphan phải dọn. Không public bucket chứa báo cáo/dữ liệu độc giả. Không tin đuôi file hoặc URL do client gửi.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Kết quả / bất biến:&lt;/b&gt; Chỉ asset đã xác minh được hiển thị; DB giữ objectKey, không chứa secret.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="3137" y="14708" width="570" height="838" /></mxCell><mxCell id="card_ST_F16" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#A8BACB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="3802" y="14603" width="1167" height="755" /></mxCell><mxCell id="board_167" value="CHI TIẾT • ST_F16 F16 — Đăng nhập và phiên truy cập" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=22;fontStyle=1;fillColor=#EAF2F8;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="3814" y="14613" width="1143" height="80" /></mxCell><mxCell id="content_card_ST_F16" value="" style="group;" vertex="1" parent="1"><mxGeometry as="geometry" x="3822" y="14708" width="527" height="602" /></mxCell><mxCell id="card_ST_F16__title" value="F16 — Đăng nhập và phiên truy cập" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="content_card_ST_F16"><mxGeometry x="24" y="16" width="436.44" height="40" as="geometry" /></mxCell><mxCell id="card_ST_F16__n0" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;ellipse;fillColor=#243444;" vertex="1" parent="content_card_ST_F16"><mxGeometry x="333.01" y="90.00000000000001" width="12.959999999999999" height="12.959999999999999" as="geometry" /></mxCell><mxCell id="card_ST_F16__n1" value="Đang xác thực" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_ST_F16"><mxGeometry x="284.2624" y="151.95999999999998" width="110.4552" height="36" as="geometry" /></mxCell><mxCell id="card_ST_F16__n2" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rhombus;" vertex="1" parent="content_card_ST_F16"><mxGeometry x="277.89" y="236.96" width="25.2" height="25.2" as="geometry" /></mxCell><mxCell id="card_ST_F16__n3" value="Bị từ chối" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_ST_F16"><mxGeometry x="243.21480000000003" y="322.15999999999997" width="94.5504" height="36" as="geometry" /></mxCell><mxCell id="card_ST_F16__n4" value="AUTHENTICATED" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor