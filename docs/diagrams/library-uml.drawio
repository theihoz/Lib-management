mxGeometry></mxCell><mxCell id="card_ST_F16__label5" value="hủy" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_ST_F16"><mxGeometry x="252.89" y="379.65999999999997" width="25.1" height="17" as="geometry" /></mxCell><mxCell id="card_ST_F16__e5" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F16" source="card_ST_F16__n3" target="card_ST_F16__n5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="263.25" y="373.971" /><mxPoint x="246.49" y="394.15999999999997" /><mxPoint x="246.49" y="394.15999999999997" /><mxPoint x="246.49" y="394.15999999999997" /><mxPoint x="235.68" y="405.267" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F16__label6" value="logout/thu hồi/hết hạn" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_ST_F16"><mxGeometry x="122.53" y="379.65999999999997" width="133.4" height="17" as="geometry" /></mxCell><mxCell id="card_ST_F16__e6" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F16" source="card_ST_F16__n4" target="card_ST_F16__n5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="137.135" y="369.545" /><mxPoint x="136.978" y="382.15999999999997" /><mxPoint x="136.978" y="382.15999999999997" /><mxPoint x="136.978" y="382.15999999999997" /><mxPoint x="136.978" y="394.15999999999997" /><mxPoint x="136.978" y="394.15999999999997" /><mxPoint x="136.978" y="394.15999999999997" /><mxPoint x="171.73000000000002" y="410.231" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F16__note" value="AuthSession" style="text;html=1;fontFamily=Arial;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="content_card_ST_F16"><mxGeometry x="24" y="477" width="456.44" height="70" as="geometry" /></mxCell><mxCell id="board_169" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chức năng:&lt;/b&gt; F16 ↔ UC0 — Đăng nhập và phiên truy cập&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Người thao tác:&lt;/b&gt; Nhân viên; độc giả có tài khoản&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chủ thể / phạm vi:&lt;/b&gt; AuthSession&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; Nút = trạng thái của chủ thể; cạnh = sự kiện [điều kiện] / hành động. Nút đen bắt đầu; nút kép kết thúc phiên được mô tả.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Hoạt động:&lt;/b&gt; Chuyển đăng nhập tới nhà cung cấp danh tính đã cấu hình. → Nhận callback; kiểm tra state/nonce/PKCE và token. → Ánh xạ tài khoản được mời/allowlist; lấy vai trò từ máy chủ. → Tạo phiên, kiểm tra quyền mỗi API; logout/thu hồi/hết hạn kết thúc phiên.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Quy tắc đề xuất:&lt;/b&gt; OIDC/JWT từ issuer tin cậy; kiểm tra iss/aud/exp/chữ ký; JIT chỉ từ danh mục đã cho phép, không tự nâng quyền.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lỗi / ngoại lệ:&lt;/b&gt; Token sai hoặc hết hạn: 401. Token hợp lệ nhưng không quyền: 403. Không log token; không tiết lộ tài khoản tồn tại qua lỗi đăng nhập.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Kết quả / bất biến:&lt;/b&gt; Vai trò không lấy từ input hoặc token issuer tùy ý; JWT ngắn hạn, refresh token có xoay vòng.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="4364" y="14708" width="570" height="635" /></mxCell><mxCell id="card_ST_F17" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#A8BACB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="5029" y="14603" width="1520" height="766" /></mxCell><mxCell id="board_171" value="CHI TIẾT • ST_F17 F17 — Xem lịch sử độc giả" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=22;fontStyle=1;fillColor=#EAF2F8;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="5041" y="14613" width="1496" height="80" /></mxCell><mxCell id="content_card_ST_F17" value="" style="group;" vertex="1" parent="1"><mxGeometry as="geometry" x="5049" y="14708" width="880" height="626" /></mxCell><mxCell id="card_ST_F17__title" value="F17 — Xem lịch sử độc giả" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="content_card_ST_F17"><mxGeometry x="24" y="16" width="789.12" height="40" as="geometry" /></mxCell><mxCell id="card_ST_F17__n0" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;ellipse;fillColor=#243444;" vertex="1" parent="content_card_ST_F17"><mxGeometry x="409.52" y="90.00000000000001" width="12.959999999999999" height="12.959999999999999" as="geometry" /></mxCell><mxCell id="card_ST_F17__n1" value="Nhập bộ lọc" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_ST_F17"><mxGeometry x="362.9432" y="151.96000000000004" width="106.1136" height="36" as="geometry" /></mxCell><mxCell id="card_ST_F17__n2" value="Đang truy vấn" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_ST_F17"><mxGeometry x="361.8524" y="247.96000000000004" width="108.2952" height="36" as="geometry" /></mxCell><mxCell id="card_ST_F17__n3" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rhombus;" vertex="1" parent="content_card_ST_F17"><mxGeometry x="403.4" y="343.9600