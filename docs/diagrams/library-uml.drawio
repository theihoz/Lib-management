5999999999993" /><mxPoint x="180.49" y="466.75999999999993" /><mxPoint x="180.49" y="705.5999999999999" /><mxPoint x="180.49" y="705.5999999999999" /><mxPoint x="180.49" y="759.6999999999999" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F12__e4" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F12" source="card_AD_F12__n4" target="card_AD_F12__n9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="238.33" y="871.2149999999999" /><mxPoint x="267.1" y="891.164" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F12__label5" value="[hợp lệ]" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_AD_F12"><mxGeometry x="285.16999999999996" y="396.5" width="53.6" height="17" as="geometry" /></mxCell><mxCell id="card_AD_F12__e5" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F12" source="card_AD_F12__n3" target="card_AD_F12__n5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="237.17" y="378.15" /><mxPoint x="288.98" y="406.78999999999996" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F12__e6" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F12" source="card_AD_F12__n5" target="card_AD_F12__n6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="406.63" y="513.48" /><mxPoint x="409.58" y="527.9" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F12__e7" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F12" source="card_AD_F12__n6" target="card_AD_F12__n7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="420.49" y="627.8599999999999" /><mxPoint x="420.49" y="642.21" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F12__label8" value="[thành công]" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_AD_F12"><mxGeometry x="412.16" y="766.66" width="76.4" height="17" as="geometry" /></mxCell><mxCell id="card_AD_F12__e8" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F12" source="card_AD_F12__n7" target="card_AD_F12__n8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="422.31" y="761.9" /><mxPoint x="422.93" y="780.8699999999999" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F12__label9" value="[lỗi / rollback nếu có ghi DB]" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_AD_F12"><mxGeometry x="259.24" y="766.66" width="179.0" height="17" as="geometry" /></mxCell><mxCell id="card_AD_F12__e9" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F12" source="card_AD_F12__n7" target="card_AD_F12__n4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="307.4" y="758.26" /><mxPoint x="284" y="769.16" /><mxPoint x="284" y="769.16" /><mxPoint x="284" y="769.16" /><mxPoint x="256.4" y="785.15" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F12__e10" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F12" source="card_AD_F12__n8" target="card_AD_F12__n9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="365.57" y="871.3" /><mxPoint x="336.13" y="891.3779999999999" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F12__note" value="Vai trò hành động ghi trong nút; nhánh lỗi kết thúc yêu cầu, dữ liệu không ghi một phần." style="text;html=1;fontFamily=Arial;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="content_card_AD_F12"><mxGeometry x="24" y="962.92" width="604.3399999999999" height="70" as="geometry" /></mxCell><mxCell id="board_254" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chức năng:&lt;/b&gt; F12 ↔ UC11 — Kiểm tra điều kiện độc giả&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Người thao tác:&lt;/b&gt; Thủ thư; dịch vụ nội bộ&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chủ thể / phạm vi:&lt;/b&gt; Một lần thực hiện chức năng; từ bắt đầu đến kết quả&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; Đọc theo mũi tên; chữ nhật là hoạt động, hình thoi chọn nhánh theo guard. Nhánh lỗi phải sửa hoặc kết thúc; không bỏ qua bước kiểm tra.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Hoạt động:&lt;/b&gt; Nhận readerId, operation và thời điểm. → Lấy thẻ, dư nợ, khoản OPEN quá hạn và chính sách hiệu lực. → Đánh giá tất cả điều kiện, trả danh sách lý do có mã. → Checkout/renew phải kiểm tra lại trong giao dịch; kết quả xem trước không bảo đảm khóa chỗ.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Quy tắc đề xuất:&lt;/b&gt; Tính lại tại thời điểm ghi giao dịch. Với mượn/gia hạn: áp dụng thẻ, quá hạn và QĐ08; trả sách không dùng cổng chặn này.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lỗi / ngoại lệ:&lt;/b&gt; Không tìm thấy độc giả: 404; không quyền xem: 403. Ngưỡng 50.000 và yêu cầu không nợ là mâu thuẫn cần duyệt, baseline dùng QĐ08.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Kết quả / bất biến:&lt;/b&gt; Không thay đổi dữ liệu; trả allowed và reasons nhất quán với operation.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="9049" y="18821" width="570" height="1108" /></mxCell><mxCell id="card_AD_F13" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#A8BACB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="20020" width="1328" height="1213" /></mxCell><mxCell id="board_256" value="CHI TIẾT • AD_F13 F13 — Luồng Thống kê và báo cáo" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=22;fontStyle=1;fillColor=#EAF2F8;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="112" y="20030" width="1304" height="80" /></mxCell><mxCell id="content_card_AD_F13" value="" style="group;" vertex="1" parent="1"><mxGeometry as="geometry" x="120" y="20125" width="688" height="1073" /></mxCell><mxCell id="card_AD_F13__title" value="F13 — Luồng Thống kê và báo cáo" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="content_card_AD_F13"><mxGeometry x="24" y="16" width="597.47" height="40" as="geometry" /></mxCell><mxCell id="card_AD_F13__n0" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;ellipse;fillColor=#243444;" vertex="1" parent="content_card_AD_F13"><mxGeometry x="210.14000000000001" y="90.00000000000001" width="12.959999999999999" height="12.959999999999999" as="geometry" /></mxCell><mxCell id="card_AD_F13__n1" value="Người dùng&lt;br&gt;Chọn kỳ và loại báo cáo; kiểm tra quyền và&lt;br&gt;ngày." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F13"><mxGeometry x="70.00280000000001" y="151.96000000000004" width="293.2344" height="65.52" as="geometry" /></mxCell><mxCell id="card_AD_F13__n2" value="API&lt;br&gt;Kiểm tra quyền và input" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" par