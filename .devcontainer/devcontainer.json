{
  "name": "Lib-management — Python + PostgreSQL",
  "initializeCommand": ["python3", ".devcontainer/prepare.py"],
  "dockerComposeFile": ["compose.yaml", "workspace.generated.json"],
  "service": "workspace",
  "workspaceFolder": "${localWorkspaceFolder}",
  "remoteUser": "developer",
  "overrideCommand": false,
  "shutdownAction": "stopCompose",
  "postCreateCommand": "cd apps/api && uv sync --locked --group dev",
  "forwardPorts": [8000],
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance", "charliermarsh.ruff"],
      "settings": {"python.defaultInterpreterPath": "/opt/venv/bin/python"}
    }
  }
}
