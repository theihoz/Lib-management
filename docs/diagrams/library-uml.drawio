al;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_DFD_Level1" source="card_DFD_Level1__n10" target="card_DFD_Level1__n3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="832.91" y="804.0200000000001" /><mxPoint x="812.29" y="791.34" /><mxPoint x="812.29" y="791.34" /><mxPoint x="812.29" y="791.34" /><mxPoint x="797.48" y="539.77" /></Array></mxGeometry></mxCell><mxCell id="card_DFD_Level1__note" value="A=A1..A4; B=B1..B4; C=C1+C2; D=D1+D2. Không có luồng thực thể→kho hoặc kho→kho." style="text;html=1;fontFamily=Arial;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="content_card_DFD_Level1"><mxGeometry x="24" y="887.94" width="1822.7" height="70" as="geometry" /></mxCell><mxCell id="board_80" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Mục đích:&lt;/b&gt; DFD mức 1 — phân rã P0&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; Hình tròn / ellipse là tiến trình; hộp là thực thể ngoài; kho là nơi lưu dữ liệu. Mũi tên có nhãn là dữ liệu được chuyển.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách hoạt động:&lt;/b&gt; P0 phân thành P1 Danh mục / thẻ, P2 Lưu thông / giữ chỗ, P3 Sổ phí và P4 Báo cáo / khai thác. Mỗi tiến trình nhận dữ liệu từ actor hoặc tiến trình rồi đọc / ghi kho phù hợp. Nhóm A1–A4, B1–B4, C1–C2, D1–D2 cân bằng với mức 0. Không nối actor trực tiếp tới kho hoặc kho tới kho.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lưu ý / ràng buộc:&lt;/b&gt; A=A1..A4; B=B1..B4; C=C1+C2; D=D1+D2. Không có luồng thực thể→kho hoặc kho→kho.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="2028" y="10682" width="570" height="1033" /></mxCell><mxCell id="card_DFD_Context" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#A8BACB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="2693" y="10577" width="1167" height="677" /></mxCell><mxCell id="board_82" value="CHI TIẾT • DFD_Context DFD ngữ cảnh — mức 0" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=22;fontStyle=1;fillColor=#EAF2F8;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="2705" y="10587" width="1143" height="80" /></mxCell><mxCell id="content_card_DFD_Context" value="" style="group;" vertex="1" parent="1"><mxGeometry as="geometry" x="2713" y="10682" width="527" height="537" /></mxCell><mxCell id="card_DFD_Context__title" value="DFD ngữ cảnh — mức 0" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="content_card_DFD_Context"><mxGeometry x="24" y="16" width="436.33" height="40" as="geometry" /></mxCell><mxCell id="card_DFD_Context__n0" value="E1 Nhân viên" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_DFD_Context"><mxGeometry x="131.0796" y="90" width="103.96079999999999" height="36" as="geometry" /></mxCell><mxCell id="card_DFD_Context__n1" value="E2 Độc giả" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_DFD_Context"><mxGeometry x="135.7812" y="340.6" width="94.5576" height="36" as="geometry" /></mxCell><mxCell id="card_DFD_Context__n2" value="P0 Phần mềm&lt;br&gt;quản lý thư viện" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;ellipse;" vertex="1" parent="content_card_DFD_Context"><mxGeometry x="94.73400000000001" y="198.00128" width="176.652" height="70.59743999999999" as="geometry" /></mxCell><mxCell id="card_DFD_Context__label0" value="A Dữ liệu danh mục/thẻ; yêu cầu lưu&lt;br&gt;thông; t