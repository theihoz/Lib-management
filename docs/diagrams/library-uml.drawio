fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_OV_CLASS"><mxGeometry x="782.07" y="1070.52" width="53.6" height="17" as="geometry" /></mxCell><mxCell id="card_OV_CLASS__e23" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;endArrow=none;" edge="1" parent="content_card_OV_CLASS" source="card_OV_CLASS__n0" target="card_OV_CLASS__n12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="488.54" y="1150.34" /><mxPoint x="573.1600000000001" y="1173.8" /><mxPoint x="573.1600000000001" y="1173.8" /><mxPoint x="573.1600000000001" y="1173.8" /><mxPoint x="724.67" y="1173.8" /><mxPoint x="724.67" y="1173.8" /><mxPoint x="724.67" y="1173.8" /><mxPoint x="1039.01" y="978.1" /></Array></mxGeometry></mxCell><mxCell id="card_OV_CLASS__label24" value="0..1 fulfilled item — 0..1" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_OV_CLASS"><mxGeometry x="1041.1" y="614.8" width="156.20000000000002" height="17" as="geometry" /></mxCell><mxCell id="card_OV_CLASS__e24" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;endArrow=none;" edge="1" parent="content_card_OV_CLASS" source="card_OV_CLASS__n11" target="card_OV_CLASS__n12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1101.1" y="644.58" /><mxPoint x="1170.7" y="678.8" /><mxPoint x="1170.7" y="678.8" /><mxPoint x="1170.7" y="678.8" /><mxPoint x="1200.9" y="719.05" /></Array></mxGeometry></mxCell><mxCell id="card_OV_CLASS__note" value="Hợp nhất các lớp và thuộc tính từ 4 sơ đồ; bội số ghi trên liên kết. Mô hình miền kết nối danh mục, độc giả, lưu thông, giữ chỗ, chính sách và sổ phí. Các thành phần kỹ thuật nằm trong vùng Thành phần." style="text;html=1;fontFamily=Arial;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="content_card_OV_CLASS"><mxGeometry x="24" y="1385" width="1616.9" height="70" as="geometry" /></mxCell><mxCell id="board_42" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Mục đích:&lt;/b&gt; UML lớp — Tổng quát mô hình miền toàn hệ thống&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; Hộp lớp gồm tên và thuộc tính. Bội số ở liên kết cho biết số đối tượng được phép liên quan; đây là mô hình miền, không là flow.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách hoạt động:&lt;/b&gt; Đọc từ BookEdition → BookCopy → LoanItem → Loan để nối tài nguyên với giao dịch. Reader nối thẻ, mượn, đặt trước và sổ phí. PolicyVersion đóng băng quy tắc. BookAuthor / BookCategory và PaymentAllocation là lớp nối. Các lớp vận hành kỹ thuật được thể hiện ở Thành phần và ERD, không gộp vào thực thể miền.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lưu ý / ràng buộc:&lt;/b&gt; Hợp nhất các lớp và thuộc tính từ 4 sơ đồ; bội số ghi trên liên kết. Mô hình miền kết nối danh mục, độc giả, lưu thông, giữ chỗ, chính sách và sổ phí. Các thành phần kỹ thuật nằm trong vùng Thành phần.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="1822" y="7126" width="570" height="1530" /></mxCell><mxCell id="card_Classes_Catalog" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#A8BACB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="2487" y="7021" width="1462" height="1043" /></mxCell><mxCell id="board_44" value="CHI TIẾT • Classes_Catalog UML lớp — Danh mục và độc giả" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=22;fontStyle=1;fillColor=#EAF2F8;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="2499" y="7031" width="1438" height="80" /></mxCell><mxCell id="content_card_Classes_Catalog" value="" style="group;" vertex="1" parent="1"><mxGeometry as="geometry" x="2507" y="7126" width="822" height="903" /></mxCell><mxCell id="card_Classes_Catalog__title" value="UML lớp — Danh mục và độc giả" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="content_card_Classes_Catalog"><mxGeometry x="24" y="16" width="731.76" height="40" as="geometry" /></mxCell><mxCell id="card_Classes_Catalog__n0" value="&lt;b&gt;BookEdition&lt;/b&gt;&lt;hr&gt;+id: UUID&lt;br&gt;+isbn: String?&lt;br&gt;+title: String&lt;br&gt;+publicationYear: Integer&lt;br&gt;+version: Integer" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=0;align=left;spacing=6;" vertex="1" parent="content_card_Classes_Catalog"><mxGeometry x="274.60720000000003" y="414.9988" width="160.9056" height="123.60239999999999" as="geometry" /></mxCell><mxCell id="card_Classes_Catalog__n1" value="&lt;b&gt;BookCopy&lt;/b&gt;&lt;hr&gt;+id: UUID&lt;br&gt;+barcode: String&lt;br&gt;+status: CopyStatus&lt;br&gt;+locationId: UUID&lt;br&gt;+version: Integer" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=0;align=left;spacing=6;" vertex="1" parent="content_card_Classes_Catalog"><mxGeometry x="587.9784000000001" y="369.9988" width="132.7032" height="123.60239999999999" as="geometry" /></mxCell><mxCell id="card_Classes_Catalog__n2" value="&lt;b&gt;Author&lt;/b&gt;&lt;hr&gt;+id: UUID&lt;br&gt;+name: String" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=0;align=left;spacing=6;" vertex="1" parent="content_card_Classes_Catalog"><mxGeometry x="306.4132" y="249.3988" width="97.2936" height="76.8024" as="geometry" /></mxCell><mxCell id="card_Classes_Catalog__n3" value="&lt;b&gt;BookAuthor&lt;/b&gt;&lt;hr&gt;+editionId: UUID&lt;br&gt;+authorId: UUID&lt;br&gt;+ordinal: Integer" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=0;align=left;spacing=6;" vertex="1" parent="content_card_Classes_Catalog"><mxGeometry x="598.4580000000001" y="241.6012" width="111.744" height="92.39760000000001" as="geometry" /></mxCell><mxCell id="card_Classes_Catalog__n4" value="&lt;b&gt;Publisher&lt;/b&gt;&lt;hr&gt;+id: UUID&lt;br&gt;+name: String" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=0;align=left;spacing=6;" vertex="1" parent="content_card_Classes_Catalog"><mxGeometry x="76.8652" y="438.3988" width="97.2936" height="76.8024" as="geometry" /></mxCell><mxCell id="card_Classes_Catalog__n5" value="&lt;b&gt;Category&lt;/b&gt;&lt;hr&gt;+id: UUID&lt;br&gt;+code: String&lt;br&gt;+parentId: UUID?" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=0;align=left;spacing=6;" vertex="1" parent="content_card_Classes_Catalog"><mxGeometry x="296.2972" y="650.6012" width="117.52560000000001" height="92.39760000000001" as="geometry" /></mxCell><mxCell id="card_Classes_Catalog__n6" value="&lt;b&gt;BookCategory&lt;/b&gt;&lt;hr&gt;+editionId: UUID&lt;br&gt;+categoryId: UUID" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=0;align=left;spacing=6;" vertex="1" parent="content_card_Classes_Catalog"><mxGeometry x="592.6836000000001" y="658.3987999999999" width="123.2928" height="76.8024" as="geometry" /></mxCell><mxCell id="card_Classes_Catalog__n7" value="&lt;b&gt;MediaAsset&lt;/b&gt;&lt;hr&gt;+id: UUID&lt;br&gt;+objectKey: String&lt;br&gt;+status: AssetStatus" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=0;align=left;spacing=6;" vertex="1" parent="content_card_Classes_Catalog"><mxGeometry x="586.8984" y="529.6012000000001" width="134.8632" height="92.39760000