edge="1" parent="content_card_ST_F12" source="card_ST_F12__n3" target="card_ST_F12__n5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="139.546" y="371.929" /><mxPoint x="154.183" y="390.088" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F12__e5" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F12" source="card_ST_F12__n4" target="card_ST_F12__n5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="214.55" y="371.929" /><mxPoint x="199.67" y="390.088" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F12__note" value="EligibilityCheck" style="text;html=1;fontFamily=Arial;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="content_card_ST_F12"><mxGeometry x="24" y="466" width="359.34" height="70" as="geometry" /></mxCell><mxCell id="board_153" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chức năng:&lt;/b&gt; F12 ↔ UC11 — Kiểm tra điều kiện độc giả&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Người thao tác:&lt;/b&gt; Thủ thư; dịch vụ nội bộ&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chủ thể / phạm vi:&lt;/b&gt; EligibilityCheck&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; Nút = trạng thái của chủ thể; cạnh = sự kiện [điều kiện] / hành động. Nút đen bắt đầu; nút kép kết thúc phiên được mô tả.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Hoạt động:&lt;/b&gt; Nhận readerId, operation và thời điểm. → Lấy thẻ, dư nợ, khoản OPEN quá hạn và chính sách hiệu lực. → Đánh giá tất cả điều kiện, trả danh sách lý do có mã. → Checkout/renew phải kiểm tra lại trong giao dịch; kết quả xem trước không bảo đảm khóa chỗ.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Quy tắc đề xuất:&lt;/b&gt; Tính lại tại thời điểm ghi giao dịch. Với mượn/gia hạn: áp dụng thẻ, quá hạn và QĐ08; trả sách không dùng cổng chặn này.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lỗi / ngoại lệ:&lt;/b&gt; Không tìm thấy độc giả: 404; không quyền xem: 403. Ngưỡng 50.000 và yêu cầu không nợ là mâu thuẫn cần duyệt, baseline dùng QĐ08.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Kết quả / bất biến:&lt;/b&gt; Không thay đổi dữ liệu; trả allowed và reasons nhất quán với operation.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="8525" y="13787" width="570" height="635" /></mxCell><mxCell id="card_ST_F13" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#A8BACB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="14603" width="1197" height="849" /></mxCell><mxCell id="board_155" value="CHI TIẾT • ST_F13 F13 — Thống kê và báo cáo" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=22;fontStyle=1;fillColor=#EAF2F8;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="112" y="14613" width="1173" height="80" /></mxCell><mxCell id="content_card_ST_F13" value="" style="group;" vertex="1" parent="1"><mxGeometry as="geometry" x="120" y="14708" width="557" height="709" /></mxCell><mxCell id="card_ST_F13__title" value="F13 — Thống kê và báo cáo" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="content_card_ST_F13"><mxGeometry x="24" y="16" width="466.56" height="40" as="geometry" /></mxCell><mxCell id="card_ST_F13__n0" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;ellipse;fillColor=#243444;" vertex="1" parent="content_card_ST_F13"><mxGeometry x="274.87" y="90.00000000000001" width="12.959999999999999" height="12.959999999999999" as="geometry" 