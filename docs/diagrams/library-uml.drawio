mượn, trả, gia hạn, giữ chỗ; dùng dữ liệu sách / thẻ / chính sách và tình trạng phí. Kết quả cập nhật kho lưu thông / giữ chỗ; dữ liệu phát sinh phí được chuyển tới P3. Nhận trả không phụ thuộc việc thu tiền đã hoàn tất.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lưu ý / ràng buộc:&lt;/b&gt; A=A1..A4; B=B1..B4; C=C1+C2; D=D1+D2. Không có luồng thực thể→kho hoặc kho→kho.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="6500" y="10682" width="570" height="525" /></mxCell><mxCell id="card_DFD_Finance" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#A8BACB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="7165" y="10577" width="1272" height="741" /></mxCell><mxCell id="board_94" value="CHI TIẾT • DFD_Finance DFD mức 1 — Chi tiết P3" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=22;fontStyle=1;fillColor=#EAF2F8;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="7177" y="10587" width="1248" height="80" /></mxCell><mxCell id="content_card_DFD_Finance" value="" style="group;" vertex="1" parent="1"><mxGeometry as="geometry" x="7185" y="10682" width="632" height="601" /></mxCell><mxCell id="card_DFD_Finance__title" value="DFD mức 1 — Chi tiết P3" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="content_card_DFD_Finance"><mxGeometry x="24" y="16" width="541.9200000000001" height="40" as="geometry" /></mxCell><mxCell id="card_DFD_Finance__n0" value="E1 Nhân viên" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_DFD_Finance"><mxGeometry x="305.5796" y="90" width="103.96079999999999" heig