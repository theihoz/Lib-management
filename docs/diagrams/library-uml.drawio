ial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_DFD_Finance" source="card_DFD_Finance__n2" target="card_DFD_Finance__n1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="293.11" y="280.37" /><mxPoint x="258.83000000000004" y="256.82000000000005" /></Array></mxGeometry></mxCell><mxCell id="card_DFD_Finance__note" value="A=A1..A4; B=B1..B4; C=C1+C2; D=D1+D2. Không có luồng thực thể→kho hoặc kho→kho." style="text;html=1;fontFamily=Arial;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="content_card_DFD_Finance"><mxGeometry x="24" y="475.67" width="561.9200000000001" height="70" as="geometry" /></mxCell><mxCell id="board_96" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Mục đích:&lt;/b&gt; DFD mức 1 — Chi tiết P3&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; Hình tròn / ellipse là tiến trình; hộp là thực thể ngoài; kho là nơi lưu dữ liệu. Mũi tên có nhãn là dữ liệu được chuyển.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách hoạt động:&lt;/b&gt; P3 nhận dữ liệu phát sinh phí từ lưu thông và yêu cầu thu / điều chỉnh của nhân viên. Tiến trình đọc chính sách và sổ hiện tại, ghi charge / payment / allocation / waiver rồi trả biên nhận và dư nợ. Dữ liệu nghĩa vụ được P2 dùng để xét điều kiện.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lưu ý / ràng buộc:&lt;/b&gt; A=A1..A4; B=B1..B4; C=C1+C2; D=D1+D2. Không có luồng thực thể→kho hoặc kho→kho.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="7832" y="10682" width="570" height="621" /></mxCell><mxCell id="card_DFD_Reporting" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#A8BACB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="11790" width="1645" height="634" /></mxCell><mxCell id="board_98" value="CHI TIẾT • DFD_Reporting DFD mức 1 — Chi tiết P4" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=22;fontStyle=1;fillColor=#EAF2F8;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="112" y="11800" width="1621" height="80" /></mxCell><mxCell id="content_card_DFD_Reporting" value="" style="group;" vertex="1" parent="1"><mxGeometry as="geometry" x="120" y="11895" width="1005" height="494" /></mxCell><mxCell id="card_DFD_Reporting__title" value="DFD mức 1 — Chi tiết P4" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="content_card_DFD_Reporting"><mxGeometry x="24" y="16" width="914.48" height="40" as="geometry" /></mxCell><mxCell id="card_DFD_Reporting__n0" value="E1 Nhân viên" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_DFD_Reporting"><mxGeometry x="69.99860000000001" y="90.80000000000001" width="103.96079999999999" height="36" as="geometry" /></mxCell><mxCell id="card_DFD_Reporting__n1" value="E2 Độc giả" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_DFD_Reporting"><mxGeometry x="311.70120000000003" y="296.94" width="94.5576" height="36" as="geometry" /></mxCell><mxCell id="card_DFD_Reporting__n2" value="P4 Khai thác và quy định" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;ellipse;" vertex="1" parent="content_card_DFD_Reporting"><mxGeometry x="298.35080000000005" y="187.60204" width="251.2584" height="48.53592" as="geometry" /></mxCell><mxCell id="card_DFD_Reporting__n3" value="D1 Catalog / Copy" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF