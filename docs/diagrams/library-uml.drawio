99999999997" y="695.05" /><mxPoint x="266" y="706.76" /><mxPoint x="266" y="706.76" /><mxPoint x="266" y="706.76" /><mxPoint x="243.78" y="722.3399999999999" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F05__e10" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F05" source="card_AD_F05__n8" target="card_AD_F05__n9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="365.57" y="808.9" /><mxPoint x="336.13" y="828.978" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F05__note" value="Vai trò hành động ghi trong nút; nhánh lỗi kết thúc yêu cầu, dữ liệu không ghi một phần." style="text;html=1;fontFamily=Arial;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="content_card_AD_F05"><mxGeometry x="24" y="900.52" width="568.46" height="70" as="geometry" /></mxCell><mxCell id="board_226" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chức năng:&lt;/b&gt; F05 ↔ UC1.2 — Quản lý nhà xuất bản&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Người thao tác:&lt;/b&gt; Thủ thư&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chủ thể / phạm vi:&lt;/b&gt; Một lần thực hiện chức năng; từ bắt đầu đến kết quả&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; Đọc theo mũi tên; chữ nhật là hoạt động, hình thoi chọn nhánh theo guard. Nhánh lỗi phải sửa hoặc kết thúc; không bỏ qua bước kiểm tra.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Hoạt động:&lt;/b&gt; Tra cứu nhà xuất bản. → Thêm/sửa tên và thông tin liên hệ. → Kiểm tra dữ liệu, version; lưu. → Xóa bị chặn nếu đầu sách đang tham chiếu.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Quy tắc đề xuất:&lt;/b&gt; Mỗi ấn bản có nhà xuất bản tùy chọn; không lấy tên làm khóa chính.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lỗi / ngoại lệ:&lt;/b&gt; Version cũ: 409; tham chiếu còn tồn tại: 409; lỗi trường: 422.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Kết quả / bất biến:&lt;/b&gt; Giữ được thông tin ấn bản và lịch sử.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="8344" y="16926" width="570" height="1046" /></mxCell><mxCell id="card_AD_F06" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#A8BACB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="18716" width="1316" height="1228" /></mxCell><mxCell id="board_228" value="CHI TIẾT • AD_F06 F06 — Luồng Quản lý độc giả và thẻ" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=22;fontStyle=1;fillColor=#EAF2F8;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="112" y="18726" width="1292" height="80" /></mxCell><mxCell id="content_card_AD_F06" value="" style="group;" vertex="1" parent="1"><mxGeometry as="geometry" x="120" y="18821" width="676" height="1088" /></mxCell><mxCell id="card_AD_F06__title" value="F06 — Luồng Quản lý độc giả và thẻ" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="content_card_AD_F06"><mxGeometry x="24" y="16" width="585.11" height="40" as="geometry" /></mxCell><mxCell id="card_AD_F06__n0" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;ellipse;fillColor=#243444;" vertex="1" parent="content_card_AD_F06"><mxGeometry x="201.01000000000002" y="89.9999999999999" width="12.959999999999999" height="12.959999999999999" as="geometry" /></mxCell><mxCell id="card_AD_F06__n1" value="Người dùng&lt;br&gt;Nhập độc giả, loại X/Y/Z, ngày sinh và&lt;br&gt;email." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeC