"1" as="geometry"><Array as="points"><mxPoint x="365.57" y="855.7" /><mxPoint x="336.13" y="875.778" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F03__note" value="Vai trò hành động ghi trong nút; nhánh lỗi kết thúc yêu cầu, dữ liệu không ghi một phần." style="text;html=1;fontFamily=Arial;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="content_card_AD_F03"><mxGeometry x="24" y="947.32" width="582" height="70" as="geometry" /></mxCell><mxCell id="board_218" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chức năng:&lt;/b&gt; F03 ↔ UC3 — Quản lý thể loại phân cấp&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Người thao tác:&lt;/b&gt; Thủ thư&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chủ thể / phạm vi:&lt;/b&gt; Một lần thực hiện chức năng; từ bắt đầu đến kết quả&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; Đọc theo mũi tên; chữ nhật là hoạt động, hình thoi chọn nhánh theo guard. Nhánh lỗi phải sửa hoặc kết thúc; không bỏ qua bước kiểm tra.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Hoạt động:&lt;/b&gt; Chọn thêm/sửa thể loại dưới một gốc. → Kiểm tra cha tồn tại, không phải chính nó hoặc hậu duệ. → Lưu parentId trong giao dịch; kiểm soát cạnh tranh. → Xóa chỉ khi không có con và liên kết đầu sách.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Quy tắc đề xuất:&lt;/b&gt; QĐ04: giữ ba gốc A/B/C; không có chu trình; không tự làm mất liên kết đầu sách.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lỗi / ngoại lệ:&lt;/b&gt; Chu trình, xóa gốc, có con hoặc đang được dùng: 409; người dùng chọn cha khác hoặc ngừng dùng.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Kết quả / bất biến:&lt;/b&gt; Cây luôn có gốc A/B/C; đường dẫn không đệ quy vô hạn.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="5644" y="16926" width="570" height="1093" /></mxCell><mxCell id="card_AD_F04" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#A8BACB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="6309" y="16821" width="1301" height="1213" /></mxCell><mxCell id="board_220" value="CHI TIẾT • AD_F04 F04 — Luồng Quản lý tác giả" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=22;fontStyle=1;fillColor=#EAF2F8;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="6321" y="16831" width="1277" height="80" /></mxCell><mxCell id="content_card_AD_F04" value="" style="group;" vertex="1" parent="1"><mxGeometry as="geometry" x="6329" y="16926" width="661" height="1073" /></mxCell><mxCell id="card_AD_F04__title" value="F04 — Luồng Quản lý tác giả" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="content_card_AD_F04"><mxGeometry x="24" y="16" width="570.73" height="40" as="geometry" /></mxCell><mxCell id="card_AD_F04__n0" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;ellipse;fillColor=#243444;" vertex="1" parent="content_card_AD_F04"><mxGeometry x="204.01000000000002" y="90.00000000000001" width="12.959999999999999" height="12.959999999999999" as="geometry" /></mxCell><mxCell id="card_AD_F04__n1" value="Người dùng&lt;br&gt;Tìm tác giả trước khi tạo." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F04"><mxGeometry x="119.15440000000001" y="151.96012000000007" width="182.6712" height="49.91976" as="geometry" /></mxCell><mxCell id="card_AD_F04__n2" value="API&lt;br&gt;Kiểm tra quyền và input" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fi