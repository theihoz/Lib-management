 /><mxPoint x="484.97" y="393.16" /><mxPoint x="449.97" y="247.96000000000004" /><mxPoint x="449.97" y="247.96000000000004" /><mxPoint x="449.97" y="247.96000000000004" /><mxPoint x="409.07" y="216.15000000000003" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F22___label7" value="hủy" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_ST_F22_"><mxGeometry x="247.07999999999998" y="209.46000000000004" width="25.1" height="17" as="geometry" /></mxCell><mxCell id="card_ST_F22___e7" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F22_" source="card_ST_F22___n1" target="card_ST_F22___n6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="277.83000000000004" y="200.98000000000002" /><mxPoint x="215.77" y="226.46000000000004" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F22___e8" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F22_" source="card_ST_F22___n6" target="card_ST_F22___n7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="121.973" y="298.84000000000003" /><mxPoint x="121.973" y="320.25" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F22___note" value="AcquisitionReceipt" style="text;html=1;fontFamily=Arial;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="content_card_ST_F22_"><mxGeometry x="24" y="608.1600000000001" width="633.17" height="70" as="geometry" /></mxCell><mxCell id="board_193" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chức năng:&lt;/b&gt; F22 ↔ UC19 — Nhập sách và thanh lý&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Người thao tác:&lt;/b&gt; Thủ thư; Quản lý duyệt&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chủ thể / phạm vi:&lt;/b&gt; AcquisitionReceipt&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; Nút = trạng thái của chủ thể; cạnh = sự kiện [điều kiện] / hành động. Nút đen bắt đầu; nút kép kết thúc phiên được mô tả.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Hoạt động:&lt;/b&gt; Lập phiếu nhập BM01 với đầu sách, số lượng, đơn giá và nguồn cung. → Kiểm tra tổng số lượng, số tiền và dải barcode chưa trùng. → Duyệt phiếu rồi tạo từng BookCopy cùng giao dịch; giữ tham chiếu nguồn nhập. → Thanh lý từng bản sao qua hồ sơ riêng, không xóa lịch sử và chỉ khi không có nghĩa vụ mở.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Quy tắc đề xuất:&lt;/b&gt; Mở rộng nghiệp vụ tiếp nhận/kiểm kê từ PDF; giữ BM01; đếm vật lý theo bản sao, đơn giá VND.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lỗi / ngoại lệ:&lt;/b&gt; Barcode trùng hoặc số lượng không khớp: không commit phiếu. Phiếu đã POSTED không sửa trực tiếp; điều chỉnh bằng chứng từ mới.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Kết quả / bất biến:&lt;/b&gt; Tổng tiền = tổng quantity×unitPrice; từng copy có nguồn nhập.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="3366" y="15738" width="570" height="754" /></mxCell><mxCell id="card_ST_F23_" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#A8BACB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="4031" y="15633" width="1387" height="958" /></mxCell><mxCell id="board_195" value="CHI TIẾT • ST_F23 F23 — Sao lưu và phục hồi" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=22;fontStyle=1;fillColor=#EAF2F8;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="4043" y="15643" 