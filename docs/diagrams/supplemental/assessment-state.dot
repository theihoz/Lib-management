digraph G { graph [rankdir=LR,bgcolor="white",pad="0.4"]; node [shape=box,style="rounded,filled",fillcolor="#f6f2e9",fontname="Arial",fontsize=16]; edge [fontname="Arial",fontsize=13]; start [shape=point]; P [label="PENDING\nThủ thư đề xuất có lý do"]; A [label="ASSESSED\nFineCharge > 0"]; C [label="CLOSED_NO_CHARGE\nKhông tạo charge bằng 0"]; start -> P [label="Nhận trả DAMAGE / ghi mất LOST"]; P -> A [label="Quản lý quyết định [amount > 0] / ghi phí + audit"]; P -> C [label="Quản lý quyết định [amount = 0] / ghi lý do + audit"]; N [shape=note,label="PENDING chặn mượn, gia hạn, đặt trước\nKhông chặn nhận trả\nTerminal: điều chỉnh qua ledger, không duyệt lại"]; }