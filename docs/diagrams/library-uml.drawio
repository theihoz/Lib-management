9999999999" /><mxPoint x="788.94" y="660.248" /></Array></mxGeometry></mxCell><mxCell id="card_Classes_Circulation__label15" value="0..1 fulfilled item — 0..1" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_Classes_Circulation"><mxGeometry x="693.15" y="491.0" width="156.20000000000002" height="17" as="geometry" /></mxCell><mxCell id="card_Classes_Circulation__e15" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;endArrow=none;" edge="1" parent="content_card_Classes_Circulation" source="card_Classes_Circulation__n2" target="card_Classes_Circulation__n4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="753.13" y="520.17" /><mxPoint x="822.66" y="553" /><mxPoint x="822.66" y="553" /><mxPoint x="822.66" y="553" /><mxPoint x="833.82" y="562.11" /></Array></mxGeometry></mxCell><mxCell id="card_Classes_Circulation__note" value="LoanItem OPEN xác định bằng closedAt IS NULL. Không lưu lại tổng dư nợ như nguồn chân lý; tính từ ledger." style="text;html=1;fontFamily=Arial;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="content_card_Classes_Circulation"><mxGeometry x="24" y="763" width="1269" height="70" as="geometry" /></mxCell><mxCell id="board_50" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Mục đích:&lt;/b&gt; UML lớp — Mượn, giữ chỗ và sổ phí&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; Hộp lớp gồm tên và thuộc tính. Bội số ở liên kết cho biết số đối tượng được phép liên quan; đây là mô hình miền, không là flow.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách hoạt động:&lt;/b&gt; Reader tạo Loan gồm nhiều LoanItem, mỗi item gắn BookCopy và PolicyVersion. Reservation đặt theo BookEdition, chỉ gắn copy khi READY. ReturnEvent đóng item. FineCharge, Payment, PaymentAllocation và Waiver lưu sổ phí riêng; dư nợ được tính từ sổ, không cập nhật bằng một tổng tùy ý.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lưu ý / ràng buộc:&lt;/b&gt; LoanItem OPEN xác định bằng closedAt IS NULL. Không lưu lại tổng dư nợ như nguồn chân lý; tính từ ledger.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="5383" y="7126" width="570" height="908" /></mxCell><mxCell id="card_Class_Loan_Hold" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#A8BACB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="6048" y="7021" width="1377" height="1018" /></mxCell><mxCell id="board_52" value="CHI TIẾT • Class_Loan_Hold UML chi tiết — Lưu thông" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=22;fontStyle=1;fillColor=#EAF2F8;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="6060" y="7031" width="1353" height="80" /></mxCell><mxCell id="content_card_Class_Loan_Hold" value="" style="group;" vertex="1" parent="1"><mxGeometry as="geometry" x="6068" y="7126" width="737" height="878" /></mxCell><mxCell id="card_Class_Loan_Hold__title" value="UML chi tiết — Lưu thông" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="content_card_Class_Loan_Hold"><mxGeometry x="24" y="16" width="646.11" height="40" as="geometry" /></mxCell><mxCell id="card_Class_Loan_Hold__n0" value="&lt;b&gt;Reader&lt;/b&gt;&lt;hr&gt;+id: UUID" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=0;align=left;spacing=6;" vertex="1" parent="content_card_Class_Loan_Hold"><mxGeometry x="69.9986" y="90.00000000000003" width="72.7128" height="61.199999999999996" as="geometry" /></mxCell><mxCell id="card_Class_Loan_Hold__n1" value="&