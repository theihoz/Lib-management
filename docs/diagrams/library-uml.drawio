source="card_OV_UC__n4" target="card_OV_UC__n26"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="265.43" y="2232.59" /><mxPoint x="319.77" y="2222.37" /></Array></mxGeometry></mxCell><mxCell id="card_OV_UC__e32" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;endArrow=none;" edge="1" parent="content_card_OV_UC" source="card_OV_UC__n4" target="card_OV_UC__n28"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="264.69" y="2272.89" /><mxPoint x="317.84000000000003" y="2282.7" /></Array></mxGeometry></mxCell><mxCell id="card_OV_UC__e33" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;endArrow=none;" edge="1" parent="content_card_OV_UC" source="card_OV_UC__n5" target="card_OV_UC__n29"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="281.64" y="2413" /><mxPoint x="328" y="2413" /></Array></mxGeometry></mxCell><mxCell id="card_OV_UC__note" value="Quan hệ giữ nguyên từ 3 UC chi tiết. UC0 là mục tiêu xác thực riêng; không nối include đăng nhập vào mọi UC. UC18–21* là phạm vi mở rộng cần duyệt." style="text;html=1;fontFamily=Arial;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="content_card_OV_UC"><mxGeometry x="24" y="2499" width="962.39" height="70" as="geometry" /></mxCell><mxCell id="board_10" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Mục đích:&lt;/b&gt; UC — Tổng quát toàn hệ thống: vai trò và mục tiêu&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; Actor ở ngoài biên hệ thống; ellipse là mục tiêu. Association không có hướng thực thi; include / extend là đường đứt có hướng.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách hoạt động:&lt;/b&gt; Hợp nhất toàn bộ actor và UC của ba vùng chi tiết. Đường nối actor–UC thể hiện actor sử dụng mục tiêu đó; không thể hiện thứ tự bước. include đi từ UC chính tới hành vi bắt buộc; extend đi từ hành vi bổ sung tới UC được mở rộng, có điều kiện trên cạnh. Đăng nhập là mục tiêu riêng; phân quyền là tiền điều kiện.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lưu ý / ràng buộc:&lt;/b&gt; Quan hệ giữ nguyên từ 3 UC chi tiết. UC0 là mục tiêu xác thực riêng; không nối include đăng nhập vào mọi UC. UC18–21* là phạm vi mở rộng cần duyệt.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="1168" y="1165" width="570" height="2644" /></mxCell><mxCell id="card_UC_Catalog" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#A8BACB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="1833" y="1060" width="1267" height="1159" /></mxCell><mxCell id="board_12" value="CHI TIẾT • UC_Catalog UC — Danh mục và thẻ" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=22;fontStyle=1;fillColor=#EAF2F8;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="1845" y="1070" width="1243" height="80" /></mxCell><mxCell id="content_card_UC_Catalog" value="" style="group;" vertex="1" parent="1"><mxGeometry as="geometry" x="1853" y="1165" width="627" height="1019" /></mxCell><mxCell id="card_UC_Catalog__title" value="UC — Danh mục và thẻ" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="content_card_UC_Catalog"><mxGeometry x="24" y="16" width="536.56" height="40" as="geometry" /></mxCell><mxCell id="card_UC_Catalog__boundary" value="Phần mềm quản lý thư viện" style="rounded=0;html=1;fillColor=none;strokeColor=#657585;verticalAlign=top;align=left;fontSize=16;" vertex="1" parent="content_card_UC_Catalog"><mxGeometry x="194.13" y="98" width="324.43" height="753" as="geometry" /></mxCell><