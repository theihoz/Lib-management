__n1" target="card_ST_F01__n6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="358.59" y="227.65000000000003" /><mxPoint x="344.34" y="319.96000000000004" /><mxPoint x="344.34" y="319.96000000000004" /><mxPoint x="344.34" y="319.96000000000004" /><mxPoint x="339.37" y="331.94000000000005" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F01__label8" value="hủy / không lưu" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_ST_F01"><mxGeometry x="257.3" y="305.46000000000004" width="93.5" height="17" as="geometry" /></mxCell><mxCell id="card_ST_F01__e8" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F01" source="card_ST_F01__n2" target="card_ST_F01__n6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="246.12" y="299.77000000000004" /><mxPoint x="268.75" y="319.96000000000004" /><mxPoint x="268.75" y="319.96000000000004" /><mxPoint x="268.75" y="319.96000000000004" /><mxPoint x="293.46000000000004" y="337.25" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F01__note" value="Phiên sửa BookEdition" style="text;html=1;fontFamily=Arial;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="content_card_ST_F01"><mxGeometry x="24" y="596.1600000000001" width="523.49" height="70" as="geometry" /></mxCell><mxCell id="board_109" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chức năng:&lt;/b&gt; F01 ↔ UC1 — Quản lý đầu sách&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Người thao tác:&lt;/b&gt; Thủ thư&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chủ thể / phạm vi:&lt;/b&gt; Phiên sửa BookEdition&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; Nút = trạng thái của chủ thể; cạnh = sự kiện [điều kiện] / hành động. Nút đen bắt đầu; nút kép kết thúc phiên được mô tả.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Hoạt động:&lt;/b&gt; Chọn thêm hoặc sửa đầu sách; tải phiên bản hiện tại. → Nhập tên, năm, ISBN, nhà xuất bản, tác giả và thể loại. → Kiểm tra năm, tham chiếu và ISBN; khóa lạc quan bằng version. → Lưu đầu sách; ghi audit; trả dữ liệu mới.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Quy tắc đề xuất:&lt;/b&gt; QĐ03: năm xuất bản trong 8 năm; ISBN chuẩn hóa và duy nhất khi có; nhiều tác giả, thể loại.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lỗi / ngoại lệ:&lt;/b&gt; ISBN trùng: 409; version cũ: 409; dữ liệu sai: 422. Xóa bị chặn khi còn bản sao hoặc lịch sử; dùng ngừng khai thác.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Kết quả / bất biến:&lt;/b&gt; Không đổi số lượng bản sao bằng cách sửa đầu sách. Bản ghi hợp lệ hoặc toàn bộ thao tác không lưu.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="2308" y="12759" width="570" height="742" /></mxCell><mxCell id="card_ST_F02" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#A8BACB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="2973" y="12654" width="2251" height="957" /></mxCell><mxCell id="board_111" value="CHI TIẾT • ST_F02 F02 — Quản lý bản sao và mã vạch" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=22;fontStyle=1;fillColor=#EAF2F8;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="2985" y="12664" width="2227" height="80" /></mxCell><mxCell id="content_card_ST_F02" value="" style="group;" vertex="1" parent="1"><mxGeometry as="geometry" x="2993" y="12759" width="1611" height="817" /></mxCell><mxCell id="card_ST_F02__title" value="F02 — Quản lý b