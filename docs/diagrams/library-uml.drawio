y"><Array as="points"><mxPoint x="408.21" y="194.25" /><mxPoint x="419.91" y="226.8" /><mxPoint x="419.91" y="226.8" /><mxPoint x="419.91" y="226.8" /><mxPoint x="419.91" y="334.8" /><mxPoint x="419.91" y="334.8" /><mxPoint x="419.91" y="334.8" /><mxPoint x="382.86" y="366.49" /></Array></mxGeometry></mxCell><mxCell id="card_ERD_Finance__note" value="Bảng liên kết Author/Category, Media, Waiver, Audit, Outbox, Idempotency và Jobs mô tả thêm trong từ điển dữ liệu." style="text;html=1;fontFamily=Arial;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="content_card_ERD_Finance"><mxGeometry x="24" y="659" width="475.29" height="70" as="geometry" /></mxCell><mxCell id="board_75" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Mục đích:&lt;/b&gt; ERD chi tiết — Sổ phí&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; PK = khóa chính; FK = tham chiếu; UQ = duy nhất; ? = tùy chọn. Nhãn bội số phản ánh quan hệ, không phải thứ tự gọi.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách hoạt động:&lt;/b&gt; readers liên kết fine_charges và payments. payment_allocations là bảng nối khoản thu với khoản phí; policy_versions lưu quy tắc tính. Tổng allocation không vượt payment / nghĩa vụ còn lại. fine_charges giữ lý do và liên kết item khi có; Waiver được bổ sung ở ERD tổng quát.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lưu ý / ràng buộc:&lt;/b&gt; Bảng liên kết Author/Category, Media, Waiver, Audit, Outbox, Idempotency và Jobs mô tả thêm trong từ điển dữ liệu.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="6869" y="9006" width="570" height="804" /></mxCell><mxCell id="board_76" value="&lt;b&gt;07 — LUỒNG DỮ LIỆU&lt;/b&gt;&lt;br&gt;Mức 0, phân rã P0 và các vùng xử lý P1–P4." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=24;fillColor=#16324F;fontColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="10447" width="9800" height="95" /></mxCell><mxCell id="card_DFD_Level1" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#A8BACB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="10577" width="2533" height="1153" /></mxCell><mxCell id="board_78" value="TỔNG QUÁT TOÀN HỆ THỐNG • DFD_Level1 DFD mức 1 — phân rã P0" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=22;fontStyle=1;fillColor=#DDF2E7;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="112" y="10587" width="2509" height="80" /></mxCell><mxCell id="content_card_DFD_Level1" value="" style="group;" vertex="1" parent="1"><mxGeometry as="geometry" x="120" y="10682" width="1893" height="1013" /></mxCell><mxCell id="card_DFD_Level1__title" value="DFD mức 1 — phân rã P0" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="content_card_DFD_Level1"><mxGeometry x="24" y="16" width="1802.7" height="40" as="geometry" /></mxCell><mxCell id="card_DFD_Level1__n0" value="E1 Nhân viên" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_DFD_Level1"><mxGeometry x="1168.3196" y="90" width="103.96079999999999" height="36" as="geometry" /></mxCell><mxCell id="card_DFD_Level1__n1" value="E2 Độc giả" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_DFD_Level1"><mxGeometry x="664.0111999999999" y="816.1400000000001" width="94.5576" height="36" as="geometry" /></mxCell><mxCell id="card_DFD_Level1__n2" value="P1 Danh mục và thẻ" style="html=1;whiteSpace=wrap;fontFamil