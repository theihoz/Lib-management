eometry relative="1" as="geometry"><Array as="points"><mxPoint x="738.69" y="1354.79" /><mxPoint x="777.32" y="1377.79" /></Array></mxGeometry></mxCell><mxCell id="card_OV_ACTIVITY__label27" value="hoàn tất yêu cầu" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_OV_ACTIVITY"><mxGeometry x="935.59" y="1472.66" width="99.2" height="17" as="geometry" /></mxCell><mxCell id="card_OV_ACTIVITY__e27" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_OV_ACTIVITY" source="card_OV_ACTIVITY__n19" target="card_OV_ACTIVITY__n22"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="922.63" y="1470.789" /><mxPoint x="961.45" y="1496.547" /></Array></mxGeometry></mxCell><mxCell id="card_OV_ACTIVITY__note" value="Sơ đồ xử lý một yêu cầu, không bắt người dùng chạy mọi chức năng nối tiếp. Hình thoi 1 vào / nhiều ra là decision; nhiều vào / 1 ra là merge, không chờ mọi nhánh như join. Query / command / job loại trừ nhau; Worker có thể xử lý sau phản hồi và UI đọc trạng thái riêng." style="text;html=1;fontFamily=Arial;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="content_card_OV_ACTIVITY"><mxGeometry x="24" y="1570" width="1316.7" height="70" as="geometry" /></mxCell><mxCell id="board_206" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Mục đích:&lt;/b&gt; Activity — Tổng quát luồng xử lý toàn hệ thống&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; Đọc theo mũi tên; hoạt động và quyết định có guard. Sơ đồ thể hiện một lần xử lý, không phải vòng đời dữ liệu.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách hoạt động:&lt;/b&gt; Luồng bắt đầu khi một người dùng xác thực và chọn một chức năng. API kiểm tra trước khi phân loại yêu cầu thành query, command hoặc job. Query đọc theo quyền; command commit nguyên tử hoặc rollback; job trả mã theo dõi. Outbox / job đã commit được worker xử lý độc lập sau phản hồi. Lỗi dữ liệu quay về bước nhập.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lưu ý / ràng buộc:&lt;/b&gt; Sơ đồ xử lý một yêu cầu, không bắt người dùng chạy mọi chức năng nối tiếp. Hình thoi 1 vào / nhiều ra là decision; nhiều vào / 1 ra là merge, không chờ mọi nhánh như join. Query / command / job loại trừ nhau; Worker có thể xử lý sau phản hồi và UI đọc trạng thái riêng.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="1522" y="16926" width="570" height="1715" /></mxCell><mxCell id="card_AD_F01" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#A8BACB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="2187" y="16821" width="1329" height="1213" /></mxCell><mxCell id="board_208" value="CHI TIẾT • AD_F01 F01 — Luồng Quản lý đầu sách" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=22;fontStyle=1;fillColor=#EAF2F8;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="2199" y="16831" width="1305" height="80" /></mxCell><mxCell id="content_card_AD_F01" value="" style="group;" vertex="1" parent="1"><mxGeometry as="geometry" x="2207" y="16926" width="689" height="1073" /></mxCell><mxCell id="card_AD_F01__title" value="F01 — Luồng Quản lý đầu sách" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="content_card_AD_F01"><mxGeometry x="24" y="16" width="598.66" height="40" as="geometry" /></mxCell><mxCell id="card_AD_F01__n0" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;ellipse;fillColor=#243444;" vertex="1" parent="content_card_AD_F01"><mxGeometry x="216.29000000000002" y="90.00000000000001" width="12.959999999999999" height="12.959999999999999" as="geometry" /></mxCell><mxCell id="card_AD_F01__n1" value="Người dùng&lt;br&gt;Chọn thêm hoặc sửa đầu sách; tải phiên bản&lt;br&gt;hiện tại." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F01"><mxGeometry x="70.00040000000001" y="151.96000000000004" width="305.5392" height="65.52" as="geometry" /></mxCell><mxCell id="card_AD_F01__n2" value="API&lt;br&gt;Kiểm tra quyền và input" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F01"><mxGeometry x="137.918" y="266.48012000000006" width="169.704" height="49.91976" as="geometry" /></mxCell><mxCell id="card_AD_F01__n3" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rhombus;" vertex="1" parent="content_card_AD_F01"><mxGeometry x="210.17000000000002" y="365.4" width="25.2" height="25.2" as="geometry" /></mxCell><mxCell id="card_AD_F01__n4" value="API&lt;br&gt;Trả lỗi có mã; không ghi dữ liệu" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F01"><mxGeometry x="85.2824" y="789.5601200000001" width="220.9752" height="49.91976" as="geometry" /></mxCell><mxCell id="card_AD_F01__n5" value="Hệ thống&lt;br&gt;Nhập tên, năm, ISBN, nhà xuất bản, tác giả&lt;br&gt;và thể loại." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F01"><mxGeometry x="272.2292" y="450.6000000000001" width="291.0816" height="65.52" as="geometry" /></mxCell><mxCell id="card_AD_F01__n6" value="Hệ thống&lt;br&gt;Kiểm tra năm, tham chiếu và ISBN; khóa lạc&lt;br&gt;quan bằng version." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F01"><mxGeometry x="296.8836" y="565.1200000000001" width="291.77279999999996" height="65.52" as="geometry" /></mxCell><mxCell id="card_AD_F01__n7" value="Hệ thống&lt;br&gt;Lưu đầu sách; ghi audit; trả dữ liệu mới." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F01"><mxGeometry x="304.3452" y="679.64012" width="270.8496" height="49.91976" as="geometry" /></mxCell><mxCell id="card_AD_F01__n8" value="API&lt;br&gt;Trả kết quả và mã yêu cầu" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F01"><mxGeometry x="342.65279999999996" y="789.5601200000001" width="194.23440000000002" height="49.91976" as="geometry" /></mxCell><mxCell id="card_AD_F01__n9" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;shape=doubleEllipse;fillColor=#243444;" vertex="1" parent="content_card_AD_F01"><mxGeometry x="304.85004000000004" y="888.4800400000001" width="23.83992" height="23.83992" as="geometry" /></mxCell><mxCell id="card_AD_F01__e0" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F01" source="card_AD_F01__n0" target="card_AD_F01__n1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="222.77" y="111.7600000000001" /><mxPoint x="222.77" y="127.69000000000005" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F01__e1" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F01" source="card_AD_F01__n1" target="card_AD_F01__n2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="222.77" y="230.41000000000008" /><mxPoint x="22