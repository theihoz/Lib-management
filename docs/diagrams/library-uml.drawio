xPoint x="415.4" y="512.8700000000001" /><mxPoint x="420.22" y="527.69" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F13__e7" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F13" source="card_AD_F13__n6" target="card_AD_F13__n7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="436.03" y="627.8800000000001" /><mxPoint x="435.52" y="642.1500000000001" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F13__label8" value="[thành công]" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_AD_F13"><mxGeometry x="422.93" y="751.0600000000001" width="76.4" height="17" as="geometry" /></mxCell><mxCell id="card_AD_F13__e8" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F13" source="card_AD_F13__n7" target="card_AD_F13__n8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="433.62" y="745.83" /><mxPoint x="433.62" y="764.83" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F13__label9" value="[lỗi / rollback nếu có ghi DB]" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_AD_F13"><mxGeometry x="270.37" y="751.0600000000001" width="179.0" height="17" as="geometry" /></mxCell><mxCell id="card_AD_F13__e9" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F13" source="card_AD_F13__n7" target="card_AD_F13__n4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="323.07" y="742.3100000000001" /><mxPoint x="295.12" y="753.5600000000001" /><mxPoint x="295.12" y="753.5600000000001" /><mxPoint x="295.12" y="753.5600000000001" /><mxPoint x="266.99" y="769.5500000000001" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F13__e10" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F13" source="card_AD_F13__n8" target="card_AD_F13__n9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="374.7" y="855.7" /><mxPoint x="345.26" y="875.778" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F13__note" value="Vai trò hành động ghi trong nút; nhánh lỗi kết thúc yêu cầu, dữ liệu không ghi một phần." style="text;html=1;fontFamily=Arial;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="content_card_AD_F13"><mxGeometry x="24" y="947.32" width="617.47" height="70" as="geometry" /></mxCell><mxCell id="board_258" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chức năng:&lt;/b&gt; F13 ↔ UC16 — Thống kê và báo cáo&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Người thao tác:&lt;/b&gt; Quản lý; Thủ thư&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chủ thể / phạm vi:&lt;/b&gt; Một lần thực hiện chức năng; từ bắt đầu đến kết quả&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; Đọc theo mũi tên; chữ nhật là hoạt động, hình thoi chọn nhánh theo guard. Nhánh lỗi phải sửa hoặc kết thúc; không bỏ qua bước kiểm tra.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Hoạt động:&lt;/b&gt; Chọn kỳ và loại báo cáo; kiểm tra quyền và ngày. → Tạo job với phạm vi và mốc snapshot. → Tổng hợp số phiếu, mục mượn, tình trạng bản sao, phí và tiền thu riêng. → Tạo bản xem/biểu mẫu và lưu nguồn, bộ lọc, thời điểm dữ liệu.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Quy tắc đề xuất:&lt;/b&gt; Khoảng từ&amp;lt;=đến&amp;lt;=hôm nay; múi giờ Asia/Ho_Chi_Minh; định nghĩa rõ số phiếu khác số cuốn.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lỗi / ngoại lệ:&lt;/b&gt; Không có dữ liệu là báo cáo rỗng, không phải lỗi. Job thất bại chỉ retry lỗi tạm; không lặp vô hạn.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Kết quả / bất biến:&lt;/b&gt; Tổng chi tiết khớp tổng hợp cùng snapshot; không nhân bản tiền do join nhiều LoanItem.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="823" y="20125" width="570" height="1093" /></mxCell><mxCell id="card_AD_F14" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#A8BACB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="1488" y="20020" width="1309" height="1213" /></mxCell><mxCell id="board_260" value="CHI TIẾT • AD_F14 F14 — Luồng Cấu hình quy định" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=22;fontStyle=1;fillColor=#EAF2F8;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="1500" y="20030" width="1285" height="80" /></mxCell><mxCell id="content_card_AD_F14" value="" style="group;" vertex="1" parent="1"><mxGeometry as="geometry" x="1508" y="20125" width="669" height="1073" /></mxCell><mxCell id="card_AD_F14__title" value="F14 — Luồng Cấu hình quy định" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="content_card_AD_F14"><mxGeometry x="24" y="16" width="578.96" height="40" as="geometry" /></mxCell><mxCell id="card_AD_F14__n0" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;ellipse;fillColor=#243444;" vertex="1" parent="content_card_AD_F14"><mxGeometry x="204.01000000000002" y="90.00000000000001" width="12.959999999999999" height="12.959999999999999" as="geometry" /></mxCell><mxCell id="card_AD_F14__n1" value="Người dùng&lt;br&gt;Tạo bản nháp từ chính sách hiện hành." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F14"><mxGeometry x="75.77080000000001" y="151.96012000000007" width="269.4384" height="49.91976" as="geometry" /></mxCell><mxCell id="card_AD_F14__n2" value="API&lt;br&gt;Kiểm tra quyền và input" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F14"><mxGeometry x="125.638" y="250.88012000000003" width="169.704" height="49.91976" as="geometry" /></mxCell><mxCell id="card_AD_F14__n3" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rhombus;" vertex="1" parent="content_card_AD_F14"><mxGeometry x="197.89000000000001" y="349.80000000000007" width="25.2" height="25.2" as="geometry" /></mxCell><mxCell id="card_AD_F14__n4" value="API&lt;br&gt;Trả lỗi có mã; không ghi dữ liệu" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F14"><mxGeometry x="70.0024" y="789.5601200000001" width="220.9752" height="49.91976" as="geometry" /></mxCell><mxCell id="card_AD_F14__n5" value="Hệ thống&lt;br&gt;Kiểm tra miền giá trị, các ràng buộc liên&lt;br&gt;quan và tác động." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F14"><mxGeometry x="260.9996" y="435.00000000000006" width="272.9808" height="65.52" as="geometry" /></mxCell><mxCell id="card_AD_F14__n6" value="Hệ thống&lt;br&gt;Duyệt và lên lịch effectiveFrom; không hai&lt;br&gt;version chồng hiệu lực." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F14"><mxGeometry x="285.0944" y="549.52" width="278.7912" height="65.52" as="geometry" /></mxCell><mxCell id="card_AD_F14__n7" value="Hệ thống&lt;br&gt;Kích hoạt cho giao d