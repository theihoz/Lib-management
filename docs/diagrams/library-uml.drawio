ometry relative="1" as="geometry"><Array as="points"><mxPoint x="673.88" y="237.13400000000001" /><mxPoint x="728.32" y="249.47400000000002" /></Array></mxGeometry></mxCell><mxCell id="card_C4_Context__note" value="Các dịch vụ ngoài được bọc bởi port/adapter, không nằm trong giao dịch DB." style="text;html=1;fontFamily=Arial;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="content_card_C4_Context"><mxGeometry x="24" y="332.96000000000004" width="979.4" height="70" as="geometry" /></mxCell><mxCell id="board_27" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Mục đích:&lt;/b&gt; Ngữ cảnh hệ thống&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; Actor sử dụng hệ thống; hộp trung tâm là phần mềm; các dịch vụ ngoài ở ngoài biên.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách hoạt động:&lt;/b&gt; Nhân viên và độc giả tương tác với phần mềm qua web. Hệ thống xác thực với OIDC, lưu ảnh / tệp ở object storage, gửi thông báo qua provider và tạo bản sao lưu ngoài DB. Mỗi dịch vụ ngoài đi qua adapter; lỗi dịch vụ ngoài không được làm hỏng giao dịch nghiệp vụ đã commit.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lưu ý / ràng buộc:&lt;/b&gt; Các dịch vụ ngoài được bọc bởi port/adapter, không nằm trong giao dịch DB.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="1185" y="4159" width="570" height="478" /></mxCell><mxCell id="board_28" value="&lt;b&gt;03 — THÀNH PHẦN&lt;/b&gt;&lt;br&gt;Module, cổng tích hợp và phụ thuộc kỹ thuật." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=24;fillColor=#16324F;fontColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="4752" width="9800" height="95" /></mxCell><mxCell id="card_Components" v