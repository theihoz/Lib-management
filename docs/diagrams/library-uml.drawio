geometry" /></mxCell><mxCell id="sync_erd_Extensions_fk_AcquisitionReceiptItem_receipt_id" value="receipt_id → AcquisitionReceipt.id&#10;con N : cha 1" style="html=1;fontFamily=Arial;fontSize=14;edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;endArrow=none;" edge="1" parent="1" source="sync_erd_Extensions_AcquisitionReceiptItem" target="sync_erd_Extensions_AcquisitionReceipt"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="sync_erd_Extensions_note" value="&lt;b&gt;Cách hoạt động:&lt;/b&gt; Hộp là bảng logic; PK/FK ghi tại trường. Đường nối là FK trong nhóm; mỗi dòng con có một cha hoặc 0..1 nếu nullable. FK ngoài nhóm: Account, BookEdition.&lt;br&gt;NULL/default/CHECK/unique và index đầy đủ tại docs/design/database-design.md. Không cascade xóa lịch sử. N:N qua bảng liên kết. Layout nhóm không tạo thêm bảng." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;strokeColor=#344454;fillColor=#FFFFFF;fillColor=#F1F5F9;align=left;verticalAlign=top;spacing=20;fontSize=19;" vertex="1" parent="1"><mxGeometry x="5735" y="33731" width="800" height="2080" as="geometry" /></mxCell><mxCell id="sync_arch" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;strokeColor=#344454;fillColor=#FFFFFF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="100" y="36071" width="3200" height="1500" as="geometry" /></mxCell><mxCell id="sync_arch_title" value="Kiến trúc triển khai đã chốt" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;strokeColor=#344454;fillColor=#FFFFFF;fontSize=24;fontStyle=1;fillColor=#EDF3F7;" vertex="1" parent="1"><mxGeometry x="120" y="36091" width="3160" height="70" as="geometry" /></mxCell><mxCell id="sync_arch_note" value="React SPA static; Keycloak OIDC/PKCE; API và worker dùng PostgreSQL. External calls sau commit; Redis chỉ rate limit. Đây là target design, hosting chưa chốt." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;strokeColor=#344454;fillColor=#FFFFFF;fillColor=#F1F5F9;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="120" y="37221" width="3160" height="310" as="geometry" /></mxCell><mxCell id="sync_web" value="React + TypeScript + Vite&lt;br&gt;Browser / PKCE" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;strokeColor=#344454;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="200" y="36231" width="800" height="150" as="geometry" /></mxCell><mxCell id="sync_api" value="Python3.13 FastAPI&lt;br&gt;Router → Service → Repository&lt;br&gt;SQLAlchemy Unit of Work" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;strokeColor=#344454;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1250" y="36471" width="850" height="220" as="geometry" /></mxCell><mxCell id="sync_kc" value="Keycloak&lt;br&gt;Issuer / JWT / JWKS" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;strokeColor=#344454;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="2300" y="36231" width="800" height="150" as="geometry" /></mxCell><mxCell id="sync_db" value="PostgreSQL17&lt;br&gt;38 bảng + bổ sung&lt;br&gt;Alembic / outbox" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;strokeColor=#344454;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1200" y="36921" width="850" height="160" as="geometry" /></mxCell><mxCell id="sync_worker" value="Worker / leased Job&lt;br&gt;R2 / SMTP adapters" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;strokeColor=#344454;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="2300" y="36921" width="850" height="160" as="geometry" /></mxCell><mxCell id="sync_a1" value="Bearer / API" style="html=1;fontFamily=Arial;fontSize=14;edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sync_web" target="sync_api"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="sync_a2" value="Authorization Code + PKCE" style="html=1;fontFamily=Arial;fontSize=14;edgeStyle=orthog