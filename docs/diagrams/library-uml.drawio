      <mxCell id="board_336" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Vai trò:&lt;/b&gt; Trang gốc được đặt tại đây để đối chiếu nguồn; tất cả cell, nhãn và liên kết được giữ nguyên.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; Theo các nhóm và nhãn của bản gốc. Nội dung lịch sử chưa sửa có thể mâu thuẫn với thiết kế mới.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Áp dụng:&lt;/b&gt; Dùng các vùng 01–10 làm thiết kế đã hiệu chỉnh. Giữ nguồn gốc để so sánh; không lấy quy tắc khác biệt ở vùng này làm quyết định đã duyệt.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="1855" y="26236" width="570" height="1960" /></mxCell><mxCell id="sync_header" value="12 — ĐỒNG BỘ THIẾT KẾ 07/10/2026 · FastAPI / React / Keycloak · F01–F24" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;strokeColor=#344454;fillColor=#FFFFFF;fillColor=#174B73;fontColor=#FFFFFF;fontSize=28;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="28461" width="9800" height="85" as="geometry" /></mxCell><mxCell id="sync_intro" value="Danh mục chuẩn 38 bảng/288 trường; 4 bảng bổ sung ChargeAssessment, Notification, NotificationDelivery, NotificationPreference được ghi riêng. Mỗi khung có chú thích; tên trường snake_case từ DOCX. Các hình là thiết kế, chưa phải triển khai. Vùng này bổ sung chi tiết, không xóa nguồn gốc. Trang vẫn là một canvas." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;strokeColor=#344454;fillColor=#FFFFFF;fillColor=#EDF3F7;" vertex="1" parent="1"><mxGeometry x="100" y="28561" width="9800" height="115" as="geometry" /></mxCell><mxCell id="sync_erd_Catalog" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;strokeColor=#344454;fillColor=#FFFFFF;fillColor=#FAFCFD;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="100" y="28721" width="3200" height="2350" as="geometry" /></mxCell><mxCell id="sync_erd_Catalog_title" value="ERD chi tiết — Catalog · khóa và thuộc tính chuẩn" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;strokeColor=#344454;fillColor=#FFFFFF;fontSize=24;fontStyle=1;fillColor=#EDF3F7;" vertex="1" parent="1"><mxGeometry x="120" y="28741" width="3160" height="60" as="geometry" /></mxCell><mxCell id="sync_erd_Catalog_Publisher" value="&lt;b&gt;Publisher&lt;/b&gt;&lt;hr&gt;id : uuid [PK]&lt;br&gt;name : varchar(200)&lt;br&gt;address : text&lt;br&gt;status : varchar(16)&lt;br&gt;created_at : timestamptz" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;strokeColor=#344454;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=12;fontSize=16;" vertex="1" parent="1"><mxGeometry x="135" y="28831" width="680" height="195" as="geometry" /></mxCell><mxCell id="sync_erd_Catalog_Author" value="&lt;b&gt;Author&lt;/b&gt;&lt;hr&gt;id : uuid [PK]&lt;br&gt;name : varchar(200)&lt;br&gt;biography : text&lt;br&gt;status : varchar(16)&lt;br&gt;created_at : timestamptz" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;strokeColor=#344454;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=12;fontSize=16;" vertex="1" parent="1"><mxGeometry x="895" y="28831" width="680" height="195" as="geometry" /></mxCell><mxCell id="sync_erd_Catalog_Category" value="&lt;b&gt;Category&lt;/b&gt;&lt;hr&gt;id : uuid [PK]&lt;br&gt;code : varchar(32)&lt;br&gt;name : varchar(120)&lt;br&gt;parent_id : uuid [FK]&lt;br&gt;is_root : boolean&lt;br&gt;created_at : timestamptz" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;strokeColor=#344454;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=12;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1655" y="28831" width="680" height="220" as="geometry" /></mxCell><mxCell id="sync_erd_Catalog_BookEdition" value="&lt;b&gt;BookEdition&lt;/b&gt;&lt;hr&gt;id : uuid [PK]&lt;br&gt;isbn : varchar(13)&lt;br&gt;title : varchar(300)&lt;br&gt;publication_year : smallint&lt;br&gt;publisher_id : uuid [FK]&lt;br&gt;language : varchar(32)&lt;br&gt;description : text&lt;br&gt;status : varchar(16)&lt;br&gt;version : integer&lt;br&gt;created_at : timestamptz" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;strokeColor=#344454;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=12;fontSize=16;" vertex="1" parent="1"><mxGeometry x="135" y="29481" width="680" height="320" as="geometry" /></mxCell><mxCell id="sync_erd_Catalog_BookAuthor" value="&lt;b&gt;BookAuthor&lt;/b&gt;&lt;hr&gt;edition_id : uuid [PK] [FK]&lt;br&gt;author_id : uuid [PK] [FK]&lt;br&gt;ordinal : smallint&lt;br&gt;created_at : timestamptz" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;strokeColor=#344454;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=12;fontSize=16;" vertex="1" parent="1"><mxGeometry x="895" y="29481" width="680" height="170" as="geometry" /></mxCell><mxCell id="sync_erd_Catalog_BookCategory" value="&lt;b&gt;BookCategory&lt;/b&gt;&lt;hr&gt;edition_id : uuid [PK] [FK]&lt;br&gt;category_id : uuid [PK] [FK]&lt;br&gt;created_at : timestamptz" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;strokeColor=#344454;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=12;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1655" y="29481" width="680" height="145" as="geometry" /></mxCell><mxCell id="sync_erd_Catalog_Location" value="&lt;b&gt;Location&lt;/b&gt;&lt;hr&gt;id : uuid [PK]&lt;br&gt;code : varchar(32)&lt;br&gt;name : varchar(120)&lt;br&gt;status : varchar(16)&lt;br&gt;created_at : timestamptz" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;strokeColor=#344454;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=12;fontSize=16;" vertex="1" parent="1"><mxGeometry x="135" y="30131" width="680" height="195" as="geometry" /></mxCell><mxCell id="sync_erd_Catalog_BookCopy" value="&lt;b&gt;BookCopy&lt;/b&gt;&lt;hr&gt;id : uuid [PK]&lt;br&gt;edition_id : uuid [FK]&lt;br&gt;barcode : varchar(64)&lt;br&gt;location_id : uuid [FK]&lt;br&gt;status : varchar(16)&lt;br&gt;acquired_at : timestamptz&lt;br&gt;source_receipt_item_id : uuid [FK]&lt;br&gt;version : integer&lt;br&gt;created_at : timestamptz" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;strokeColor=#344454;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=12;fontSize=16;" vertex="1" parent="1"><mxGeometry x="895" y="30131" width="680" height="295" as="geometry" /></mxCell><mxCell id="sync_erd_Catalog_MediaAsset" value="&lt;b&gt;MediaAsset&lt;/b&gt;&lt;hr&gt;id : uuid [PK]&lt;br&gt;edition_id : uuid [FK]&lt;br&gt;object_key : text&lt;br&gt;mime_type : varchar(100)&lt;br&gt;byte_size : bigint&lt;br&gt;sha256 : char(64)&lt;br&gt;visibility : varchar(16)&lt;br&gt;status : varchar(16)&lt;br&gt;uploaded_by : uuid [FK]&lt;br&gt;created_at : timestamptz" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;strokeColor=#344454;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=12;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1655" y="30131" width="680" height="320" as="geometry" /></mxCell><mxCell id="sync_erd_Catalog_fk_BookEdition_publisher_id" value="publisher_id → Publisher.id&#10;con N : cha 0..1" style="html=1;fontFamily=Arial;fontSize=14;edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;endArrow=none;" edge="1" parent="1" source="sync_erd_Catalog_BookEdition" target="sync_erd_Catalog_Publisher"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="sync_erd_Catalog_fk_BookAuthor_edition_id" value="edition_id → BookEdition.id&#10;con N : cha 1" style="html=1;fontFamily=Arial;fontSize=14;edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;endArrow=none;" edge="1" parent="1" source="sync_erd_Catalog_BookAuthor" target="sync_erd_Catalog_BookEdition"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="sync_erd_Catalog_fk_BookAuthor_author_id" value="author_id 