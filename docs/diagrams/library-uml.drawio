"275.4" y="891.164" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F11__label5" value="[hợp lệ]" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_AD_F11"><mxGeometry x="295.22" y="412.09999999999997" width="53.6" height="17" as="geometry" /></mxCell><mxCell id="card_AD_F11__e5" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F11" source="card_AD_F11__n3" target="card_AD_F11__n5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="246.08" y="393.77" /><mxPoint x="299.18" y="422.50999999999993" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F11__e6" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F11" source="card_AD_F11__n5" target="card_AD_F11__n6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="418.93" y="529.0799999999999" /><mxPoint x="421.87" y="543.5" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F11__e7" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F11" source="card_AD_F11__n6" target="card_AD_F11__n7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="432.78" y="643.48" /><mxPoint x="432.78" y="657.75" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F11__label8" value="[thành công]" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_AD_F11"><mxGeometry x="422.1" y="766.66" width="76.4" height="17" as="geometry" /></mxCell><mxCell id="card_AD_F11__e8" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F11" source="card_AD_F11__n7" target="card_AD_F11__n8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="432.78" y="761.43" /><mxPoint x="432.78" y="780.43" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F11__label9" value="[lỗi / rollback nếu có ghi DB]" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_AD_F11"><mxGeometry x="269.54" y="766.66" width="179.0" height="17" as="geometry" /></mxCell><mxCell id="card_AD_F11__e9" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F11" source="card_AD_F11__n7" target="card_AD_F11__n4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="322.24" y="757.91" /><mxPoint x="294.28999999999996" y="769.16" /><mxPoint x="294.28999999999996" y="769.16" /><mxPoint x="294.28999999999996" y="769.16" /><mxPoint x="266.15999999999997" y="785.15" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F11__e10" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F11" source="card_AD_F11__n8" target="card_AD_F11__n9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="373.86" y="871.3" /><mxPoint x="344.42" y="891.3779999999999" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F11__note" value="Vai trò hành động ghi trong nút; nhánh lỗi kết thúc yêu cầu, dữ liệu không ghi một phần." style="text;html=1;fontFamily=Arial;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="content_card_AD_F11"><mxGeometry x="24" y="962.92" width="602.5699999999999" height="70" as="geometry" /></mxCell><mxCell id="board_250" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chức năng:&lt;/b&gt; F11 ↔ UC10; UC22 — Ghi phí, thu và miễn phạt&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Người thao tác:&lt;/b&gt; Thủ thư thu; Quản lý miễn&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chủ thể / phạm vi:&lt;/b&gt; Một lần thực hiện chức năng; từ bắt đầu đến kết quả&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; Đọc theo mũi tên; chữ nhật là hoạt động, hình thoi chọn nhánh theo guard. Nhánh lỗi phải sửa hoặc kết thúc; không bỏ qua bước kiểm tra.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Hoạt động:&lt;/b&gt; Tạo phí từ UC22 khi trả trễ/hỏng/mất hoặc ghi phí thủ công có lý do. → Thu khoản thanh toán; khóa số dư, phân bổ cho các phí. → Cho thanh toán một phần, không cho tổng phân bổ vượt tiền thu hoặc số dư. → Miễn/đảo khoản có thẩm quyền và audit; tính số dư từ sổ giao dịch.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Quy tắc đề xuất:&lt;/b&gt; Trễ 1.000 VND/ngày/cuốn theo QĐ07; phí mất 100.000–600.000 theo loại cần bảng được duyệt; phí hỏng chưa thống nhất.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lỗi / ngoại lệ:&lt;/b&gt; Gửi thu tiền lại: idempotent. Không xóa khoản đã thu; sai sót dùng đảo giao dịch. Thu tiền không phụ thuộc việc đang trả sách.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Kết quả / bất biến:&lt;/b&gt; Assessed, collected, waived và outstanding là bốn đại lượng khác nhau; số dư không âm.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="7674" y="18821" width="570" height="1108" /></mxCell><mxCell id="card_AD_F12" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#A8BACB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="8339" y="18716" width="1315" height="1228" /></mxCell><mxCell id="board_252" value="CHI TIẾT • AD_F12 F12 — Luồng Kiểm tra điều kiện độc giả" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=22;fontStyle=1;fillColor=#EAF2F8;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="8351" y="18726" width="1291" height="80" /></mxCell><mxCell id="content_card_AD_F12" value="" style="group;" vertex="1" parent="1"><mxGeometry as="geometry" x="8359" y="18821" width="675" height="1088" /></mxCell><mxCell id="card_AD_F12__title" value="F12 — Luồng Kiểm tra điều kiện độc giả" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="content_card_AD_F12"><mxGeometry x="24" y="16" width="584.3399999999999" height="40" as="geometry" /></mxCell><mxCell id="card_AD_F12__n0" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;ellipse;fillColor=#243444;" vertex="1" parent="content_card_AD_F12"><mxGeometry x="204.01000000000002" y="89.9999999999999" width="12.959999999999999" height="12.959999999999999" as="geometry" /></mxCell><mxCell id="card_AD_F12__n1" value="Người dùng&lt;br&gt;Nhận readerId, operation và thời điểm." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F12"><mxGeometry x="81.1996" y="151.96011999999996" width="258.5808" height="49.91976" as="geometry" /></mxCell><mxCell id="card_AD_F12__n2" value="API&lt;br&gt;Kiểm tra quyền và input" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F12"><mxGeometry x="125.638" y="250.88011999999992" width="169.704" height="49.91976" as="geometry" /></mxCell><mxCell id="card_AD_F12__n3" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rhombus;" vertex="1" parent="content_card_AD_F12"><mxGeometry x="197.89000000000001" y="349.79999999999995" width="25.2" height="25.2" as="geometry" /></mxCell><mxCell id="card_AD_F12__n4" value="API&lt;br&gt;Trả lỗi có mã; không ghi dữ liệu" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F12"><mxGeometry x="70.0024" y="805.16012" width="220.9752" height="49.91976" as="geometry" /></mxCell><mxCell id="card_AD_F12__n5" value="Hệ thống&lt;br&gt;Lấy thẻ, dư nợ, khoản OPEN quá hạn và&lt;br&gt;chính sách hiệu lực." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F12"><mxGeometry x="258.8036" y="434.99999999999994" width="277.3728" height="65.52" as="geometry" /></mxCell><mxCell id="card_AD_F12__n6" value="Hệ thống&lt;br&gt;Đánh giá tất cả điều kiện, trả danh sách&lt;br&gt;lý do có mã." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F12"><mxGeometry x="285.0652" y="549.52" width="270.8496" height="65.52" as="geometry" /></mxCell><mxCell id="card_AD_F12__n7" value="Hệ thống&lt;br&gt;Checkout/renew phải kiểm tra lại trong&lt;br&gt;giao dịch; kết quả xem trước không bảo đảm&lt;br&gt;khóa chỗ." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F12"><mxGeometry x="266.6404" y="664.0387999999999" width="307.6992" height="81.1224" as="geometry" /></mxCell><mxCell id="card_AD_F12__n8" value="API&lt;br&gt;Trả kết quả và mã yêu cầu" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F12"><mxGeometry x="327.3728" y="805.16012" width="194.23440000000002" height="49.91976" as="geometry" /></mxCell><mxCell id="card_AD_F12__n9" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;shape=doubleEllipse;fillColor=#243444;" vertex="1" parent="content_card_AD_F12"><mxGeometry x="2