metry></mxCell><mxCell id="card_ERD_Loan__note" value="Bảng liên kết Author/Category, Media, Waiver, Audit, Outbox, Idempotency và Jobs mô tả thêm trong từ điển dữ liệu." style="text;html=1;fontFamily=Arial;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="content_card_ERD_Loan"><mxGeometry x="24" y="690.2" width="782.58" height="70" as="geometry" /></mxCell><mxCell id="board_71" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Mục đích:&lt;/b&gt; ERD chi tiết — Mượn và giữ chỗ&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; PK = khóa chính; FK = tham chiếu; UQ = duy nhất; ? = tùy chọn. Nhãn bội số phản ánh quan hệ, không phải thứ tự gọi.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách hoạt động:&lt;/b&gt; book_editions có nhiều book_copies; readers có thẻ, loans và reservations. loans chứa loan_items; return_events có tối đa một bản ghi cho item. policy_versions gắn item khi mượn. Các ràng buộc unique có điều kiện ngăn hai người cùng mượn hoặc cùng giữ một copy; FIFO và chuyển trạng thái phải thực hiện trong transaction.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lưu ý / ràng buộc:&lt;/b&gt; Bảng liên kết Author/Category, Media, Waiver, Audit, Outbox, Idempotency và Jobs mô tả thêm trong từ điển dữ liệu.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="5623" y="9006" width="570" height="836" /></mxCell><mxCell id="card_ERD_Finance" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#A8BACB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="6288" y="8901" width="1186" height="924" /></mxCell><mxCell id="board_73" value="CHI TIẾT • ERD_Finance ERD chi tiết — Sổ phí" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=22;fontStyle=1;fillColor=#EAF2F8;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="6300" y="8911" width="1162" height="80" /></mxCell><mxCell id="content_card_ERD_Finance" value="" style="group;" vertex="1" parent="1"><mxGeometry as="geometry" x="6308" y="9006" width="546" height="784" /></mxCell><mxCell id="card_ERD_Finance__title" value="ERD chi tiết — Sổ phí" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="content_card_ERD_Finance"><mxGeometry x="24" y="16" width="455.29" height="40" as="geometry" /></mxCell><mxCell id="card_ERD_Finance__n0" value="&lt;b&gt;readers&lt;/b&gt;&lt;hr&gt;PK id" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=0;align=left;spacing=6;" vertex="1" parent="content_card_ERD_Finance"><mxGeometry x="91.42044" y="250.20000000000002" width="62.97912" height="61.199999999999996" as="geometry" /></mxCell><mxCell id="card_ERD_Finance__n1" value="&lt;b&gt;loan_items&lt;/b&gt;&lt;hr&gt;PK id&lt;br&gt;FK loan_id, copy_id, policy_id&lt;br&gt;UQ copy_id WHERE closed_at IS&lt;br&gt;NULL" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=0;align=left;spacing=6;" vertex="1" parent="content_card_ERD_Finance"><mxGeometry x="190.3724" y="226.8" width="211.0752" height="108" as="geometry" /></mxCell><mxCell id="card_ERD_Finance__n2" value="&lt;b&gt;fine_charges&lt;/b&gt;&lt;hr&gt;PK id&lt;br&gt;FK reader_id, loan_item_id?,&lt;br&gt;policy_id" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=0;align=left;spacing=6;" vertex="1" parent="content_card_ERD_Finance"><mxGeometry x="205.4448" y="394.8012" width="182.93040000000002" height="92.39760000000001" as="geometry" /></mxCell><mxCell id="card_ERD_Finance__n3" value="&lt;b&gt;payments&lt;/b&gt;&lt;hr&gt;PK id&lt;br&gt;FK reader_id&lt;br&gt;UQ receipt_no" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=0;align=left;spacing=6;" vertex="1" parent="content_card_ERD_Finance"><mxGeometry x="69.99959999999999" y="394.8012" width="99.8208" height="92.39760000000001" as="geometry" /></mxCell><mxCell id="card_ERD_Finance__n4" value="&lt;b&gt;payment_allocations&lt;/b&gt;&lt;hr&gt;PK(payment_id,charge_id)&lt;br&gt;FK payment_id,charge_id" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=0;align=left;spacing=6;" vertex="1" parent="content_card_ERD_Finance"><mxGeometry x="122.95" y="547.1988" width="169.92" height="76.8024" as="geometry" /></mxCell><mxCell id="card_ERD_Finance__n5" value="&lt;b&gt;policy_versions&lt;/b&gt;&lt;hr&gt;PK id&lt;br&gt;UQ effective_from" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=0;align=left;spacing=6;" vertex="1" parent="content_card_ERD_Finance"><mxGeometry x="324.5308" y="89.99879999999997" width="120.7584" height="76.8024" as="geometry" /></mxCell><mxCell id="card_ERD_Finance__label0" value="1 : N" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_ERD_Finance"><mxGeometry x="204.65" y="356.3" width="36.5" height="17" as="geometry" /></mxCell><mxCell id="card_ERD_Finance__e0" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;endArrow=none;" edge="1" parent="content_card_ERD_Finance" source="card_ERD_Finance__n0" target="card_ERD_Finance__n2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="161.5" y="323.54" /><mxPoint x="171.91" y="334.8" /><mxPoint x="171.91" y="334.8" /><mxPoint x="171.91" y="334.8" /><mxPoint x="209.56" y="366.49" /></Array></mxGeometry></mxCell><mxCell id="card_ERD_Finance__label1" value="1 : N optional" style="text;html=1;f