<mxPoint x="246.12" y="299.77000000000004" /><mxPoint x="268.75" y="319.96000000000004" /><mxPoint x="268.75" y="319.96000000000004" /><mxPoint x="268.75" y="319.96000000000004" /><mxPoint x="293.46000000000004" y="337.25" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F05__note" value="Phiên sửa Publisher" style="text;html=1;fontFamily=Arial;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="content_card_ST_F05"><mxGeometry x="24" y="596.1600000000001" width="523.49" height="70" as="geometry" /></mxCell><mxCell id="board_125" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chức năng:&lt;/b&gt; F05 ↔ UC1.2 — Quản lý nhà xuất bản&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Người thao tác:&lt;/b&gt; Thủ thư&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chủ thể / phạm vi:&lt;/b&gt; Phiên sửa Publisher&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; Nút = trạng thái của chủ thể; cạnh = sự kiện [điều kiện] / hành động. Nút đen bắt đầu; nút kép kết thúc phiên được mô tả.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Hoạt động:&lt;/b&gt; Tra cứu nhà xuất bản. → Thêm/sửa tên và thông tin liên hệ. → Kiểm tra dữ liệu, version; lưu. → Xóa bị chặn nếu đầu sách đang tham chiếu.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Quy tắc đề xuất:&lt;/b&gt; Mỗi ấn bản có nhà xuất bản tùy chọn; không lấy tên làm khóa chính.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lỗi / ngoại lệ:&lt;/b&gt; Version cũ: 409; tham chiếu còn tồn tại: 409; lỗi trường: 422.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Kết quả / bất biến:&lt;/b&gt; Giữ được thông tin ấn bản và lịch sử.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="8501" y="12759" width="570" height="742" /></mxCell><mxCell id="card_ST_F06" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#A8BACB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="13682" width="1263" height="851" /></mxCell><mxCell id="board_127" value="CHI TIẾT • ST_F06 F06 — Quản lý độc giả và thẻ" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=22;fontStyle=1;fillColor=#EAF2F8;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="112" y="13692" width="1239" height="80" /></mxCell><mxCell id="content_card_ST_F06" value="" style="group;" vertex="1" parent="1"><mxGeometry as="geometry" x="120" y="13787" width="623" height="711" /></mxCell><mxCell id="card_ST_F06__title" value="F06 — Quản lý độc giả và thẻ" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="content_card_ST_F06"><mxGeometry x="24" y="16" width="532.76" height="40" as="geometry" /></mxCell><mxCell id="card_ST_F06__n0" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;ellipse;fillColor=#243444;" vertex="1" parent="content_card_ST_F06"><mxGeometry x="329.56" y="90.00000000000001" width="12.959999999999999" height="12.959999999999999" as="geometry" /></mxCell><mxCell id="card_ST_F06__n1" value="Đang xác minh" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_ST_F06"><mxGeometry x="280.8124" y="151.96000000000004" width="110.4552" height="36" as="geometry" /></mxCell><mxCell id="card_ST_F06__n2" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rhombus;" vertex="1" parent="content_card_ST_F06"><mxGeometry x="323.44000000000005" y="236.96" width="25.2" height="25.2" as="geometry" /></mxCell><mxCell id="card_ST_F06__n3" value="ACTIV