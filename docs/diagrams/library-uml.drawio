610.16" /><mxPoint x="256.34000000000003" y="610.16" /><mxPoint x="256.34000000000003" y="610.16" /><mxPoint x="319.63" y="629.2139999999999" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F23___e14" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F23_" source="card_ST_F23___n8" target="card_ST_F23___n10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="424.78" y="599.76" /><mxPoint x="402.08" y="619.374" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F23___label15" value="ghi lỗi; giữ target cũ" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_ST_F23_"><mxGeometry x="281.51" y="558.66" width="133.4" height="17" as="geometry" /></mxCell><mxCell id="card_ST_F23___e15" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F23_" source="card_ST_F23___n9" target="card_ST_F23___n10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="299.82" y="502.38" /><mxPoint x="302.08000000000004" y="585.16" /><mxPoint x="302.08000000000004" y="585.16" /><mxPoint x="302.08000000000004" y="585.16" /><mxPoint x="336.35" y="614.386" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F23___note" value="BackupRestoreJob" style="text;html=1;fontFamily=Arial;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="content_card_ST_F23_"><mxGeometry x="24" y="693" width="676.94" height="70" as="geometry" /></mxCell><mxCell id="board_197" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chức năng:&lt;/b&gt; F23 ↔ UC20 — Sao lưu và phục hồi&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Người thao tác:&lt;/b&gt; Admin vận hành&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chủ thể / phạm vi:&lt;/b&gt; BackupRestoreJob&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; Nút = trạng thái của chủ thể; cạnh = sự kiện [điều kiện] / hành động. Nút đen bắt đầu; nút kép kết thúc phiên được mô tả.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Hoạt động:&lt;/b&gt; Chọn chế độ backup hoặc restore; kiểm tra quyền và target. → Backup: tạo bản mã hóa có hash; restore: chọn bản verified và khôi phục vào vùng cô lập. → Kiểm tra checksum, schema, FK và invariant; bản chưa đạt không được dùng. → Backup lưu manifest; restore chỉ chuyển target khi đã duyệt và có kế hoạch quay lại.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Quy tắc đề xuất:&lt;/b&gt; Mở rộng từ PDF; hai chế độ riêng; phục hồi phải được duyệt, chạy kiểm tra trên môi trường cô lập trước khi chuyển.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lỗi / ngoại lệ:&lt;/b&gt; Không restore trực tiếp lên production khi chưa kiểm tra; fail không đổi target đang hoạt động. Chạy diễn tập phục hồi đo RPO/RTO.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Kết quả / bất biến:&lt;/b&gt; Có manifest, kết quả verify và audit; khả năng phục hồi phải được chứng minh bằng diễn tập.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="4813" y="15738" width="570" height="838" /></mxCell><mxCell id="card_ST_F24_" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#A8BACB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="5478" y="15633" width="1496" height="777" /></mxCell><mxCell id="board_199" value="CHI TIẾT • ST_F24 F24 — Thông báo giữ chỗ và quá hạn" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=22;fontStyle=1;fillColor=#EAF2F8;strokeColor=none;"