" parent="content_card_AD_F21_"><mxGeometry x="24" y="978.52" width="603.29" height="70" as="geometry" /></mxCell><mxCell id="board_290" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chức năng:&lt;/b&gt; F21 ↔ UC18 — Quản trị tài khoản và vai trò&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Người thao tác:&lt;/b&gt; Admin hệ thống&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chủ thể / phạm vi:&lt;/b&gt; Một lần thực hiện chức năng; từ bắt đầu đến kết quả&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; Đọc theo mũi tên; chữ nhật là hoạt động, hình thoi chọn nhánh theo guard. Nhánh lỗi phải sửa hoặc kết thúc; không bỏ qua bước kiểm tra.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Hoạt động:&lt;/b&gt; Mời tài khoản theo directory/issuer được phép. → Admin gán các permission theo nhiệm vụ; quản lý thư viện không tự sửa quyền hệ thống. → Kích hoạt sau xác minh; thu hồi quyền làm mất hiệu lực các phiên đang dùng. → Khóa hoặc ngừng tài khoản, giữ dấu vết tác giả của giao dịch lịch sử.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Quy tắc đề xuất:&lt;/b&gt; Mở rộng từ PDF và kiến trúc; không cho tài khoản tự nâng quyền; phân quyền máy chủ, không mặc định Quản lý có mọi quyền Thủ thư.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lỗi / ngoại lệ:&lt;/b&gt; Không xóa admin cuối cùng; role change cần audit. Vô hiệu hóa tài khoản không được xóa phiếu do họ lập.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Kết quả / bất biến:&lt;/b&gt; Account trạng thái độc lập với ReaderCard; giữ FK lịch sử.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="2176" y="21413" width="570" height="1124" /></mxCell><mxCell id="card_AD_F22_" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#A8BACB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="2841" y="21308" width="1303" height="1244" /></mxCell><mxCell id="board_292" value="CHI TIẾT • AD_F22 F22 — Luồng Nhập sách và thanh lý" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=22;fontStyle=1;fillColor=#EAF2F8;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="2853" y="21318" width="1279" height="80" /></mxCell><mxCell id="content_card_AD_F22_" value="" style="group;" vertex="1" parent="1"><mxGeometry as="geometry" x="2861" y="21413" width="663" height="1104" /></mxCell><mxCell id="card_AD_F22___title" value="F22 — Luồng Nhập sách và thanh lý" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="content_card_AD_F22_"><mxGeometry x="24" y="16" width="572.1700000000001" height="40" as="geometry" /></mxCell><mxCell id="card_AD_F22___n0" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;ellipse;fillColor=#243444;" vertex="1" parent="content_card_AD_F22_"><mxGeometry x="204.01000000000002" y="90.00000000000001" width="12.959999999999999" height="12.959999999999999" as="geometry" /></mxCell><mxCell id="card_AD_F22___n1" value="Người dùng&lt;br&gt;Lập phiếu nhập BM01 với đầu sách, số&lt;br&gt;lượng, đơn giá và nguồn cung." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F22_"><mxGeometry x="74.33440000000002" y="151.96000000000004" width="272.3112" height="65.52" as="geometry" /></mxCell><mxCell id="card_AD_F22___n2" value="API&lt;br&gt;Kiểm tra quyền và input" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F22_"><mxGeometry x="125.638" y="266.48011999999994" width="169.704" height="49.91976" as="geometry" /></mxCell><mxCell id="card_AD_F22___n3" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rhombus;" vertex="1" parent="content_card_AD_F22_"><mxGeometry x="197.89000000000001" y="365.4" width="25.2" height="25.2" as="geometry" /></mxCell><mxCell id="card_AD_F22___n4" value="API&lt;br&gt;Trả lỗi có mã; không ghi dữ liệu" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F22_"><mxGeometry x="70.0024" y="820.76012" width="220.9752" height="49.91976" as="geometry" /></mxCell><mxCell id="card_AD_F22___n5" value="Hệ thống&lt;br&gt;Kiểm tra tổng số lượng, số tiền và dải&lt;br&gt;barcode chưa trùng." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F22_"><mxGeometry x="262.96680000000003" y="450.59999999999997" width="265.0464" height="65.52" as="geometry" /></mxCell><mxCell id="card_AD_F22___n6" value="Hệ thống&lt;br&gt;Duyệt phiếu rồi tạo từng BookCopy cùng&lt;br&gt;giao dịch; giữ tham chiếu nguồn nhập." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F22_"><mxGeometry x="284.8036" y="565.12" width="277.3728" height="65.52" as="geometry" /></mxCell><mxCell id="card_AD_F22___n7" value="Hệ thống&lt;br&gt;Thanh lý từng bản sao qua hồ sơ riêng,&lt;br&gt;không xóa lịch sử và chỉ khi không có&lt;br&gt;nghĩa vụ mở." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F22_"><mxGeometry x="292.01800000000003" y="679.6388000000001" width="262.944" height="81.1224" as="geometry" /></mxCell><mxCell id="card_AD_F22___n8" value="API&lt;br&gt;Trả kết quả và mã yêu cầu" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F22_"><mxGeometry x="327.3728" y="820.76012" width="194.23440000000002" height="49.91976" as="geometry" /></mxCell><mxCell id="card_AD_F22___n9" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;shape=doubleEllipse;fillColor=#243444;" vertex="1" parent="content_card_AD_F22_"><mxGeometry x="289.57004" y="919.6800400000001" width="23.83992" height="23.83992" as="geometry" /></mxCell><mxCell id="card_AD_F22___e0" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F22_" source="card_AD_F22___n0" target="card_AD_F22___n1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="210.49" y="111.75999999999999" /><mxPoint x="210.49" y="127.68999999999994" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F22___e1" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F22_" source="card_AD_F22___n1" target="card_AD_F22___n2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="210.49" y="230.40999999999997" /><mxPoint x="210.49" y="245.01999999999998" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F22___e2" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F22_" source="card_AD_F22___n2" target="card_AD_F22___n3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="210.49" y="329.49" /><mxPoint x="210.49" y="344.66999999999996" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F22___label3" value="[không hợp lệ]" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_AD_F22_"><mxGeometry x="170.76999999999998" y="589.38" width="87.8" height="17" as="geometry" /></mxCell><mxCell id="card_AD_F22___e3" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F22_" source="card_AD_F22___n3" target="card_AD_F22___n4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="200.48" y="413.47" /><mxPoint x="180.49" y="482.35999999999996" /><mxPoint x="180.49" y="482.35999999999996" /><mxPoint x="180.49" y="482.35999999999996" /><mxPoint x="180.49" y="482.35999999999996" /><mxPoint x="180.49" y="721.2" /><mxPoint x="180.49" y="721.2" /><mxPoint x="180.49" y="775.3" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F22___e4" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F22_" source="card_AD_F22___n4" target="card_AD_F22___n9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="238.33" y="886.8149999999999" /><mxPoint x="267.1" y="906.764" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F22___label5" value="[hợp lệ]" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_AD_F22_"><mxGeometry x="284.28999999999996" y="412.1" width="53.6" height="17" as="geometry" /></mxCell><mxCell id="card_AD_F22___e5" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F22_" source="card_AD_F22___n3" target="card_AD_F22___n5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="236.88" y="393.75" /><mxPoint x="288.15" y="422.39" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F22___e6" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F22_" source="card_AD_F22___n5" target="card_AD_F22___n6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="406.62" y="529.0799999999999" /><mxPoint x="410.2" y="543.5" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F22___e7" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F22_" source="card_AD_F22___n6" target="card_AD_F22___n7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="423.49" y="643.46" /><mxPoint x="423.49" y="657.81" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F22___label8" value="[thành công]" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_AD_F22_"><mxGeometry x="413.40000000000003" y="782.26" width="76.4" height="17" as="geometry" /></mxCell><mxCell id="card_AD_F22___e8" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F22_" source="card_AD_F22___n7" target="card_AD_F22___n8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="423.94" y="777.5" /><mxPoint x="424.1" y="796.47" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F22___label9" value="[lỗi / rollback nếu có ghi DB]" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_AD_F22_"><mxGeometry x="261.24" y="782.26" width="179.0" height="17" as="geometry" /></mxCell><mxCell id="card_AD_F22___e9" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F22_" source="card_AD_F22___n7" target="card_AD_F22___n4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="309.57" y="773.86" /><mxPoint x="286" y="784.76" /><mxPoint x="286" y="784.76" /><mxPoint x="286" y="784.76" /><mxPoint x="257.87" y="800.75" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F22___e10" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F22_" source="card_AD_F22___n8" target="card_AD_F22___n9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="365.57" y="886.9" /><mxPoint x="336.13" y="906.978" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F22___note" value="Vai trò hành động ghi trong nút; nhánh lỗi kết thúc yêu cầu, dữ liệu không ghi một phần." style="text;html=1;fontFamily=Arial;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="content_card_AD_F22_"><mxGeometry x="24" y="978.52" width="592.1700000000001" height="70" as="geometry" /></mxCell><mxCell id="board_294" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chức năng:&lt;/b&gt; F22 ↔ UC19 — Nhập sách và thanh lý&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Người thao tác:&lt;/b&gt; Thủ thư; Quản lý duyệt&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chủ thể / phạm vi:&lt;/b&gt; Một lần thực hiện chức năng; từ bắt đầu đến kết quả&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; Đọc theo mũi tên; chữ nhật là hoạt động, hình thoi chọn nhánh theo guard. Nhánh lỗi phải sửa hoặc kết thúc; không bỏ qua bước kiểm tra.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Hoạt động:&lt;/b&gt; Lập phiếu nhập BM01 với đầu sách, số lượng, đơn giá và nguồn cung. → Kiểm tra tổng số lượng, số tiền và dải barcode chưa trùng. → Duyệt phiếu rồi tạo từng BookCopy cùng giao dịch; giữ tham chiếu nguồn nhập. → Thanh lý từng bản sao qua hồ sơ riêng, không xóa lịch sử và chỉ khi không có nghĩa vụ mở.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Quy tắc đề xuất:&lt;/b&gt; Mở rộng nghiệp vụ tiếp nhận/kiểm kê từ PDF; giữ BM01; đếm vật lý theo bản sao, đơn giá VND.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lỗi / ngoại lệ:&lt;/b&gt; Barcode trùng hoặc số lượng không khớp: không commit phiếu. Phiếu đã POSTED không sửa trực tiếp; điều chỉnh bằng chứng từ mới.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Kết quả / bất biến:&lt;/b&gt; Tổng tiền = tổng quantity×unitPrice; từng copy có nguồn nhập.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="3539" y="21413" width="570" height="1124" /></mxCell><mxCell id="card_AD_F23_" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#A8BACB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="4204" y="21308" width="1306" height="1260" /></mxCell><mxCell id="board_296" value="CHI TIẾT • AD_F23 F23 — Luồng Sao lưu và phục hồi" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=22;fontStyle=1;fillColor=#EAF2F8;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="4216" y="21318" width="1282" height="80" /></mxCell><mxCell id="content_card_AD_F23_" value="" style="group;" vertex="1" parent="1"><mxGeometry as="geometry" x="4224" y="21413" width="666" height="1120" /></mxCell><mxCell id="card_AD_F23___title" value="F23 — Luồng Sao lưu và phục hồi" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="content_card_AD_F23_"><mxGeometry x="24" y="16" width="575.87" height="40" as="geometry" /></mxCell><mxCell id="card_AD_F23___n0" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;ellipse;fillColor=#243444;" vertex="1" parent="content_card_AD_F23_"><mxGeometry x="209.78" y="90.00000000000001" width="12.959999999999999" height="12.959999999999999" as="geometry" /></mxCell><mxCell id="card_AD_F23___n1" value="Người dùng&lt;br&gt;Chọn chế độ backup hoặc restore; kiểm tra&lt;br&gt;quyền và target." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F23_"><mxGeometry x="69.99919999999997" y="151.96000000000004" width="292.52160000000003" height="65.52" as="geometry" /></mxCell><mxCell id="card_AD_F23___n2" value="API&lt;br&gt;Kiểm tra quyền và input" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F23_"><mxGeometry x="131.408" y="266.48012000000006" width="169.704" height="49.91976" as="geometry" /></mxCell><mxCell id="card_AD_F23___n3" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rhombus;" vertex="1" parent="content_card_AD_F23_"><mxGeometry x="203.66" y="365.4" width="25.2" height="25.2" as="geometry" /></mxCell><mxCell id="card_AD_F23___n4" value="API&lt;br&gt;Trả lỗi có mã; không ghi dữ liệu" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F23_"><mxGeometry x="75.7724" y="836.36012" width="220.9752" height="49.91976" as="geometry" /></mxCell><mxCell id="card_AD_F23___n5" value="Hệ thống&lt;br&gt;Backup: tạo bản mã hóa có hash; restore:&lt;br&gt;chọn bản verified và khôi phục vào vùng cô&lt;br&gt;lập." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F23_"><mxGeometry x="263.2428" y="450.59880000000004" width="286.0344" height="81.1224" as="geometry" /></mxCell><mxCell id="card_AD_F23___n6" value="Hệ thống&lt;br&gt;Kiểm tra checksum, schema, FK và&lt;br&gt;invariant; bản chưa đạt không được dùng." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F23_"><mxGeometry x="290.6536" y="580.72" width="275.2128" height="65.52" as="geometry" /></mxCell><mxCell id="card_AD_F23___n7" value="Hệ thống&lt;br&gt;Backup lưu manifest; restore chỉ chuyển&lt;br&gt;target khi đã duyệt và có kế hoạch quay&lt;br&gt;lại." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F23_"><mxGeometry x="294.2716" y="695.2388" width="267.9768" height="81.1224" as="geometry" /></mxCell><mxCell id="card_AD_F23___n8" value="API&lt;br&gt;Trả kết quả và mã yêu cầu" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F23_"><mxGeometry x="333.14279999999997" y="836.36012" width="194.23440000000002" height="49.91976" as="geometry" /></mxCell><mxCell id="card_AD_F23___n9" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;shape=doubleEllipse;fillColor=#243444;" vertex="1" parent="content_card_AD_F23_"><mxGeometry x="295.34004" y="935.2800400000001" width="23.83992" height="23.83992" as="geometry" /></mxCell><mxCell id="card_AD_F23___e0" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F23_" source="card_AD_F23___n0" target="card_AD_F23___n1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="216.26" y="111.75999999999999" /><mxPoint x="216.26" y="127.69000000000005" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F23___e1" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F23_" source="card_AD_F23___n1" target="card_AD_F23___n2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="216.26" y="230.40999999999997" /><mxPoint x="216.26" y="245.01999999999998" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F23___e2" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F23_" source="card_AD_F23___n2" target="card_AD_F23___n3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="216.26" y="329.49" /><mxPoint x="216.26" y="344.66999999999996" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F23___label3" value="[không hợp lệ]" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_AD_F23_"><mxGeometry x="176.54999999999998" y="604.98" width="87.8" height="17" as="geometry" /></mxCell><mxCell id="card_AD_F23___e3" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F23_" source="card_AD_F23___n3" target="card_AD_F23___n4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="206.45" y="415.36" /><mxPoint x="186.26" y="490.16" /><mxPoint x="186.26" y="490.16" /><mxPoint x="186.26" y="490.16" /><mxPoint x="186.26" y="490.16" /><mxPoint x="186.26" y="736.8" /><mxPoint x="186.26" y="736.8" /><mxPoint x="186.26" y="790.9" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F23___e4" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F23_" source="card_AD_F23___n4" target="card_AD_F23___n9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="244.1" y="902.415" /><mxPoint x="272.88" y="922.364" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F23___label5" value="[hợp lệ]" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_AD_F23_"><mxGeometry x="286.62" y="412.1" width="53.6" height="17" as="geometry" /></mxCell><mxCell id="card_AD_F23___e5" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F23_" source="card_AD_F23___n3" target="card_AD_F23___n5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="242.06" y="394.09000000000003" /><mxPoint x="289.05" y="421.59000000000003" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F23___e6" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F23_" source="card_AD_F23___n5" target="card_AD_F23___n6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="415.89" y="544.81" /><mxPoint x="418.51" y="559.15" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F23___e7" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F23_" source="card_AD_F23___n6" target="card_AD_F23___n7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="428.26" y="659.06" /><mxPoint x="428.26" y="673.4100000000001" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F23___label8" value="[thành công]" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_AD_F23_"><mxGeometry x="418.76" y="797.86" width="76.4" height="17" as="geometry" /></mxCell><mxCell id="card_AD_F23___e8" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F23_" source="card_AD_F23___n7" target="card_AD_F23___n8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="429.17" y="793.1" /><mxPoint x="429.48" y="812.0699999999999" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F23___label9" value="[lỗi / rollback nếu có ghi DB]" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_AD_F23_"><mxGeometry x="266.01" y="797.86" width="179.0" height="17" as="geometry" /></mxCell><mxCell id="card_AD_F23___e9" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F23_" source="card_AD_F23___n7" target="card_AD_F23___n4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="314.34000000000003" y="789.46" /><mxPoint x="290.77" y="800.36" /><mxPoint x="290.77" y="800.36" /><mxPoint x="290.77" y="800.36" /><mxPoint x="262.9" y="816.35" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F23___e10" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F23_" source="card_AD_F23___n8" target="card_AD_F23___n9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="371.34" y="902.5" /><mxPoint x="341.9" y="922.578" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F23___note" value="Vai trò hành động ghi trong nút; nhánh lỗi kết thúc yêu cầu, dữ liệu không ghi một phần." style="text;html=1;fontFamily=Arial;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="content_card_AD_F23_"><mxGeometry x="24" y="994.12" width="595.87" height="70" as="geometry" /></mxCell><mxCell id="board_298" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chức năng:&lt;/b&gt; F23 ↔ UC20 — Sao lưu và phục hồi&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Người thao tác:&lt;/b&gt; Admin vận hành&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chủ thể / phạm vi:&lt;/b&gt; Một lần thực hiện chức năng; từ bắt đầu đến kết quả&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; Đọc theo mũi tên; chữ nhật là hoạt động, hình thoi chọn nhánh theo guard. Nhánh lỗi phải sửa hoặc kết thúc; không bỏ qua bước kiểm tra.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Hoạt động:&lt;/b&gt; Chọn chế độ backup hoặc restore; kiểm tra quyền và target. → Backup: tạo bản mã hóa có hash; restore: chọn bản verified và khôi phục vào vùng cô lập. → Kiểm tra checksum, schema, FK và invariant; bản chưa đạt không được dùng. → Backup lưu manifest; restore chỉ chuyển target khi đã duyệt và có kế hoạch quay lại.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Quy tắc đề xuất:&lt;/b&gt; Mở rộng từ PDF; hai chế độ riêng; phục hồi phải được duyệt, chạy kiểm tra trên môi trường cô lập trước khi chuyển.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lỗi / ngoại lệ:&lt;/b&gt; Không restore trực tiếp lên production khi chưa kiểm tra; fail không đổi target đang hoạt động. Chạy diễn tập phục hồi đo RPO/RTO.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Kết quả / bất biến:&lt;/b&gt; Có manifest, kết quả verify và audit; khả năng phục hồi phải được chứng minh bằng diễn tập.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="4905" y="21413" width="570" height="1140" /></mxCell><mxCell id="card_AD_F24_" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#A8BACB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="5570" y="21308" width="1300" height="1244" /></mxCell><mxCell id="board_300" value="CHI TIẾT • AD_F24 F24 — Luồng Thông báo giữ chỗ và quá hạn" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=22;fontStyle=1;fillColor=#EAF2F8;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="5582" y="21318" width="1276" height="80" /></mxCell><mxCell id="content_card_AD_F24_" value="" style="group;" vertex="1" parent="1"><mxGeometry as="geometry" x="5590" y="21413" width="660" height="1104" /></mxCell><mxCell id="card_AD_F24___title" value="F24 — Luồng Thông báo giữ chỗ và quá hạn" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="content_card_AD_F24_"><mxGeometry x="24" y="16" width="569.8299999999999" height="40" as="geometry" /></mxCell><mxCell id="card_AD_F24___n0" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;ellipse;fillColor=#243444;" vertex="1" parent="content_card_AD_F24_"><mxGeometry x="205.45000000000002" y="90.00000000000001" width="12.959999999999999" height="12.959999999999999" as="geometry" /></mxCell><mxCell id="card_AD_F24___n1" value="Người dùng&lt;br&gt;Đọc outbox đã commit hoặc lịch nhắc quá&lt;br&gt;hạn theo cấu hình được duyệt." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F24_"><mxGeometry x="70" y="151.96000000000004" width="283.86" height="65.52" as="geometry" /></mxCell><mxCell id="card_AD_F24___n2" value="API&lt;br&gt;Kiểm tra quyền và input" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F24_"><mxGeometry x="127.078" y="266.48011999999994" width="169.704" height="49.91976" as="geometry" /></mxCell><mxCell id="card_AD_F24___n3" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rhombus;" vertex="1" parent="content_card_AD_F24_"><mxGeometry x="199.33" y="365.4" width="25.2" height="25.2" as="geometry" /></mxCell><mxCell id="card_AD_F24___n4" value="API&lt;br&gt;Trả lỗi có mã; không ghi dữ liệu" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F24_"><mxGeometry x="71.4424" y="820.76012" width="220.9752" height="49.91976" as="geometry" /></mxCell><mxCell id="card_AD_F24___n5" value="Hệ thống&lt;br&gt;Kiểm tra sự kiện còn phù hợp; thẻ/thông&lt;br&gt;tin nhận và consent theo kênh." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F24_"><mxGeometry x="261.058" y="450.59999999999997" width="273.744" height="65.52" as="geometry" /></mxCell><mxCell id="card_AD_F24___n6" value="Hệ thống&lt;br&gt;Nhận lease và gửi qua adapter; không log&lt;br&gt;nội dung chứa PII." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F24_"><mxGeometry x="286.0328" y="565.12" width="273.7944" height="65.52" as="geometry" /></mxCell><mxCell id="card_AD_F24___n7" value="Hệ thống&lt;br&gt;Ghi delivered/failed; retry có backoff,&lt;br&gt;vào dead-letter khi hết lượt; không kéo&lt;br&gt;dài hạn READY." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F24_"><mxGeometry x="296.1668" y="679.6388000000001" width="253.5264" height="81.1224" as="geometry" /></mxCell><mxCell id="card_AD_F24___n8" value="API&lt;br&gt;Trả kết quả và mã yêu cầu" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_AD_F24_"><mxGeometry x="328.8128" y="820.76012" width="194.23440000000002" height="49.91976" as="geometry" /></mxCell><mxCell id="card_AD_F24___n9" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;shape=doubleEllipse;fillColor=#243444;" vertex="1" parent="content_card_AD_F24_"><mxGeometry x="291.01004" y="919.6800400000001" width="23.83992" height="23.83992" as="geometry" /></mxCell><mxCell id="card_AD_F24___e0" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F24_" source="card_AD_F24___n0" target="card_AD_F24___n1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="211.93" y="111.75999999999999" /><mxPoint x="211.93" y="127.68999999999994" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F24___e1" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F24_" source="card_AD_F24___n1" target="card_AD_F24___n2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="211.93" y="230.40999999999997" /><mxPoint x="211.93" y="245.01999999999998" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F24___e2" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F24_" source="card_AD_F24___n2" target="card_AD_F24___n3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="211.93" y="329.49" /><mxPoint x="211.93" y="344.66999999999996" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F24___label3" value="[không hợp lệ]" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_AD_F24_"><mxGeometry x="172.21" y="589.38" width="87.8" height="17" as="geometry" /></mxCell><mxCell id="card_AD_F24___e3" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F24_" source="card_AD_F24___n3" target="card_AD_F24___n4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="201.92" y="413.47" /><mxPoint x="181.93" y="482.35999999999996" /><mxPoint x="181.93" y="482.35999999999996" /><mxPoint x="181.93" y="482.35999999999996" /><mxPoint x="181.93" y="482.35999999999996" /><mxPoint x="181.93" y="721.2" /><mxPoint x="181.93" y="721.2" /><mxPoint x="181.93" y="775.3" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F24___e4" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F24_" source="card_AD_F24___n4" target="card_AD_F24___n9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="239.77" y="886.8149999999999" /><mxPoint x="268.53999999999996" y="906.764" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F24___label5" value="[hợp lệ]" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_AD_F24_"><mxGeometry x="286.16999999999996" y="412.1" width="53.6" height="17" as="geometry" /></mxCell><mxCell id="card_AD_F24___e5" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F24_" source="card_AD_F24___n3" target="card_AD_F24___n5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="238.47" y="393.75" /><mxPoint x="290" y="422.39" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F24___e6" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F24_" source="card_AD_F24___n5" target="card_AD_F24___n6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="407.86" y="529.0799999999999" /><mxPoint x="411.07" y="543.5" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F24___e7" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F24_" source="card_AD_F24___n6" target="card_AD_F24___n7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="422.93" y="643.46" /><mxPoint x="422.93" y="657.81" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F24___label8" value="[thành công]" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_AD_F24_"><mxGeometry x="414.01" y="782.26" width="76.4" height="17" as="geometry" /></mxCell><mxCell id="card_AD_F24___e8" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F24_" source="card_AD_F24___n7" target="card_AD_F24___n8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="424.3" y="777.5" /><mxPoint x="424.76" y="796.47" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F24___label9" value="[lỗi / rollback nếu có ghi DB]" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_AD_F24_"><mxGeometry x="261.68" y="782.26" width="179.0" height="17" as="geometry" /></mxCell><mxCell id="card_AD_F24___e9" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F24_" source="card_AD_F24___n7" target="card_AD_F24___n4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="309.84000000000003" y="773.86" /><mxPoint x="286.44" y="784.76" /><mxPoint x="286.44" y="784.76" /><mxPoint x="286.44" y="784.76" /><mxPoint x="258.57" y="800.75" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F24___e10" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_AD_F24_" source="card_AD_F24___n8" target="card_AD_F24___n9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="367.01" y="886.9" /><mxPoint x="337.57" y="906.978" /></Array></mxGeometry></mxCell><mxCell id="card_AD_F24___note" value="Vai trò hành động ghi trong nút; nhánh lỗi kết thúc yêu cầu, dữ liệu không ghi một phần." style="text;html=1;fontFamily=Arial;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="content_card_AD_F24_"><mxGeometry x="24" y="978.52" width="589.8299999999999" height="70" as="geometry" /></mxCell><mxCell id="board_302" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chức năng:&lt;/b&gt; F24 ↔ UC21 — Thông báo giữ chỗ và quá hạn&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Người thao tác:&lt;/b&gt; Worker; Thủ thư theo dõi&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chủ thể / phạm vi:&lt;/b&gt; Một lần thực hiện chức năng; từ bắt đầu đến kết quả&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; Đọc theo mũi tên; chữ nhật là hoạt động, hình thoi chọn nhánh theo guard. Nhánh lỗi phải sửa hoặc kết thúc; không bỏ qua bước kiểm tra.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Hoạt động:&lt;/b&gt; Đọc outbox đã commit hoặc lịch nhắc quá hạn theo cấu hình được duyệt. → Kiểm tra sự kiện còn phù hợp; thẻ/thông tin nhận và consent theo kênh. → Nhận lease và gửi qua adapter; không log nội dung chứa PII. → Ghi delivered/failed; retry có backoff, vào dead-letter khi hết lượt; không kéo dài hạn READY.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Quy tắc đề xuất:&lt;/b&gt; Giữ chỗ có outbox trong baseline; nhắc quá hạn là mở rộng từ PDF; at-least-once với dedupe eventId+channel.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lỗi / ngoại lệ:&lt;/b&gt; Provider lỗi không rollback mượn/trả. Timeout có thể đã gửi: dedupe phía provider nếu hỗ trợ; không hứa exactly-once.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Kết quả / bất biến:&lt;/b&gt; Có số lần thử, nextAttemptAt, trạng thái và mã provider; thư không gửi không làm sai vòng đời giữ chỗ.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="6265" y="21413" width="570" height="1124" /></mxCell><mxCell id="board_303" value="&lt;b&gt;10 — TUẦN TỰ&lt;/b&gt;&lt;br&gt;Tương tác tổng quát và các kịch bản giao dịch quan trọng." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=24;fillColor=#16324F;fontColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="22668" width="9800" height="95" /></mxCell><mxCell id="card_OV_SEQUENCE" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#A8BACB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="22798" width="2135" height="1793" /></mxCell><mxCell id="board_305" value="TỔNG QUÁT TOÀN HỆ THỐNG • OV_SEQUENCE Sequence — Tổng quát tương tác UI / API / miền / DB / Worker" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=22;fontStyle=1;fillColor=#DDF2E7;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="112" y="22808" width="2111" height="80" /></mxCell><mxCell id="content_card_OV_SEQUENCE" value="" style="group;" vertex="1" parent="1"><mxGeometry as="geometry" x="120" y="22903" width="1495" height="1653" /></mxCell><mxCell id="card_OV_SEQUENCE__frame0" value="alt [QUERY]" style="rounded=0;fillColor=none;strokeColor=#657585;html=1;verticalAlign=top;align=left;fontSize=11;" vertex="1" parent="content_card_OV_SEQUENCE"><mxGeometry x="20" y="396" width="1435" height="504" as="geometry" /></mxCell><mxCell id="card_OV_SEQUENCE__branchLine0_0" value="" style="dashed=1;endArrow=none;strokeColor=#657585;" edge="1" parent="content_card_OV_SEQUENCE"><mxGeometry relative="1" as="geometry"><mxPoint x="20" y="540" as="sourcePoint" /><mxPoint x="1455" y="540" as="targetPoint" /></mxGeometry></mxCell><mxCell id="card_OV_SEQUENCE__branchLabel0_0" value="[COMMAND]" style="text;html=1;fontSize=11;align=left;" vertex="1" parent="content_card_OV_SEQUENCE"><mxGeometry x="25" y="540" width="1425" height="20" as="geometry" /></mxCell><mxCell id="card_OV_SEQUENCE__branchLine0_1" value="" style="dashed=1;endArrow=none;strokeColor=#657585;" edge="1" parent="content_card_OV_SEQUENCE"><mxGeometry relative="1" as="geometry"><mxPoint x="20" y="756" as="sourcePoint" /><mxPoint x="1455" y="756" as="targetPoint" /></mxGeometry></mxCell><mxCell id="card_OV_SEQUENCE__branchLabel0_1" value="[JOB]" style="text;html=1;fontSize=11;align=left;" vertex="1" parent="content_card_OV_SEQUENCE"><mxGeometry x="25" y="756" width="1425" height="20" as="geometry" /></mxCell><mxCell id="card_OV_SEQUENCE__frame1" value="critical giao dịch DB nguyên tử" style="rounded=0;fillColor=none;strokeColor=#657585;html=1;verticalAlign=top;align=left;fontSize=11;" vertex="1" parent="content_card_OV_SEQUENCE"><mxGeometry x="615" y="540" width="480" height="216" as="geometry" /></mxCell><mxCell id="card_OV_SEQUENCE__frame2" value="opt [có job/outbox] sau commit; chạy bất đồng bộ" style="rounded=0;fillColor=none;strokeColor=#657585;html=1;verticalAlign=top;align=left;fontSize=11;" vertex="1" parent="content_card_OV_SEQUENCE"><mxGeometry x="44" y="1116" width="1387" height="360" as="geometry" /></mxCell><mxCell id="card_OV_SEQUENCE__p0" value="Người dùng" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=0;fillColor=#edf3f7;" vertex="1" parent="content_card_OV_SEQUENCE"><mxGeometry x="50" y="55" width="165" height="44" as="geometry" /></mxCell><mxCell id="card_OV_SEQUENCE__life0" value="" style="dashed=1;endArrow=none;strokeColor=#657585;" edge="1" parent="content_card_OV_SEQUENCE"><mxGeometry relative="1" as="geometry"><mxPoint x="132.5" y="99" as="sourcePoint" /><mxPoint x="132.5" y="1543" as="targetPoint" /></mxGeometry></mxCell><mxCell id="card_OV_SEQUENCE__p1" value="Web UI" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=0;fillColor=#edf3f7;" vertex="1" parent="content_card_OV_SEQUENCE"><mxGeometry x="255" y="55" width="165" height="44" as="geometry" /></mxCell><mxCell id="card_OV_SEQUENCE__life1" value="" style="dashed=1;endArrow=none;strokeColor=#657585;" edge="1" parent="content_card_OV_SEQUENCE"><mxGeometry relative="1