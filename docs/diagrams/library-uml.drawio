ard_OV_SEQUENCE"><mxGeometry x="455" y="924" width="380" height="36" as="geometry" /></mxCell><mxCell id="card_OV_SEQUENCE__m12" value="" style="endArrow=classic;endFill=1;strokeColor=#344454;" edge="1" parent="content_card_OV_SEQUENCE"><mxGeometry relative="1" as="geometry"><mxPoint x="542.5" y="1039" as="sourcePoint" /><mxPoint x="337.5" y="1039" as="targetPoint" /></mxGeometry></mxCell><mxCell id="card_OV_SEQUENCE__l12" value="13. 200 hoặc 201; 202 cho job" style="text;html=1;fontSize=12;whiteSpace=wrap;align=center;fillColor=#FFFFFF;" vertex="1" parent="content_card_OV_SEQUENCE"><mxGeometry x="250" y="996" width="380" height="36" as="geometry" /></mxCell><mxCell id="card_OV_SEQUENCE__m13" value="" style="endArrow=classic;endFill=1;strokeColor=#344454;" edge="1" parent="content_card_OV_SEQUENCE"><mxGeometry relative="1" as="geometry"><mxPoint x="337.5" y="1111" as="sourcePoint" /><mxPoint x="132.5" y="1111" as="targetPoint" /></mxGeometry></mxCell><mxCell id="card_OV_SEQUENCE__l13" value="14. Hiển thị kết quả / theo dõi tác vụ" style="text;html=1;fontSize=12;whiteSpace=wrap;align=center;fillColor=#FFFFFF;" vertex="1" parent="content_card_OV_SEQUENCE"><mxGeometry x="45" y="1068" width="380" height="36" as="geometry" /></mxCell><mxCell id="card_OV_SEQUENCE__m14" value="" style="endArrow=classic;endFill=1;strokeColor=#344454;" edge="1" parent="content_card_OV_SEQUENCE"><mxGeometry relative="1" as="geometry"><mxPoint x="1157.5" y="1183" as="sourcePoint" /><mxPoint x="952.5" y="1183" as="targetPoint" /></mxGeometry></mxCell><mxCell id="card_OV_SEQUENCE__l14" value="15. Claim job/outbox đã commit; lease" style="text;html=1;fontSize=12;whiteSpace=wrap;align=center;fillColor=#FFFFFF;" vertex="1" parent="content_card_OV_SEQUENCE"><mxGeometry x="865" y="1140" width="380" height="36" as="geometry" /></mxCell><mxCell id="card_OV_SEQUENCE__m15" value="" style="endArrow=classic;endFill=1;strokeColor=#344454;" edge="1" parent="content_card_OV_SEQUENCE"><mxGeometry relative="1" as="geometry"><mxPoint x="952.5" y="1255" as="sourcePoint" /><mxPoint x="1157.5" y="1255" as="targetPoint" /></mxGeometry></mxCell><mxCell id="card_OV_SEQUENCE__l15" value="16. Sự kiện / tác vụ chờ xử lý" style="text;html=1;fontSize=12;whiteSpace=wrap;align=center;fillColor=#FFFFFF;" vertex="1" parent="content_card_OV_SEQUENCE"><mxGeometry x="865" y="1212" width="380" height="36" as="geometry" /></mxCell><mxCell id="card_OV_SEQUENCE__m16" value="" style="endArrow=classic;endFill=1;strokeColor=#344454;" edge="1" parent="content_card_OV_SEQUENCE"><mxGeometry relative="1" as="geometry"><mxPoint x="1157.5" y="1327" as="sourcePoint" /><mxPoint x="1362.5" y="1327" as="targetPoint" /></mxGeometry></mxCell><mxCell id="card_OV_SEQUENCE__l16" value="17. Thông báo / storage qua adapter; dedupe" style="text;html=1;fontSize=12;whiteSpace=wrap;align=center;fillColor=#FFFFFF;" vertex="1" parent="content_card_OV_SEQUENCE"><mxGeometry x="1070" y="1284" width="380" height="36" as="geometry" /></mxCell><mxCell id="card_OV_SEQUENCE__m17" value="" style="endArrow=classic;endFill=1;strokeColor=#344454;" edge="1" parent="content_card_OV_SEQUENCE"><mxGeometry relative="1" as="geometry"><mxPoint x="1362.5" y="1399" as="sourcePoint" /><mxPoint x="1157.5" y="1399" as="targetPoint" /></mxGeometry></mxCell><mxCell id="card_OV_SEQUENCE__l17" value="18. Kết quả hoặc lỗi tạm thời" style="text;html=1;fontSize=12;whiteSpace=wrap;align=center;fillColor=#FFFFFF;" vertex="1" parent="content_card_OV_SEQUENCE"><mxGeometry x="1070" y="1356" width="380" height="36" as="geometry" /></mxCell><mxCell id="card_OV_SEQUENCE__m18" value="" style="endArrow=classic;endFill=1;strokeColor=#344454;" edge="1" parent="content_card_OV_SEQUENCE"><mxGeometry relative="1" as="geometry"><mxPoint x="1157.5" y="1471" as="sourcePoint" /><mxPoint x="952.5" y="1471" as="targetPoint" /></mxGeometry></mxCell><mxCell id="card_OV_SEQUENCE__l18" value="19. Đánh dấu hoàn tất hoặc lập lịch retry hữu hạn" style="text;html=1;fontSize=12;whiteSpace=wrap;align=center;fillColor=#FFFFFF;" vertex="1" parent="content_card_OV_SEQUENCE"><mxGeometry x="865" y="1428" width="380" height="36" as="geometry" /></mxCell><mxCell id="card_OV_SEQUENCE__note" value="Các nhánh QUERY / COMMAND / JOB được chọn theo loại yêu cầu. Auth lỗi trả 401/403 trước dispatch; nghiệp vụ lỗi trả 409/422; command lỗi rollback. Dịch vụ ngoài không tham gia giao dịch DB. Số hàng đếm từ 1; chi tiết thông điệp nằm trong 6 sequence phía dưới." style="text;html=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="content_card_OV_SEQUENCE"><mxGeometry x="25" y="1558" width="1425" height="60" as="geometry" /></mxCell><mxCell id="board_307" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Mục đích:&lt;/b&gt; Sequence — Tổng quát tương tác UI / API / miền / DB / Worker&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; Cột là participant, nét đứt là lifeline; thời gian từ trên xuống. alt = chọn một nhánh; critical = vùng nguyên tử; opt = có điều kiện.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách hoạt động:&lt;/b&gt; Thời gian đi từ trên xuống. UI → API → module miền; API kiểm tra token và quyền trước dispatch. Khung alt có ba nhánh QUERY / COMMAND / JOB, chỉ một nhánh chạy cho một yêu cầu. Khung critical thuộc COMMAND: khóa, ghi nghiệp vụ / audit / outbox, commit. Khung opt sau phản hồi chạy bất đồng bộ khi có job / outbox; tích hợp ngoài có retry và dedupe.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lưu ý / ràng buộc:&lt;/b&gt; Các nhánh QUERY / COMMAND / JOB được chọn theo loại yêu cầu. Auth lỗi trả 401/403 trước dispatch; nghiệp vụ lỗi trả 409/422; command lỗi rollback. Dịch vụ ngoài không tham gia giao dịch DB. Số hàng đếm từ 1; chi tiết thông điệp nằm trong 6 sequence phía dưới.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="1630" y="22903" width="570" height="1673" /></mxCell><mxCell id="card_SD_Auth" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#A8BACB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="2295" y="22798" width="1725" height="1022" /></mxCell><mxCell id="board_309" value="CHI TIẾT • SD_Auth Sequence — UC0 đăng nhập" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=22;fontStyle=1;fillColor=#EAF2F8;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="2307" y="22808" width="1701" height="80" /></mxCell><mxCell id="content_card_SD_Auth" value="" style="group;" vertex="1" parent="1"><mxGeometry as="geometry" x="2315" y="22903" width="1085" height="882" /></mxCell><mxCell id="card_SD_Auth__frame0" value="alt [token hợp lệ và account được phép]" style="rounded=0;fillColor=none;strokeColor=#657585;html=1;verticalAlign=top;align=left;fontSize=11;" vertex="1" parent="content_card_SD_Auth"><mxGeometry x="20" y="507" width="1025" height="228" as="geometry" /></mxCell><mxCell id="card_SD_Auth__divider0" value="[token sai hoặc thiếu quyền]" style="text;html=1;fontSize=11;align=left;" vertex="1" parent="content_card_SD_Auth"><mxGeometry x="25" y="678" width="1015" height="20" as="geometry" /></mxCell><mxCell id="card_SD_Auth__p0" value="Người dùng" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=0;fillColor=#edf3f7;" vertex="1" parent="content_card_SD_Auth"><mxGeometry x="50" y="55" width="165" height="44" as="geometry" /></mxCell><mxCell id="card_SD_Auth__life0" value="" style="dashed=1;endArrow=none;strokeColor=#657585;" edge="1" parent="content_card_SD_Auth"><mxGeometry relative="1" as="geometry"><mxPoint x="132.5" y="99" as="sourcePoint" /><mxPoint x="132.5" y="772" as="targetPoint" /></mxGeometry></mxC