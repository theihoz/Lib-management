1" as="geometry"><mxPoint x="952.5" y="487" as="sourcePoint" /><mxPoint x="747.5" y="487" as="targetPoint" /></mxGeometry></mxCell><mxCell id="card_SD_Hold__l6" value="7. Đọc event READY" style="text;html=1;fontSize=12;whiteSpace=wrap;align=center;fillColor=#FFFFFF;" vertex="1" parent="content_card_SD_Hold"><mxGeometry x="660" y="444" width="380" height="36" as="geometry" /></mxCell><mxCell id="card_SD_Hold__m7" value="" style="endArrow=classic;endFill=1;strokeColor=#344454;" edge="1" parent="content_card_SD_Hold"><mxGeometry relative="1" as="geometry"><mxPoint x="952.5" y="544" as="sourcePoint" /><mxPoint x="132.5" y="544" as="targetPoint" /></mxGeometry></mxCell><mxCell id="card_SD_Hold__l7" value="8. Thông báo nhận sách" style="text;html=1;fontSize=12;whiteSpace=wrap;align=center;fillColor=#FFFFFF;" vertex="1" parent="content_card_SD_Hold"><mxGeometry x="352.5" y="501" width="380" height="36" as="geometry" /></mxCell><mxCell id="card_SD_Hold__m8" value="" style="endArrow=classic;endFill=1;strokeColor=#344454;" edge="1" parent="content_card_SD_Hold"><mxGeometry relative="1" as="geometry"><mxPoint x="132.5" y="601" as="sourcePoint" /><mxPoint x="337.5" y="601" as="targetPoint" /></mxGeometry></mxCell><mxCell id="card_SD_Hold__l8" value="9. Đến quầy nhận; checkout do thủ thư" style="text;html=1;fontSize=12;whiteSpace=wrap;align=center;fillColor=#FFFFFF;" vertex="1" parent="content_card_SD_Hold"><mxGeometry x="45" y="558" width="380" height="36" as="geometry" /></mxCell><mxCell id="card_SD_Hold__m9" value="" style="endArrow=classic;endFill=1;strokeColor=#344454;" edge="1" parent="content_card_SD_Hold"><mxGeometry relative="1" as="geometry"><mxPoint x="337.5" y="658" as="sourcePoint" /><mxPoint x="542.5" y="658" as="targetPoint" /></mxGeometry></mxCell><mxCell id="card_SD_Hold__l9" value="10. Kiểm tra lại owner, expiry, eligibility" style="text;html=1;fontSize=12;whiteSpace=wrap;align=center;fillColor=#FFFFFF;" vertex="1" parent="content_card_SD_Hold"><mxGeometry x="250" y="615" width="380" height="36" as="geometry" /></mxCell><mxCell id="card_SD_Hold__m10" value="" style="endArrow=classic;endFill=1;strokeColor=#344454;" edge="1" parent="content_card_SD_Hold"><mxGeometry relative="1" as="geometry"><mxPoint x="542.5" y="715" as="sourcePoint" /><mxPoint x="747.5" y="715" as="targetPoint" /></mxGeometry></mxCell><mxCell id="card_SD_Hold__l10" value="11. COMMIT: FULFILLED + ON_LOAN" style="text;html=1;fontSize=12;whiteSpace=wrap;align=center;fillColor=#FFFFFF;" vertex="1" parent="content_card_SD_Hold"><mxGeometry x="455" y="672" width="380" height="36" as="geometry" /></mxCell><mxCell id="card_SD_Hold__m11" value="" style="endArrow=classic;endFill=1;strokeColor=#344454;" edge="1" parent="content_card_SD_Hold"><mxGeometry relative="1" as="geometry"><mxPoint x="337.5" y="772" as="sourcePoint" /><mxPoint x="132.5" y="772" as="targetPoint" /></mxGeometry></mxCell><mxCell id="card_SD_Hold__l11" value="12. Phiếu mượn" style="text;html=1;fontSize=12;whiteSpace=wrap;align=center;fillColor=#FFFFFF;" vertex="1" parent="content_card_SD_Hold"><mxGeometry x="45" y="729" width="380" height="36" as="geometry" /></mxCell><mxCell id="card_SD_Hold__m12" value="" style="endArrow=classic;endFill=1;strokeColor=#344454;" edge="1" parent="content_card_SD_Hold"><mxGeometry relative="1" as="geometry"><mxPoint x="952.5" y="829" as="sourcePoint" /><mxPoint x="747.5" y="829" as="targetPoint" /></mxGeometry></mxCell><mxCell id="card_SD_Hold__l12" value="13. alt quá hạn: EXPIRED, gán lượt tiếp" style="text;html=1;fontSize=12;whiteSpace=wrap;align=center;fillColor=#FFFFFF;" vertex="1" parent="content_card_SD_Hold"><mxGeometry x="660" y="786" width="380" height="36" as="geometry" /></mxCell><mxCell id="card_SD_Hold__note" value="READY không phải kết thúc vòng đời. Không phân bổ hai lượt vào cùng copy." style="text;html=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="content_card_SD_Hold"><mxGeometry x="25" y="901" width="1015" height="60" as="geometry" /></mxCell><mxCell id="board_331" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Mục đích:&lt;/b&gt; Sequence — UC9 phân bổ và nhận sách đặt trước&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; Cột là participant, nét đứt là lifeline; thời gian từ trên xuống. alt = chọn một nhánh; critical = vùng nguyên tử; opt = có điều kiện.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách hoạt động:&lt;/b&gt; Giữ chỗ theo BookEdition; service khóa edition để xử lý FIFO. QUEUED → READY khi copy phù hợp xuất hiện; gắn copy và readyExpiresAt. Nhận sách READY kiểm tra đúng độc giả / thời hạn và tạo LoanItem, chuyển FULFILLED nguyên tử. Hủy / hết hạn giải phóng copy và phân bổ người tiếp theo; thông báo qua outbox.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lưu ý / ràng buộc:&lt;/b&gt; READY không phải kết thúc vòng đời. Không phân bổ hai lượt vào cùng copy.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="3348" y="24756" width="570" height="1016" /></mxCell><mxCell id="board_332" value="&lt;b&gt;11 — SƠ ĐỒ GỐC THAM KHẢO&lt;/b&gt;&lt;br&gt;Giữ nguyên nội dung lịch sử; sử dụng các vùng 01–10 làm thiết kế mới." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=24;fillColor=#16324F;fontColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="26001" width="9800" height="95" /></mxCell><mxCell id="card_ARCHIVE" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#A8BACB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="26131" width="2360" height="2080" /></mxCell><mxCell id="board_334" value="CHI TIẾT • ARCHIVE — Trang gốc (tham khảo, chưa sửa)" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=22;fontStyle=1;fillColor=#EAF2F8;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="112" y="26141" width="2336" height="80" /></mxCell><mxCell id="content_card_ARCHIVE" value="" style="group;" vertex="1" parent="1"><mxGeometry as="geometry" x="120" y="26696.0" width="1720" height="1940" /></mxCell><mxCell id="card_ARCHIVE__AyUVIFYtMWB9BJY2zEMB-293" parent="content_card_ARCHIVE" style="swimlane;startSize=30;fontStyle=1;align=center;horizontal=1;container=1;collapsible=0;html=1;whiteSpace=wrap;strokeWidth=1.5;" value="Hệ thống Quản lý Thư viện" vertex="1">
