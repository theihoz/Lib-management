" as="targetPoint" /></mxGeometry></mxCell><mxCell id="card_SD_Card__l3" value="4. Tuổi 12–55; 6 tháng lịch" style="text;html=1;fontSize=12;whiteSpace=wrap;align=center;fillColor=#FFFFFF;" vertex="1" parent="content_card_SD_Card"><mxGeometry x="455" y="273" width="380" height="36" as="geometry" /></mxCell><mxCell id="card_SD_Card__m4" value="" style="endArrow=classic;endFill=1;strokeColor=#344454;" edge="1" parent="content_card_SD_Card"><mxGeometry relative="1" as="geometry"><mxPoint x="542.5" y="373" as="sourcePoint" /><mxPoint x="952.5" y="373" as="targetPoint" /></mxGeometry></mxCell><mxCell id="card_SD_Card__l4" value="5. BEGIN; khóa reader; kiểm tra trùng" style="text;html=1;fontSize=12;whiteSpace=wrap;align=center;fillColor=#FFFFFF;" vertex="1" parent="content_card_SD_Card"><mxGeometry x="557.5" y="330" width="380" height="36" as="geometry" /></mxCell><mxCell id="card_SD_Card__m5" value="" style="endArrow=classic;endFill=1;strokeColor=#344454;" edge="1" parent="content_card_SD_Card"><mxGeometry relative="1" as="geometry"><mxPoint x="542.5" y="430" as="sourcePoint" /><mxPoint x="542.5" y="430" as="targetPoint" /><Array as="points"><mxPoint x="622.5" y="430" /><mxPoint x="622.5" y="452" /></Array></mxGeometry></mxCell><mxCell id="card_SD_Card__l5" value="6. Tính tuổi và expiresAt" style="text;html=1;fontSize=12;whiteSpace=wrap;align=center;fillColor=#FFFFFF;" vertex="1" parent="content_card_SD_Card"><mxGeometry x="412.5" y="387" width="380" height="36" as="geometry" /></mxCell><mxCell id="card_SD_Card__m6" value="" style="endArrow=classic;endFill=1;strokeColor=#344454;" edge="1" parent="content_card_SD_Card"><mxGeometry relative="1" as="geometry"><mxPoint x="542.5" y="487" as="sourcePoint" /><mxPoint x="952.5" y="487" as="targetPoint" /></mxGeometry></mxCell><mxCell id="card_SD_Card__l6" value="7. INSERT card + audit + idempotency; COMMIT" style="text;html=1;fontSize=12;whiteSpace=wrap;align=center;fillColor=#FFFFFF;" vertex="1" parent="content_card_SD_Card"><mxGeometry x="557.5" y="444" width="380" height="36" as="geometry" /></mxCell><mxCell id="card_SD_Card__m7" value="" style="endArrow=classic;endFill=1;strokeColor=#344454;" edge="1" parent="content_card_SD_Card"><mxGeometry relative="1" as="geometry"><mxPoint x="952.5" y="544" as="sourcePoint" /><mxPoint x="542.5" y="544" as="targetPoint" /></mxGeometry></mxCell><mxCell id="card_SD_Card__l7" value="8. Card ID" style="text;html=1;fontSize=12;whiteSpace=wrap;align=center;fillColor=#FFFFFF;" vertex="1" parent="content_card_SD_Card"><mxGeometry x="557.5" y="501" width="380" height="36" as="geometry" /></mxCell><mxCell id="card_SD_Card__m8" value="" style="endArrow=classic;endFill=1;strokeColor=#344454;" edge="1" parent="content_card_SD_Card"><mxGeometry relative="1" as="geometry"><mxPoint x="542.5" y="601" as="sourcePoint" /><mxPoint x="337.5" y="601" as="targetPoint" /></mxGeometry></mxCell><mxCell id="card_SD_Card__l8" value="9. 201 thẻ" style="text;html=1;fontSize=12;whiteSpace=wrap;align=center;fillColor=#FFFFFF;" vertex="1" parent="content_card_SD_Card"><mxGeometry x="250" y="558" width="380" height="36" as="geometry" /></mxCell><mxCell id="card_SD_Card__m9" value="" style="endArrow=classic;endFill=1;strokeColor=#344454;" edge="1" parent="content_card_SD_Card"><mxGeometry relative="1" as="geometry"><mxPoint x="542.5" y="658" as="sourcePoint" /><mxPoint x="337.5" y="658" as="targetPoint" /></mxGeometry></mxCell><mxCell id="card_SD_Card__l9" value="10. alt dữ liệu sai: 422; rollback" style="text;html=1;fontSize=12;whiteSpace=wrap;align=center;fillColor=#FFFFFF;" vertex="1" parent="content_card_SD_Card"><mxGeometry x="250" y="615" width="380" height="36" as="geometry" /></mxCell><mxCell id="card_SD_Card__note" value="Khoảng hiệu lực [issuedAt, expiresAt); ngày cuối tháng được clamp theo lịch." style="text;html=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="content_card_SD_Card"><mxGeometry x="25" y="730" width="1015" height="60" as="geometry" /></mxCell><mxCell id="board_315" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Mục đích:&lt;/b&gt; Sequence — UC5 cấp thẻ&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; Cột là participant, nét đứt là lifeline; thời gian từ trên xuống. alt = chọn một nhánh; critical = vùng nguyên tử; opt = có điều kiện.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách hoạt động:&lt;/b&gt; Thủ thư gửi dữ liệu độc giả; API kiểm tra quyền, tuổi và dữ liệu. Domain xác định thời điểm cấp, tính hạn theo tháng lịch và ghi Reader / ReaderCard cùng audit trong transaction. Lỗi trả về trước commit hoặc rollback. Thẻ có trạng thái và khoảng hiệu lực rõ ràng, không chỉ một ngày hết hạn.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lưu ý / ràng buộc:&lt;/b&gt; Khoảng hiệu lực [issuedAt, expiresAt); ngày cuối tháng được clamp theo lịch.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="5200" y="22903" width="570" height="845" /></mxCell><mxCell id="card_SD_Catalog" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#A8BACB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="5865" y="22798" width="1520" height="965" /></mxCell><mxCell id="board_317" value="CHI TIẾT • SD_Catalog Sequence — UC1/UC2 đầu sách và bản sao" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=22;fontStyle=1;fillColor=#EAF2F8;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="5877" y="22808" width="1496" height="80" /></mxCell><mxCell id="content_card_SD_Catalog" value="" style="group;" vertex="1" parent="1"><mxGeometry as="geometry" x="5885" y="22903" width="880" height="825" /></mxCell><mxCell id="card_SD_Catalog_