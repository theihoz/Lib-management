ry" /></mxCell><mxCell id="card_ST_F10__e3" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F10" source="card_ST_F10__n2" target="card_ST_F10__n3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="315.2" y="298.78" /><mxPoint x="410.77" y="319.96000000000004" /><mxPoint x="410.77" y="319.96000000000004" /><mxPoint x="410.77" y="319.96000000000004" /><mxPoint x="419.11" y="341.65" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F10__label4" value="hủy / giải phóng copy" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_ST_F10"><mxGeometry x="125.88999999999999" y="323.46000000000004" width="127.7" height="17" as="geometry" /></mxCell><mxCell id="card_ST_F10__e4" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F10" source="card_ST_F10__n2" target="card_ST_F10__n4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="166.566" y="307.17" /><mxPoint x="139.715" y="319.96000000000004" /><mxPoint x="139.715" y="319.96000000000004" /><mxPoint x="139.715" y="319.96000000000004" /><mxPoint x="139.715" y="343.96000000000004" /><mxPoint x="139.715" y="343.96000000000004" /><mxPoint x="139.715" y="343.96000000000004" /><mxPoint x="139.898" y="351.06" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F10__label5" value="at(expiresAt) / chuyển lượt tiếp" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_ST_F10"><mxGeometry x="235.28000000000003" y="323.46000000000004" width="190.4" height="17" as="geometry" /></mxCell><mxCell id="card_ST_F10__e5" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F10" source="card_ST_F10__n2" target="card_ST_F10__n5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="243.94" y="313.35" /><mxPoint x="258.26" y="340.46000000000004" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F10__e6" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F10" source="card_ST_F10__n3" target="card_ST_F10__n6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="369.41" y="420.105" /><mxPoint x="324.53" y="442.524" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F10__e7" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F10" source="card_ST_F10__n4" target="card_ST_F10__n6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="201.11" y="419.87800000000004" /><mxPoint x="241.44" y="441.877" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F10__e8" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F10" source="card_ST_F10__n5" target="card_ST_F10__n6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="281.77" y="416.399" /><mxPoint x="281.77" y="432.309" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F10__note" value="Reservation" style="text;html=1;fontFamily=Arial;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="content_card_ST_F10"><mxGeometry x="24" y="511.8" width="621.31" height="70" as="geometry" /></mxCell><mxCell id="board_145" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chức năng:&lt;/b&gt; F10 ↔ UC9 — Đặt trước và giữ chỗ&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Người thao tác:&lt;/b&gt; Độc giả; Thủ thư hỗ trợ&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chủ thể / phạm vi:&lt;/b&gt; Reservation&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; Nút = trạng thái của chủ thể; cạnh = sự kiện [điều kiện] / hành động. Nút đen bắt đầu; nút kép kết thúc phiên được mô tả.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Hoạt động:&lt;/b&gt; Xác thực độc giả; kiểm tra đầu sách và trùng lượt đang hoạt động. → Khi không có bản sao khả dụng, tạo QUEUED. → Khi có bản sao trả tốt, khóa hàng đợi và gán lượt hợp lệ đầu tiên thành READY. → Gửi thông báo sau commit; nhận sách phải kiểm tra điều kiện mượn lần nữa.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Quy tắc đề xuất:&lt;/b&gt; Đặt theo đầu sách; hàng đợi FIFO createdAt+ID; mỗi độc giả chỉ một lượt đang hoạt động/đầu sách; READY hết hạn sau 3 ngày.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lỗi / ngoại lệ:&lt;/b&gt; Hết 3 ngày: EXPIRED và phân bổ lượt tiếp theo cùng giao dịch. Hủy được QUEUED/READY. Không cấm đặt lại chỉ vì đã từng có lịch sử.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Kết quả / bất biến:&lt;/b&gt; Một bản sao chỉ gắn một lượt READY; một lượt READY chỉ gắn một bản sao.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="5937" y="13787" width="570" height="658" /></mxCell><mxCell id="card_ST_F11" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#A8BACB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="6602" y="13682" width="1398" height="778" /></mxCell><mxCell id="board_147" value="CHI TIẾT • ST_F11 F11 — Ghi phí, thu và miễn phạt" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=22;fontStyle=1;fillColor=#EAF2F8;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="6614" y="13692" width="1374" height="80" /></mxCell><mxCell id="content_card_ST_F11" value="" style="group;" vertex="1" parent="1"><mxGeometry as="geometry" x="6622" y="13787" width="758" height="540" /></mxCell><mxCell id="card_ST_F11__title" value="F11 — Ghi phí, thu và miễn phạt" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="content_card_ST_F11"><mxGeometry x="24" y="16" width="667.81" height="40" as="geometry" /></mxCell><mxCell id="card_ST_F11__n0" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;ellipse;fillColor=#243444;" vertex="1" parent="content_card_ST_F11"><mxGeometry x="351.39" y="89.99999999999996" width="12.959999999999999" height="12.959999999999999" as="geometry" /></mxCell><mxCell id="card_ST_F11__n1" value="UNPAID" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_ST_F11"><mxGeometry x="320.3508" y="151.95999999999998" width="75.0384" height="36" as="geometry" /></mxCell><mxCell id="card_ST_F11__n2" value="PARTIALLY_SETTLED" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_ST_F11"><mxGeometry x="69.99999999999999" y="247.95999999999998" width="161.74800000000002" height="36" as="geometry" /></mxCell><mxCell id="card_ST_F11__n3" value="SETTLED" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_ST_F11"><mxGeometry x="293.6528" y="343.96" width="84.43440000000001" height="36" as="geometry" /></mxCell><mxCell id="card_ST_F11__e0" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F11" source="card_ST_F11__n0" target="card_ST_F11__n1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="357.87" y="111.72