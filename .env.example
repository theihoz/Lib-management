# Copy to .env and replace this LOCAL development password before starting.
POSTGRES_USER=lib_dev
POSTGRES_DB=lib_management
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432
API_PORT=3000
WEB_PORT=5173
# Browser uses localhost; containers reach PostgreSQL using the hostname db.
VITE_API_BASE_URL=http://localhost:3000/api/v1
CORS_ORIGIN=http://localhost:5173
