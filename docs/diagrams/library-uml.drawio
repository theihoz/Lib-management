=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_DFD_Reporting" source="card_DFD_Reporting__n4" target="card_DFD_Reporting__n2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="456.77" y="141.83" /><mxPoint x="446.91" y="162.58" /></Array></mxGeometry></mxCell><mxCell id="card_DFD_Reporting__label8" value="Policy version" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_DFD_Reporting"><mxGeometry x="502.32000000000005" y="257.64" width="87.8" height="17" as="geometry" /></mxCell><mxCell id="card_DFD_Reporting__e8" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_DFD_Reporting" source="card_DFD_Reporting__n2" target="card_DFD_Reporting__n7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="481.24" y="247.573" /><mxPoint x="501.98" y="260.14" /><mxPoint x="501.98" y="260.14" /><mxPoint x="501.98" y="260.14" /><mxPoint x="520.71" y="276.396" /></Array></mxGeometry></mxCell><mxCell id="card_DFD_Reporting__note" value="A=A1..A4; B=B1..B4; C=C1+C2; D=D1+D2. Không có luồng thực thể→kho hoặc kho→kho." style="text;html=1;fontFamily=Arial;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="content_card_DFD_Reporting"><mxGeometry x="24" y="368.74" width="934.48" height="70" as="geometry" /></mxCell><mxCell id="board_100" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Mục đích:&lt;/b&gt; DFD mức 1 — Chi tiết P4&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; Hình tròn / ellipse là tiến trình; hộp là thực thể ngoài; kho là nơi lưu dữ liệu. Mũi tên có nhãn là dữ liệu được chuyển.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách hoạt động:&lt;/b&gt; P4 nhận bộ lọc thống kê, lịch sử, quá hạn và xuất dữ liệu; đọc các kho liên quan và trả báo cáo / kết quả theo quyền. Tác vụ xuất lớn chạy nền. Báo cáo chỉ đọc dữ liệu nghiệp vụ, không thay đổi LoanItem, copy hoặc sổ phí.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lưu ý / ràng buộc:&lt;/b&gt; A=A1..A4; B=B1..B4; C=C1+C2; D=D1+D2. Không có luồng thực thể→kho hoặc kho→kho.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="1140" y="11895" width="570" height="514" /></mxCell><mxCell id="board_101" value="&lt;b&gt;08 — TRẠNG THÁI&lt;/b&gt;&lt;br&gt;Một sơ đồ cho mỗi chức năng F01–F24; chủ thể ghi riêng." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=24;fillColor=#16324F;fontColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="12524" width="9800" height="95" /></mxCell><mxCell id="card_OV_STATE" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#A8BACB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="12654" width="1519" height="968" /></mxCell><mxCell id="board_103" value="TỔNG QUÁT TOÀN HỆ THỐNG • OV_STATE State — Tổng quát phiên làm việc của người dùng" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=22;fontStyle=1;fillColor=#DDF2E7;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="112" y="12664" width="1495" height="80" /></mxCell><mxCell id="content_card_OV_STATE" value="" style="group;" vertex="1" parent="1"><mxGeometry as="geometry" x="120" y="12759" width="879" height="828" /></mxCell><mxCell id="card_OV_STATE__title" value="State — Tổng quát phiên làm việc của người dùng" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="content_card_OV_STA