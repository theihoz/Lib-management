4454;endArrow=classic;endFill=1;rounded=0;endArrow=none;" edge="1" parent="content_card_Class_Finance" source="card_Class_Finance__n2" target="card_Class_Finance__n4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="229.81" y="587.1" /><mxPoint x="204.06" y="612.24" /></Array></mxGeometry></mxCell><mxCell id="card_Class_Finance__label7" value="1 — 0..*" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_Class_Finance"><mxGeometry x="296.94" y="586.7" width="53.6" height="17" as="geometry" /></mxCell><mxCell id="card_Class_Finance__e7" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;endArrow=none;" edge="1" parent="content_card_Class_Finance" source="card_Class_Finance__n2" target="card_Class_Finance__n5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="306.51" y="584.44" /><mxPoint x="306.51" y="606.2" /></Array></mxGeometry></mxCell><mxCell id="card_Class_Finance__note" value="LoanItem OPEN xác định bằng closedAt IS NULL. Không lưu lại tổng dư nợ như nguồn chân lý; tính từ ledger." style="text;html=1;fontFamily=Arial;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="content_card_Class_Finance"><mxGeometry x="24" y="768.2" width="480.8" height="70" as="geometry" /></mxCell><mxCell id="board_58" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Mục đích:&lt;/b&gt; UML chi tiết — Sổ phí&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; Hộp lớp gồm tên và thuộc tính. Bội số ở liên kết cho biết số đối tượng được phép liên quan; đây là mô hình miền, không là flow.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách hoạt động:&lt;/b&gt; Khoản phí thuộc độc giả, có thể gắn LoanItem và phiên bản quy định. Payment được phân bổ vào các FineCharge bằng PaymentAllocation. Waiver giảm nghĩa vụ theo thẩm quyền, có lý do và dấu vết. Ghi tiền VND bằng số nguyên; điều chỉnh tạo bút toán, không sửa / xóa lịch sử tài chính.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lưu ý / ràng buộc:&lt;/b&gt; LoanItem OPEN xác định bằng closedAt IS NULL. Không lưu lại tổng dư nợ như nguồn chân lý; tính từ ledger.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="8071" y="7126" width="570" height="914" /></mxCell><mxCell id="board_59" value="&lt;b&gt;06 — MÔ HÌNH DỮ LIỆU&lt;/b&gt;&lt;br&gt;Khóa, bảng liên kết, bội số và ràng buộc lịch sử." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=24;fillColor=#16324F;fontColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="8771" width="9800" height="95" /></mxCell><mxCell id="card_OV_ERD" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#A8BACB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="8901" width="2490" height="1446" /></mxCell><mxCell id="board_61" value="TỔNG QUÁT TOÀN HỆ THỐNG • OV_ERD ERD — Tổng quát dữ liệu nghiệp vụ và dữ liệu vận hành" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=22;fontStyle=1;fillColor=#DDF2E7;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="112" y="8911" width="2466" height="80" /></mxCell><mxCell id="content_card_OV_ERD" value="" style="group;" vertex="1" parent="1"><mxGeometry as="geometry" x="120" y="9006" width="1850" height="1306" /></mxCell><mxCell id="card_OV_ERD__title" value="ERD — Tổng quát dữ liệu nghiệp vụ và dữ liệu vận hành" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="content_card_OV_ERD"><mxGeometry x="24" y="16" wid