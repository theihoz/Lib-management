mxGeometry x="376.7" y="305.46000000000004" width="139.1" height="17" as="geometry" /></mxCell><mxCell id="card_ST_F03__e4" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F03" source="card_ST_F03__n4" target="card_ST_F03__n1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="239.59" y="433.32000000000005" /><mxPoint x="357.34" y="379.96000000000004" /><mxPoint x="357.34" y="379.96000000000004" /><mxPoint x="357.34" y="379.96000000000004" /><mxPoint x="413.34" y="283.96000000000004" /><mxPoint x="413.34" y="283.96000000000004" /><mxPoint x="413.34" y="283.96000000000004" /><mxPoint x="413.34" y="247.96000000000004" /><mxPoint x="413.34" y="247.96000000000004" /><mxPoint x="413.34" y="247.96000000000004" /><mxPoint x="395.59" y="218.25" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F03__label5" value="[else] / chỉ lỗi" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_ST_F03"><mxGeometry x="156.82" y="486.66" width="99.2" height="17" as="geometry" /></mxCell><mxCell id="card_ST_F03__e5" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F03" source="card_ST_F03__n4" target="card_ST_F03__n5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="185.5" y="472.72" /><mxPoint x="166.84300000000002" y="498.54900000000004" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F03__label6" value="sửa lại" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_ST_F03"><mxGeometry x="133.459" y="401.46000000000004" width="47.9" height="17" as="geometry" /></mxCell><mxCell id="card_ST_F03__e6" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F03" source="card_ST_F03__n5" target="card_ST_F03__n2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="137.65300000000002" y="476.697" /><mxPoint x="142.341" y="343.96000000000004" /><mxPoint x="142.341" y="343.96000000000004" /><mxPoint x="142.341" y="343.96000000000004" /><mxPoint x="152.341" y="307.96000000000004" /><mxPoint x="152.341" y="307.96000000000004" /><mxPoint x="152.341" y="307.96000000000004" /><mxPoint x="165.111" y="298.77000000000004" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F03__label7" value="đóng phiên" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_ST_F03"><mxGeometry x="347.31" y="257.46000000000004" width="65.0" height="17" as="geometry" /></mxCell><mxCell id="card_ST_F03__e7" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F03" source="card_ST_F03__n1" target="card_ST_F03__n6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="358.59" y="227.65000000000003" /><mxPoint x="344.34" y="319.96000000000004" /><mxPoint x="344.34" y="319.96000000000004" /><mxPoint x="344.34" y="319.96000000000004" /><mxPoint x="339.37" y="331.94000000000005" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F03__label8" value="hủy / không lưu" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_ST_F03"><mxGeometry x="257.3" y="305.46000000000004" width="93.5" height="17" as="geometry" /></mxCell><mxCell id="card_ST_F03__e8" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F03" source="card_ST_F03__n2" target="card_ST_F03__n6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="246.12" y="299.77000000000004" /><mxPoint x="268.75" y="319.96000000000004" /><mxPoint x="268.75" y="319.96000000000004" /><mxPoint x="268.75" y="319.96000000000004" /><mxPoint x="293.46000000000004" y="337.25" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F03__note" value="Phiên sửa Category" style="text;html=1;fontFamily=Arial;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="content_card_ST_F03"><mxGeometry x="24" y="596.1600000000001" width="523.49" height="70" as="geometry" /></mxCell><mxCell id="board_117" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chức năng:&lt;/b&gt; F03 ↔ UC3 — Quản lý thể loại phân cấp&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Người thao tác:&lt;/b&gt; Thủ thư&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chủ thể / phạm vi:&lt;/b&gt; Phiên sửa Category&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; Nút = trạng thái của chủ thể; cạnh = sự kiện [điều kiện] / hành động. Nút đen bắt đầu; nút kép kết thúc phiên được mô tả.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Hoạt động:&lt;/b&gt; Chọn thêm/sửa thể loại dưới một gốc. → Kiểm tra cha tồn tại, không phải chính nó hoặc hậu duệ. → Lưu parentId trong giao dịch; kiểm soát cạnh tranh. → Xóa chỉ khi không có con và liên kết đầu sách.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Quy tắc đề xuất:&lt;/b&gt; QĐ04: giữ ba gốc A/B/C; không có chu trình; không tự làm mất liên kết đầu sách.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lỗi / ngoại lệ:&lt;/b&gt; Chu trình, xóa gốc, có con hoặc đang được dùng: 409; người dùng chọn cha khác hoặc ngừng dùng.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Kết quả / bất biến:&lt;/b&gt; Cây luôn có gốc A/B/C; đường dẫn không đệ quy vô hạn.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="5913" y="12759" width="570" height="742" /></mxCell><mxCell id="card_ST_F04" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#A8BACB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="6578" y="12654" width="1234" height="862" /></mxCell><mxCell id="board_119" value="CHI TIẾT • ST_F04 F04 — Quản lý tác giả" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=22;fontStyle=1;fillColor=#EAF2F8;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="6590" y="12664" width="1210" height="80" /></mxCell><mxCell id="content_card_ST_F04" value="" style="group;" vertex="1" parent="1"><mxGeometry as="geometry" x="6598" y="12759" width="594" height="722" /></mxCell><mxCell id="card_ST_F04__title" value="F04 — Quản lý tác giả" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="content_card_ST_F04"><mxGeometry x="24" y="16" width="503.49" height="40" as="geometry" /></mxCell><mxCell id="card_ST_F04__n0" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;ellipse;fillColor=#243444;" vertex="1" parent="content_card_ST_F04"><mxGeometry x="360.85999999999996" y="90.00000000000001" width="12.959999999999999" height="12.959999999999999" as="geometry" /></mxCell><mxCell id="card_ST_F04__n1" value="Đang xem" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_ST_F04"><mxGeometry x="325.8392" y="151.96000000000004" width="83.0016" height="36" as="geometry" /></mxCell><mxCell id="card_ST_F04__n2" value="Đang sửa" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_ST_F04"><mxGeometry x="167.8356" y="247.96000000000004" width="83.00880000000001" hei