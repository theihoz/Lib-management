9996" y="422.399" /><mxPoint x="189" y="405.16" /><mxPoint x="189" y="405.16" /><mxPoint x="189" y="405.16" /><mxPoint x="189" y="393.16" /><mxPoint x="189" y="393.16" /><mxPoint x="189" y="393.16" /><mxPoint x="333.92" y="251.3" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F18__label9" value="đóng phiên" style="text;html=1;fontFamily=Arial;fontSize=10;align=center;whiteSpace=wrap;fillColor=none;" vertex="1" parent="content_card_ST_F18"><mxGeometry x="721.88" y="209.46000000000004" width="65.0" height="17" as="geometry" /></mxCell><mxCell id="card_ST_F18__e9" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F18" source="card_ST_F18__n1" target="card_ST_F18__n7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="556.95" y="189.91000000000003" /><mxPoint x="721" y="211.96000000000004" /><mxPoint x="721" y="211.96000000000004" /><mxPoint x="721" y="211.96000000000004" /><mxPoint x="737.22" y="233.46000000000004" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F18__note" value="SearchSession" style="text;html=1;fontFamily=Arial;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="content_card_ST_F18"><mxGeometry x="24" y="500.16" width="809.12" height="70" as="geometry" /></mxCell><mxCell id="board_177" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chức năng:&lt;/b&gt; F18 ↔ UC12 — Tìm kiếm nhanh sách và độc giả&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Người thao tác:&lt;/b&gt; Mọi người tìm sách; Thủ thư tìm độc giả&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chủ thể / phạm vi:&lt;/b&gt; SearchSession&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; Nút = trạng thái của chủ thể; cạnh = sự kiện [điều kiện] / hành động. Nút đen bắt đầu; nút kép kết thúc phiên được mô tả.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Hoạt động:&lt;/b&gt; Nhập từ khóa/bộ lọc tên sách, tác giả, thể loại hoặc mã. → Chuẩn hóa, giới hạn độ dài và phân trang. → Tách truy vấn catalog và reader; kiểm tra quyền trước truy vấn reader. → Trả trạng thái tồn tại thời điểm truy vấn, không bảo đảm sách còn lúc checkout.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Quy tắc đề xuất:&lt;/b&gt; Tìm độc giả là API có quyền riêng; catalog công khai không chứa dữ liệu độc giả; Ctrl+K là shortcut UI.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lỗi / ngoại lệ:&lt;/b&gt; Không kết quả là trạng thái rỗng. Truy vấn quá rộng phải có limit; không ghép SQL bằng chuỗi input.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Kết quả / bất biến:&lt;/b&gt; Không rò rỉ reader qua endpoint công khai.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="7524" y="14708" width="570" height="646" /></mxCell><mxCell id="card_ST_F19" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#A8BACB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="8189" y="14603" width="1520" height="766" /></mxCell><mxCell id="board_179" value="CHI TIẾT • ST_F19 F19 — Theo dõi sách quá hạn" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=22;fontStyle=1;fillColor=#EAF2F8;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="8201" y="14613" width="1496" height="80" /></mxCell><mxCell id="content_card_ST_F19" value="" style="group;" vertex="1" parent="1"><mxGeometry as="geometry" x="8209" y="14708" width="880" height="626" /></mxCell><mxCell id="card_ST_F19__title" value="F19 — Theo dõi sách quá hạn" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="content_card_ST_F19"><mxGeometry x="24" y="16" width="789.12" height="40" as="geometry" /></mxCell><mxCell id="card_ST_F19__n0" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;ellipse;fillColor=#243444;" vertex="1" parent="content_card_ST_F19"><mxGeometry x="409.52" y="90.00000000000001" width="12.959999999999999" height="12.959999999999999" as="geometry" /></mxCell><mxCell id="card_ST_F19__n1" value="Nhập bộ lọc" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_ST_F19"><mxGeometry x="362.9432" y="151.96000000000004" width="106.1136" height="36" as="geometry" /></mxCell><mxCell id="card_ST_F19__n2" value="Đang truy vấn" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_ST_F19"><mxGeometry x="361.8524" y="247.96000000000004" width="108.2952" height="36" as="geometry" /></mxCell><mxCell id="card_ST_F19__n3" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rhombus;" vertex="1" parent="content_card_ST_F19"><mxGeometry x="403.4" y="343.96000000000004" width="25.2" height="25.2" as="geometry" /></mxCell><mxCell id="card_ST_F19__n4" value="Có kết quả" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_ST_F19"><mxGeometry x="70.0002" y="429.16" width="95.99759999999999" height="36" as="geometry" /></mxCell><mxCell id="card_ST_F19__n5" value="Không có kết quả" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="content_card_ST_F19"><mxGeometry x="516.8456" y="429.16" width="134.3088" height="36" as="geometry" /></mxCell><mxCell id="card_ST_F19__n6" value="Lỗi truy vấn" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeC