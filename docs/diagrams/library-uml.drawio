4" /><mxPoint x="104.429" y="403.96000000000004" /><mxPoint x="104.429" y="403.96000000000004" /><mxPoint x="104.429" y="415.96000000000004" /><mxPoint x="104.429" y="415.96000000000004" /><mxPoint x="104.429" y="415.96000000000004" /><mxPoint x="107.36" y="423.51" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F20__e7" value="" style="html=1;fontFamily=Arial;fontSize=11;strokeColor=#344454;endArrow=classic;endFill=1;rounded=0;" edge="1" parent="content_card_ST_F20" source="card_ST_F20__n5" target="card_ST_F20__n6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="145.555" y="489.72900000000004" /><mxPoint x="160.428" y="507.88800000000003" /></Array></mxGeometry></mxCell><mxCell id="card_ST_F20__note" value="ExportJob" style="text;html=1;fontFamily=Arial;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="content_card_ST_F20"><mxGeometry x="24" y="583.8" width="486.56" height="70" as="geometry" /></mxCell><mxCell id="board_185" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chức năng:&lt;/b&gt; F20 ↔ UC15 — Xuất dữ liệu CSV&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Người thao tác:&lt;/b&gt; Quản lý theo nguồn yêu cầu&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Chủ thể / phạm vi:&lt;/b&gt; ExportJob&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; Nút = trạng thái của chủ thể; cạnh = sự kiện [điều kiện] / hành động. Nút đen bắt đầu; nút kép kết thúc phiên được mô tả.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Hoạt động:&lt;/b&gt; Kiểm tra quyền và phạm vi dữ liệu; tạo job idempotent. → Chụp bộ lọc/snapshot; tạo CSV UTF-8 và chống công thức khi mở bảng tính. → Lưu artifact private, hash, số dòng và hạn tải. → Kiểm tra quyền lần nữa khi tải; trả signed URL ngắn hạn hoặc stream.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Quy tắc đề xuất:&lt;/b&gt; Baseline CSV khoản mượn/phạt; mở quyền Thủ thư hoặc định dạng Excel/PDF cần duyệt vì nguồn mâu thuẫn.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lỗi / ngoại lệ:&lt;/b&gt; Không export PII ngoài phạm vi; quyền đã bị thu hồi chặn tải. Artifact hết hạn: 410; worker retry giới hạn, không nhân job.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Kết quả / bất biến:&lt;/b&gt; File không công khai; audit người xuất và người tải.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="692" y="15738" width="570" height="729" /></mxCell><mxCell id="card_ST_F21_" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#A8BACB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="1357" y="15633" width="1210" height="776" /></mxCell><mxCell id="board_187" value="CHI TIẾT • ST_F21 F21 — Quản trị tài khoản và vai trò" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=22;fontStyle=1;fillColor=#EAF2F8;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="1369" y="15643" width="1186" height="80" /></mxCell><mxCell id="content_card_ST_F21_" value="" style="group;" vertex="1" parent="1"><mxGeometry as="geometry" x="1377" y="15738" width="570" height="636" /></mxCell><mxCell id="card_ST_F21___title" value="F21 — Quản trị tài khoản và vai trò" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="content_card_ST_F21_"><mxGeometry x="24" y="16" width="479.92" height="40" as="geometry" /></mxCell><mxCell id="card_ST_F21___n0" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;ellipse;fillColor=#243444;" vertex="1" parent="content_card_ST_F21_"><mxGeometry x="198.57000000000002" y="89.99999999999996" width="12.9599