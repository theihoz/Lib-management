geometry" /></mxCell><mxCell id="card_SD_Auth__life4" value="" style="dashed=1;endArrow=none;strokeColor=#657585;" edge="1" parent="content_card_SD_Auth"><mxGeometry relative="1" as="geometry"><mxPoint x="952.5" y="99" as="sourcePoint" /><mxPoint x="952.5" y="772" as="targetPoint" /></mxGeometry></mxCell><mxCell id="card_SD_Auth__m0" value="" style="endArrow=classic;endFill=1;strokeColor=#344454;" edge="1" parent="content_card_SD_Auth"><mxGeometry relative="1" as="geometry"><mxPoint x="132.5" y="145" as="sourcePoint" /><mxPoint x="337.5" y="145" as="targetPoint" /></mxGeometry></mxCell><mxCell id="card_SD_Auth__l0" value="1. Chọn đăng nhập" style="text;html=1;fontSize=12;whiteSpace=wrap;align=center;fillColor=#FFFFFF;" vertex="1" parent="content_card_SD_Auth"><mxGeometry x="45" y="102" width="380" height="36" as="geometry" /></mxCell><mxCell id="card_SD_Auth__m1" value="" style="endArrow=classic;endFill=1;strokeColor=#344454;" edge="1" parent="content_card_SD_Auth"><mxGeometry relative="1" as="geometry"><mxPoint x="337.5" y="202" as="sourcePoint" /><mxPoint x="542.5" y="202" as="targetPoint" /></mxGeometry></mxCell><mxCell id="card_SD_Auth__l1" value="2. Authorization code + PKCE; state/nonce" style="text;html=1;fontSize=12;whiteSpace=wrap;align=center;fillColor=#FFFFFF;" vertex="1" parent="content_card_SD_Auth"><mxGeometry x="250" y="159" width="380" height="36" as="geometry" /></mxCell><mxCell id="card_SD_Auth__m2" value="" style="endArrow=classic;endFill=1;strokeColor=#344454;" edge="1" parent="content_card_SD_Auth"><mxGeometry relative="1" as="geometry"><mxPoint x="542.5" y="259" as="sourcePoint" /><mxPoint x="337.5" y="259" as="targetPoint" /></mxGeometry></mxCell><mxCell id="card_SD_Auth__l2" value="3. Callback code" style="text;html=1;fontSize=12;whiteSpace=wrap;align=center;fillColor=#FFFFFF;" vertex="1" parent="content_card_SD_Auth"><mxGeometry x="250" y="216" width="380" height="36" as="geometry" /></mxCell><mxCell id="card_SD_Auth__m3" value="" style="endArrow=classic;endFill=1;strokeColor=#344454;" edge="1" parent="content_card_SD_Auth"><mxGeometry relative="1" as="geometry"><mxPoint x="337.5" y="316" as="sourcePoint" /><mxPoint x="542.5" y="316" as="targetPoint" /></mxGeometry></mxCell><mxCell id="card_SD_Auth__l3" value="4. Đổi code lấy token" style="text;html=1;fontSize=12;whiteSpace=wrap;align=center;fillColor=#FFFFFF;" vertex="1" parent="content_card_SD_Auth"><mxGeometry x="250" y="273" width="380" height="36" as="geometry" /></mxCell><mxCell id="card_SD_Auth__m4" value="" style="endArrow=classic;endFill=1;strokeColor=#344454;" edge="1" parent="content_card_SD_Auth"><mxGeometry relative="1" as="geometry"><mxPoint x="542.5" y="373" as="sourcePoint" /><mxPoint x="337.5" y="373" as="targetPoint" /></mxGeometry></mxCell><mxCell id="card_SD_Auth__l4" value="5. Token từ issuer đã cấu hình" style="text;html=1;fontSize=12;whiteSpace=wrap;align=center;fillColor=#FFFFFF;" vertex="1" parent="content_card_SD_Auth"><mxGeometry x="250" y="330" width="380" height="36" as="geometry" /></mxCell><mxCell id="card_SD_Auth__m5" value="" style="endArrow=classic;endFill=1;strokeColor=#344454;" edge="1" parent="content_card_SD_Auth"><mxGeometry relative="1" as="geometry"><mxPoint x="337.5" y="430" as="sourcePoint" /><mxPoint x="747.5" y="430" as="targetPoint" /></mxGeometry></mxCell><mxCell id="card_SD_Auth__l5" value="6. Yêu cầu API + access token" style="text;html=1;fontSize=12;whiteSpace=wrap;align=center;fillColor=#FFFFFF;" vertex="1" parent="content_card_SD_Auth"><mxGeometry x="352.5" y="387" width="380" height="36" as="geometry" /></mxCell><mxCell id="card_SD_Auth__m6" value="" style="endArrow=classic;endFill=1;strokeColor=#344454;" edge="1" parent="content_card_SD_Auth"><mxGeometry relative="1" as="geometry"><mxPoint x="747.5" y="487" as="sourcePoint" /><mxPoint x="747.5" y="487" as="targetPoint" /><Array as="points"><mxPoint x="827.5" y="487" /><mxPoint x="827.5" y="509" /></Array></mxGeometry></mxCell><mxCell id="card_SD_Auth__l6" value="7. Kiểm tra chữ ký, iss, aud, exp" style="text;html=1;fontSize=12;whiteSpace=wrap;align=center;fillColor=#FFFFFF;" vertex="1" parent="content_card_SD_Auth"><mxGeometry x="617.5" y="444" width="380" height="36" as="geometry" /></mxCell><mxCell id="card_SD_Auth__m7" value="" style="endArrow=classic;endFill=1;strokeColor=#344454;" edge="1" parent="content_card_SD_Auth"><mxGeometry relative="1" as="geometry"><mxPoint x="747.5" y="544" as="sourcePoint" /><mxPoint x="952.5" y="544" as="targetPoint" /></mxGeometry></mxCell><mxCell id="card_SD_Auth__l7" value="8. Ánh xạ sub; allowlist; vai trò" style="text;html=1;fontSize=12;whiteSpace=wrap;align=center;fillColor=#FFFFFF;" vertex="1" parent="content_card_SD_Auth"><mxGeometry x="660" y="501" width="380" height="36" as="geometry" /></mxCell><mxCell id="card_SD_Auth__m8" value="" style="endArrow=classic;endFill=1;strokeColor=#344454;" edge="1" parent="content_card_SD_Auth"><mxGeometry relative="1" as="geometry"><mxPoint x="952.5" y="601" as="sourcePoint" /><mxPoint x="747.5" y="601" as="targetPoint" /></mxGeometry></mxCell><mxCell id="card_SD_Auth__l8" value="9. Account + permissions" style="text;html=1;fontSize=12;whiteSpace=wrap;align=center;fillColor=#FFFFFF;" vertex="1" parent="content_card_SD_Auth"><mxGeometry x="660" y="558" width="380" height="36" as="geometry" /></mxCell><mxCell id="card_SD_Auth__m9" value="" style="endArrow=classic;endFill=1;strokeColor=#344454;" edge="1" parent="content_card_SD_Auth"><mxGeometry relative="1" as="geometry"><mxPoint x="747.5" y="658" as="sourcePoint" /><mxPoint x="337.5" y="658" as="targetPoint" /></mxGeometry></mxCell><mxCell id="card_SD_Auth__l9" value="10. 200 dữ liệu theo quyền" style="text;html=1;fontSize=12;whiteSpace=wrap;align=center;fillColor=#FFFFFF;" vertex="1" parent="content_card_SD_Auth"><mxGeometry x="352.5" y="615" width="380" height="36" as="geometry" /></mxCell><mxCell id="card_SD_Auth__m10" value="" style="endArrow=classic;endFill=1;strokeColor=#344454;" edge="1" parent="content_card_SD_Auth"><mxGeometry relative="1" as="geometry"><mxPoint x="747.5" y="715" as="sourcePoint" /><mxPoint x="337.5" y="715" as="targetPoint" /></mxGeometry></mxCell><mxCell id="card_SD_Auth__l10" value="11. alt token sai: 401; thiếu quyền: 403" style="text;html=1;fontSize=12;whiteSpace=wrap;align=center;fillColor=#FFFFFF;" vertex="1" parent="content_card_SD_Auth"><mxGeometry x="352.5" y="672" width="380" height="36" as="geometry" /></mxCell><mxCell id="card_SD_Auth__note" value="Không JIT từ token tùy ý. Không tự cấp vai trò nhân viên/quản lý từ request." style="text;html=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="content_card_SD_Auth"><mxGeometry x="25" y="787" width="1015" height="60" as="geometry" /></mxCell><mxCell id="board_311" value="&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Mục đích:&lt;/b&gt; Sequence — UC0 đăng nhập&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách đọc:&lt;/b&gt; Cột là participant, nét đứt là lifeline; thời gian từ trên xuống. alt = chọn một nhánh; critical = vùng nguyên tử; opt = có điều kiện.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Cách hoạt động:&lt;/b&gt; Người dùng khởi tạo OIDC authorization code + PKCE; UI kiểm tra state / nonce và nhận token từ issuer cấu hình. API kiểm tra chữ ký, iss, aud, exp rồi ánh xạ sub vào account allowlist. Token sai trả 401, thiếu quyền trả 403. Không tự tạo tài khoản nhân viên hoặc lấy role từ request.&lt;/p&gt;&lt;p style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Lưu ý / ràng buộc:&lt;/b&gt; Không JIT từ token tùy ý. Không tự cấp vai trò nhân viên/quản lý từ request.&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#F7FAFD;strokeColor=#DCE5EE;" vertex="1" parent="1"><mxGeometry as="geometry" x="3415" y="22903" width="570" height="902" /></mxCell><mxCell id="card_SD_Card" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#A8BACB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="4080" y="22798" width="1725" height="965" /></mxCell><mxCell id="board_313" value="CHI TIẾT • SD_Card Sequence — UC5 cấp thẻ" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=12;fontSize=22;fontStyle=1;fillColor=#EAF2F8;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="4092" y="22808" width="1701" height="80" /></mxCell><mxCell id="content_card_SD_Card" value="" style="group;" vertex="1" parent="1"><mxGeometry as="geometry" x="4100" y="22903" width="1085" height="825" /></mxCell><mxCell id="card_SD_Card__frame0" value="alt [tuổi, dữ liệu và tham chiếu hợp lệ]" style="rounded=0;fillColor=none;strokeColor=#657585;html=1;verticalAlign=top;align=left;fontSize=11;" vertex="1" parent="content_card_SD_Card"><mxGeometry x="20" y="393" width="1025" height="285" as="geometry" /></mxCell><mxCell id="card_SD_Card__divider0" value="[else]" style="text;html=1;fontSize=11;align=left;" vertex="1" parent="content_card_SD_Card"><mxGeometry x="25" y="621" width="1015" height="20" as="geometry" /></mxCell><mxCell id="card_SD_Card__p0" value="Thủ thư" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=0;fillColor=#edf3f7;" vertex="1" parent="content_card_SD_Card"><mxGeometry x="50" y="55" width="165" height="44" as="geometry" /></mxCell><mxCell id="card_SD_Card__life0" value="" style="dashed=1;endArrow=none;strokeColor=#657585;" edge="1" parent="content_card_SD_Card"><mxGeometry relative="1" as="geometry"><mxPoint x="132.5" y="99" as="sourcePoint" /><mxPoint x="132.5" y="715" as="targetPoint" /></mxGeometry></mxCell><mxCell id="card_SD_Card__p1" value="UI" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#344454;fillColor=#FFFFFF;rounded=0;fillColor=#edf3f7;" vertex="1" parent="content_ca